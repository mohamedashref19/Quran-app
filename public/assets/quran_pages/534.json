      "page": 534,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 6,
      "text": "فَكَانَتْ هَبَآءً مُّنۢبَثًّا",
      "surahNumber": 56,
      "page": 534,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 7,
      "text": "وَكُنتُمْ أَزْوَٰجًا ثَلَـٰثَةً",
