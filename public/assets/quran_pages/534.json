      "page": 534,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 4,
      "text": "إِذَا رُجَّتِ ٱلْأَرْضُ رَجًّا",
      "surahNumber": 56,
      "page": 534,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 5,
      "text": "وَبُسَّتِ ٱلْجِبَالُ بَسًّا",
