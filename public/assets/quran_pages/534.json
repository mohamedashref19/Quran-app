      "surahNumber": 55,
      "page": 534,
      "surahNameAr": "سورة الرحمن"
    },
    {
      "numberInSurah": 78,
      "text": "تَبَـٰرَكَ ٱسْمُ رَبِّكَ ذِى ٱلْجَلَـٰلِ وَٱلْإِكْرَامِ",
      "surahNumber": 55,
      "page": 534,
      "surahNameAr": "سورة الرحمن"
    },
    {
      "numberInSurah": 1,
      "text": " إِذَا وَقَعَتِ ٱلْوَاقِعَةُ",
      "surahNumber": 56,
      "page": 534,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 2,
      "text": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ",
