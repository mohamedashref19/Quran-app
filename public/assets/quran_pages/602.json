{
  "number": 602,
  "ayahs": [
    {
      "numberInSurah": 1,
      "text": " لِإِيلَـٰفِ قُرَيْشٍ",
      "surahNumber": 106,
      "page": 602,
      "surahNameAr": "سورة قريش"
    },
    {
      "numberInSurah": 2,
      "text": "إِۦلَـٰفِهِمْ رِحْلَةَ ٱلشِّتَآءِ وَٱلصَّيْفِ",
      "surahNumber": 106,
      "page": 602,
      "surahNameAr": "سورة قريش"
    },
    {
      "numberInSurah": 3,
      "text": "فَلْيَعْبُدُوا۟ رَبَّ هَـٰذَا ٱلْبَيْتِ",
      "surahNumber": 106,
      "page": 602,
      "surahNameAr": "سورة قريش"
    },
    {
      "numberInSurah": 4,
      "text": "ٱلَّذِىٓ أَطْعَمَهُم مِّن جُوعٍ وَءَامَنَهُم مِّنْ خَوْفٍۭ",
      "surahNumber": 106,
      "page": 602,
      "surahNameAr": "سورة قريش"
    },
    {
      "numberInSurah": 1,
      "text": " أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ",
      "surahNumber": 107,
      "page": 602,
      "surahNameAr": "سورة الماعون"
    },
    {
      "numberInSurah": 2,
      "text": "فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ",
      "surahNumber": 107,
      "page": 602,
      "surahNameAr": "سورة الماعون"
    },
    {
      "numberInSurah": 3,
      "text": "وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ",
      "surahNumber": 107,
      "page": 602,
      "surahNameAr": "سورة الماعون"
    },
    {
      "numberInSurah": 4,
      "text": "فَوَيْلٌ لِّلْمُصَلِّينَ",
      "surahNumber": 107,
      "page": 602,
      "surahNameAr": "سورة الماعون"
    },
    {
      "numberInSurah": 5,
      "text": "ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ",
      "surahNumber": 107,
      "page": 602,
      "surahNameAr": "سورة الماعون"
    },
    {
      "numberInSurah": 6,
      "text": "ٱلَّذِينَ هُمْ يُرَآءُونَ",
      "surahNumber": 107,
      "page": 602,
      "surahNameAr": "سورة الماعون"
    },
    {
      "numberInSurah": 7,
      "text": "وَيَمْنَعُونَ ٱلْمَاعُونَ",
      "surahNumber": 107,
      "page": 602,
      "surahNameAr": "سورة الماعون"
    },
    {
      "numberInSurah": 1,
      "text": " إِنَّآ أَعْطَيْنَـٰكَ ٱلْكَوْثَرَ",
      "surahNumber": 108,
      "page": 602,
      "surahNameAr": "سورة الكوثر"
    },
    {
      "numberInSurah": 2,
      "text": "فَصَلِّ لِرَبِّكَ وَٱنْحَرْ",
      "surahNumber": 108,
      "page": 602,
      "surahNameAr": "سورة الكوثر"
    },
    {
      "numberInSurah": 3,
      "text": "إِنَّ شَانِئَكَ هُوَ ٱلْأَبْتَرُ",
      "surahNumber": 108,
      "page": 602,
      "surahNameAr": "سورة الكوثر"
    }
  ]
}