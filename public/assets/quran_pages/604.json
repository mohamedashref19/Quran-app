{
  "number": 604,
  "ayahs": [
    {
      "numberInSurah": 1,
      "text": " قُلْ هُوَ ٱللَّهُ أَحَدٌ",
      "surahNumber": 112,
      "page": 604,
      "surahNameAr": "سورة الإخلاص"
    },
    {
      "numberInSurah": 2,
      "text": "ٱللَّهُ ٱلصَّمَدُ",
      "surahNumber": 112,
      "page": 604,
      "surahNameAr": "سورة الإخلاص"
    },
    {
      "numberInSurah": 3,
      "text": "لَمْ يَلِدْ وَلَمْ يُولَدْ",
      "surahNumber": 112,
      "page": 604,
      "surahNameAr": "سورة الإخلاص"
    },
    {
      "numberInSurah": 4,
      "text": "وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ",
      "surahNumber": 112,
      "page": 604,
      "surahNameAr": "سورة الإخلاص"
    },
    {
      "numberInSurah": 1,
      "text": " قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ",
      "surahNumber": 113,
      "page": 604,
      "surahNameAr": "سورة الفلق"
    },
    {
      "numberInSurah": 2,
      "text": "مِن شَرِّ مَا خَلَقَ",
      "surahNumber": 113,
      "page": 604,
      "surahNameAr": "سورة الفلق"
    },
    {
      "numberInSurah": 3,
      "text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ",
      "surahNumber": 113,
      "page": 604,
      "surahNameAr": "سورة الفلق"
    },
    {
      "numberInSurah": 4,
      "text": "وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ",
      "surahNumber": 113,
      "page": 604,
      "surahNameAr": "سورة الفلق"
    },
    {
      "numberInSurah": 5,
      "text": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ",
      "surahNumber": 113,
      "page": 604,
      "surahNameAr": "سورة الفلق"
    },
    {
      "numberInSurah": 1,
      "text": " قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ",
      "surahNumber": 114,
      "page": 604,
      "surahNameAr": "سورة الناس"
    },
    {
      "numberInSurah": 2,
      "text": "مَلِكِ ٱلنَّاسِ",
      "surahNumber": 114,
      "page": 604,
      "surahNameAr": "سورة الناس"
    },
    {
      "numberInSurah": 3,
      "text": "إِلَـٰهِ ٱلنَّاسِ",
      "surahNumber": 114,
      "page": 604,
      "surahNameAr": "سورة الناس"
    },
    {
      "numberInSurah": 4,
      "text": "مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ",
      "surahNumber": 114,
      "page": 604,
      "surahNameAr": "سورة الناس"
    },
    {
      "numberInSurah": 5,
      "text": "ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ",
      "surahNumber": 114,
      "page": 604,
      "surahNameAr": "سورة الناس"
    },
    {
      "numberInSurah": 6,
      "text": "مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ",
      "surahNumber": 114,
      "page": 604,
      "surahNameAr": "سورة الناس"
    }
  ]
