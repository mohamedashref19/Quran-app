{
  "number": 595,
  "ayahs": [
    {
      "numberInSurah": 1,
      "text": " وَٱلشَّمْسِ وَضُحَىٰهَا",
      "surahNumber": 91,
      "page": 595,
      "surahNameAr": "سورة الشمس"
    },
    {
      "numberInSurah": 2,
      "text": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا",
      "surahNumber": 91,
      "page": 595,
      "surahNameAr": "سورة الشمس"
    },
    {
      "numberInSurah": 3,
      "text": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا",
      "surahNumber": 91,
      "page": 595,
      "surahNameAr": "سورة الشمس"
    },
    {
      "numberInSurah": 4,
      "text": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا",
      "surahNumber": 91,
      "page": 595,
      "surahNameAr": "سورة الشمس"
    },
    {
      "numberInSurah": 5,
      "text": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا",
      "surahNumber": 91,
      "page": 595,
      "surahNameAr": "سورة الشمس"
    },
    {
      "numberInSurah": 6,
      "text": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا",
      "surahNumber": 91,
      "page": 595,
      "surahNameAr": "سورة الشمس"
    },
    {
      "numberInSurah": 7,
      "text": "وَنَفْسٍ وَمَا سَوَّىٰهَا",
      "surahNumber": 91,
      "page": 595,
      "surahNameAr": "سورة الشمس"
    },
    {
      "numberInSurah": 8,
      "text": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا",
      "surahNumber": 91,
      "page": 595,
      "surahNameAr": "سورة الشمس"
    },
    {
      "numberInSurah": 9,
      "text": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا",
      "surahNumber": 91,
      "page": 595,
      "surahNameAr": "سورة الشمس"
    },
    {
      "numberInSurah": 10,
      "text": "وَقَدْ خَابَ مَن دَسَّىٰهَا",
      "surahNumber": 91,
      "page": 595,
      "surahNameAr": "سورة الشمس"
    },
    {
      "numberInSurah": 11,
      "text": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ",
      "surahNumber": 91,
      "page": 595,
      "surahNameAr": "سورة الشمس"
    },
    {
      "numberInSurah": 12,
      "text": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا",
      "surahNumber": 91,
      "page": 595,
      "surahNameAr": "سورة الشمس"
    },
    {
      "numberInSurah": 13,
      "text": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَـٰهَا",
      "surahNumber": 91,
      "page": 595,
      "surahNameAr": "سورة الشمس"
    },
    {
      "numberInSurah": 14,
      "text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا",
      "surahNumber": 91,
      "page": 595,
      "surahNameAr": "سورة الشمس"
    },
    {
      "numberInSurah": 15,
      "text": "وَلَا يَخَافُ عُقْبَـٰهَا",
      "surahNumber": 91,
      "page": 595,
      "surahNameAr": "سورة الشمس"
    },
    {
      "numberInSurah": 1,
      "text": " وَٱلَّيْلِ إِذَا يَغْشَىٰ",
      "surahNumber": 92,
      "page": 595,
      "surahNameAr": "سورة الليل"
    },
    {
      "numberInSurah": 2,
      "text": "وَٱلنَّهَارِ إِذَا تَجَلَّىٰ",
      "surahNumber": 92,
      "page": 595,
      "surahNameAr": "سورة الليل"
    },
    {
      "numberInSurah": 3,
      "text": "وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ",
      "surahNumber": 92,
      "page": 595,
      "surahNameAr": "سورة الليل"
    },
    {
      "numberInSurah": 4,
      "text": "إِنَّ سَعْيَكُمْ لَشَتَّىٰ",
      "surahNumber": 92,
      "page": 595,
      "surahNameAr": "سورة الليل"
    },
    {
      "numberInSurah": 5,
      "text": "فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ",
      "surahNumber": 92,
      "page": 595,
      "surahNameAr": "سورة الليل"
    },
    {
      "numberInSurah": 6,
      "text": "وَصَدَّقَ بِٱلْحُسْنَىٰ",
      "surahNumber": 92,
      "page": 595,
      "surahNameAr": "سورة الليل"
    },
    {
      "numberInSurah": 7,
      "text": "فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ",
      "surahNumber": 92,
      "page": 595,
      "surahNameAr": "سورة الليل"
    },
    {
      "numberInSurah": 8,
      "text": "وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ",
      "surahNumber": 92,
      "page": 595,
      "surahNameAr": "سورة الليل"
    },
    {
      "numberInSurah": 9,
      "text": "وَكَذَّبَ بِٱلْحُسْنَىٰ",
      "surahNumber": 92,
      "page": 595,
      "surahNameAr": "سورة الليل"
    },
    {
      "numberInSurah": 10,
      "text": "فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ",
      "surahNumber": 92,
      "page": 595,
      "surahNameAr": "سورة الليل"
    },
    {
      "numberInSurah": 11,
      "text": "وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ",
      "surahNumber": 92,
      "page": 595,
      "surahNameAr": "سورة الليل"
    },
    {
      "numberInSurah": 12,
      "text": "إِنَّ عَلَيْنَا لَلْهُدَىٰ",
      "surahNumber": 92,
      "page": 595,
      "surahNameAr": "سورة الليل"
    },
    {
      "numberInSurah": 13,
      "text": "وَإِنَّ لَنَا لَلْـَٔاخِرَةَ وَٱلْأُولَىٰ",
      "surahNumber": 92,
      "page": 595,
      "surahNameAr": "سورة الليل"
    },
    {
      "numberInSurah": 14,
      "text": "فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ",
      "surahNumber": 92,
      "page": 595,
      "surahNameAr": "سورة الليل"
    }
  ]
}