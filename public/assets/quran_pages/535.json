{
  "number": 535,
  "ayahs": [
    {
      "numberInSurah": 17,
      "text": "يَطُوفُ عَلَيْهِمْ وِلْدَٰنٌ مُّخَلَّدُونَ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 18,
      "text": "بِأَكْوَابٍ وَأَبَارِيقَ وَكَأْسٍ مِّن مَّعِينٍ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 19,
      "text": "لَّا يُصَدَّعُونَ عَنْهَا وَلَا يُنزِفُونَ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 20,
      "text": "وَفَـٰكِهَةٍ مِّمَّا يَتَخَيَّرُونَ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 21,
      "text": "وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُونَ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 22,
      "text": "وَحُورٌ عِينٌ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 23,
      "text": "كَأَمْثَـٰلِ ٱللُّؤْلُؤِ ٱلْمَكْنُونِ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 24,
      "text": "جَزَآءًۢ بِمَا كَانُوا۟ يَعْمَلُونَ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 25,
      "text": "لَا يَسْمَعُونَ فِيهَا لَغْوًا وَلَا تَأْثِيمًا",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 26,
      "text": "إِلَّا قِيلًا سَلَـٰمًا سَلَـٰمًا",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 27,
      "text": "وَأَصْحَـٰبُ ٱلْيَمِينِ مَآ أَصْحَـٰبُ ٱلْيَمِينِ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 28,
      "text": "فِى سِدْرٍ مَّخْضُودٍ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 29,
      "text": "وَطَلْحٍ مَّنضُودٍ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 30,
      "text": "وَظِلٍّ مَّمْدُودٍ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 31,
      "text": "وَمَآءٍ مَّسْكُوبٍ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 32,
      "text": "وَفَـٰكِهَةٍ كَثِيرَةٍ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 33,
      "text": "لَّا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 34,
      "text": "وَفُرُشٍ مَّرْفُوعَةٍ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 35,
      "text": "إِنَّآ أَنشَأْنَـٰهُنَّ إِنشَآءً",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 36,
      "text": "فَجَعَلْنَـٰهُنَّ أَبْكَارًا",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 37,
      "text": "عُرُبًا أَتْرَابًا",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 38,
      "text": "لِّأَصْحَـٰبِ ٱلْيَمِينِ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 39,
      "text": "ثُلَّةٌ مِّنَ ٱلْأَوَّلِينَ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 40,
      "text": "وَثُلَّةٌ مِّنَ ٱلْـَٔاخِرِينَ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 41,
      "text": "وَأَصْحَـٰبُ ٱلشِّمَالِ مَآ أَصْحَـٰبُ ٱلشِّمَالِ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 42,
      "text": "فِى سَمُومٍ وَحَمِيمٍ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 43,
      "text": "وَظِلٍّ مِّن يَحْمُومٍ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 44,
      "text": "لَّا بَارِدٍ وَلَا كَرِيمٍ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 45,
      "text": "إِنَّهُمْ كَانُوا۟ قَبْلَ ذَٰلِكَ مُتْرَفِينَ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 46,
      "text": "وَكَانُوا۟ يُصِرُّونَ عَلَى ٱلْحِنثِ ٱلْعَظِيمِ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 47,
      "text": "وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَـٰمًا أَءِنَّا لَمَبْعُوثُونَ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 48,
      "text": "أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 49,
      "text": "قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْـَٔاخِرِينَ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    },
    {
      "numberInSurah": 50,
      "text": "لَمَجْمُوعُونَ إِلَىٰ مِيقَـٰتِ يَوْمٍ مَّعْلُومٍ",
      "surahNumber": 56,
      "page": 535,
      "surahNameAr": "سورة الواقعة"
    }
  ]
}