{
  "number": 592,
  "ayahs": [
    {
      "numberInSurah": 16,
      "text": "بَلْ تُؤْثِرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا",
      "surahNumber": 87,
      "page": 592,
      "surahNameAr": "سورة الأعلى"
    },
    {
      "numberInSurah": 17,
      "text": "وَٱلْـَٔاخِرَةُ خَيْرٌ وَأَبْقَىٰٓ",
      "surahNumber": 87,
      "page": 592,
      "surahNameAr": "سورة الأعلى"
    },
    {
      "numberInSurah": 18,
      "text": "إِنَّ هَـٰذَا لَفِى ٱلصُّحُفِ ٱلْأُولَىٰ",
      "surahNumber": 87,
      "page": 592,
      "surahNameAr": "سورة الأعلى"
    },
    {
      "numberInSurah": 19,
      "text": "صُحُفِ إِبْرَٰهِيمَ وَمُوسَىٰ",
      "surahNumber": 87,
      "page": 592,
      "surahNameAr": "سورة الأعلى"
    },
    {
      "numberInSurah": 1,
      "text": " هَلْ أَتَىٰكَ حَدِيثُ ٱلْغَـٰشِيَةِ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 2,
      "text": "وُجُوهٌ يَوْمَئِذٍ خَـٰشِعَةٌ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 3,
      "text": "عَامِلَةٌ نَّاصِبَةٌ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 4,
      "text": "تَصْلَىٰ نَارًا حَامِيَةً",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 5,
      "text": "تُسْقَىٰ مِنْ عَيْنٍ ءَانِيَةٍ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 6,
      "text": "لَّيْسَ لَهُمْ طَعَامٌ إِلَّا مِن ضَرِيعٍ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 7,
      "text": "لَّا يُسْمِنُ وَلَا يُغْنِى مِن جُوعٍ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 8,
      "text": "وُجُوهٌ يَوْمَئِذٍ نَّاعِمَةٌ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 9,
      "text": "لِّسَعْيِهَا رَاضِيَةٌ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 10,
      "text": "فِى جَنَّةٍ عَالِيَةٍ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 11,
      "text": "لَّا تَسْمَعُ فِيهَا لَـٰغِيَةً",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 12,
      "text": "فِيهَا عَيْنٌ جَارِيَةٌ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 13,
      "text": "فِيهَا سُرُرٌ مَّرْفُوعَةٌ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 14,
      "text": "وَأَكْوَابٌ مَّوْضُوعَةٌ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 15,
      "text": "وَنَمَارِقُ مَصْفُوفَةٌ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 16,
      "text": "وَزَرَابِىُّ مَبْثُوثَةٌ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 17,
      "text": "أَفَلَا يَنظُرُونَ إِلَى ٱلْإِبِلِ كَيْفَ خُلِقَتْ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 18,
      "text": "وَإِلَى ٱلسَّمَآءِ كَيْفَ رُفِعَتْ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 19,
      "text": "وَإِلَى ٱلْجِبَالِ كَيْفَ نُصِبَتْ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 20,
      "text": "وَإِلَى ٱلْأَرْضِ كَيْفَ سُطِحَتْ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 21,
      "text": "فَذَكِّرْ إِنَّمَآ أَنتَ مُذَكِّرٌ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 22,
      "text": "لَّسْتَ عَلَيْهِم بِمُصَيْطِرٍ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 23,
      "text": "إِلَّا مَن تَوَلَّىٰ وَكَفَرَ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 24,
      "text": "فَيُعَذِّبُهُ ٱللَّهُ ٱلْعَذَابَ ٱلْأَكْبَرَ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 25,
      "text": "إِنَّ إِلَيْنَآ إِيَابَهُمْ",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    },
    {
      "numberInSurah": 26,
      "text": "ثُمَّ إِنَّ عَلَيْنَا حِسَابَهُم",
      "surahNumber": 88,
      "page": 592,
      "surahNameAr": "سورة الغاشية"
    }
  ]
}