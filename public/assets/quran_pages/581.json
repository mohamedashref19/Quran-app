{
  "number": 581,
  "ayahs": [
    {
      "numberInSurah": 20,
      "text": "أَلَمْ نَخْلُقكُّم مِّن مَّآءٍ مَّهِينٍ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 21,
      "text": "فَجَعَلْنَـٰهُ فِى قَرَارٍ مَّكِينٍ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 22,
      "text": "إِلَىٰ قَدَرٍ مَّعْلُومٍ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 23,
      "text": "فَقَدَرْنَا فَنِعْمَ ٱلْقَـٰدِرُونَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 24,
      "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 25,
      "text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ كِفَاتًا",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 26,
      "text": "أَحْيَآءً وَأَمْوَٰتًا",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 27,
      "text": "وَجَعَلْنَا فِيهَا رَوَٰسِىَ شَـٰمِخَـٰتٍ وَأَسْقَيْنَـٰكُم مَّآءً فُرَاتًا",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 28,
      "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 29,
      "text": "ٱنطَلِقُوٓا۟ إِلَىٰ مَا كُنتُم بِهِۦ تُكَذِّبُونَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 30,
      "text": "ٱنطَلِقُوٓا۟ إِلَىٰ ظِلٍّ ذِى ثَلَـٰثِ شُعَبٍ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 31,
      "text": "لَّا ظَلِيلٍ وَلَا يُغْنِى مِنَ ٱللَّهَبِ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 32,
      "text": "إِنَّهَا تَرْمِى بِشَرَرٍ كَٱلْقَصْرِ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 33,
      "text": "كَأَنَّهُۥ جِمَـٰلَتٌ صُفْرٌ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 34,
      "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 35,
      "text": "هَـٰذَا يَوْمُ لَا يَنطِقُونَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 36,
      "text": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 37,
      "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 38,
      "text": "هَـٰذَا يَوْمُ ٱلْفَصْلِ ۖ جَمَعْنَـٰكُمْ وَٱلْأَوَّلِينَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 39,
      "text": "فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 40,
      "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 41,
      "text": "إِنَّ ٱلْمُتَّقِينَ فِى ظِلَـٰلٍ وَعُيُونٍ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 42,
      "text": "وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 43,
      "text": "كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 44,
      "text": "إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 45,
      "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 46,
      "text": "كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 47,
      "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 48,
      "text": "وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 49,
      "text": "وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    },
    {
      "numberInSurah": 50,
      "text": "فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ",
      "surahNumber": 77,
      "page": 581,
      "surahNameAr": "سورة المرسلات"
    }
  ]
}