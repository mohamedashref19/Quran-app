{
  "number": 582,
  "ayahs": [
    {
      "numberInSurah": 1,
      "text": " عَمَّ يَتَسَآءَلُونَ",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 2,
      "text": "عَنِ ٱلنَّبَإِ ٱلْعَظِيمِ",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 3,
      "text": "ٱلَّذِى هُمْ فِيهِ مُخْتَلِفُونَ",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 4,
      "text": "كَلَّا سَيَعْلَمُونَ",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 5,
      "text": "ثُمَّ كَلَّا سَيَعْلَمُونَ",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 6,
      "text": "أَلَمْ نَجْعَلِ ٱلْأَرْضَ مِهَـٰدًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 7,
      "text": "وَٱلْجِبَالَ أَوْتَادًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 8,
      "text": "وَخَلَقْنَـٰكُمْ أَزْوَٰجًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 9,
      "text": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 10,
      "text": "وَجَعَلْنَا ٱلَّيْلَ لِبَاسًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 11,
      "text": "وَجَعَلْنَا ٱلنَّهَارَ مَعَاشًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 12,
      "text": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 13,
      "text": "وَجَعَلْنَا سِرَاجًا وَهَّاجًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 14,
      "text": "وَأَنزَلْنَا مِنَ ٱلْمُعْصِرَٰتِ مَآءً ثَجَّاجًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 15,
      "text": "لِّنُخْرِجَ بِهِۦ حَبًّا وَنَبَاتًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 16,
      "text": "وَجَنَّـٰتٍ أَلْفَافًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 17,
      "text": "إِنَّ يَوْمَ ٱلْفَصْلِ كَانَ مِيقَـٰتًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 18,
      "text": "يَوْمَ يُنفَخُ فِى ٱلصُّورِ فَتَأْتُونَ أَفْوَاجًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 19,
      "text": "وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتْ أَبْوَٰبًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 20,
      "text": "وَسُيِّرَتِ ٱلْجِبَالُ فَكَانَتْ سَرَابًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 21,
      "text": "إِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 22,
      "text": "لِّلطَّـٰغِينَ مَـَٔابًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 23,
      "text": "لَّـٰبِثِينَ فِيهَآ أَحْقَابًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 24,
      "text": "لَّا يَذُوقُونَ فِيهَا بَرْدًا وَلَا شَرَابًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 25,
      "text": "إِلَّا حَمِيمًا وَغَسَّاقًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 26,
      "text": "جَزَآءً وِفَاقًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 27,
      "text": "إِنَّهُمْ كَانُوا۟ لَا يَرْجُونَ حِسَابًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 28,
      "text": "وَكَذَّبُوا۟ بِـَٔايَـٰتِنَا كِذَّابًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 29,
      "text": "وَكُلَّ شَىْءٍ أَحْصَيْنَـٰهُ كِتَـٰبًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    },
    {
      "numberInSurah": 30,
      "text": "فَذُوقُوا۟ فَلَن نَّزِيدَكُمْ إِلَّا عَذَابًا",
      "surahNumber": 78,
      "page": 582,
      "surahNameAr": "سورة النبأ"
    }
  ]
}