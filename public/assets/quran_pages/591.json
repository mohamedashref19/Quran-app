{
  "number": 591,
  "ayahs": [
    {
      "numberInSurah": 1,
      "text": " وَٱلسَّمَآءِ وَٱلطَّارِقِ",
      "surahNumber": 86,
      "page": 591,
      "surahNameAr": "سورة الطارق"
    },
    {
      "numberInSurah": 2,
      "text": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ",
      "surahNumber": 86,
      "page": 591,
      "surahNameAr": "سورة الطارق"
    },
    {
      "numberInSurah": 3,
      "text": "ٱلنَّجْمُ ٱلثَّاقِبُ",
      "surahNumber": 86,
      "page": 591,
      "surahNameAr": "سورة الطارق"
    },
    {
      "numberInSurah": 4,
      "text": "إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ",
      "surahNumber": 86,
      "page": 591,
      "surahNameAr": "سورة الطارق"
    },
    {
      "numberInSurah": 5,
      "text": "فَلْيَنظُرِ ٱلْإِنسَـٰنُ مِمَّ خُلِقَ",
      "surahNumber": 86,
      "page": 591,
      "surahNameAr": "سورة الطارق"
    },
    {
      "numberInSurah": 6,
      "text": "خُلِقَ مِن مَّآءٍ دَافِقٍ",
      "surahNumber": 86,
      "page": 591,
      "surahNameAr": "سورة الطارق"
    },
    {
      "numberInSurah": 7,
      "text": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ",
      "surahNumber": 86,
      "page": 591,
      "surahNameAr": "سورة الطارق"
    },
    {
      "numberInSurah": 8,
      "text": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ",
      "surahNumber": 86,
      "page": 591,
      "surahNameAr": "سورة الطارق"
    },
    {
      "numberInSurah": 9,
      "text": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ",
      "surahNumber": 86,
      "page": 591,
      "surahNameAr": "سورة الطارق"
    },
    {
      "numberInSurah": 10,
      "text": "فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ",
      "surahNumber": 86,
      "page": 591,
      "surahNameAr": "سورة الطارق"
    },
    {
      "numberInSurah": 11,
      "text": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ",
      "surahNumber": 86,
      "page": 591,
      "surahNameAr": "سورة الطارق"
    },
    {
      "numberInSurah": 12,
      "text": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ",
      "surahNumber": 86,
      "page": 591,
      "surahNameAr": "سورة الطارق"
    },
    {
      "numberInSurah": 13,
      "text": "إِنَّهُۥ لَقَوْلٌ فَصْلٌ",
      "surahNumber": 86,
      "page": 591,
      "surahNameAr": "سورة الطارق"
    },
    {
      "numberInSurah": 14,
      "text": "وَمَا هُوَ بِٱلْهَزْلِ",
      "surahNumber": 86,
      "page": 591,
      "surahNameAr": "سورة الطارق"
    },
    {
      "numberInSurah": 15,
      "text": "إِنَّهُمْ يَكِيدُونَ كَيْدًا",
      "surahNumber": 86,
      "page": 591,
      "surahNameAr": "سورة الطارق"
    },
    {
      "numberInSurah": 16,
      "text": "وَأَكِيدُ كَيْدًا",
      "surahNumber": 86,
      "page": 591,
      "surahNameAr": "سورة الطارق"
    },
    {
      "numberInSurah": 17,
      "text": "فَمَهِّلِ ٱلْكَـٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا",
      "surahNumber": 86,
      "page": 591,
      "surahNameAr": "سورة الطارق"
    },
    {
      "numberInSurah": 1,
      "text": " سَبِّحِ ٱسْمَ رَبِّكَ ٱلْأَعْلَى",
      "surahNumber": 87,
      "page": 591,
      "surahNameAr": "سورة الأعلى"
    },
    {
      "numberInSurah": 2,
      "text": "ٱلَّذِى خَلَقَ فَسَوَّىٰ",
      "surahNumber": 87,
      "page": 591,
      "surahNameAr": "سورة الأعلى"
    },
    {
      "numberInSurah": 3,
      "text": "وَٱلَّذِى قَدَّرَ فَهَدَىٰ",
      "surahNumber": 87,
      "page": 591,
      "surahNameAr": "سورة الأعلى"
    },
    {
      "numberInSurah": 4,
      "text": "وَٱلَّذِىٓ أَخْرَجَ ٱلْمَرْعَىٰ",
      "surahNumber": 87,
      "page": 591,
      "surahNameAr": "سورة الأعلى"
    },
    {
      "numberInSurah": 5,
      "text": "فَجَعَلَهُۥ غُثَآءً أَحْوَىٰ",
      "surahNumber": 87,
      "page": 591,
      "surahNameAr": "سورة الأعلى"
    },
    {
      "numberInSurah": 6,
      "text": "سَنُقْرِئُكَ فَلَا تَنسَىٰٓ",
      "surahNumber": 87,
      "page": 591,
      "surahNameAr": "سورة الأعلى"
    },
    {
      "numberInSurah": 7,
      "text": "إِلَّا مَا شَآءَ ٱللَّهُ ۚ إِنَّهُۥ يَعْلَمُ ٱلْجَهْرَ وَمَا يَخْفَىٰ",
      "surahNumber": 87,
      "page": 591,
      "surahNameAr": "سورة الأعلى"
    },
    {
      "numberInSurah": 8,
      "text": "وَنُيَسِّرُكَ لِلْيُسْرَىٰ",
      "surahNumber": 87,
      "page": 591,
      "surahNameAr": "سورة الأعلى"
    },
    {
      "numberInSurah": 9,
      "text": "فَذَكِّرْ إِن نَّفَعَتِ ٱلذِّكْرَىٰ",
      "surahNumber": 87,
      "page": 591,
      "surahNameAr": "سورة الأعلى"
    },
    {
      "numberInSurah": 10,
      "text": "سَيَذَّكَّرُ مَن يَخْشَىٰ",
      "surahNumber": 87,
      "page": 591,
      "surahNameAr": "سورة الأعلى"
    },
    {
      "numberInSurah": 11,
      "text": "وَيَتَجَنَّبُهَا ٱلْأَشْقَى",
      "surahNumber": 87,
      "page": 591,
      "surahNameAr": "سورة الأعلى"
    },
    {
      "numberInSurah": 12,
      "text": "ٱلَّذِى يَصْلَى ٱلنَّارَ ٱلْكُبْرَىٰ",
      "surahNumber": 87,
      "page": 591,
      "surahNameAr": "سورة الأعلى"
    },
    {
      "numberInSurah": 13,
      "text": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْيَىٰ",
      "surahNumber": 87,
      "page": 591,
      "surahNameAr": "سورة الأعلى"
    },
    {
      "numberInSurah": 14,
      "text": "قَدْ أَفْلَحَ مَن تَزَكَّىٰ",
      "surahNumber": 87,
      "page": 591,
      "surahNameAr": "سورة الأعلى"
    },
    {
      "numberInSurah": 15,
      "text": "وَذَكَرَ ٱسْمَ رَبِّهِۦ فَصَلَّىٰ",
      "surahNumber": 87,
      "page": 591,
      "surahNameAr": "سورة الأعلى"
    }
  ]
}