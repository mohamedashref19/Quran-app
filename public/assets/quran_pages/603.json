{
  "number": 603,
  "ayahs": [
    {
      "numberInSurah": 1,
      "text": " قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ",
      "surahNumber": 109,
      "page": 603,
      "surahNameAr": "سورة الكافرون"
    },
    {
      "numberInSurah": 2,
      "text": "لَآ أَعْبُدُ مَا تَعْبُدُونَ",
      "surahNumber": 109,
      "page": 603,
      "surahNameAr": "سورة الكافرون"
    },
    {
      "numberInSurah": 3,
      "text": "وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ",
      "surahNumber": 109,
      "page": 603,
      "surahNameAr": "سورة الكافرون"
    },
    {
      "numberInSurah": 4,
      "text": "وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ",
      "surahNumber": 109,
      "page": 603,
      "surahNameAr": "سورة الكافرون"
    },
    {
      "numberInSurah": 5,
      "text": "وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ",
      "surahNumber": 109,
      "page": 603,
      "surahNameAr": "سورة الكافرون"
    },
    {
      "numberInSurah": 6,
      "text": "لَكُمْ دِينُكُمْ وَلِىَ دِينِ",
      "surahNumber": 109,
      "page": 603,
      "surahNameAr": "سورة الكافرون"
    },
    {
      "numberInSurah": 1,
      "text": " إِذَا جَآءَ نَصْرُ ٱللَّهِ وَٱلْفَتْحُ",
      "surahNumber": 110,
      "page": 603,
      "surahNameAr": "سورة النصر"
    },
    {
      "numberInSurah": 2,
      "text": "وَرَأَيْتَ ٱلنَّاسَ يَدْخُلُونَ فِى دِينِ ٱللَّهِ أَفْوَاجًا",
      "surahNumber": 110,
      "page": 603,
      "surahNameAr": "سورة النصر"
    },
    {
      "numberInSurah": 3,
      "text": "فَسَبِّحْ بِحَمْدِ رَبِّكَ وَٱسْتَغْفِرْهُ ۚ إِنَّهُۥ كَانَ تَوَّابًۢا",
      "surahNumber": 110,
      "page": 603,
      "surahNameAr": "سورة النصر"
    },
    {
      "numberInSurah": 1,
      "text": " تَبَّتْ يَدَآ أَبِى لَهَبٍ وَتَبَّ",
      "surahNumber": 111,
      "page": 603,
      "surahNameAr": "سورة المسد"
    },
    {
      "numberInSurah": 2,
      "text": "مَآ أَغْنَىٰ عَنْهُ مَالُهُۥ وَمَا كَسَبَ",
      "surahNumber": 111,
      "page": 603,
      "surahNameAr": "سورة المسد"
    },
    {
      "numberInSurah": 3,
      "text": "سَيَصْلَىٰ نَارًا ذَاتَ لَهَبٍ",
      "surahNumber": 111,
      "page": 603,
      "surahNameAr": "سورة المسد"
    },
    {
      "numberInSurah": 4,
      "text": "وَٱمْرَأَتُهُۥ حَمَّالَةَ ٱلْحَطَبِ",
      "surahNumber": 111,
      "page": 603,
      "surahNameAr": "سورة المسد"
    },
    {
      "numberInSurah": 5,
      "text": "فِى جِيدِهَا حَبْلٌ مِّن مَّسَدٍۭ",
      "surahNumber": 111,
      "page": 603,
      "surahNameAr": "سورة المسد"
    }
  ]
}