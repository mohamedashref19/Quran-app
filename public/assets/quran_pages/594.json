{
  "number": 594,
  "ayahs": [
    {
      "numberInSurah": 24,
      "text": "يَقُولُ يَـٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى",
      "surahNumber": 89,
      "page": 594,
      "surahNameAr": "سورة الفجر"
    },
    {
      "numberInSurah": 25,
      "text": "فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ",
      "surahNumber": 89,
      "page": 594,
      "surahNameAr": "سورة الفجر"
    },
    {
      "numberInSurah": 26,
      "text": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ",
      "surahNumber": 89,
      "page": 594,
      "surahNameAr": "سورة الفجر"
    },
    {
      "numberInSurah": 27,
      "text": "يَـٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ",
      "surahNumber": 89,
      "page": 594,
      "surahNameAr": "سورة الفجر"
    },
    {
      "numberInSurah": 28,
      "text": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً",
      "surahNumber": 89,
      "page": 594,
      "surahNameAr": "سورة الفجر"
    },
    {
      "numberInSurah": 29,
      "text": "فَٱدْخُلِى فِى عِبَـٰدِى",
      "surahNumber": 89,
      "page": 594,
      "surahNameAr": "سورة الفجر"
    },
    {
      "numberInSurah": 30,
      "text": "وَٱدْخُلِى جَنَّتِى",
      "surahNumber": 89,
      "page": 594,
      "surahNameAr": "سورة الفجر"
    },
    {
      "numberInSurah": 1,
      "text": " لَآ أُقْسِمُ بِهَـٰذَا ٱلْبَلَدِ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 2,
      "text": "وَأَنتَ حِلٌّۢ بِهَـٰذَا ٱلْبَلَدِ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 3,
      "text": "وَوَالِدٍ وَمَا وَلَدَ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 4,
      "text": "لَقَدْ خَلَقْنَا ٱلْإِنسَـٰنَ فِى كَبَدٍ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 5,
      "text": "أَيَحْسَبُ أَن لَّن يَقْدِرَ عَلَيْهِ أَحَدٌ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 6,
      "text": "يَقُولُ أَهْلَكْتُ مَالًا لُّبَدًا",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 7,
      "text": "أَيَحْسَبُ أَن لَّمْ يَرَهُۥٓ أَحَدٌ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 8,
      "text": "أَلَمْ نَجْعَل لَّهُۥ عَيْنَيْنِ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 9,
      "text": "وَلِسَانًا وَشَفَتَيْنِ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 10,
      "text": "وَهَدَيْنَـٰهُ ٱلنَّجْدَيْنِ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 11,
      "text": "فَلَا ٱقْتَحَمَ ٱلْعَقَبَةَ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 12,
      "text": "وَمَآ أَدْرَىٰكَ مَا ٱلْعَقَبَةُ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 13,
      "text": "فَكُّ رَقَبَةٍ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 14,
      "text": "أَوْ إِطْعَـٰمٌ فِى يَوْمٍ ذِى مَسْغَبَةٍ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 15,
      "text": "يَتِيمًا ذَا مَقْرَبَةٍ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 16,
      "text": "أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 17,
      "text": "ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُوا۟ وَتَوَاصَوْا۟ بِٱلصَّبْرِ وَتَوَاصَوْا۟ بِٱلْمَرْحَمَةِ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 18,
      "text": "أُو۟لَـٰٓئِكَ أَصْحَـٰبُ ٱلْمَيْمَنَةِ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 19,
      "text": "وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَـٰتِنَا هُمْ أَصْحَـٰبُ ٱلْمَشْـَٔمَةِ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    },
    {
      "numberInSurah": 20,
      "text": "عَلَيْهِمْ نَارٌ مُّؤْصَدَةٌۢ",
      "surahNumber": 90,
      "page": 594,
      "surahNameAr": "سورة البلد"
    }
  ]
