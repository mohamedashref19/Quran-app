        "89_1": {
            "title": "\u0627\u0644\u0639\u0634\u0631 \u0641\u062C\u0631\u0647\u0627 \u0644\u0627\u062D",
            "sabab": "",
            "fadl": "\u0645\u0627 \u0645\u0646 \u0623\u064A\u0627\u0645 \u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0635\u0627\u0644\u062D \u0623\u062D\u0628 \u0625\u0644\u0649 \u0627\u0644\u0644\u0647 \u0641\u064A\u0647\u0646 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0623\u064A\u0627\u0645 (\u0639\u0634\u0631 \u0630\u064A \u0627\u0644\u062D\u062C\u0629).",
            "action": "\u0636\u0627\u0639\u0641 \u0627\u0644\u0637\u0627\u0639\u0627\u062A \u0648\u0627\u0644\u0627\u062C\u062A\u0647\u0627\u062F \u0641\u064A \u0627\u0644\u0639\u0628\u0627\u062F\u0629 \u0648\u0627\u0644\u0635\u064A\u0627\u0645 \u0648\u0627\u0644\u0630\u0643\u0631 \u0641\u064A \u0627\u0644\u0639\u0634\u0631 \u0627\u0644\u0623\u0648\u0627\u0626\u0644 \u0645\u0646 \u0630\u064A \u0627\u0644\u062D\u062C\u0629."
        },
        "92_18": {
            "title": "\u0627\u0644\u0651\u064E\u0630\u0650\u064A \u064A\u064F\u0624\u0652\u062A\u0650\u064A \u0645\u064E\u0627\u0644\u064E\u0647\u064F \u064A\u064E\u062A\u064E\u0632\u064E\u0643\u0651\u064E\u0649\u0670",
            "sabab": "\u0639\u0646 \u0639\u0628\u062F \u0627\u0644\u0644\u0647 \u0628\u0646 \u0627\u0644\u0632\u0628\u064A\u0631 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u0642\u0627\u0644: \u0642\u0627\u0644 \u0623\u0628\u0648 \u0642\u062D\u0627\u0641\u0629 \u0644\u0623\u0628\u064A \u0628\u0643\u0631: \u0623\u0631\u0627\u0643 \u062A\u0639\u062A\u0642 \u0631\u0642\u0627\u0628\u0627\u064B \u0636\u0639\u0627\u0641\u0627\u064B\u060C \u0641\u0644\u0648 \u0623\u0646\u0643 \u0625\u0630 \u0641\u0639\u0644\u062A\u060C \u0623\u0639\u062A\u0642\u062A \u0631\u062C\u0627\u0644\u0627\u064B \u062C\u0644\u062F\u0627\u064B \u064A\u0645\u0646\u0639\u0648\u0646\u0643 \u0648\u064A\u0642\u0648\u0645\u0648\u0646 \u062F\u0648\u0646\u0643\u060C \u0641\u0642\u0627\u0644 \u0623\u0628\u0648 \u0628\u0643\u0631: \u064A\u0627 \u0623\u0628\u062A \u0625\u0646\u064A \u0625\u0646\u0645\u0627 \u0623\u0631\u064A\u062F \u0645\u0627 \u0623\u0631\u064A\u062F\u060C \u0641\u0646\u0632\u0644\u062A \u0647\u0630\u0647 \u0627\u0644\u0622\u064A\u0629 \u0641\u064A\u0647: { \u0641\u064E\u0623\u064E\u0645\u0651\u064E\u0627 \u0645\u064E\u0646\u0652 \u0623\u064E\u0639\u0652\u0637\u064E\u0649\u0670 \u0648\u064E\u0671\u062A\u0651\u064E\u0642\u064E\u0649\u0670 \uFD3F\u0665\uFD3E \u0648\u064E\u0635\u064E\u062F\u0651\u064E\u0642\u064E \u0628\u0650\u0671\u0644\u0652\u062D\u064F\u0633\u0652\u0646\u064E\u0649\u0670 \uFD3F\u0666\uFD3E \u0641\u064E\u0633\u064E\u0646\u064F\u064A\u064E\u0633\u0651\u0650\u0631\u064F\u0647\u064F\u06E5 \u0644\u0650\u0644\u0652\u064A\u064F\u0633\u0652\u0631\u064E\u0649\u0670 \uFD3F\u0667\uFD3E } \u0625\u0644\u0649 \u0642\u0648\u0644\u0647 \u0639\u0632 \u0648 \u062C\u0644: { \u0648\u064E\u0645\u064E\u0627 \u0644\u0650\u0623\u064E\u062D\u064E\u062F\u064D \u0639\u0650\u0646\u062F\u064E\u0647\u064F\u06E5 \u0645\u0650\u0646 \u0646\u0651\u0650\u0639\u0652\u0645\u064E\u0629\u064D \u062A\u064F\u062C\u0652\u0632\u064E\u0649\u0670\u0653 \uFD3F\u0661\u0669\uFD3E \u0625\u0650\u0644\u0651\u064E\u0627 \u0671\u0628\u0652\u062A\u0650\u063A\u064E\u0627\u0653\u0621\u064E \u0648\u064E\u062C\u0652\u0647\u0650 \u0631\u064E\u0628\u0651\u0650\u0647\u0650 \u0671\u0644\u0652\u0623\u064E\u0639\u0652\u0644\u064E\u0649\u0670 \uFD3F\u0662\u0660\uFD3E } \u0648\u0644\u0633\u0648\u0641 \u064A\u0631\u0636\u064A.",
            "fadl": "",
            "action": ""
        },
        "93_1": {
            "title": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u0627\u0644\u0631\u0651\u064E\u062D\u0652\u0645\u064E\u0670\u0646\u0650 \u0627\u0644\u0631\u0651\u064E\u062D\u0650\u064A\u0645\u0650 \u0648\u064E\u0627\u0644\u0636\u0651\u064F\u062D\u064E\u0649\u0670",
            "sabab": "\u0639\u0646 \u062C\u064F\u0646\u0652\u062F\u064F\u0628 \u0628\u0652\u0646\u0650 \u0633\u064F\u0641\u0652\u064A\u064E\u0627\u0646\u064E \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u064E\u0627\u0644\u064E: \u0627\u0634\u0652\u062A\u064E\u0643\u064E\u0649 \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA\u060C \u0641\u064E\u0644\u064E\u0645\u0652 \u064A\u064E\u0642\u064F\u0645\u0652 \u0644\u064E\u064A\u0652\u0644\u064E\u062A\u064E\u064A\u0652\u0646\u0650 \u0623\u064E\u0648\u0652 \u062B\u064E\u0644\u0627\u062B\u0627\u064B\u060C \u0641\u064E\u062C\u064E\u0627\u0621\u064E\u062A\u0652 \u0627\u0645\u0652\u0631\u064E\u0623\u064E\u0629\u064C \u0641\u064E\u0642\u064E\u0627\u0644\u064E\u062A\u0652: \u064A\u064E\u0627 \u0645\u064F\u062D\u064E\u0645\u0651\u064E\u062F\u064F\u060C \u0625\u0650\u0646\u0651\u0650\u064A \u0644\u064E\u0623\u064E\u0631\u0652\u062C\u064F\u0648 \u0623\u064E\u0646\u0652 \u064A\u064E\u0643\u064F\u0648\u0646\u064E \u0634\u064E\u064A\u0652\u0637\u064E\u0627\u0646\u064F\u0643\u064E \u0642\u064E\u062F\u0652 \u062A\u064E\u0631\u064E\u0643\u064E\u0643\u064E\u060C \u0644\u064E\u0645\u0652 \u0623\u064E\u0631\u064E\u0647\u064F \u0642\u064E\u0631\u0650\u0628\u064E\u0643\u064E \u0645\u064F\u0646\u0652\u0630\u064F \u0644\u064E\u064A\u0652\u0644\u064E\u062A\u064E\u064A\u0652\u0646\u0650 \u0623\u064E\u0648\u0652 \u062B\u064E\u0644\u064E\u0627\u062B\u064E\u0629\u064D\u060C \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0639\u0632 \u0648 \u062C\u0644: { \u0648\u064E\u0671\u0644\u0636\u0651\u064F\u062D\u064E\u0649\u0670 \uFD3F\u0661\uFD3E \u0648\u064E\u0671\u0644\u0651\u064E\u064A\u0652\u0644\u0650 \u0625\u0650\u0630\u064E\u0627 \u0633\u064E\u062C\u064E\u0649\u0670 \uFD3F\u0662\uFD3E \u0645\u064E\u0627 \u0648\u064E\u062F\u0651\u064E\u0639\u064E\u0643\u064E \u0631\u064E\u0628\u0651\u064F\u0643\u064E \u0648\u064E\u0645\u064E\u0627 \u0642\u064E\u0644\u064E\u0649\u0670 \uFD3F\u0663\uFD3E }.",
            "fadl": "",
            "action": ""
        },
        "93_2": {
            "title": "\u0648\u064E\u0627\u0644\u0644\u0651\u064E\u064A\u0652\u0644\u0650 \u0625\u0650\u0630\u064E\u0627 \u0633\u064E\u062C\u064E\u0649\u0670",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 1 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
            "fadl": "",
