            title: "\u0627\u0644\u0634\u0628\u064A\u0647 \u0628\u0627\u0644\u0646\u0628\u064A",
            story: "\u0627\u0628\u0646 \u0639\u0645 \u0627\u0644\u0646\u0628\u064A \uFDFA\u060C \u0648\u0643\u0627\u0646 \u0634\u062F\u064A\u062F \u0627\u0644\u0634\u0628\u0647 \u0628\u0647 \u0641\u064A \u0645\u0644\u0627\u0645\u062D\u0647. \u0648\u0644\u064A \u0625\u0645\u0627\u0631\u0629 \u0645\u0643\u0629 \u0644\u0639\u0644\u064A \u0628\u0646 \u0623\u0628\u064A \u0637\u0627\u0644\u0628. \u062E\u0631\u062C \u0645\u062C\u0627\u0647\u062F\u0627\u064B \u0648\u0645\u0627\u062A \u0634\u0647\u064A\u062F\u0627\u064B \u0641\u064A \u0633\u0645\u0631\u0642\u0646\u062F (\u0645\u0627 \u0648\u0631\u0627\u0621 \u0627\u0644\u0646\u0647\u0631). \u0643\u0627\u0646 \u0622\u062E\u0631 \u0627\u0644\u0646\u0627\u0633 \u0639\u0647\u062F\u0627\u064B \u0628\u0627\u0644\u0646\u0628\u064A \uFDFA \u0641\u064A \u0642\u0628\u0631\u0647.",
            lessons: "\u0622\u0644 \u0628\u064A\u062A \u0627\u0644\u0646\u0628\u064A \uFDFA \u062C\u0645\u0639\u0648\u0627 \u0628\u064A\u0646 \u0627\u0644\u0634\u0631\u0641 \u0628\u0627\u0644\u0642\u0631\u0627\u0628\u0629 \u0648\u0627\u0644\u062C\u0647\u0627\u062F \u0648\u0627\u0644\u062A\u0636\u062D\u064A\u0629 \u0641\u064A \u0645\u064A\u0627\u062F\u064A\u0646 \u0627\u0644\u062F\u0639\u0648\u0629 \u0627\u0644\u0628\u0639\u064A\u062F\u0629.",
            category_tag: "\u0622\u0644 \u0627\u0644\u0628\u064A\u062A"
