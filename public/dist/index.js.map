        "4_88": {
            "title": "\u06DE \u0641\u064E\u0645\u064E\u0627 \u0644\u064E\u0643\u064F\u0645\u0652 \u0641\u0650\u064A \u0627\u0644\u0652\u0645\u064F\u0646\u064E\u0627\u0641\u0650\u0642\u0650\u064A\u0646\u064E \u0641\u0650\u0626\u064E\u062A\u064E\u064A\u0652\u0646\u0650 \u0648\u064E\u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0623\u064E\u0631\u0652\u0643\u064E\u0633\u064E\u0647\u064F\u0645\u0652 \u0628\u0650\u0645\u064E\u0627 \u0643\u064E\u0633\u064E\u0628\u064F\u0648\u0627 \u06DA \u0623\u064E\u062A\u064F\u0631\u0650\u064A\u062F\u064F\u0648\u0646\u064E \u0623\u064E\u0646\u0652 \u062A\u064E\u0647\u0652\u062F\u064F\u0648\u0627 \u0645\u064E\u0646\u0652 \u0623\u064E\u0636\u064E\u0644\u0651\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u06D6 \u0648\u064E\u0645\u064E\u0646\u0652 \u064A\u064F\u0636\u0652\u0644\u0650\u0644\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0641\u064E\u0644\u064E\u0646\u0652 \u062A\u064E\u062C\u0650\u062F\u064E \u0644\u064E\u0647\u064F \u0633\u064E\u0628\u0650\u064A\u0644\u064B\u0627",
            "sabab": "\u0639\u064E\u0646\u0652 \u0632\u064E\u064A\u0652\u062F\u0650 \u0628\u0652\u0646\u0650 \u062B\u064E\u0627\u0628\u0650\u062A\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u064E\u0627\u0644\u064E: \u0644\u064E\u0645\u0651\u064E\u0627 \u062E\u064E\u0631\u064E\u062C\u064E \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064F \uFDFA \u0625\u0650\u0644\u064E\u0649 \u0623\u064F\u062D\u064F\u062F\u064D\u060C \u0631\u064E\u062C\u064E\u0639\u064E \u0646\u064E\u0627\u0633\u064C \u0645\u0650\u0645\u0651\u064E\u0646\u0652 \u062E\u064E\u0631\u064E\u062C\u064E \u0645\u064E\u0639\u064E\u0647\u064F\u060C \u0648\u064E\u0643\u064E\u0627\u0646\u064E \u0623\u064E\u0635\u0652\u062D\u064E\u0627\u0628\u064F \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u0650 \uFDFA \u0641\u0650\u0631\u0652\u0642\u064E\u062A\u064E\u064A\u0652\u0646\u0650: \u0641\u0650\u0631\u0652\u0642\u064E\u0629\u064B \u062A\u064E\u0642\u064F\u0648\u0644\u064F: \u0646\u064F\u0642\u064E\u0627\u062A\u0650\u0644\u064F\u0647\u064F\u0645\u0652\u060C \u0648\u064E\u0641\u0650\u0631\u0652\u0642\u064E\u0629\u064B \u062A\u064E\u0642\u064F\u0648\u0644\u064F: \u0644\u064E\u0627 \u062A\u064F\u0642\u064E\u0627\u062A\u0650\u0644\u064F\u0647\u064F\u0645\u0652\u060C \u0641\u0646\u0632\u0644\u062A { \u0641\u064E\u0645\u064E\u0627 \u0644\u064E\u0643\u064F\u0645\u0652 \u0641\u0650\u0649 \u0671\u0644\u0652\u0645\u064F\u0646\u064E\u0640\u0670\u0641\u0650\u0642\u0650\u064A\u0646\u064E \u0641\u0650\u0626\u064E\u062A\u064E\u064A\u0652\u0646\u0650 \u0648\u064E\u0671\u0644\u0644\u0651\u064E\u0647\u064F \u0623\u064E\u0631\u0652\u0643\u064E\u0633\u064E\u0647\u064F\u0645 \u0628\u0650\u0645\u064E\u0627 \u0643\u064E\u0633\u064E\u0628\u064F\u0648\u0653\u0627\u06DF \u06DA }\u060C \u0648\u064E\u0642\u064E\u0627\u0644\u064E: \xab \u0625\u0650\u0646\u0651\u064E\u0647\u064E\u0627 \u0637\u064E\u064A\u0652\u0628\u064E\u0629\u064C \u062A\u064E\u0646\u0652\u0641\u0650\u064A \u0627\u0644\u0630\u0651\u064F\u0646\u064F\u0648\u0628\u064E\u060C \u0643\u064E\u0645\u064E\u0627 \u062A\u064E\u0646\u0652\u0641\u0650\u064A \u0627\u0644\u0646\u0651\u064E\u0627\u0631\u064F \u062E\u064E\u0628\u064E\u062B\u064E \u0627\u0644\u0652\u0641\u0650\u0636\u0651\u064E\u0629\u0650 \xbb.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0648\u0647\u0646\u0627\u0643 \u0633\u0628\u0628 \u0622\u062E\u0631 \u0644\u0646\u0632\u0648\u0644 \u0647\u0630\u0647 \u0627\u0644\u0622\u064A\u0629: \u0641\u0642\u062F \u062C\u0627\u0621 \u0639\u0646 \u0645\u062C\u0627\u0647\u062F \u0631\u062D\u0645\u0647 \u0627\u0644\u0644\u0647 {  \u0641\u064E\u0645\u064E\u0627 \u0644\u064E\u0643\u064F\u0645\u0652 \u0641\u0650\u0649 \u0671\u0644\u0652\u0645\u064F\u0646\u064E\u0640\u0670\u0641\u0650\u0642\u0650\u064A\u0646\u064E \u0641\u0650\u0626\u064E\u062A\u064E\u064A\u0652\u0646\u0650 } \u0642\u0627\u0644: \u0647\u0645 \u0642\u0648\u0645 \u062E\u0631\u062C\u0648\u0627 \u0645\u0646 \u0645\u0643\u0629\u060C \u062D\u062A\u0649 \u062C\u0627\u0624\u0648\u0627 \u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u064A\u0632\u0639\u0645\u0648\u0646 \u0623\u0646\u0647\u0645 \u0645\u0647\u0627\u062C\u0631\u0648\u0646\u060C \u062B\u0645 \u0627\u0631\u062A\u062F\u0648\u0627 \u0628\u0639\u062F \u0630\u0644\u0643\u060C \u0641\u0627\u0633\u062A\u0623\u0630\u0646\u0648\u0627 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0625\u0644\u0649 \u0645\u0643\u0629 \u0644\u064A\u0623\u062A\u0648\u0627 \u0628\u0628\u0636\u0627\u0626\u0639 \u0644\u0647\u0645 \u064A\u062A\u062C\u0631\u0648\u0646 \u0641\u064A\u0647\u0627\u060C \u0641\u0627\u062E\u062A\u0644\u0641 \u0641\u064A\u0647\u0645 \u0627\u0644\u0645\u0624\u0645\u0646\u0648\u0646: \u0641\u0642\u0627\u0626\u0644 \u064A\u0642\u0648\u0644: \u0647\u0645 \u0645\u0646\u0627\u0641\u0642\u0648\u0646\u060C \u0648\u0642\u0627\u0626\u0644 \u064A\u0642\u0648\u0644: \u0647\u0645 \u0645\u0624\u0645\u0646\u0648\u0646. \u0641\u0628\u064A\u0646 \u0627\u0644\u0644\u0647 \u0646\u0641\u0627\u0642\u0647\u0645 \u0648\u0623\u0646\u0632\u0644 \u0647\u0630\u0647 \u0627\u0644\u0622\u064A\u0629\u060C \u0648\u0623\u0645\u0631 \u0628\u0642\u062A\u0644\u0647\u0645 \u0641\u064A \u0642\u0648\u0644\u0647: { \u0641\u064E\u0625\u0650\u0646 \u062A\u064E\u0648\u064E\u0644\u0651\u064E\u0648\u0652\u0627\u06DF \u0641\u064E\u062E\u064F\u0630\u064F\u0648\u0647\u064F\u0645\u0652 \u0648\u064E\u0671\u0642\u0652\u062A\u064F\u0644\u064F\u0648\u0647\u064F\u0645\u0652 \u062D\u064E\u064A\u0652\u062B\u064F \u0648\u064E\u062C\u064E\u062F\u062A\u0651\u064F\u0645\u064F\u0648\u0647\u064F\u0645\u0652 \u06D6 }\u060C \u0641\u062C\u0627\u0621\u0648\u0627 \u0628\u0628\u0636\u0627\u0626\u0639\u0647\u0645 \u064A\u0631\u064A\u062F\u0648\u0646 \u0647\u0644\u0627\u0644 \u0628\u0646 \u0639\u0648\u064A\u0645\u0631 \u0627\u0644\u0623\u0633\u0644\u0645\u064A \u0648\u0628\u064A\u0646\u0647 \u0648\u0628\u064A\u0646 \u0627\u0644\u0646\u0628\u064A \uFDFA \u062D\u0644\u0641\u060C \u0648\u0647\u0648 \u0627\u0644\u0630\u064A \u062D\u0635\u0631 \u0635\u062F\u0631\u0647 \u0623\u0646 \u064A\u0642\u0627\u062A\u0644 \u0627\u0644\u0645\u0624\u0645\u0646\u064A\u0646\u060C \u0641\u0631\u0641\u0639 \u0639\u0646\u0647\u0645 \u0627\u0644\u0642\u062A\u0644 \u0628\u0642\u0648\u0644\u0647 \u062A\u0639\u0627\u0644\u0649: { \u0625\u0650\u0644\u0651\u064E\u0627 \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u064A\u064E\u0635\u0650\u0644\u064F\u0648\u0646\u064E \u0625\u0650\u0644\u064E\u0649\u0670 \u0642\u064E\u0648\u0652\u0645\u0650\u06ED } \u0627\u0644\u0622\u064A\u0629.",
