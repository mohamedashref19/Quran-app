            name: "\u0647\u0627\u0634\u0645 \u0628\u0646 \u0639\u062A\u0628\u0629",
            title: "\u0627\u0644\u0645\u0631\u0642\u0627\u0644",
            story: "\u0627\u0628\u0646 \u0623\u062E\u064A \u0633\u0639\u062F \u0628\u0646 \u0623\u0628\u064A \u0648\u0642\u0627\u0635 \u0648\u0623\u062E\u0648 \u0645\u0635\u0639\u0628 \u0628\u0646 \u0639\u0645\u064A\u0631 \u0644\u0623\u0645\u0647. \u0633\u064F\u0645\u064A \u0628\u0627\u0644\u0645\u0631\u0642\u0627\u0644 \u0644\u0625\u0633\u0631\u0627\u0639\u0647 \u0646\u062D\u0648 \u0627\u0644\u0639\u062F\u0648 \u0641\u064A \u0627\u0644\u0645\u0639\u0627\u0631\u0643. \u0641\u0642\u0623 \u0639\u064A\u0646\u0647 \u0641\u064A \u0627\u0644\u064A\u0631\u0645\u0648\u0643\u060C \u0648\u0643\u0627\u0646 \u0641\u0627\u062A\u062D \u062C\u0644\u0648\u0644\u0627\u0621\u060C \u0648\u062D\u0627\u0645\u0644 \u0631\u0627\u064A\u0629 \u0639\u0644\u064A \u0628\u0646 \u0623\u0628\u064A \u0637\u0627\u0644\u0628 \u0641\u064A \u0635\u0641\u064A\u0646.",
            lessons: "\u0627\u0644\u0647\u0645\u0629 \u0627\u0644\u0639\u0627\u0644\u064A\u0629 \u0648\u0627\u0644\u0625\u0633\u0631\u0627\u0639 \u0641\u064A \u0646\u0635\u0631\u0629 \u0627\u0644\u062D\u0642 (\u0627\u0644\u0625\u0631\u0642\u0627\u0644). \u0627\u0644\u062B\u0628\u0627\u062A \u0639\u0644\u0649 \u0627\u0644\u0645\u0628\u062F\u0623 \u0648\u0627\u0644\u062A\u0636\u062D\u064A\u0629 \u0628\u0627\u0644\u062C\u0633\u062F.",
            category_tag: "\u0627\u0644\u0642\u0627\u062F\u0629"
        },
        {
            id: 45,
            category: "\u0627\u0644\u0635\u062D\u0627\u0628\u0629",
            name: "\u0639\u0645\u0631\u0627\u0646 \u0628\u0646 \u062D\u0635\u064A\u0646",
            title: "\u0627\u0644\u0645\u064F\u0633\u0644\u0651\u0645 \u0639\u0644\u064A\u0647 \u0645\u0646 \u0627\u0644\u0645\u0644\u0627\u0626\u0643\u0629",
            story: "\u0623\u0633\u0644\u0645 \u0639\u0627\u0645 \u062E\u064A\u0628\u0631\u060C \u0648\u0643\u0627\u0646 \u0645\u0646 \u0641\u0636\u0644\u0627\u0621 \u0627\u0644\u0635\u062D\u0627\u0628\u0629 \u0648\u0641\u0642\u0647\u0627\u0626\u0647\u0645 \u0628\u0627\u0644\u0628\u0635\u0631\u0629. \u0623\u0635\u0627\u0628\u0647 \u0645\u0631\u0636 \u0641\u0635\u0628\u0631 \u0639\u0644\u064A\u0647 \u0648\u0627\u062D\u062A\u0633\u0628\u060C \u0641\u0628\u0644\u063A \u0645\u0646 \u0634\u062F\u0629 \u0631\u0648\u062D\u0627\u0646\u064A\u062A\u0647 \u0648\u0635\u0628\u0631\u0647 \u0623\u0646 \u0627\u0644\u0645\u0644\u0627\u0626\u0643\u0629 \u0643\u0627\u0646\u062A \u062A\u0646\u0632\u0644 \u0648\u062A\u0633\u0644\u0645 \u0639\u0644\u064A\u0647 \u0648\u062A\u0643\u0644\u0645\u0647.",
            lessons: "\u0627\u0644\u0635\u0628\u0631 \u0627\u0644\u062C\u0645\u064A\u0644 \u0639\u0644\u0649 \u0627\u0644\u0627\u0628\u062A\u0644\u0627\u0621 \u0648\u0627\u0644\u0645\u0631\u0636 \u064A\u0631\u0641\u0639 \u0627\u0644\u062F\u0631\u062C\u0627\u062A \u0644\u0645\u0631\u062A\u0628\u0629 \u0627\u0644\u0643\u0631\u0627\u0645\u0627\u062A. \u0641\u0636\u0644 \u0627\u0644\u0641\u0642\u0647 \u0648\u062A\u0639\u0644\u064A\u0645 \u0627\u0644\u0646\u0627\u0633.",
            category_tag: "\u0639\u0644\u0645\u0627\u0621 \u0627\u0644\u0635\u062D\u0627\u0628\u0629"
        },
        {
            id: 46,
            category: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631",
            name: "\u0647\u0644\u0627\u0644 \u0628\u0646 \u0623\u0645\u064A\u0629",
            title: "\u0627\u0644\u062A\u0627\u0626\u0628 \u0645\u0646 \u0627\u0644\u0635\u0627\u062F\u0642\u064A\u0646",
            story: "\u0623\u062D\u062F \u0627\u0644\u062B\u0644\u0627\u062B\u0629 \u0627\u0644\u0630\u064A\u0646 \u062E\u064F\u0644\u0641\u0648\u0627 \u0641\u064A \u062A\u0628\u0648\u0643. \u0642\u0627\u0637\u0639\u0647\u0645 \u0627\u0644\u0646\u0628\u064A \u0648\u0627\u0644\u0645\u0633\u0644\u0645\u0648\u0646 \u0644\u0642\u0639\u0648\u062F\u0647\u0645 \u0639\u0646 \u0627\u0644\u062C\u0647\u0627\u062F\u060C \u0641\u0627\u0639\u062A\u0632\u0644 \u0632\u0648\u062C\u062A\u0647 \u0648\u0628\u0643\u0649 \u0644\u064A\u0644 \u0646\u0647\u0627\u0631 \u0644\u0645\u062F\u0629 50 \u064A\u0648\u0645\u0627\u064B \u062D\u062A\u0649 \u0636\u0627\u0642\u062A \u0639\u0644\u064A\u0647 \u0627\u0644\u0623\u0631\u0636\u060C \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u062A\u0648\u0628\u062A\u0647\u0645 \u0641\u064A \u0627\u0644\u0642\u0631\u0622\u0646.",
            lessons: "\u0627\u0644\u0627\u0639\u062A\u0631\u0627\u0641 \u0628\u0627\u0644\u0630\u0646\u0628 \u0641\u0636\u064A\u0644\u0629 \u0648\u062A\u0648\u0628\u0629. \u062A\u062D\u0645\u0644 \u062A\u0628\u0639\u0627\u062A \u0627\u0644\u0623\u062E\u0637\u0627\u0621 \u0628\u0634\u062C\u0627\u0639\u0629 \u0648\u0639\u062F\u0645 \u0627\u062E\u062A\u0644\u0627\u0642 \u0627\u0644\u0623\u0639\u0630\u0627\u0631 \u0648\u0627\u0644\u0645\u0628\u0631\u0631\u0627\u062A.",
            category_tag: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631"
        },
        {
            id: 47,
            category: "\u0627\u0644\u0635\u062D\u0627\u0628\u0629",
            name: "\u0648\u0628\u0631 \u0628\u0646 \u064A\u062D\u0646\u0633",
            title: "\u062F\u0627\u0639\u064A\u0629 \u0627\u0644\u0623\u0628\u0646\u0627\u0621 \u0628\u0627\u0644\u064A\u0645\u0646",
            story: "\u0635\u062D\u0627\u0628\u064A \u062C\u0644\u064A\u0644 \u0645\u0646 \u0627\u0644\u0623\u0628\u0646\u0627\u0621 \u0627\u0644\u0630\u064A\u0646 \u0627\u0633\u062A\u0648\u0637\u0646\u0648\u0627 \u0627\u0644\u064A\u0645\u0646. \u0628\u0645\u062C\u0631\u062F \u0623\u0646 \u0642\u062F\u0645 \u0639\u0644\u0649 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0648\u0623\u0633\u0644\u0645\u060C \u0631\u062C\u0639 \u0644\u0644\u064A\u0645\u0646 \u062F\u0627\u0639\u064A\u0629 \u0625\u0644\u0649 \u0627\u0644\u0644\u0647\u060C \u0648\u0643\u0627\u0646 \u0633\u0628\u0628\u0627\u064B \u0641\u064A \u0625\u0633\u0644\u0627\u0645 \u0627\u0644\u0643\u062B\u064A\u0631\u064A\u0646 \u0645\u0646\u0647\u0645 \u0641\u064A\u0631\u0648\u0632 \u0627\u0644\u062F\u064A\u0644\u0645\u064A \u0648\u0648\u0647\u0628 \u0628\u0646 \u0645\u0646\u0628\u0647.",
            lessons: "\u0627\u0644\u0645\u0628\u0627\u062F\u0631\u0629 \u0628\u062F\u0639\u0648\u0629 \u0627\u0644\u0622\u062E\u0631\u064A\u0646 \u0648\u0646\u0642\u0644 \u0646\u0648\u0631 \u0627\u0644\u0647\u062F\u0627\u064A\u0629 \u0641\u0648\u0631 \u0627\u0644\u062D\u0635\u0648\u0644 \u0639\u0644\u064A\u0647\u060C \u0648\u062A\u062D\u0645\u0644 \u0645\u0633\u0624\u0648\u0644\u064A\u0629 \u0646\u0634\u0631 \u0627\u0644\u062F\u064A\u0646.",
            category_tag: "\u0627\u0644\u0635\u062D\u0627\u0628\u0629"
        },
        {
            id: 48,
            category: "\u0627\u0644\u0635\u062D\u0627\u0628\u0629",
            name: "\u0645\u0639\u0627\u0648\u064A\u0629 \u0628\u0646 \u0627\u0644\u062D\u0643\u0645 \u0627\u0644\u0633\u0644\u0645\u064A",
            title: "\u0633\u0627\u0626\u0644 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647",
            story: "\u0639\u0637\u0633 \u0631\u062C\u0644 \u0641\u064A \u0627\u0644\u0635\u0644\u0627\u0629 \u0641\u0634\u0645\u0651\u062A\u0647 \u0645\u0639\u0627\u0648\u064A\u0629 \u0644\u062C\u0647\u0644\u0647 \u0628\u0627\u0644\u062D\u0643\u0645\u060C \u0641\u0646\u0638\u0631 \u0625\u0644\u064A\u0647 \u0627\u0644\u0635\u062D\u0627\u0628\u0629 \u063A\u0627\u0636\u0628\u064A\u0646\u060C \u0641\u0644\u0645\u0627 \u0627\u0646\u062A\u0647\u062A \u0627\u0644\u0635\u0644\u0627\u0629 \u0639\u0644\u0651\u0645\u0647 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0628\u0631\u0641\u0642 \u0648\u0644\u064A\u0646 \u0648\u0644\u0645 \u064A\u0639\u0646\u0641\u0647\u060C \u0641\u0642\u0627\u0644: (\u0645\u0627 \u0631\u0623\u064A\u062A \u0645\u0639\u0644\u0645\u0627\u064B \u0642\u0628\u0644\u0647 \u0648\u0644\u0627 \u0628\u0639\u062F\u0647 \u0623\u062D\u0633\u0646 \u0645\u0646\u0647).",
            lessons: "\u0627\u0644\u0631\u0641\u0642 \u0641\u064A \u062A\u0635\u062D\u064A\u062D \u0627\u0644\u0623\u062E\u0637\u0627\u0621 \u0645\u0646 \u0623\u0647\u0645 \u0635\u0641\u0627\u062A \u0627\u0644\u0645\u0631\u0628\u064A \u0627\u0644\u0646\u0627\u062C\u062D. \u062D\u0633\u0646 \u0627\u0644\u0633\u0624\u0627\u0644 \u0645\u0641\u062A\u0627\u062D \u0627\u0644\u0639\u0644\u0645.",
            category_tag: "\u0627\u0644\u0635\u062D\u0627\u0628\u0629"
        },
        {
            id: 49,
            category: "\u0627\u0644\u0635\u062D\u0627\u0628\u0629",
            name: "\u0639\u0645\u0631\u0648 \u0628\u0646 \u0645\u0627\u0644\u0643",
            title: "\u0645\u0644\u0627\u0639\u0628 \u0627\u0644\u0623\u0633\u0646\u0629",
            story: "\u0633\u064F\u0645\u064A \u0623\u0628\u0648 \u0628\u0631\u0627\u0621 (\u0645\u0644\u0627\u0639\u0628 \u0627\u0644\u0623\u0633\u0646\u0629) \u0644\u0641\u0631\u0648\u0633\u064A\u062A\u0647 \u0648\u0634\u062C\u0627\u0639\u062A\u0647. \u0648\u0641\u062F \u0639\u0644\u0649 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0648\u0644\u0645 \u064A\u0633\u0644\u0645 \u062D\u064A\u0646\u0647\u0627\u060C \u0648\u0637\u0644\u0628 \u0645\u0646 \u0627\u0644\u0646\u0628\u064A \u0625\u0631\u0633\u0627\u0644 \u062F\u0639\u0627\u0629 \u0644\u0646\u062C\u062F \u0648\u0623\u0639\u0637\u0627\u0647\u0645 \u0627\u0644\u0623\u0645\u0627\u0646\u060C \u0641\u063A\u062F\u0631 \u0628\u0647\u0645 \u0627\u0628\u0646 \u0623\u062E\u064A\u0647 (\u0639\u0627\u0645\u0631) \u0641\u064A \u0628\u0626\u0631 \u0645\u0639\u0648\u0646\u0629. \u0623\u0633\u0644\u0645 \u0644\u0627\u062D\u0642\u0627\u064B.",
            lessons: "\u0623\u0647\u0645\u064A\u0629 \u0627\u0644\u0641\u0631\u0648\u0633\u064A\u0629 \u0648\u062D\u0645\u0627\u064A\u0629 \u0627\u0644\u062C\u0648\u0627\u0631 \u0641\u064A \u0627\u0644\u0625\u0633\u0644\u0627\u0645 \u0648\u0627\u0644\u062C\u0627\u0647\u0644\u064A\u0629. \u0627\u0644\u0647\u062F\u0627\u064A\u0629 \u0628\u064A\u062F \u0627\u0644\u0644\u0647 \u062A\u0623\u062A\u064A \u0641\u064A \u0648\u0642\u062A\u0647\u0627.",
            category_tag: "\u0627\u0644\u0642\u0627\u062F\u0629"
        },
        {
            id: 50,
            category: "\u0627\u0644\u0635\u062D\u0627\u0628\u0629",
            name: "\u063A\u0627\u0644\u0628 \u0628\u0646 \u0639\u0628\u062F \u0627\u0644\u0644\u0647 \u0627\u0644\u0644\u064A\u062B\u064A",
            title: "\u0642\u0627\u0626\u062F \u0627\u0644\u0633\u0631\u0627\u064A\u0627",
            story: "\u0635\u062D\u0627\u0628\u064A \u0634\u062C\u0627\u0639 \u0648\u0645\u0642\u062F\u0627\u0645\u060C \u0627\u0639\u062A\u0645\u062F\u0647 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0641\u064A \u0642\u064A\u0627\u062F\u0629 \u0627\u0644\u0639\u062F\u064A\u062F \u0645\u0646 \u0627\u0644\u0633\u0631\u0627\u064A\u0627 (\u0627\u0644\u0639\u0645\u0644\u064A\u0627\u062A \u0627\u0644\u062E\u0627\u0635\u0629) \u0644\u0636\u0631\u0628 \u0645\u0639\u0627\u0642\u0644 \u0627\u0644\u0645\u0634\u0631\u0643\u064A\u0646 \u0648\u062C\u0645\u0639 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062A\u060C \u0648\u0647\u0648 \u0645\u0646 \u0645\u0647\u062F \u0627\u0644\u0637\u0631\u064A\u0642 \u0644\u0644\u0645\u0633\u0644\u0645\u064A\u0646 \u0644\u0641\u062A\u062D \u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629.",
            lessons: "\u0627\u0644\u0642\u064A\u0627\u062F\u0629 \u0627\u0644\u0639\u0633\u0643\u0631\u064A\u0629 \u0627\u0644\u0645\u064A\u062F\u0627\u0646\u064A\u0629 \u062A\u062D\u062A\u0627\u062C \u0625\u0644\u0649 \u062D\u0646\u0643\u0629 \u0648\u0634\u062C\u0627\u0639\u0629 \u0648\u0642\u062F\u0631\u0629 \u0639\u0644\u0649 \u0627\u062A\u062E\u0627\u0630 \u0627\u0644\u0642\u0631\u0627\u0631 \u0627\u0644\u0633\u0631\u064A\u0639.",
            category_tag: "\u0627\u0644\u0642\u0627\u062F\u0629"
        },
        {
            id: 51,
            category: "\u0627\u0644\u0645\u0647\u0627\u062C\u0631\u0648\u0646",
            name: "\u0639\u0645\u064A\u0631 \u0628\u0646 \u0623\u0628\u064A \u0648\u0642\u0627\u0635",
            title: "\u0627\u0644\u0634\u0647\u064A\u062F \u0627\u0644\u0635\u063A\u064A\u0631",
            story: "\u0623\u062E\u0648 \u0633\u0639\u062F \u0628\u0646 \u0623\u0628\u064A \u0648\u0642\u0627\u0635. \u0623\u0633\u0644\u0645 \u0642\u062F\u064A\u0645\u0627\u064B\u060C \u0648\u0641\u064A \u063A\u0632\u0648\u0629 \u0628\u062F\u0631 \u0627\u062E\u062A\u0628\u0623 \u062E\u0648\u0641\u0627\u064B \u0645\u0646 \u0623\u0646 \u064A\u0631\u062F\u0651\u0647 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0644\u0635\u063A\u0631 \u0633\u0646\u0647 (16 \u0639\u0627\u0645\u0627\u064B). \u0641\u0644\u0645\u0627 \u0631\u0622\u0647 \u0627\u0644\u0646\u0628\u064A \u0631\u062F\u0647 \u0641\u0628\u0643\u0649 \u0639\u0645\u064A\u0631 \u0628\u0643\u0627\u0621\u064B \u0634\u062F\u064A\u062F\u0627\u064B \u0641\u0623\u062C\u0627\u0632\u0647\u060C \u0648\u0627\u0633\u062A\u0634\u0647\u062F \u0641\u064A \u0627\u0644\u0645\u0639\u0631\u0643\u0629.",
            lessons: "\u062D\u0628 \u0627\u0644\u062A\u0636\u062D\u064A\u0629 \u0641\u064A \u0633\u0628\u064A\u0644 \u0627\u0644\u0644\u0647 \u0644\u0627 \u064A\u0642\u0627\u0633 \u0628\u0627\u0644\u0639\u0645\u0631. \u0642\u0648\u0629 \u0627\u0644\u0625\u064A\u0645\u0627\u0646 \u062A\u0635\u0646\u0639 \u0645\u0646 \u0627\u0644\u0635\u063A\u0627\u0631 \u0623\u0628\u0637\u0627\u0644\u0627\u064B \u0639\u0638\u0645\u0627\u0621.",
            category_tag: "\u0623\u0647\u0644 \u0628\u062F\u0631"
        },
        {
            id: 52,
            category: "\u0627\u0644\u0645\u0647\u0627\u062C\u0631\u0648\u0646",
            name: "\u0639\u0644\u0642\u0645\u0629 \u0628\u0646 \u0632\u064A\u062F",
            title: "\u062D\u0627\u0641\u0638 \u0627\u0644\u0623\u062F\u0639\u064A\u0629",
            story: "\u0635\u062D\u0627\u0628\u064A \u0623\u062F\u0631\u0643 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0648\u0646\u0642\u0644 \u0639\u0646\u0647 \u0628\u0639\u0636 \u0627\u0644\u0623\u062D\u0627\u062F\u064A\u062B \u0648\u0627\u0644\u0623\u062F\u0639\u064A\u0629 \u0627\u0644\u0647\u0627\u0645\u0629\u060C \u0645\u0646\u0647\u0627 \u0627\u0644\u062F\u0639\u0627\u0621 \u0627\u0644\u0630\u064A \u0639\u0644\u0651\u0645\u0647 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0644\u062E\u0627\u0644\u062F \u0628\u0646 \u0627\u0644\u0648\u0644\u064A\u062F \u062D\u064A\u0646 \u0623\u0635\u0627\u0628\u0647 \u0627\u0644\u0623\u0631\u0642 \u0648\u0644\u0645 \u064A\u0633\u062A\u0637\u0639 \u0627\u0644\u0646\u0648\u0645.",
            lessons: "\u062D\u0641\u0638 \u0627\u0644\u0623\u062F\u0639\u064A\u0629 \u0627\u0644\u0646\u0628\u0648\u064A\u0629 \u0648\u0627\u0644\u0644\u062C\u0648\u0621 \u0625\u0644\u0649 \u0627\u0644\u0644\u0647 \u0641\u064A \u0643\u0644 \u0635\u063A\u064A\u0631\u0629 \u0648\u0643\u0628\u064A\u0631\u0629 \u0645\u0646 \u0623\u0645\u0648\u0631 \u0627\u0644\u062D\u064A\u0627\u0629 (\u0643\u0627\u0644\u0623\u0631\u0642).",
            category_tag: "\u0627\u0644\u0635\u062D\u0627\u0628\u0629"
