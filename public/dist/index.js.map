        "4_123": {
            "title": "\u0644\u064E\u064A\u0652\u0633\u064E \u0628\u0650\u0623\u064E\u0645\u064E\u0627\u0646\u0650\u064A\u0651\u0650\u0643\u064F\u0645\u0652 \u0648\u064E\u0644\u064E\u0627 \u0623\u064E\u0645\u064E\u0627\u0646\u0650\u064A\u0651\u0650 \u0623\u064E\u0647\u0652\u0644\u0650 \u0627\u0644\u0652\u0643\u0650\u062A\u064E\u0627\u0628\u0650 \u06D7 \u0645\u064E\u0646\u0652 \u064A\u064E\u0639\u0652\u0645\u064E\u0644\u0652 \u0633\u064F\u0648\u0621\u064B\u0627 \u064A\u064F\u062C\u0652\u0632\u064E \u0628\u0650\u0647\u0650 \u0648\u064E\u0644\u064E\u0627 \u064A\u064E\u062C\u0650\u062F\u0652 \u0644\u064E\u0647\u064F \u0645\u0650\u0646\u0652 \u062F\u064F\u0648\u0646\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u0648\u064E\u0644\u0650\u064A\u0651\u064B\u0627 \u0648\u064E\u0644\u064E\u0627 \u0646\u064E\u0635\u0650\u064A\u0631\u064B\u0627",
            "sabab": "\u0639\u0646 \u0645\u0633\u0631\u0648\u0642 \u0641\u064A \u0642\u0648\u0644\u0647: { \u0644\u0651\u064E\u064A\u0652\u0633\u064E \u0628\u0650\u0623\u064E\u0645\u064E\u0627\u0646\u0650\u064A\u0651\u0650\u0643\u064F\u0645\u0652 \u0648\u064E\u0644\u064E\u0627\u0653 \u0623\u064E\u0645\u064E\u0627\u0646\u0650\u0649\u0651\u0650 \u0623\u064E\u0647\u0652\u0644\u0650 \u0671\u0644\u0652\u0643\u0650\u062A\u064E\u0640\u0670\u0628\u0650 \u06D7 } \u0642\u0627\u0644: \u0627\u062D\u062A\u062C \u0627\u0644\u0645\u0633\u0644\u0645\u0648\u0646 \u0648\u0623\u0647\u0644 \u0627\u0644\u0643\u062A\u0627\u0628\u060C \u0641\u0642\u0627\u0644 \u0627\u0644\u0645\u0633\u0644\u0645\u0648\u0646: \u0646\u062D\u0646 \u0623\u0647\u062F\u0649 \u0645\u0646\u0643\u0645\u060C \u0648\u0642\u0627\u0644 \u0623\u0647\u0644 \u0627\u0644\u0643\u062A\u0627\u0628: \u0646\u062D\u0646 \u0623\u0647\u062F\u0649 \u0645\u0646\u0643\u0645 \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647: { \u0644\u0651\u064E\u064A\u0652\u0633\u064E \u0628\u0650\u0623\u064E\u0645\u064E\u0627\u0646\u0650\u064A\u0651\u0650\u0643\u064F\u0645\u0652 \u0648\u064E\u0644\u064E\u0627\u0653 \u0623\u064E\u0645\u064E\u0627\u0646\u0650\u0649\u0651\u0650 \u0623\u064E\u0647\u0652\u0644\u0650 \u0671\u0644\u0652\u0643\u0650\u062A\u064E\u0640\u0670\u0628\u0650 \u06D7 } \u0642\u0627\u0644: \u0641\u0641\u0644\u062C \u0639\u0644\u064A\u0647\u0645 \u0627\u0644\u0645\u0633\u0644\u0645\u0648\u0646 \u0628\u0647\u0630\u0647 \u0627\u0644\u0622\u064A\u0629\u060C { \u0648\u064E\u0645\u064E\u0646 \u064A\u064E\u0639\u0652\u0645\u064E\u0644\u0652 \u0645\u0650\u0646\u064E \u0671\u0644\u0635\u0651\u064E\u0640\u0670\u0644\u0650\u062D\u064E\u0640\u0670\u062A\u0650 \u0645\u0650\u0646 \u0630\u064E\u0643\u064E\u0631\u064D \u0623\u064E\u0648\u0652 \u0623\u064F\u0646\u062B\u064E\u0649\u0670 \u0648\u064E\u0647\u064F\u0648\u064E \u0645\u064F\u0624\u0652\u0645\u0650\u0646\u064C } \u0625\u0644\u0649 \u0622\u062E\u0640\u0640\u0640\u0640\u0640\u0631 \u0627\u0644\u0622\u064A\u062A\u064A\u0646.\n\n\u0648\u062C\u0627\u0621 \u0639\u0646 \u0642\u062A\u0627\u062F\u0629 \u0634\u0628\u064A\u0647\u0627\u064B \u0628\u0647.\n\n\u0648\u062C\u0627\u0621 \u0639\u0646 \u0623\u0628\u064A \u0635\u0627\u0644\u062D \u0634\u0628\u064A\u0647\u0627\u064B \u0628\u0647.",
