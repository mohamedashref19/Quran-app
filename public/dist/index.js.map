        "24_11": {
            "title": "\u0625\u0646 \u0627\u0644\u0630\u064A\u0646 \u062C\u0627\u0621\u0648\u0627 \u0628\u0627\u0644\u0625\u0641\u0643 \u0639\u0635\u0628\u0629 \u0645\u0646\u0643\u0645",
            "sabab": "\u0646\u0632\u0644\u062A \u0644\u062A\u0628\u0631\u0626\u0629 \u0623\u0645 \u0627\u0644\u0645\u0624\u0645\u0646\u064A\u0646 \u0639\u0627\u0626\u0634\u0629 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0627 \u0628\u0639\u062F \u0623\u0646 \u0627\u062A\u0647\u0645\u0647\u0627 \u0627\u0644\u0645\u0646\u0627\u0641\u0642\u0648\u0646 \u0641\u064A \u0639\u0650\u0631\u0636\u0647\u0627 \u0648\u0638\u0644\u062A \u062A\u0628\u0643\u064A \u0634\u0647\u0631\u0627\u064B \u0643\u0627\u0645\u0644\u0627\u064B \u062D\u062A\u0649 \u0646\u0632\u0644 \u0627\u0644\u0648\u062D\u064A.",
            "fadl": "",
            "action": "\u0644\u0627 \u062A\u0646\u0642\u0644 \u0634\u0627\u0626\u0639\u0629\u060C \u0648\u0644\u0627 \u062A\u0633\u0627\u0647\u0645 \u0641\u064A \u0646\u0634\u0631 \u0643\u0644\u0627\u0645 \u064A\u0645\u0633 \u0623\u0639\u0631\u0627\u0636 \u0627\u0644\u0646\u0627\u0633. \u0642\u0641 \u0639\u0646\u062F \u062D\u062F\u0648\u062F \u0627\u0644\u0644\u0647 \u0648\u0642\u0644: \u0633\u0628\u062D\u0627\u0646\u0643 \u0647\u0630\u0627 \u0628\u0647\u062A\u0627\u0646 \u0639\u0638\u064A\u0645."
        },
        "24_22": {
            "title": "\u062F\u0639\u0648\u0629 \u0644\u0644\u0639\u0641\u0648 \u0648\u0627\u0644\u0635\u0641\u062D",
            "sabab": "\u0646\u0632\u0644\u062A \u0641\u064A \u0623\u0628\u064A \u0628\u0643\u0631 \u0627\u0644\u0635\u062F\u064A\u0642 \uFD41 \u062D\u064A\u0646 \u062D\u0644\u0641 \u0623\u0644\u0627 \u064A\u0646\u0641\u0642 \u0639\u0644\u0649 \u0645\u0633\u0637\u062D \u0628\u0646 \u0623\u062B\u0627\u062B\u0629 \u0628\u0639\u062F \u0645\u0634\u0627\u0631\u0643\u062A\u0647 \u0641\u064A \u062D\u0627\u062F\u062B\u0629 \u0627\u0644\u0625\u0641\u0643\u060C \u0641\u062F\u0639\u0627\u0647 \u0627\u0644\u0644\u0647 \u0644\u0644\u0639\u0641\u0648.",
            "fadl": "",
            "action": "\u0647\u0644 \u062A\u062D\u0628 \u0623\u0646 \u064A\u063A\u0641\u0631 \u0627\u0644\u0644\u0647 \u0644\u0643\u061F \u0625\u0630\u0646 \u0627\u063A\u0641\u0631 \u0644\u0644\u0646\u0627\u0633 \u0632\u0644\u0627\u062A\u0647\u0645 \u0648\u0627\u0639\u0641\u064F \u0639\u0645\u0646 \u0623\u062E\u0637\u0623 \u0641\u064A \u062D\u0642\u0643\u060C \u0641\u0627\u0644\u062C\u0632\u0627\u0621 \u0645\u0646 \u062C\u0646\u0633 \u0627\u0644\u0639\u0645\u0644."
