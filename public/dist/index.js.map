            "fadl": "",
            "action": "\u0623\u062E\u0644\u0635 \u0646\u064A\u062A\u0643 \u0644\u0644\u0647 \u0641\u064A \u062C\u0645\u064A\u0639 \u062A\u0641\u0627\u0635\u064A\u0644 \u062D\u064A\u0627\u062A\u0643 \u0648\u0645\u0645\u0627\u062A\u0643 \u0648\u0639\u0628\u0627\u062F\u062A\u0643\u060C \u0648\u062C\u0631\u062F \u0627\u0644\u062A\u0648\u062D\u064A\u062F \u0645\u0646 \u0623\u064A \u0646\u0648\u0639 \u0645\u0646 \u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u0634\u0631\u0643."
        },
        "7_31": {
            "title": "\u06DE \u064A\u064E\u0627 \u0628\u064E\u0646\u0650\u064A \u0622\u062F\u064E\u0645\u064E \u062E\u064F\u0630\u064F\u0648\u0627 \u0632\u0650\u064A\u0646\u064E\u062A\u064E\u0643\u064F\u0645\u0652 \u0639\u0650\u0646\u0652\u062F\u064E \u0643\u064F\u0644\u0651\u0650 \u0645\u064E\u0633\u0652\u062C\u0650\u062F\u064D \u0648\u064E\u0643\u064F\u0644\u064F\u0648\u0627 \u0648\u064E\u0627\u0634\u0652\u0631\u064E\u0628\u064F\u0648\u0627 \u0648\u064E\u0644\u064E\u0627 \u062A\u064F\u0633\u0652\u0631\u0650\u0641\u064F\u0648\u0627 \u06DA \u0625\u0650\u0646\u0651\u064E\u0647\u064F \u0644\u064E\u0627 \u064A\u064F\u062D\u0650\u0628\u0651\u064F \u0627\u0644\u0652\u0645\u064F\u0633\u0652\u0631\u0650\u0641\u0650\u064A\u0646\u064E",
            "sabab": "\u0639\u064E\u0646\u0650 \u0627\u0628\u0652\u0646\u0650 \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u0642\u064E\u0627\u0644\u064E: \u0643\u064E\u0627\u0646\u064E\u062A\u0650 \u0627\u0644\u0652\u0645\u064E\u0631\u0652\u0623\u064E\u0629\u064F \u062A\u064E\u0637\u064F\u0648\u0641\u064F \u0628\u0650\u0627\u0644\u0652\u0628\u064E\u064A\u0652\u062A\u0650 \u0648\u064E\u0647\u0650\u064A\u064E \u0639\u064F\u0631\u0652\u064A\u064E\u0627\u0646\u064E\u0629\u064C\u060C \u0641\u064E\u062A\u064E\u0642\u064F\u0648\u0644\u064F: \u0645\u064E\u0646\u0652 \u064A\u064F\u0639\u0650\u064A\u0631\u064F\u0646\u0650\u064A \u062A\u0650\u0637\u0652\u0648\u064E\u0627\u0641\u0627\u064B \u062A\u064E\u062C\u0652\u0639\u064E\u0644\u064F\u0647\u064F \u0639\u064E\u0644\u064E\u0649 \u0641\u064E\u0631\u0652\u062C\u0650\u0647\u064E\u0627\u060C \u0648\u064E\u062A\u064E\u0642\u064F\u0648\u0644\u064F:\n\u0627\u0644\u0652\u064A\u064E\u0648\u0652\u0645\u064E \u064A\u064E\u0628\u0652\u062F\u064F\u0648 \u0628\u064E\u0639\u0652\u0636\u064F\u0647\u064F \u0623\u064E\u0648\u0652 \u0643\u064F\u0644\u0651\u064F\u0647\u064F     \u0641\u064E\u0645\u064E\u0627 \u0628\u064E\u062F\u064E\u0627 \u0645\u0650\u0646\u0652\u0647\u064F \u0641\u064E\u0644\u064E\u0627 \u0623\u064F\u062D\u0650\u0644\u0651\u064F\u0647\u064F\n\u0641\u064E\u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652 \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u064F: { \u062E\u064F\u0630\u064F\u0648\u0627\u06DF \u0632\u0650\u064A\u0646\u064E\u062A\u064E\u0643\u064F\u0645\u0652 \u0639\u0650\u0646\u062F\u064E \u0643\u064F\u0644\u0651\u0650 \u0645\u064E\u0633\u0652\u062C\u0650\u062F\u064D }.",
            "fadl": "",
            "action": ""
        },
        "7_175": {
            "title": "\u0627\u0646\u0633\u0644\u0627\u062E \u0627\u0644\u0639\u0627\u0644\u0645 \u0645\u0646 \u0639\u0644\u0645\u0647",
            "sabab": "\u0646\u0632\u0644\u062A \u0641\u064A \u0631\u062C\u0644 \u0645\u0646 \u0627\u0644\u0645\u062A\u0642\u062F\u0645\u064A\u0646 \u0641\u064A \u0632\u0645\u0646 \u0628\u0646\u064A \u0625\u0633\u0631\u0627\u0626\u064A\u0644 \u0622\u062A\u0627\u0647 \u0627\u0644\u0644\u0647 \u0639\u0644\u0645 \u0627\u0644\u0643\u062A\u0627\u0628\u060C \u0641\u0627\u0646\u0633\u0644\u062E \u0645\u0646\u0647 \u0648\u0646\u0628\u0630 \u0643\u062A\u0627\u0628 \u0627\u0644\u0644\u0647 \u0648\u0631\u0627\u0621 \u0638\u0647\u0631\u0647 \u0641\u0623\u062A\u0628\u0639\u0647 \u0627\u0644\u0634\u064A\u0637\u0627\u0646.",
            "fadl": "",
            "action": "\u0627\u062D\u0630\u0631 \u0645\u0646 \u062A\u0631\u0643 \u0627\u0644\u0639\u0645\u0644 \u0628\u0645\u0627 \u062A\u0639\u0644\u0645\u062A\u060C \u0641\u0627\u0644\u062A\u0631\u063A\u064A\u0628 \u0647\u0646\u0627 \u0641\u064A \u0627\u0644\u0639\u0645\u0644 \u0628\u0627\u0644\u0639\u0644\u0645\u060C \u0648\u0627\u0644\u062A\u0631\u0647\u064A\u0628 \u0645\u0646 \u0627\u062A\u0628\u0627\u0639 \u0627\u0644\u0647\u0648\u0649 \u0648\u0645\u0632\u0627\u0644\u0642 \u0627\u0644\u0634\u064A\u0637\u0627\u0646."
        },
        "8_1": {
            "title": "\u064A\u0633\u0623\u0644\u0648\u0646\u0643 \u0639\u0646 \u0627\u0644\u0623\u0646\u0641\u0627\u0644",
            "sabab": "\u0646\u0632\u0644\u062A \u0641\u064A \u063A\u0632\u0648\u0629 \u0628\u062F\u0631 \u062D\u064A\u0646 \u0627\u062E\u062A\u0644\u0641 \u0627\u0644\u0635\u062D\u0627\u0628\u0629 \u0641\u064A \u062A\u0648\u0632\u064A\u0639 \u0627\u0644\u063A\u0646\u0627\u0626\u0645\u060C \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u0627\u0644\u0633\u0648\u0631\u0629 \u0644\u064A\u064F\u0628\u064A\u0646 \u0623\u0646 \u0645\u0631\u062F\u0647\u0627 \u0644\u0644\u0647 \u0648\u0631\u0633\u0648\u0644\u0647\u060C \u062A\u0647\u0630\u064A\u0628\u0627\u064B \u0644\u0644\u0646\u0641\u0648\u0633.",
            "fadl": "",
            "action": "\u0644\u0627 \u062A\u062C\u0639\u0644 \u0627\u0644\u062F\u0646\u064A\u0627 \u0648\u0645\u0643\u0627\u0633\u0628\u0647\u0627 \u0633\u0628\u0628\u0627\u064B \u0644\u0644\u062E\u0644\u0627\u0641 \u0645\u0639 \u0625\u062E\u0648\u0627\u0646\u0643. \u062A\u0642\u0648\u0649 \u0627\u0644\u0644\u0647 \u0648\u0625\u0635\u0644\u0627\u062D \u0630\u0627\u062A \u0627\u0644\u0628\u064A\u0646 \u0623\u0639\u0638\u0645 \u0645\u0646 \u0643\u0644 \u0627\u0644\u063A\u0646\u0627\u0626\u0645."
        },
        "8_2": {
            "title": "\u0625\u0650\u0646\u0651\u064E\u0645\u064E\u0627 \u0627\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u064F\u0648\u0646\u064E \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0625\u0650\u0630\u064E\u0627 \u0630\u064F\u0643\u0650\u0631\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0648\u064E\u062C\u0650\u0644\u064E\u062A\u0652 \u0642\u064F\u0644\u064F\u0648\u0628\u064F\u0647\u064F\u0645\u0652 \u0648\u064E\u0625\u0650\u0630\u064E\u0627 \u062A\u064F\u0644\u0650\u064A\u064E\u062A\u0652 \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650\u0645\u0652 \u0622\u064A\u064E\u0627\u062A\u064F\u0647\u064F \u0632\u064E\u0627\u062F\u064E\u062A\u0652\u0647\u064F\u0645\u0652 \u0625\u0650\u064A\u0645\u064E\u0627\u0646\u064B\u0627 \u0648\u064E\u0639\u064E\u0644\u064E\u0649\u0670 \u0631\u064E\u0628\u0651\u0650\u0647\u0650\u0645\u0652 \u064A\u064E\u062A\u064E\u0648\u064E\u0643\u0651\u064E\u0644\u064F\u0648\u0646\u064E",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 1 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
            "fadl": "",
            "action": ""
        },
        "8_3": {
            "title": "\u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u064A\u064F\u0642\u0650\u064A\u0645\u064F\u0648\u0646\u064E \u0627\u0644\u0635\u0651\u064E\u0644\u064E\u0627\u0629\u064E \u0648\u064E\u0645\u0650\u0645\u0651\u064E\u0627 \u0631\u064E\u0632\u064E\u0642\u0652\u0646\u064E\u0627\u0647\u064F\u0645\u0652 \u064A\u064F\u0646\u0652\u0641\u0650\u0642\u064F\u0648\u0646\u064E",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 1 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
            "fadl": "",
            "action": ""
        },
        "8_4": {
            "title": "\u0623\u064F\u0648\u0644\u064E\u0670\u0626\u0650\u0643\u064E \u0647\u064F\u0645\u064F \u0627\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u064F\u0648\u0646\u064E \u062D\u064E\u0642\u0651\u064B\u0627 \u06DA \u0644\u064E\u0647\u064F\u0645\u0652 \u062F\u064E\u0631\u064E\u062C\u064E\u0627\u062A\u064C \u0639\u0650\u0646\u0652\u062F\u064E \u0631\u064E\u0628\u0651\u0650\u0647\u0650\u0645\u0652 \u0648\u064E\u0645\u064E\u063A\u0652\u0641\u0650\u0631\u064E\u0629\u064C \u0648\u064E\u0631\u0650\u0632\u0652\u0642\u064C \u0643\u064E\u0631\u0650\u064A\u0645\u064C",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 1 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
            "fadl": "",
            "action": ""
        },
        "8_5": {
            "title": "\u0643\u064E\u0645\u064E\u0627 \u0623\u064E\u062E\u0652\u0631\u064E\u062C\u064E\u0643\u064E \u0631\u064E\u0628\u0651\u064F\u0643\u064E \u0645\u0650\u0646\u0652 \u0628\u064E\u064A\u0652\u062A\u0650\u0643\u064E \u0628\u0650\u0627\u0644\u0652\u062D\u064E\u0642\u0651\u0650 \u0648\u064E\u0625\u0650\u0646\u0651\u064E \u0641\u064E\u0631\u0650\u064A\u0642\u064B\u0627 \u0645\u0650\u0646\u064E \u0627\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u0650\u064A\u0646\u064E \u0644\u064E\u0643\u064E\u0627\u0631\u0650\u0647\u064F\u0648\u0646\u064E",
            "sabab": '\u0648\u0639\u0646 \u0623\u0628\u064A \u0623\u064A\u0648\u0628 \u0627\u0644\u0623\u0646\u0635\u0627\u0631\u064A \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u0627\u0644: \u0642\u0627\u0644 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \uFDFA: \u0648\u0646\u062D\u0646 \u0628\u0627\u0644\u0645\u062F\u064A\u0646\u0629: \xab \u0625\u0646\u064A \u0623\u062E\u0628\u0631\u062A \u0648\u0646\u062D\u0646 \u0628\u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0639\u0646 \u0639\u064A\u0631 \u0623\u0628\u064A \u0633\u0641\u064A\u0627\u0646 \u0623\u0646\u0647\u0627 \u0645\u0642\u0628\u0644\u0629\u060C \u0641\u0647\u0644 \u0644\u0643\u0645 \u0623\u0646 \u0646\u062E\u0631\u062C \u0642\u0628\u0644 \u0647\u0630\u0627 \u0627\u0644\u0639\u064A\u0631\u060C \u0644\u0639\u0644 \u0627\u0644\u0644\u0647 \u064A\u063A\u0646\u0645\u0646\u0627\u0647\u0627 \xbb\u060C \u0642\u0644\u0646\u0627: \u0646\u0639\u0645\u060C \u0641\u062E\u0631\u062C \u0648 \u062E\u0631\u062C\u0646\u0627 \u0645\u0639\u0647\u060C \u0641\u0644\u0645\u0627 \u0633\u0631\u0646\u0627 \u064A\u0648\u0645\u0627\u064B \u0623\u0648 \u064A\u0648\u0645\u064A\u0646\u060C \u0642\u0627\u0644 \u0644\u0646\u0627: \xab \u0645\u0627 \u062A\u0631\u0648\u0646 \u0641\u064A \u0627\u0644\u0642\u0648\u0645 \u0641\u0625\u0646\u0647\u0645 \u0623\u062E\u0628\u0631\u0648\u0627 \u0628\u0645\u062E\u0631\u062C\u0643\u0645\u061F \xbb \u0641\u0642\u0644\u0646\u0627: \u0644\u0627 \u0648\u0627\u0644\u0644\u0647 \u0645\u0627 \u0644\u0646\u0627 \u0637\u0627\u0642\u0629 \u0628\u0642\u062A\u0627\u0644 \u0627\u0644\u0639\u062F\u0648\u060C \u0648\u0644\u0643\u0646 \u0623\u0631\u062F\u0646\u0627 \u0627\u0644\u0639\u064A\u0631\u060C \u062B\u0645 \u0642\u0627\u0644: \xab \u0645\u0627 \u062A\u0631\u0648\u0646 \u0641\u064A \u0627\u0644\u0642\u0648\u0645\u061F \xbb \u0641\u0642\u0644\u0646\u0627: \u0645\u062B\u0644 \u0630\u0644\u0643\u060C \u0641\u0642\u0627\u0644 \u0627\u0644\u0645\u0642\u062F\u0627\u062F \u0628\u0646 \u0639\u0645\u0631\u0648: \u0625\u0630\u0627\u064B \u0644\u0627 \u0646\u0642\u0648\u0644 \u0644\u0643 \u064A\u0627 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0643\u0645\u0627 \u0642\u0627\u0644 \u0642\u0648\u0645 \u0645\u0648\u0633\u0649 \u0644\u0645\u0648\u0633\u0649: "\u0627\u0630\u0647\u0628 \u0623\u0646\u062A \u0648\u0631\u0628\u0643 \u0641\u0642\u0627\u062A\u0644\u0627 \u0625\u0646\u0627 \u0647\u0647\u0646\u0627 \u0642\u0627\u0639\u062F\u0648\u0646". \u0642\u0627\u0644: \u0641\u062A\u0645\u0646\u064A\u0646\u0627 \u0645\u0639\u0634\u0631 \u0627\u0644\u0623\u0646\u0635\u0627\u0631 \u0623\u0646\u0627 \u0642\u0644\u0646\u0627 \u0643\u0645\u0627 \u0642\u0627\u0644 \u0627\u0644\u0645\u0642\u062F\u0627\u062F\u060C \u0623\u062D\u0628 \u0625\u0644\u064A\u0646\u0627 \u0645\u0646 \u0623\u0646 \u064A\u0643\u0648\u0646 \u0644\u0646\u0627 \u0645\u0627\u0644 \u0639\u0638\u064A\u0645\u060C \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u0639\u0632 \u0648 \u062C\u0644 \u0639\u0644\u0649 \u0631\u0633\u0648\u0644\u0647 \uFDFA { \u0643\u064E\u0645\u064E\u0627\u0653 \u0623\u064E\u062E\u0652\u0631\u064E\u062C\u064E\u0643\u064E \u0631\u064E\u0628\u0651\u064F\u0643\u064E \u0645\u0650\u0646\u06E2 \u0628\u064E\u064A\u0652\u062A\u0650\u0643\u064E \u0628\u0650\u0671\u0644\u0652\u062D\u064E\u0642\u0651\u0650 \u0648\u064E\u0625\u0650\u0646\u0651\u064E \u0641\u064E\u0631\u0650\u064A\u0642\u064B\u0627 \u0645\u0651\u0650\u0646\u064E \u0671\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u0650\u064A\u0646\u064E \u0644\u064E\u0643\u064E\u0640\u0670\u0631\u0650\u0647\u064F\u0648\u0646\u064E \uFD3F\u0665\uFD3E \u064A\u064F\u062C\u064E\u0640\u0670\u062F\u0650\u0644\u064F\u0648\u0646\u064E\u0643\u064E \u0641\u0650\u0649 \u0671\u0644\u0652\u062D\u064E\u0642\u0651\u0650 \u0628\u064E\u0639\u0652\u062F\u064E \u0645\u064E\u0627 \u062A\u064E\u0628\u064E\u064A\u0651\u064E\u0646\u064E \u0643\u064E\u0623\u064E\u0646\u0651\u064E\u0645\u064E\u0627 \u064A\u064F\u0633\u064E\u0627\u0642\u064F\u0648\u0646\u064E \u0625\u0650\u0644\u064E\u0649 \u0671\u0644\u0652\u0645\u064E\u0648\u0652\u062A\u0650 \u0648\u064E\u0647\u064F\u0645\u0652 \u064A\u064E\u0646\u0638\u064F\u0631\u064F\u0648\u0646\u064E \uFD3F\u0666\uFD3E }.',
            "fadl": "",
            "action": ""
        },
        "8_9": {
            "title": "\u0625\u0650\u0630\u0652 \u062A\u064E\u0633\u0652\u062A\u064E\u063A\u0650\u064A\u062B\u064F\u0648\u0646\u064E \u0631\u064E\u0628\u0651\u064E\u0643\u064F\u0645\u0652 \u0641\u064E\u0627\u0633\u0652\u062A\u064E\u062C\u064E\u0627\u0628\u064E \u0644\u064E\u0643\u064F\u0645\u0652 \u0623\u064E\u0646\u0651\u0650\u064A \u0645\u064F\u0645\u0650\u062F\u0651\u064F\u0643\u064F\u0645\u0652 \u0628\u0650\u0623\u064E\u0644\u0652\u0641\u064D \u0645\u0650\u0646\u064E \u0627\u0644\u0652\u0645\u064E\u0644\u064E\u0627\u0626\u0650\u0643\u064E\u0629\u0650 \u0645\u064F\u0631\u0652\u062F\u0650\u0641\u0650\u064A\u0646\u064E",
            "sabab": "\u0639\u064E\u0646\u0650 \u0627\u0628\u0652\u0646\u0650 \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627: \u062D\u064E\u062F\u0651\u064E\u062B\u064E\u0646\u0650\u064A \u0639\u064F\u0645\u064E\u0631\u064F \u0628\u0652\u0646\u064F \u0627\u0644\u0652\u062E\u064E\u0637\u0651\u064E\u0627\u0628\u064E \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u064E\u0627\u0644\u064E: \u0644\u064E\u0645\u0651\u064E\u0627 \u0643\u064E\u0627\u0646\u064E \u064A\u064E\u0648\u0652\u0645\u064F \u0628\u064E\u062F\u0652\u0631\u064D\u060C \u0646\u064E\u0638\u064E\u0631\u064E \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064F \uFDFA \u0625\u0650\u0644\u064E\u0649 \u0623\u064E\u0635\u0652\u062D\u064E\u0627\u0628\u0650\u0647\u0650 \u0648\u064E\u0647\u064F\u0645\u0652 \u062B\u064E\u0644\u064E\u0627\u062B\u064F \u0645\u0650\u0626\u064E\u0629\u064D \u0648\u064E\u0646\u064E\u064A\u0652\u0641\u064C\u060C \u0648\u064E\u0646\u064E\u0638\u064E\u0631\u064E \u0625\u0650\u0644\u064E\u0649 \u0627\u0644\u0652\u0645\u064F\u0634\u0652\u0631\u0650\u0643\u0650\u064A\u0646\u064E \u0648\u064E\u0647\u064F\u0645\u0652 \u0623\u064E\u0644\u0652\u0641\u064C \u0648\u064E\u0632\u0650\u064A\u064E\u0627\u062F\u064E\u0629\u064C\u060C \u0641\u064E\u0627\u0633\u0652\u062A\u064E\u0642\u0652\u0628\u064E\u0644\u064E \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064F \uFDFA \u0627\u0644\u0652\u0642\u0650\u0628\u0652\u0644\u064E\u0629\u064E \u062B\u064F\u0645\u0651\u064E \u0645\u064E\u062F\u0651\u064E \u064A\u064E\u062F\u064E\u064A\u0652\u0647\u0650\u060C \u0648\u064E\u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650 \u0631\u0650\u062F\u064E\u0627\u0624\u064F\u0647\u064F \u0648\u064E\u0625\u0650\u0632\u064E\u0627\u0631\u064F\u0647\u064F\u060C \u062B\u064F\u0645\u0651\u064E \u0642\u064E\u0627\u0644\u064E: \xab \u0627\u0644\u0644\u0651\u064E\u0647\u064F\u0645\u0651\u064E \u0623\u064E\u064A\u0652\u0646\u064E \u0645\u064E\u0627 \u0648\u064E\u0639\u064E\u062F\u0652\u062A\u064E\u0646\u0650\u064A\u061F\u060C \u0627\u0644\u0644\u0651\u064E\u0647\u064F\u0645\u0651\u064E \u0623\u064E\u0646\u062C\u0632\u0652 \u0644\u0650\u064A \u0645\u064E\u0627 \u0648\u064E\u0639\u064E\u062F\u0652\u062A\u064E\u0646\u0650\u064A\u060C \u0627\u0644\u0644\u0651\u064E\u0647\u064F\u0645\u0651\u064E \u0625\u0650\u0646\u0652 \u062A\u064E\u0647\u0652\u0644\u0650\u0643\u064F \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0639\u0650\u0635\u064E\u0627\u0628\u064E\u0629\u064F \u0645\u0650\u0646\u0652 \u0623\u064E\u0647\u0652\u0644\u0650 \u0627\u0644\u0652\u0625\u0650\u0633\u0652\u0644\u064E\u0627\u0645 \u0641\u064E\u0644\u064E\u0627 \u062A\u064F\u0639\u0652\u0628\u064E\u062F\u0652 \u0641\u0650\u064A \u0627\u0644\u0652\u0623\u064E\u0631\u0652\u0636\u0650 \u0623\u064E\u0628\u062F\u0627\u064B \xbb\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0645\u064E\u0627 \u0632\u064E\u0627\u0644\u064E \u064A\u064E\u0633\u0652\u062A\u064E\u063A\u0650\u064A\u062B\u064F \u0631\u064E\u0628\u0651\u064E\u0647\u064F \u0639\u0632 \u0648 \u062C\u0644\u060C \u0648\u064E\u064A\u064E\u062F\u0652\u0639\u064F\u0648\u0647\u064F \u062D\u064E\u062A\u0651\u064E\u0649 \u0633\u064E\u0642\u064E\u0637\u064E \u0631\u0650\u062F\u064E\u0627\u0624\u064F\u0647\u064F \u0639\u064E\u0646\u0652 \u0645\u064E\u0646\u0652\u0643\u0650\u0628\u064E\u064A\u0652\u0647\u0650\u060C \u0641\u064E\u0623\u064E\u062A\u064E\u0627\u0647\u064F \u0623\u064E\u0628\u064F\u0648 \u0628\u064E\u0643\u0652\u0631\u064D\u060C \u0641\u064E\u0623\u064E\u062E\u064E\u0630\u064E \u0631\u0650\u062F\u064E\u0627\u0621\u064E\u0647\u064F \u0641\u064E\u0631\u064E\u062F\u0651\u064E\u0627\u0647\u064F \u062B\u064F\u0645\u0651\u064E \u0627\u0644\u0652\u062A\u064E\u0632\u064E\u0645\u064E\u0647\u064F \u0645\u0650\u0646\u0652 \u0648\u064E\u0631\u064E\u0627\u0626\u0650\u0647\u0650\u060C \u062B\u064F\u0645\u0651\u064E \u0642\u064E\u0627\u0644\u064E: \u064A\u064E\u0627 \u0646\u064E\u0628\u0650\u064A\u0651\u064E \u0627\u0644\u0644\u0647\u0650 \u0643\u064E\u0641\u064E\u0627\u0643\u064E \u0645\u064F\u0646\u064E\u0627\u0634\u064E\u062F\u064E\u062A\u064F\u0643\u064E \u0631\u064E\u0628\u0651\u064E\u0643\u064E\u060C \u0641\u064E\u0625\u0650\u0646\u0651\u064E\u0647\u064F \u0633\u064E\u064A\u064F\u0646\u0652\u062C\u0650\u0632\u064F \u0644\u064E\u0643\u064E \u0645\u064E\u0627 \u0648\u064E\u0639\u064E\u062F\u064E\u0643\u064E\u060C \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0639\u0632 \u0648 \u062C\u0644 { \u0625\u0650\u0630\u0652 \u062A\u064E\u0633\u0652\u062A\u064E\u063A\u0650\u064A\u062B\u064F\u0648\u0646\u064E \u0631\u064E\u0628\u0651\u064E\u0643\u064F\u0645\u0652 \u0641\u064E\u0671\u0633\u0652\u062A\u064E\u062C\u064E\u0627\u0628\u064E \u0644\u064E\u0643\u064F\u0645\u0652 \u0623\u064E\u0646\u0651\u0650\u0649 \u0645\u064F\u0645\u0650\u062F\u0651\u064F\u0643\u064F\u0645 \u0628\u0650\u0623\u064E\u0644\u0652\u0641\u064D \u0645\u0651\u0650\u0646\u064E \u0671\u0644\u0652\u0645\u064E\u0644\u064E\u0640\u0670\u0653\u0626\u0650\u0643\u064E\u0629\u0650 \u0645\u064F\u0631\u0652\u062F\u0650\u0641\u0650\u064A\u0646\u064E \uFD3F\u0669\uFD3E... }",
            "fadl": "",
            "action": ""
        },
        "8_17": {
            "title": "\u0641\u064E\u0644\u064E\u0645\u0652 \u062A\u064E\u0642\u0652\u062A\u064F\u0644\u064F\u0648\u0647\u064F\u0645\u0652 \u0648\u064E\u0644\u064E\u0670\u0643\u0650\u0646\u0651\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064E \u0642\u064E\u062A\u064E\u0644\u064E\u0647\u064F\u0645\u0652 \u06DA \u0648\u064E\u0645\u064E\u0627 \u0631\u064E\u0645\u064E\u064A\u0652\u062A\u064E \u0625\u0650\u0630\u0652 \u0631\u064E\u0645\u064E\u064A\u0652\u062A\u064E \u0648\u064E\u0644\u064E\u0670\u0643\u0650\u0646\u0651\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064E \u0631\u064E\u0645\u064E\u0649\u0670 \u06DA \u0648\u064E\u0644\u0650\u064A\u064F\u0628\u0652\u0644\u0650\u064A\u064E \u0627\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u0650\u064A\u0646\u064E \u0645\u0650\u0646\u0652\u0647\u064F \u0628\u064E\u0644\u064E\u0627\u0621\u064B \u062D\u064E\u0633\u064E\u0646\u064B\u0627 \u06DA \u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064E \u0633\u064E\u0645\u0650\u064A\u0639\u064C \u0639\u064E\u0644\u0650\u064A\u0645\u064C",
            "sabab": "\u0648\u0639\u0646 \u062D\u0643\u064A\u0645 \u0628\u0646 \u062D\u0632\u0627\u0645 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u0627\u0644: \u0644\u0645\u0627 \u0643\u0627\u0646 \u064A\u0648\u0645 \u0628\u062F\u0631\u060C \u0623\u0645\u0631 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \uFDFA \u0639\u0644\u064A\u0627\u064B \u0641\u0623\u062E\u0630 \u0643\u0641\u0651\u064E\u0627 \u0645\u0646 \u0627\u0644\u062D\u0635\u0649\u060C \u0641\u0627\u0633\u062A\u0642\u0628\u0644\u0646\u0627 \u0628\u0647\u060C \u0641\u0631\u0645\u0649 \u0628\u0647\u0627\u060C \u0648\u0642\u0627\u0644: \xab \u0634\u0627\u0647\u062A \u0627\u0644\u0648\u062C\u0648\u0647 \xbb\u060C \u0641\u0627\u0646\u0647\u0632\u0645\u0646\u0627 \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u0639\u0632 \u0648 \u062C\u0644: { \u0648\u064E\u0645\u064E\u0627 \u0631\u064E\u0645\u064E\u064A\u0652\u062A\u064E \u0625\u0650\u0630\u0652 \u0631\u064E\u0645\u064E\u064A\u0652\u062A\u064E \u0648\u064E\u0644\u064E\u0640\u0670\u0643\u0650\u0646\u0651\u064E \u0671\u0644\u0644\u0651\u064E\u0647\u064E \u0631\u064E\u0645\u064E\u0649\u0670 \u06DA }.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0648\u0639\u0646 \u0627\u0628\u0646 \u0639\u0628\u0627\u0633 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627: \u0623\u0646 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0642\u0627\u0644 \u0644\u0639\u0644\u064A: \xab \u0646\u0627\u0648\u0644\u0646\u064A \u0643\u0641\u0627 \u0645\u0646 \u062D\u0635\u06CC \xbb\u060C \u0641\u0646\u0627\u0648\u0644\u0647\u060C \u0641\u0631\u0645\u06CC \u0628\u0647 \u0648\u062C\u0648\u0647 \u0627\u0644\u0642\u0648\u0645\u060C \u0641\u0645\u0627 \u0628\u0642\u064A \u0623\u062D\u062F \u0645\u0646 \u0627\u0644\u0642\u0648\u0645 \u0625\u0644\u0627 \u0627\u0645\u062A\u0644\u0623\u062A \u0639\u064A\u0646\u0627\u0647 \u0645\u0646 \u0627\u0644\u062D\u0635\u0628\u0627\u0621\u060C \u0641\u0646\u0632\u0644\u062A: { \u0648\u064E\u0645\u064E\u0627 \u0631\u064E\u0645\u064E\u064A\u0652\u062A\u064E \u0625\u0650\u0630\u0652 \u0631\u064E\u0645\u064E\u064A\u0652\u062A\u064E \u0648\u064E\u0644\u064E\u0640\u0670\u0643\u0650\u0646\u0651\u064E \u0671\u0644\u0644\u0651\u064E\u0647\u064E \u0631\u064E\u0645\u064E\u0649\u0670 \u06DA }\u060C \u0627\u0644\u0622\u064A\u0629.",
            "fadl": "",
            "action": ""
        },
        "8_19": {
            "title": "\u0625\u0650\u0646\u0652 \u062A\u064E\u0633\u0652\u062A\u064E\u0641\u0652\u062A\u0650\u062D\u064F\u0648\u0627 \u0641\u064E\u0642\u064E\u062F\u0652 \u062C\u064E\u0627\u0621\u064E\u0643\u064F\u0645\u064F \u0627\u0644\u0652\u0641\u064E\u062A\u0652\u062D\u064F \u06D6 \u0648\u064E\u0625\u0650\u0646\u0652 \u062A\u064E\u0646\u0652\u062A\u064E\u0647\u064F\u0648\u0627 \u0641\u064E\u0647\u064F\u0648\u064E \u062E\u064E\u064A\u0652\u0631\u064C \u0644\u064E\u0643\u064F\u0645\u0652 \u06D6 \u0648\u064E\u0625\u0650\u0646\u0652 \u062A\u064E\u0639\u064F\u0648\u062F\u064F\u0648\u0627 \u0646\u064E\u0639\u064F\u062F\u0652 \u0648\u064E\u0644\u064E\u0646\u0652 \u062A\u064F\u063A\u0652\u0646\u0650\u064A\u064E \u0639\u064E\u0646\u0652\u0643\u064F\u0645\u0652 \u0641\u0650\u0626\u064E\u062A\u064F\u0643\u064F\u0645\u0652 \u0634\u064E\u064A\u0652\u0626\u064B\u0627 \u0648\u064E\u0644\u064E\u0648\u0652 \u0643\u064E\u062B\u064F\u0631\u064E\u062A\u0652 \u0648\u064E\u0623\u064E\u0646\u0651\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064E \u0645\u064E\u0639\u064E \u0627\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u0650\u064A\u0646\u064E",
            "sabab": "\u0639\u0646 \u0639\u0628\u062F \u0627\u0644\u0644\u0647 \u0628\u0646 \u062B\u0639\u0644\u0628\u0629 \u0628\u0646 \u0635\u064F\u0639\u064E\u064A\u0652\u0631 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647: \u0623\u0646 \u0623\u0628\u0627 \u062C\u0647\u0644 \u0642\u0627\u0644 \u064A\u0648\u0645 \u0628\u062F\u0631: \u0627\u0644\u0644\u0647\u0645 \u0623\u064A\u0646\u0627 \u0643\u0627\u0646 \u0623\u0642\u0637\u0639 \u0644\u0644\u0631\u062D\u0645\u060C \u0648\u0622\u062A\u0627\u0646\u0627 \u0628\u0645\u0627 \u0644\u0627 \u064A\u0639\u0631\u0641\u060C \u0641\u0623\u062D\u0646\u0647 \u0627\u0644\u063A\u062F\u0627\u0629\u060C \u0648\u0643\u0627\u0646 \u0627\u0633\u062A\u0641\u062A\u0627\u062D\u0627\u064B \u0645\u0646\u0647\u060C \u0641\u0646\u0632\u0644\u062A: { \u0625\u0650\u0646 \u062A\u064E\u0633\u0652\u062A\u064E\u0641\u0652\u062A\u0650\u062D\u064F\u0648\u0627\u06DF \u0641\u064E\u0642\u064E\u062F\u0652 \u062C\u064E\u0627\u0653\u0621\u064E\u0643\u064F\u0645\u064F \u0671\u0644\u0652\u0641\u064E\u062A\u0652\u062D\u064F \u06D6 }\u060C \u0625\u0644\u0649 \u0622\u062E\u0631 \u0627\u0644\u0622\u064A\u0629.",
            "fadl": "",
            "action": ""
        },
        "8_33": {
            "title": "\u0623\u0645\u0627\u0646 \u0623\u0647\u0644 \u0627\u0644\u0623\u0631\u0636 (\u0627\u0644\u0627\u0633\u062A\u063A\u0641\u0627\u0631)",
            "sabab": "\u0642\u0627\u0644 \u0627\u0644\u0645\u0634\u0631\u0643\u0648\u0646: \u0627\u0644\u0644\u0647\u0645 \u0625\u0646 \u0643\u0627\u0646 \u0647\u0630\u0627 \u0647\u0648 \u0627\u0644\u062D\u0642 \u0641\u0623\u0645\u0637\u0631 \u0639\u0644\u064A\u0646\u0627 \u062D\u062C\u0627\u0631\u0629\u060C \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u0623\u0646\u0647 \u0644\u0646 \u064A\u0639\u0630\u0628\u0647\u0645 \u0648\u0627\u0644\u0646\u0628\u064A \u0641\u064A\u0647\u0645\u060C \u0648\u0644\u0646 \u064A\u0639\u0630\u0628\u0647\u0645 \u0648\u0647\u0645 \u064A\u0633\u062A\u063A\u0641\u0631\u0648\u0646.",
            "fadl": "\u0642\u0627\u0644 \u0627\u0628\u0646 \u0639\u0628\u0627\u0633: \u0643\u0627\u0646 \u0641\u064A\u0643\u0645 \u0623\u0645\u0627\u0646\u0627\u0646: \u0646\u0628\u064A \u0627\u0644\u0644\u0647 \u0648\u0627\u0644\u0627\u0633\u062A\u063A\u0641\u0627\u0631\u060C \u0641\u0630\u0647\u0628 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0648\u0628\u0642\u064A \u0627\u0644\u0627\u0633\u062A\u063A\u0641\u0627\u0631.",
            "action": "\u0627\u062C\u0639\u0644 \u0627\u0644\u0627\u0633\u062A\u063A\u0641\u0627\u0631 \u0648\u0631\u062F\u0643 \u0627\u0644\u062F\u0627\u0626\u0645\u060C \u0641\u0647\u0648 \u0623\u0645\u0627\u0646\u0643 \u0645\u0646 \u0627\u0644\u0639\u0630\u0627\u0628\u060C \u0648\u0645\u0641\u062A\u0627\u062D\u0643 \u0644\u0644\u0631\u0632\u0642 \u0648\u062A\u0641\u0631\u064A\u062C \u0627\u0644\u0643\u0631\u0648\u0628."
        },
        "8_34": {
            "title": "\u0648\u064E\u0645\u064E\u0627 \u0644\u064E\u0647\u064F\u0645\u0652 \u0623\u064E\u0644\u0651\u064E\u0627 \u064A\u064F\u0639\u064E\u0630\u0651\u0650\u0628\u064E\u0647\u064F\u0645\u064F \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0648\u064E\u0647\u064F\u0645\u0652 \u064A\u064E\u0635\u064F\u062F\u0651\u064F\u0648\u0646\u064E \u0639\u064E\u0646\u0650 \u0627\u0644\u0652\u0645\u064E\u0633\u0652\u062C\u0650\u062F\u0650 \u0627\u0644\u0652\u062D\u064E\u0631\u064E\u0627\u0645\u0650 \u0648\u064E\u0645\u064E\u0627 \u0643\u064E\u0627\u0646\u064F\u0648\u0627 \u0623\u064E\u0648\u0652\u0644\u0650\u064A\u064E\u0627\u0621\u064E\u0647\u064F \u06DA \u0625\u0650\u0646\u0652 \u0623\u064E\u0648\u0652\u0644\u0650\u064A\u064E\u0627\u0624\u064F\u0647\u064F \u0625\u0650\u0644\u0651\u064E\u0627 \u0627\u0644\u0652\u0645\u064F\u062A\u0651\u064E\u0642\u064F\u0648\u0646\u064E \u0648\u064E\u0644\u064E\u0670\u0643\u0650\u0646\u0651\u064E \u0623\u064E\u0643\u0652\u062B\u064E\u0631\u064E\u0647\u064F\u0645\u0652 \u0644\u064E\u0627 \u064A\u064E\u0639\u0652\u0644\u064E\u0645\u064F\u0648\u0646\u064E",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 33 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
            "fadl": "",
            "action": ""
        },
        "8_67": {
            "title": "\u0645\u064E\u0627 \u0643\u064E\u0627\u0646\u064E \u0644\u0650\u0646\u064E\u0628\u0650\u064A\u0651\u064D \u0623\u064E\u0646\u0652 \u064A\u064E\u0643\u064F\u0648\u0646\u064E \u0644\u064E\u0647\u064F \u0623\u064E\u0633\u0652\u0631\u064E\u0649\u0670 \u062D\u064E\u062A\u0651\u064E\u0649\u0670 \u064A\u064F\u062B\u0652\u062E\u0650\u0646\u064E \u0641\u0650\u064A \u0627\u0644\u0652\u0623\u064E\u0631\u0652\u0636\u0650 \u06DA \u062A\u064F\u0631\u0650\u064A\u062F\u064F\u0648\u0646\u064E \u0639\u064E\u0631\u064E\u0636\u064E \u0627\u0644\u062F\u0651\u064F\u0646\u0652\u064A\u064E\u0627 \u0648\u064E\u0627\u0644\u0644\u0651\u064E\u0647\u064F \u064A\u064F\u0631\u0650\u064A\u062F\u064F \u0627\u0644\u0652\u0622\u062E\u0650\u0631\u064E\u0629\u064E \u06D7 \u0648\u064E\u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0639\u064E\u0632\u0650\u064A\u0632\u064C \u062D\u064E\u0643\u0650\u064A\u0645\u064C",
            "sabab": "\u0639\u0646 \u0627\u0628\u0646\u0650 \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D \u0642\u064E\u0627\u0644\u064E: \u0628\u064E\u064A\u0652\u0646\u064E\u0645\u064E\u0627 \u0631\u064E\u062C\u064F\u0644\u064C \u0645\u0650\u0646\u0652 \u0627\u0644\u0652\u0645\u064F\u0633\u0652\u0644\u0650\u0645\u0650\u064A\u0646\u064E \u064A\u064E\u0648\u0652\u0645\u064E\u0626\u0650\u0630\u064D \u064A\u064E\u0634\u0652\u062A\u064E\u062F\u0651\u064F \u0641\u0650\u064A \u0623\u064E\u062B\u064E\u0631\u0650 \u0631\u064E\u062C\u064F\u0644\u064D \u0645\u0650\u0646\u0652 \u0627\u0644\u0652\u0645\u064F\u0634\u0652\u0631\u0650\u0643\u0650\u064A\u0646\u064E \u0623\u064E\u0645\u064E\u0627\u0645\u064E\u0647\u064F\u060C \u0625\u0650\u0630\u0652 \u0633\u064E\u0645\u0650\u0639\u064E \u0636\u064E\u0631\u0652\u0628\u064E\u0629\u064B \u0628\u0650\u0627\u0644\u0633\u0651\u064E\u0648\u0652\u0637\u0650 \u0641\u064E\u0648\u0652\u0642\u064E\u0647\u064F\u060C \u0648\u064E\u0635\u064E\u0648\u0652\u062A\u064E \u0627\u0644\u0652\u0641\u064E\u0627\u0631\u0650\u0633\u0650 \u064A\u064E\u0642\u064F\u0648\u0644\u064F: \u0623\u064E\u0642\u0652\u062F\u0650\u0645\u0652 \u062D\u064E\u064A\u0652\u0632\u064F\u0648\u0645\u064F\u060C \u0641\u064E\u0646\u064E\u0638\u064E\u0631\u064E \u0625\u0650\u0644\u064E\u0649 \u0627\u0644\u0652\u0645\u064F\u0634\u0652\u0631\u0650\u0643\u0650 \u0623\u064E\u0645\u064E\u0627\u0645\u064E\u0647\u064F \u0641\u064E\u062E\u064E\u0631\u0651\u064E \u0645\u064F\u0633\u0652\u062A\u064E\u0644\u0652\u0642\u0650\u064A\u0627\u064B\u060C \u0641\u064E\u0646\u064E\u0638\u064E\u0631\u064E \u0625\u0650\u0644\u064E\u064A\u0652\u0647\u0650 \u0641\u064E\u0625\u0650\u0630\u064E\u0627 \u0647\u064F\u0648\u064E \u0642\u064E\u062F\u0652 \u062E\u064F\u0637\u0650\u0645\u064E \u0623\u064E\u0646\u0652\u0641\u064F\u0647\u064F\u060C \u0648\u064E\u0634\u064F\u0642\u0651\u064E \u0648\u064E\u062C\u0652\u0647\u064F\u0647\u064F \u0643\u064E\u0636\u064E\u0631\u0652\u0628\u064E\u0629\u0650 \u0627\u0644\u0633\u0651\u064E\u0648\u0652\u0637\u0650\u060C \u0641\u064E\u0627\u062E\u0652\u0636\u064E\u0631\u0651\u064E \u0630\u064E\u0644\u0650\u0643\u064E \u0623\u064E\u062C\u0652\u0645\u064E\u0639\u064F\u060C \u0641\u064E\u062C\u064E\u0627\u0621\u064E \u0627\u0644\u0652\u0623\u064E\u0646\u0652\u0635\u064E\u0627\u0631\u0650\u064A\u0651\u064F \u0641\u064E\u062D\u064E\u062F\u0651\u064E\u062B\u064E \u0628\u0650\u0630\u064E\u0644\u0650\u0643\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0641\u064E\u0642\u064E\u0627\u0644\u064E: \xab \u0635\u064E\u062F\u064E\u0642\u0652\u062A\u064E\u060C \u0630\u064E\u0644\u0650\u0643\u064E \u0645\u0650\u0646\u0652 \u0645\u064E\u062F\u064E\u062F\u0650 \u0627\u0644\u0633\u0651\u064E\u0645\u064E\u0627\u0621\u0650 \u0627\u0644\u062B\u0651\u064E\u0627\u0644\u0650\u062B\u064E\u0629\u0650 \xbb \u0641\u064E\u0642\u064E\u062A\u064E\u0644\u064F\u0648\u0627 \u064A\u064E\u0648\u0652\u0645\u064E\u0626\u0650\u0630\u064D \u0633\u064E\u0628\u0652\u0639\u0650\u064A\u0646\u064E\u060C \u0648\u064E\u0623\u064E\u0633\u064E\u0631\u064F\u0648\u0627 \u0633\u064E\u0628\u0652\u0639\u0650\u064A\u0646\u064E.\n\n\u0642\u064E\u0627\u0644\u064E \u0623\u064E\u0628\u064F\u0648 \u0632\u064F\u0645\u064E\u064A\u0652\u0644\u064D: \u0642\u064E\u0627\u0644\u064E \u0627\u0628\u0652\u0646\u064F \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D: \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0623\u064E\u0633\u064E\u0631\u064F\u0648\u0627 \u0627\u0644\u0652\u0623\u064E\u0633\u064E\u0627\u0631\u064E\u0649\u060C \u0642\u064E\u0627\u0644\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0644\u0650\u0623\u064E\u0628\u0650\u064A \u0628\u064E\u0643\u0652\u0631\u064D \u0648\u064E\u0639\u064F\u0645\u064E\u0631\u064E: \xab \u0645\u064E\u0627 \u062A\u064E\u0631\u064E\u0648\u0652\u0646\u064E \u0641\u0650\u064A \u0647\u064E\u0624\u064F\u0644\u064E\u0627\u0621\u0650 \u0627\u0644\u0652\u0623\u064F\u0633\u064E\u0627\u0631\u064E\u0649\u061F \xbb\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0623\u064E\u0628\u064F\u0648 \u0628\u064E\u0643\u0652\u0631\u064D: \u064A\u064E\u0627 \u0646\u064E\u0628\u0650\u064A\u0651\u064E \u0627\u0644\u0644\u0647\u0650! \u0647\u064F\u0645\u0652 \u0628\u064E\u0646\u064F\u0648 \u0627\u0644\u0652\u0639\u064E\u0645\u0651\u0650 \u0648\u064E\u0627\u0644\u0652\u0639\u064E\u0634\u0650\u064A\u0631\u064E\u0629\u0650\u060C \u0623\u064E\u0631\u064E\u0649 \u0623\u064E\u0646\u0652 \u062A\u064E\u0623\u0652\u062E\u064F\u0630\u064E \u0645\u0650\u0646\u0652\u0647\u064F\u0645\u0652 \u0641\u0650\u062F\u0652\u064A\u064E\u0629\u064D\u060C \u0641\u064E\u062A\u064E\u0643\u064F\u0648\u0646\u064F \u0644\u064E\u0646\u064E\u0627 \u0642\u064F\u0648\u0651\u064E\u0629\u064B \u0639\u064E\u0644\u064E\u0649 \u0627\u0644\u0652\u0643\u064F\u0641\u0651\u064E\u0627\u0631\u0650\u060C \u0641\u064E\u0639\u064E\u0633\u064E\u0649 \u0627\u0644\u0644\u0647\u064F \u0623\u064E\u0646\u0652 \u064A\u064E\u0647\u0652\u062F\u0650\u064A\u064E\u0647\u064F\u0645\u0652 \u0644\u0650\u0644\u0652\u0625\u0650\u0633\u0652\u0644\u064E\u0627\u0645\u0650. \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA: \xab \u0645\u064E\u0627 \u062A\u064E\u0631\u064E\u0649 \u064A\u064E\u0627 \u0627\u0628\u0652\u0646\u064E \u0627\u0644\u0652\u062E\u064E\u0637\u064E\u0627\u0628\u0650\u061F \xbb \u0642\u064F\u0644\u0652\u062A\u064F: \u0644\u064E\u0627\u060C \u0648\u064E\u0627\u0644\u0644\u0647\u0650 \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650\u060C \u0645\u064E\u0627 \u0623\u064E\u0631\u064E\u0649 \u0627\u0644\u0651\u064E\u0630\u0650\u064A \u0631\u064E\u0623\u064E\u0649 \u0623\u064E\u0628\u064F\u0648 \u0628\u064E\u0643\u0652\u0631\u064D\u060C \u0648\u064E\u0644\u064E\u0643\u0650\u0646\u0651\u0650\u064A \u0623\u064E\u0631\u064E\u0649 \u0623\u064E\u0646\u0652 \u062A\u064F\u0645\u064E\u0643\u0651\u0646\u0651\u064E\u0627 \u0641\u064E\u0646\u064E\u0636\u0652\u0631\u0650\u0628\u064E \u0623\u064E\u0639\u0652\u0646\u064E\u0627\u0642\u064F\u0647\u064F\u0645\u0652\u060C \u0641\u064E\u062A\u064F\u0645\u064E\u0643\u0651\u0650\u0646\u064E \u0639\u064E\u0644\u0650\u064A\u0651\u064B\u0627 \u0645\u0650\u0646\u0652 \u0639\u064E\u0642\u0650\u064A\u0644\u064D \u0641\u064E\u064A\u064E\u0636\u0652\u0631\u0650\u0628\u064E \u0639\u064F\u0646\u064F\u0642\u064E\u0647\u064F\u060C \u0648\u064E\u062A\u064F\u0645\u064E\u0643\u0651\u064E\u0646\u0651\u0650\u064A \u0645\u0650\u0646\u0652 - \u0641\u064F\u0644\u064E\u0627\u0646\u064D \u0646\u064E\u0633\u0650\u064A\u0628\u0627\u064B \u0644\u0650\u0639\u064F\u0645\u064E\u0631\u064E - \u0641\u064E\u0623\u064E\u0636\u0652\u0631\u0650\u0628\u064E \u0639\u064F\u0646\u064F\u0642\u064E\u0647\u064F\u060C \u0641\u064E\u0625\u0650\u0646\u0651\u064E \u0647\u064E\u0624\u064F\u0644\u064E\u0627\u0621\u0650 \u0623\u064E\u0626\u0650\u0645\u0651\u064E\u0629\u064F \u0627\u0644\u0652\u0643\u064F\u0641\u0652\u0631\u0650 \u0648\u064E\u0635\u064E\u0646\u064E\u0627\u062F\u0650\u064A\u062F\u064F\u0647\u064E\u0627\u060C \u0641\u064E\u0647\u064E\u0648\u0650\u064A\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0645\u064E\u0627 \u0642\u064E\u0627\u0644\u064E \u0623\u064E\u0628\u064F\u0648 \u0628\u064E\u0643\u0652\u0631\u064D\u060C \u0648\u064E\u0644\u064E\u0645\u0652 \u064A\u064E\u0647\u0652\u0648\u064E \u0645\u064E\u0627 \u0642\u064F\u0644\u0652\u062A\u064F.\n\n\u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0643\u064E\u0627\u0646\u064E \u0645\u0650\u0646\u0652 \u0627\u0644\u0652\u063A\u064E\u062F\u0650 \u062C\u0650\u0626\u0652\u062A\u064F \u0641\u064E\u0625\u0650\u0630\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0648\u064E\u0623\u064E\u0628\u064F\u0648 \u0628\u064E\u0643\u0652\u0631 \u0642\u064E\u0627\u0639\u0650\u062F\u064E\u064A\u0652\u0646\u0650 \u064A\u064E\u0628\u0652\u0643\u0650\u064A\u064E\u0627\u0646\u060C \u0642\u064F\u0644\u0652\u062A\u064F: \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650\u060C \u0623\u064E\u062E\u0652\u0628\u0650\u0631\u0652\u0646\u0650\u064A \u0645\u0650\u0646\u0652 \u0623\u064E\u064A\u0651\u0650 \u0634\u064E\u064A\u0652\u0621\u064D \u062A\u064E\u0628\u0652\u0643\u064A \u0623\u064E\u0646\u0652\u062A\u064E \u0648\u064E\u0635\u064E\u0627\u062D\u0650\u0628\u064F\u0643\u064E\u060C \u0641\u064E\u0625\u0650\u0646\u0652 \u0648\u064E\u062C\u064E\u062F\u0652\u062A\u064F \u0628\u064F\u0643\u064E\u0627\u0621\u064B \u0628\u064E\u0643\u064E\u064A\u0652\u062A\u064F\u060C \u0648\u064E\u0625\u0650\u0646\u0652 \u0644\u064E\u0645\u0652 \u0623\u064E\u062C\u0650\u062F\u064F \u0628\u064F\u0643\u064E\u0627\u0621\u064B \u062A\u064E\u0628\u064E\u0627\u0643\u064E\u064A\u0652\u062A\u064F \u0644\u0650\u0628\u064F\u0643\u064E\u0627\u0626\u0650\u0643\u064F\u0645\u064E\u0627\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA: \xab \u0623\u064E\u0628\u0652\u0643\u0650\u064A \u0644\u0650\u0644\u0651\u064E\u0630\u0650\u064A \u0639\u064E\u0631\u064E\u0636\u064E \u0639\u064E\u0644\u064E\u064A\u0651\u064E \u0623\u064E\u0635\u0652\u062D\u064E\u0627\u0628\u064F\u0643\u064E \u0645\u0650\u0646\u0652 \u0623\u064E\u062E\u0652\u0630\u0650\u0647\u0650\u0645 \u0627\u0644\u0652\u0641\u0650\u062F\u064E\u0627\u0621\u064E\u060C \u0644\u064E\u0642\u064E\u062F\u0652 \u0639\u064F\u0631\u0650\u0636\u064E \u0639\u064E\u0644\u064E\u064A\u0651\u064E \u0639\u064E\u0630\u064E\u0627\u0628\u064F\u0647\u064F\u0645\u0652 \u0623\u064E\u062F\u0652\u0646\u064E\u0649 \u0645\u0650\u0646\u0652 \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0634\u0651\u064E\u062C\u064E\u0631\u064E\u0629\u0650 \xbb - \u0634\u064E\u062C\u064E\u0631\u064E\u0629\u064D \u0642\u064E\u0631\u0650\u064A\u0628\u064E\u0629\u064D \u0645\u0650\u0646\u0652 \u0646\u064E\u0628\u0650\u064A\u0651\u0650 \u0627\u0644\u0644\u0647\u0650 \uFDFA - \u0648\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0639\u0632 \u0648 \u062C\u0644: { \u0645\u064E\u0627 \u0643\u064E\u0627\u0646\u064E \u0644\u0650\u0646\u064E\u0628\u0650\u0649\u0651\u064D \u0623\u064E\u0646 \u064A\u064E\u0643\u064F\u0648\u0646\u064E \u0644\u064E\u0647\u064F\u06E5\u0653 \u0623\u064E\u0633\u0652\u0631\u064E\u0649\u0670 \u062D\u064E\u062A\u0651\u064E\u0649\u0670 \u064A\u064F\u062B\u0652\u062E\u0650\u0646\u064E \u0641\u0650\u0649 \u0671\u0644\u0652\u0623\u064E\u0631\u0652\u0636\u0650 \u06DA } \u0625\u0650\u0644\u064E\u0649 \u0642\u064E\u0648\u0652\u0644\u0650\u0647\u0650 { \u0641\u064E\u0643\u064F\u0644\u064F\u0648\u0627\u06DF \u0645\u0650\u0645\u0651\u064E\u0627 \u063A\u064E\u0646\u0650\u0645\u0652\u062A\u064F\u0645\u0652 \u062D\u064E\u0644\u064E\u0640\u0670\u0644\u064B\u0627 \u0637\u064E\u064A\u0651\u0650\u0628\u064B\u0627 \u06DA } \u0641\u064E\u0623\u064E\u062D\u064E\u0644\u0651\u064E \u0627\u0644\u0644\u0647\u064F \u0627\u0644\u0652\u063A\u064E\u0646\u0650\u064A\u0645\u064E\u0629\u064E \u0644\u064E\u0647\u064F\u0645\u0652.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0639\u064E\u0646\u0652 \u0639\u064E\u0628\u0652\u062F\u0650 \u0627\u0644\u0644\u0647\u0650 - \u064A\u064E\u0639\u0652\u0646\u0650\u064A \u0627\u0628\u0652\u0646\u064E \u0645\u064E\u0633\u0652\u0639\u064F\u0648\u062F\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 - \u0642\u064E\u0627\u0644\u064E: \u0644\u064E\u0645\u0651\u064E\u0627 \u0643\u064E\u0627\u0646\u064E \u064A\u064E\u0648\u0652\u0645\u064F \u0628\u064E\u062F\u0652\u0631\u064D\u060C \u0642\u064E\u0627\u0644\u064E: \u0642\u064E\u0627\u0644\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA: \xab \u0645\u064E\u0627 \u062A\u064E\u0642\u064F\u0648\u0644\u064F\u0648\u0646\u064E \u0641\u0650\u064A \u0647\u064E\u0624\u064F\u0644\u064E\u0627\u0621\u0650 \u0627\u0644\u0652\u0623\u064E\u0633\u0652\u0631\u064E\u0649\u061F \xbb \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0623\u064E\u0628\u064F\u0648 \u0628\u064E\u0643\u0652\u0631\u064D: \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650\u060C \u0642\u064E\u0648\u0652\u0645\u064F\u0643\u064E \u0648\u064E\u0623\u064E\u0647\u0652\u0644\u064F\u0643\u064E\u060C \u0627\u0633\u0652\u062A\u064E\u0628\u0652\u0642\u0650\u0647\u0650\u0645\u0652\u060C \u0648\u064E\u0627\u0633\u0652\u062A\u064E\u0623\u0652\u0646\u0650 \u0628\u0650\u0647\u0650\u0645\u0652\u060C \u0644\u064E\u0639\u064E\u0644\u0651\u064E \u0627\u0644\u0644\u0647\u064E \u0623\u064E\u0646\u0652 \u064A\u064E\u062A\u064F\u0648\u0628\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650\u0645\u0652\u060C \u0642\u064E\u0627\u0644\u064E: \u0648\u064E\u0642\u064E\u0627\u0644\u064E \u0639\u064F\u0645\u064E\u0631\u064F: \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650\u060C \u0623\u064E\u062E\u0652\u0631\u064E\u062C\u064F\u0648\u0643\u064E \u0648\u064E\u0643\u064E\u0630\u0651\u064E\u0628\u064F\u0648\u0643\u064E\u060C \u0642\u064E\u0631\u0651\u0650\u0628\u0652\u0647\u064F\u0645\u0652 \u0641\u064E\u0627\u0636\u0652\u0631\u0650\u0628\u0652 \u0623\u064E\u0639\u0652\u0646\u064E\u0627\u0642\u064E\u0647\u064F\u0645\u0652\u060C \u0642\u064E\u0627\u0644\u064E: \u0648\u064E\u0642\u064E\u0627\u0644\u064E \u0639\u064E\u0628\u0652\u062F\u064F \u0627\u0644\u0644\u0647\u0650 \u0628\u0652\u0646\u064F \u0631\u064E\u0648\u064E\u0627\u062D\u064E\u0629\u064E: \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650\u060C \u0627\u0646\u0652\u0638\u064F\u0631\u0652 \u0648\u064E\u0627\u062F\u0650\u064A\u0627\u064B \u0643\u064E\u062B\u0650\u064A\u0631\u064E \u0627\u0644\u0652\u062D\u064E\u0637\u064E\u0628\u0650\u060C \u0641\u064E\u0623\u064E\u062F\u0652\u062E\u0650\u0644\u0652\u0647\u064F\u0645\u0652 \u0641\u0650\u064A\u0647\u0650\u060C \u062B\u064F\u0645\u0651\u064E \u0623\u064E\u0636\u0652\u0631\u0650\u0645\u0652 \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650\u0645\u0652 \u0646\u064E\u0627\u0631\u0627\u064B\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0627\u0644\u0652\u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064F: \u0642\u064E\u0637\u064E\u0639\u0652\u062A\u064E \u0631\u064E\u062D\u0650\u0645\u064E\u0643\u064E\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u062F\u064E\u062E\u064E\u0644\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA\u060C \u0648\u064E\u0644\u064E\u0645\u0652 \u064A\u064E\u0631\u064F\u062F\u0651\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650\u0645\u0652 \u0634\u064E\u064A\u0652\u0626\u064B\u0627\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0646\u064E\u0627\u0633\u064C: \u064A\u064E\u0623\u0652\u062E\u064F\u0630\u064F \u0628\u0650\u0642\u064E\u0648\u0652\u0644\u0650 \u0623\u064E\u0628\u0650\u064A \u0628\u064E\u0643\u0652\u0631\u064D\u060C \u0648\u064E\u0642\u064E\u0627\u0644\u064E \u0646\u064E\u0627\u0633\u064C: \u064A\u064E\u0623\u0652\u062E\u064F\u0630\u064F \u0628\u0650\u0642\u064E\u0648\u0652\u0644\u0650 \u0639\u064F\u0645\u064E\u0631\u064E\u060C \u0648\u064E\u0642\u064E\u0627\u0644\u064E \u0646\u064E\u0627\u0633\u064C: \u064A\u064E\u0623\u0652\u062E\u064F\u0630\u064F \u0628\u0650\u0642\u064E\u0648\u0652\u0644\u0650 \u0639\u064E\u0628\u0652\u062F\u0650 \u0627\u0644\u0644\u0647\u0650 \u0628\u0652\u0646\u0650 \u0631\u064E\u0648\u064E\u0627\u062D\u064E\u0629\u064E\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u062E\u064E\u0631\u064E\u062C\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650\u0645\u0652 \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E: \xab \u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0644\u0647 \u0644\u064E\u064A\u064F\u0644\u0650\u064A\u0646\u064F \u0642\u064F\u0644\u064F\u0648\u0628\u064E \u0631\u0650\u062C\u064E\u0627\u0644\u064D \u0641\u0650\u064A\u0647\u0650\u060C \u062D\u064E\u062A\u0651\u064E\u0649 \u062A\u064E\u0643\u064F\u0648\u0646\u064E \u0623\u064E\u0644\u0652\u064A\u064E\u0646\u064E \u0645\u0650\u0646\u0652 \u0627\u0644\u0644\u0651\u064E\u0628\u064E\u0646\u0650\u060C \u0648\u064E\u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0644\u0647\u064E \u0644\u064E\u064A\u064E\u0634\u064F\u062F\u0651\u064F \u0642\u064F\u0644\u064F\u0648\u0628\u064E \u0631\u0650\u062C\u064E\u0627\u0644\u064D \u0641\u0650\u064A\u0647\u0650\u060C \u062D\u064E\u062A\u0651\u064E\u0649 \u062A\u064E\u0643\u064F\u0648\u0646\u064E \u0623\u064E\u0634\u064E\u062F\u0651\u064E \u0645\u0650\u0646\u0652 \u0627\u0644\u0652\u062D\u0650\u062C\u064E\u0627\u0631\u064E\u0629\u0650\u060C \u0648\u064E\u0625\u0650\u0646\u0651\u064E \u0645\u064E\u062B\u064E\u0644\u064E\u0643\u064E \u064A\u064E\u0627 \u0623\u064E\u0628\u064E\u0627 \u0628\u064E\u0643\u0652\u0631\u064D\u060C \u0643\u064E\u0645\u064E\u062B\u064E\u0644\u0650 \u0625\u0650\u0628\u0652\u0631\u064E\u0627\u0647\u0650\u064A\u0645\u064E \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645 \u0642\u064E\u0627\u0644\u064E: { \u0641\u064E\u0645\u064E\u0646 \u062A\u064E\u0628\u0650\u0639\u064E\u0646\u0650\u0649 \u0641\u064E\u0625\u0650\u0646\u0651\u064E\u0647\u064F\u06E5 \u0645\u0650\u0646\u0651\u0650\u0649 \u06D6 \u0648\u064E\u0645\u064E\u0646\u0652 \u0639\u064E\u0635\u064E\u0627\u0646\u0650\u0649 \u0641\u064E\u0625\u0650\u0646\u0651\u064E\u0643\u064E \u063A\u064E\u0641\u064F\u0648\u0631\u064C \u0631\u0651\u064E\u062D\u0650\u064A\u0645\u064C }\u060C \u0648\u064E\u0645\u064E\u062B\u064E\u0644\u064E\u0643\u064E \u064A\u064E\u0627 \u0623\u064E\u0628\u064E\u0627 \u0628\u064E\u0643\u0652\u0631\u064D\u060C \u0643\u064E\u0645\u064E\u062B\u064E\u0644 \u0639\u0650\u064A\u0633\u064E\u0649\u060C \u0642\u064E\u0627\u0644\u064E: { \u0625\u0650\u0646 \u062A\u064F\u0639\u064E\u0630\u0651\u0650\u0628\u0652\u0647\u064F\u0645\u0652 \u0641\u064E\u0625\u0650\u0646\u0651\u064E\u0647\u064F\u0645\u0652 \u0639\u0650\u0628\u064E\u0627\u062F\u064F\u0643\u064E \u06D6 \u0648\u064E\u0625\u0650\u0646 \u062A\u064E\u063A\u0652\u0641\u0650\u0631\u0652 \u0644\u064E\u0647\u064F\u0645\u0652 \u0641\u064E\u0625\u0650\u0646\u0651\u064E\u0643\u064E \u0623\u064E\u0646\u062A\u064E \u0671\u0644\u0652\u0639\u064E\u0632\u0650\u064A\u0632\u064F \u0671\u0644\u0652\u062D\u064E\u0643\u0650\u064A\u0645\u064F \uFD3F\u0661\u0661\u0668\uFD3E }\u060C \u0648\u064E\u0625\u0650\u0646\u0652 \u0645\u064E\u062B\u064E\u0644\u064E\u0643\u064E \u064A\u064E\u0627 \u0639\u064F\u0645\u064E\u0631\u064F\u060C \u0643\u064E\u0645\u064E\u062B\u064E\u0644\u0650 \u0646\u064F\u0648\u062D\u064D\u060C \u0642\u064E\u0627\u0644\u064E: { \u0631\u0651\u064E\u0628\u0651\u0650 \u0644\u064E\u0627 \u062A\u064E\u0630\u064E\u0631\u0652 \u0639\u064E\u0644\u064E\u0649 \u0671\u0644\u0652\u0623\u064E\u0631\u0652\u0636\u0650 \u0645\u0650\u0646\u064E \u0671\u0644\u0652\u0643\u064E\u0640\u0670\u0641\u0650\u0631\u0650\u064A\u0646\u064E \u062F\u064E\u064A\u0651\u064E\u0627\u0631\u064B\u0627 }\u060C \u0648\u064E\u0625\u0650\u0646\u0651\u064E \u0645\u0650\u062B\u0652\u0644\u064E\u0643\u064E \u064A\u064E\u0627 \u0639\u064F\u0645\u064E\u0631\u064F\u060C \u0643\u064E\u0645\u064E\u062B\u064E\u0644\u0650 \u0645\u064F\u0648\u0633\u064E\u0649\u060C \u0642\u064E\u0627\u0644\u064E: { \u0648\u064E\u0671\u0634\u0652\u062F\u064F\u062F\u0652 \u0639\u064E\u0644\u064E\u0649\u0670 \u0642\u064F\u0644\u064F\u0648\u0628\u0650\u0647\u0650\u0645\u0652 \u0641\u064E\u0644\u064E\u0627 \u064A\u064F\u0624\u0652\u0645\u0650\u0646\u064F\u0648\u0627\u06DF \u062D\u064E\u062A\u0651\u064E\u0649\u0670 \u064A\u064E\u0631\u064E\u0648\u064F\u0627\u06DF \u0671\u0644\u0652\u0639\u064E\u0630\u064E\u0627\u0628\u064E \u0671\u0644\u0652\u0623\u064E\u0644\u0650\u064A\u0645\u064E }\u060C \u0623\u064E\u0646\u0652\u062A\u064F\u0645\u0652 \u0639\u064E\u0627\u0644\u064E\u0629\u064C \u0641\u064E\u0644\u064E\u0627 \u064A\u064E\u0646\u0652\u0641\u064E\u0644\u0650\u0626\u064E\u0646\u0651\u064E \u0645\u0650\u0646\u0652\u0647\u064F\u0645\u0652 \u0623\u064E\u062D\u064E\u062F\u064C \u0625\u0650\u0644\u0651\u064E\u0627 \u0628\u0650\u0641\u0650\u062F\u064E\u0627\u0621\u064D\u060C \u0623\u064E\u0648\u0652 \u0636\u064E\u0631\u0652\u0628\u064E\u0629\u0650 \u0639\u064F\u0646\u064F\u0642\u064D \xbb\u060C \u0642\u064E\u0627\u0644\u064E \u0639\u064E\u0628\u0652\u062F\u064F \u0627\u0644\u0644\u0647: \u0641\u064E\u0642\u064F\u0644\u0652\u062A\u064F: \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650\u060C \u0625\u0650\u0644\u0651\u064E\u0627 \u0633\u064F\u0647\u064E\u064A\u0652\u0644\u064F \u0627\u0628\u0652\u0646\u064F \u0628\u064E\u064A\u0652\u0636\u064E\u0627\u0621\u064E\u060C \u0641\u064E\u0625\u0650\u0646\u0651\u0650\u064A \u0642\u064E\u062F\u0652 \u0633\u064E\u0645\u0650\u0639\u0652\u062A\u064F\u0647\u064F \u064A\u064E\u0630\u0652\u0643\u064F\u0631\u064F \u0627\u0644\u0652\u0625\u0650\u0633\u0652\u0644\u064E\u0627\u0645\u064E\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0633\u064E\u0643\u064E\u062A\u064E\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0645\u064E\u0627 \u0631\u064E\u0623\u064E\u064A\u0652\u062A\u064F\u0646\u0650\u064A \u0641\u0650\u064A \u064A\u064E\u0648\u0652\u0645\u064D\u060C \u0623\u064E\u062E\u0652\u0648\u064E\u0641\u064E \u0623\u064E\u0646\u0652 \u062A\u064E\u0642\u064E\u0639\u064E \u0639\u064E\u0644\u064E\u064A\u0651\u064E \u062D\u0650\u062C\u064E\u0627\u0631\u064E\u0629\u064C \u0645\u0650\u0646\u0652 \u0627\u0644\u0633\u0651\u064E\u0645\u064E\u0627\u0621\u0650\u060C \u0641\u0650\u064A \u0630\u064E\u0644\u0650\u0643\u064E \u0627\u0644\u0652\u064A\u064E\u0648\u0652\u0645\u0650 \u062D\u064E\u062A\u0651\u064E\u0649 \u0642\u064E\u0627\u0644\u064E: \xab \u0625\u0650\u0644\u0651\u064E\u0627 \u0633\u064F\u0647\u064E\u064A\u0652\u0644\u064F \u0627\u0628\u0652\u0646\u064F \u0628\u064E\u064A\u0652\u0636\u064E\u0627\u0621\u064E \xbb\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0639\u0632 \u0648 \u062C\u0644 { \u0645\u064E\u0627 \u0643\u064E\u0627\u0646\u064E \u0644\u0650\u0646\u064E\u0628\u0650\u0649\u0651\u064D \u0623\u064E\u0646 \u064A\u064E\u0643\u064F\u0648\u0646\u064E \u0644\u064E\u0647\u064F\u06E5\u0653 \u0623\u064E\u0633\u0652\u0631\u064E\u0649\u0670 \u062D\u064E\u062A\u0651\u064E\u0649\u0670 \u064A\u064F\u062B\u0652\u062E\u0650\u0646\u064E \u0641\u0650\u0649 \u0671\u0644\u0652\u0623\u064E\u0631\u0652\u0636\u0650 \u06DA \u062A\u064F\u0631\u0650\u064A\u062F\u064F\u0648\u0646\u064E \u0639\u064E\u0631\u064E\u0636\u064E \u0671\u0644\u062F\u0651\u064F\u0646\u0652\u064A\u064E\u0627 \u0648\u064E\u0671\u0644\u0644\u0651\u064E\u0647\u064F \u064A\u064F\u0631\u0650\u064A\u062F\u064F \u0671\u0644\u0652\u0640\u0654\u064E\u0627\u062E\u0650\u0631\u064E\u0629\u064E \u06D7 \u0648\u064E\u0671\u0644\u0644\u0651\u064E\u0647\u064F \u0639\u064E\u0632\u0650\u064A\u0632\u064C \u062D\u064E\u0643\u0650\u064A\u0645\u064C \uFD3F\u0666\u0667\uFD3E } \u0625\u0650\u0644\u064E\u0649 \u0642\u064E\u0648\u0652\u0644\u0650\u0647\u0650 { \u0644\u0651\u064E\u0648\u0652\u0644\u064E\u0627 \u0643\u0650\u062A\u064E\u0670\u0628\u064C \u0645\u0651\u0650\u0646\u064E \u0671\u0644\u0644\u0651\u064E\u0647\u0650 \u0633\u064E\u0628\u064E\u0642\u064E \u0644\u064E\u0645\u064E\u0633\u0651\u064E\u0643\u064F\u0645\u0652 \u0641\u0650\u064A\u0645\u064E\u0627\u0653 \u0623\u064E\u062E\u064E\u0630\u0652\u062A\u064F\u0645\u0652 \u0639\u064E\u0630\u064E\u0627\u0628\u064C \u0639\u064E\u0638\u0650\u064A\u0645\u064C \uFD3F\u0666\u0668\uFD3E }. \n\n\u0648\u0642\u062F \u062C\u0627\u0621 \u0639\u0646 \u0627\u0628\u0646 \u0639\u0645\u0631 \u0639\u0646 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0634\u0628\u064A\u0647\u0627\u064B \u0628\u0647.\n\n\u0648\u0642\u062F \u062C\u0627\u0621 \u0639\u064E\u0646\u0