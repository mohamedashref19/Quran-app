        "97_1": {
            "title": "\u0625\u0646\u0627 \u0623\u0646\u0632\u0644\u0646\u0627\u0647 \u0641\u064A \u0644\u064A\u0644\u0629 \u0627\u0644\u0642\u062F\u0631",
            "sabab": "\u0630\u064F\u0643\u0631 \u0644\u0644\u0646\u0628\u064A \uFDFA \u0631\u062C\u0644 \u0645\u0646 \u0628\u0646\u064A \u0625\u0633\u0631\u0627\u0626\u064A\u0644 \u0644\u0628\u0633 \u0627\u0644\u0633\u0644\u0627\u062D \u0645\u062C\u0627\u0647\u062F\u0627\u064B \u0648\u0639\u0627\u0628\u062F\u0627\u064B \u0623\u0644\u0641 \u0634\u0647\u0631\u060C \u0641\u0627\u0633\u062A\u0642\u0644\u0651 \u0627\u0644\u0645\u0633\u0644\u0645\u0648\u0646 \u0623\u0639\u0645\u0627\u0631\u0647\u0645 \u0648\u0623\u0639\u0645\u0627\u0644\u0647\u0645\u060C \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629 \u0639\u0637\u0627\u0621\u064B \u0644\u0647\u0630\u0647 \u0627\u0644\u0623\u0645\u0629.",
            "fadl": "\u0627\u0644\u0639\u0628\u0627\u062F\u0629 \u0641\u064A\u0647\u0627 \u062E\u064A\u0631 \u0645\u0646 \u0639\u0628\u0627\u062F\u0629 83 \u0633\u0646\u0629 \u0645\u062A\u0648\u0627\u0635\u0644\u0629 (\u0623\u0644\u0641 \u0634\u0647\u0631).",
            "action": "\u0623\u0639\u0645\u0627\u0631\u0646\u0627 \u0642\u0635\u064A\u0631\u0629\u060C \u0644\u0643\u0646 \u0627\u0644\u0644\u0647 \u0639\u0648\u0651\u0636\u0646\u0627 \u0628\u0645\u0648\u0627\u0633\u0645 \u062A\u062A\u0636\u0627\u0639\u0641 \u0641\u064A\u0647\u0627 \u0627\u0644\u0623\u062C\u0648\u0631. \u0627\u0633\u062A\u063A\u0644 \u0631\u0645\u0636\u0627\u0646 \u0648\u0645\u0648\u0627\u0633\u0645 \u0627\u0644\u0637\u0627\u0639\u0627\u062A \u0628\u0630\u0643\u0627\u0621."
        },
        "105_1": {
            "title": "\u0623\u0644\u0645 \u062A\u0631 \u0643\u064A\u0641 \u0641\u0639\u0644 \u0631\u0628\u0643 \u0628\u0623\u0635\u062D\u0627\u0628 \u0627\u0644\u0641\u064A\u0644",
            "sabab": "\u0646\u0632\u0644\u062A \u062A\u0630\u0643\u064A\u0631\u0627\u064B \u0644\u0623\u0647\u0644 \u0645\u0643\u0629 \u0628\u0646\u0639\u0645\u0629 \u0627\u0644\u0644\u0647 \u0639\u0644\u064A\u0647\u0645 \u062D\u064A\u0646 \u062D\u0645\u0627\u0647\u0645 \u0645\u0646 \u062C\u064A\u0634 \u0623\u0628\u0631\u0647\u0629 \u0627\u0644\u062D\u0628\u0634\u064A \u0627\u0644\u0630\u064A \u062C\u0627\u0621 \u0644\u0647\u062F\u0645 \u0627\u0644\u0643\u0639\u0628\u0629 \u0628\u0641\u064A\u0644 \u0636\u062E\u0645 \u0644\u064A\u0635\u0631\u0641 \u0627\u0644\u062D\u062C\u0627\u062C \u0644\u0643\u0646\u064A\u0633\u062A\u0647.",
            "fadl": "",
            "action": "\u0645\u0647\u0645\u0627 \u0628\u0644\u063A\u062A \u0642\u0648\u0629 \u0623\u0639\u062F\u0627\u0626\u0643 \u0623\u0648 \u062D\u062C\u0645 \u0627\u0644\u062A\u062D\u062F\u064A\u0627\u062A \u0641\u064A \u062D\u064A\u0627\u062A\u0643\u060C \u062A\u0630\u0643\u0631 \u0623\u0646 \u0627\u0644\u0644\u0647 \u0642\u0627\u062F\u0631 \u0639\u0644\u0649 \u0625\u0647\u0644\u0627\u0643\u0647\u0645 \u0628\u0623\u0636\u0639\u0641 \u062C\u0646\u0648\u062F\u0647 (\u0637\u064A\u0631 \u0623\u0628\u0627\u0628\u064A\u0644)."
        },
        "106_1": {
            "title": "\u0644\u0625\u064A\u0644\u0627\u0641 \u0642\u0631\u064A\u0634",
            "sabab": "\u0627\u0645\u062A\u0646 \u0627\u0644\u0644\u0647 \u0639\u0644\u0649 \u0642\u0631\u064A\u0634 \u0628\u0631\u062D\u0644\u062A\u064A \u0627\u0644\u0634\u062A\u0627\u0621 \u0648\u0627\u0644\u0635\u064A\u0641 \u0644\u0644\u062A\u062C\u0627\u0631\u0629\u060C \u0648\u062D\u0645\u0627\u064A\u062A\u0647\u0645 \u0641\u064A \u0627\u0644\u062D\u0631\u0645\u060C \u0644\u064A\u062F\u0639\u0648\u0647\u0645 \u0644\u0639\u0628\u0627\u062F\u062A\u0647 \u0648\u062D\u062F\u0647 \u0634\u0643\u0631\u0627\u064B \u0639\u0644\u0649 \u0627\u0644\u0623\u0645\u0646 \u0648\u0627\u0644\u0631\u0632\u0642.",
            "fadl": "",
            "action": "\u0627\u0644\u0623\u0645\u0627\u0646 \u0641\u064A \u0628\u064A\u062A\u0643 \u0648\u0648\u062C\u0648\u062F \u0627\u0644\u0637\u0639\u0627\u0645 \u0639\u0644\u0649 \u0645\u0627\u0626\u062F\u062A\u0643 \u0646\u0639\u0645\u062A\u0627\u0646 \u0639\u0638\u064A\u0645\u062A\u0627\u0646. \u0644\u0627 \u062A\u0639\u062A\u062F \u0627\u0644\u0646\u0639\u0645\u0629\u060C \u0628\u0644 \u0627\u0634\u0643\u0631 \u0645\u064F\u0646\u0639\u0645\u0647\u0627 \u062F\u0648\u0645\u0627\u064B."
        },
        "108_1": {
            "title": "\u0625\u0646\u0627 \u0623\u0639\u0637\u064A\u0646\u0627\u0643 \u0627\u0644\u0643\u0648\u062B\u0631",
            "sabab": "\u0645\u0627\u062A \u0623\u0628\u0646\u0627\u0621 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0627\u0644\u0630\u0643\u0648\u0631\u060C \u0641\u0642\u0627\u0644 \u0623\u062D\u062F \u0627\u0644\u0645\u0634\u0631\u0643\u064A\u0646: \u062F\u0639\u0648\u0647 \u0641\u0625\u0646\u0647 \u0623\u0628\u062A\u0631 (\u0645\u0642\u0637\u0648\u0639 \u0627\u0644\u0646\u0633\u0644 \u0648\u0627\u0644\u0630\u0643\u0631)\u060C \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u0627\u0644\u0633\u0648\u0631\u0629 \u062F\u0641\u0627\u0639\u0627\u064B \u0639\u0646\u0647 \u0648\u062A\u0628\u0634\u064A\u0631\u0627\u064B \u0644\u0647 \u0628\u0646\u0647\u0631 \u0627\u0644\u0643\u0648\u062B\u0631.",
            "fadl": "",
            "action": "\u0645\u0646 \u064A\u062F\u0627\u0641\u0639 \u0639\u0646 \u0627\u0644\u0644\u0647 \u0648\u0631\u0633\u0648\u0644\u0647 \u064A\u0631\u0641\u0639 \u0627\u0644\u0644\u0647 \u0630\u0643\u0631\u0647 \u0648\u064A\u062E\u0644\u062F\u0647\u060C \u0648\u0645\u0646 \u064A\u0639\u0627\u062F\u064A\u0647\u0645 \u064A\u064F\u0628\u062A\u0631 \u0630\u0643\u0631\u0647 \u0648\u062A\u0646\u0645\u062D\u064A \u0633\u064A\u0631\u062A\u0647. \u0643\u0646 \u062F\u0627\u0626\u0645\u0627\u064B \u0641\u064A \u0635\u0641 \u0627\u0644\u062D\u0642."
        },
        "108_2": {
            "title": "\u0641\u064E\u0635\u064E\u0644\u0651\u0650 \u0644\u0650\u0631\u064E\u0628\u0651\u0650\u0643\u064E \u0648\u064E\u0627\u0646\u0652\u062D\u064E\u0631\u0652",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 1 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
            "fadl": "",
