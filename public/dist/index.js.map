                surahNum = idParts[1];
                ayahNum = idParts[2];
            } else {
                surahNum = ayahElement.getAttribute('data-surah');
                ayahNum = ayahElement.getAttribute('data-ayah');
            }
            if (!surahNum || !ayahNum) return;
            // نبدأ العداد (600 مللي ثانية)
