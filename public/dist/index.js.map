        "6_108": {
            "title": "\u0648\u064E\u0644\u064E\u0627 \u062A\u064E\u0633\u064F\u0628\u0651\u064F\u0648\u0627 \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u064A\u064E\u062F\u0652\u0639\u064F\u0648\u0646\u064E \u0645\u0650\u0646\u0652 \u062F\u064F\u0648\u0646\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u0641\u064E\u064A\u064E\u0633\u064F\u0628\u0651\u064F\u0648\u0627 \u0627\u0644\u0644\u0651\u064E\u0647\u064E \u0639\u064E\u062F\u0652\u0648\u064B\u0627 \u0628\u0650\u063A\u064E\u064A\u0652\u0631\u0650 \u0639\u0650\u0644\u0652\u0645\u064D \u06D7 \u0643\u064E\u0630\u064E\u0670\u0644\u0650\u0643\u064E \u0632\u064E\u064A\u0651\u064E\u0646\u0651\u064E\u0627 \u0644\u0650\u0643\u064F\u0644\u0651\u0650 \u0623\u064F\u0645\u0651\u064E\u0629\u064D \u0639\u064E\u0645\u064E\u0644\u064E\u0647\u064F\u0645\u0652 \u062B\u064F\u0645\u0651\u064E \u0625\u0650\u0644\u064E\u0649\u0670 \u0631\u064E\u0628\u0651\u0650\u0647\u0650\u0645\u0652 \u0645\u064E\u0631\u0652\u062C\u0650\u0639\u064F\u0647\u064F\u0645\u0652 \u0641\u064E\u064A\u064F\u0646\u064E\u0628\u0651\u0650\u0626\u064F\u0647\u064F\u0645\u0652 \u0628\u0650\u0645\u064E\u0627 \u0643\u064E\u0627\u0646\u064F\u0648\u0627 \u064A\u064E\u0639\u0652\u0645\u064E\u0644\u064F\u0648\u0646\u064E",
            "sabab": "\u0639\u064E\u0646\u0650 \u0627\u0628\u0652\u0646\u0650 \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627: \u0642\u064E\u0648\u0652\u0644\u064E\u0647\u064F: { \u0648\u064E\u0644\u064E\u0627 \u062A\u064E\u0633\u064F\u0628\u0651\u064F\u0648\u0627\u06DF \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u064A\u064E\u062F\u0652\u0639\u064F\u0648\u0646\u064E \u0645\u0650\u0646 \u062F\u064F\u0648\u0646\u0650 \u0671\u0644\u0644\u0651\u064E\u0647\u0650 \u0641\u064E\u064A\u064E\u0633\u064F\u0628\u0651\u064F\u0648\u0627\u06DF \u0671\u0644\u0644\u0651\u064E\u0647\u064E \u0639\u064E\u062F\u0652\u0648\u064E\u06E2\u0627 \u0628\u0650\u063A\u064E\u064A\u0652\u0631\u0650 \u0639\u0650\u0644\u0652\u0645\u064D \u06D7 }\u060C \u0642\u064E\u0627\u0644\u064E: \u0642\u064E\u0627\u0644\u064F\u0648\u0627: \u064A\u064E\u0627 \u0645\u064F\u062D\u064E\u0645\u0651\u064E\u062F \u0644\u064E\u062A\u064E\u0646\u0652\u062A\u064E\u0647\u0650\u064A\u064E\u0646\u0651\u064E \u0639\u064E\u0646\u0652 \u0633\u064E\u0628\u0651\u0650 \u0622\u0644\u0650\u0647\u064E\u062A\u0650\u0646\u064E\u0627\u060C \u0623\u064E\u0648\u0652 \u0644\u064E\u0646\u064E\u0647\u0652\u062C\u064F\u0648\u064E\u0646\u0651\u064E \u0631\u064E\u0628\u0651\u064E\u0643\u064E\u060C \u0641\u064E\u0646\u064E\u0647\u064E\u0627\u0647\u064F\u0645\u064F \u0627\u0644\u0644\u0647\u064F \u0623\u064E\u0646\u0652 \u064A\u064E\u0633\u064F\u0628\u0651\u064F\u0648\u0627 \u0623\u064E\u0648\u0652\u062B\u064E\u0627\u0646\u064E\u0647\u064F\u0645\u0652\u060C \u0641\u064E\u064A\u064E\u0633\u064F\u0628\u0651\u064F\u0648\u0627 \u0627\u0644\u0644\u0647\u064E \u0639\u064E\u062F\u064F\u0648\u0627\u064B \u0628\u0650\u063A\u064E\u064A\u0652\u0631\u0650 \u0639\u0650\u0644\u0652\u0645\u064D.",
            "fadl": "",
            "action": ""
