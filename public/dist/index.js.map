            story: "\u0623\u0648\u0644 \u0645\u0646 \u0622\u0645\u0646 \u0628\u0627\u0644\u0646\u0628\u064A \uFDFA \u0645\u0637\u0644\u0642\u0627\u064B. \u0635\u062F\u0651\u0642\u062A\u0647 \u062D\u064A\u0646 \u0643\u0630\u0628\u0647 \u0627\u0644\u0646\u0627\u0633 \u0648\u0648\u0627\u0633\u062A\u0647 \u0628\u0645\u0627\u0644\u0647\u0627 \u0648\u0646\u0641\u0633\u0647\u0627. \u0628\u0634\u0651\u0631\u0647\u0627 \u0627\u0644\u0644\u0647 \u0628\u0628\u064A\u062A \u0641\u064A \u0627\u0644\u062C\u0646\u0629 \u0645\u0646 \u0642\u0635\u0628. \u0643\u0627\u0646\u062A \u0623\u0645 \u0623\u0628\u0646\u0627\u0626\u0647\u060C \u0648\u0642\u0627\u0644 \u0639\u0646\u0647\u0627: (\u0645\u0627 \u0623\u0628\u062F\u0644\u0646\u064A \u0627\u0644\u0644\u0647 \u062E\u064A\u0631\u0627\u064B \u0645\u0646\u0647\u0627).",
            lessons: "\u0627\u0644\u0632\u0648\u062C\u0629 \u0627\u0644\u0635\u0627\u0644\u062D\u0629 \u0633\u0646\u062F \u0627\u0644\u0632\u0648\u062C \u0641\u064A \u0623\u0634\u062F \u0627\u0644\u0623\u0648\u0642\u0627\u062A. \u0631\u062C\u0627\u062D\u0629 \u0627\u0644\u0639\u0642\u0644 \u0648\u0627\u0644\u062D\u0643\u0645\u0629 \u0641\u064A \u0627\u0644\u062A\u0639\u0627\u0645\u0644 \u0645\u0639 \u0627\u0644\u0623\u0632\u0645\u0627\u062A.",
            category_tag: "\u0623\u0645\u0647\u0627\u062A \u0627\u0644\u0645\u0624\u0645\u0646\u064A\u0646"
