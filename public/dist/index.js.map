            category: "\u0627\u0644\u0642\u0627\u062F\u0629",
            name: "\u0645\u062C\u0632\u0623\u0629 \u0628\u0646 \u062B\u0648\u0631 \u0627\u0644\u0633\u062F\u0648\u0633\u064A",
            title: "\u0627\u0644\u0628\u0627\u0633\u0644 \u0627\u0644\u0645\u063A\u0648\u0627\u0631",
            story: "\u0641\u0627\u0631\u0633 \u0639\u0638\u064A\u0645\u060C \u0642\u0627\u062F \u0643\u062A\u064A\u0628\u0629 \u0627\u0633\u062A\u0634\u0647\u0627\u062F\u064A\u0629 \u0644\u0644\u0633\u0628\u0627\u062D\u0629 \u0641\u064A \u0646\u0641\u0642 \u062A\u062D\u062A \u0627\u0644\u0623\u0631\u0636 \u0644\u0627\u0642\u062A\u062D\u0627\u0645 \u062D\u0635\u0646 (\u062A\u0633\u062A\u0631) \u0627\u0644\u0641\u0627\u0631\u0633\u064A \u0627\u0644\u062D\u0635\u064A\u0646. \u062A\u0645\u0643\u0646 \u0645\u0646 \u0641\u062A\u062D \u0628\u0627\u0628 \u0627\u0644\u062D\u0635\u0646 \u0645\u0643\u0628\u0631\u0627\u064B \u0648\u0646\u062C\u062D \u0627\u0644\u0645\u0633\u0644\u0645\u0648\u0646 \u0628\u0627\u0644\u062F\u062E\u0648\u0644\u060C \u0648\u0627\u0633\u062A\u0634\u0647\u062F \u0641\u064A \u0627\u0644\u0645\u0639\u0631\u0643\u0629.",
            lessons: "\u0627\u0644\u0628\u0637\u0648\u0644\u0629 \u0648\u0627\u0644\u062A\u0636\u062D\u064A\u0629 \u0628\u0627\u0644\u0646\u0641\u0633 \u0641\u064A \u0627\u0644\u0645\u0648\u0627\u0642\u0641 \u0627\u0644\u062D\u0627\u0633\u0645\u0629. \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0639\u0633\u0643\u0631\u064A \u0648\u062A\u062C\u0627\u0648\u0632 \u0627\u0644\u0639\u0642\u0628\u0627\u062A.",
            category_tag: "\u0627\u0644\u0642\u0627\u062F\u0629"
        },
        {
            id: 43,
            category: "\u0627\u0644\u0635\u062D\u0627\u0628\u0629",
            name: "\u0641\u064A\u0631\u0648\u0632 \u0627\u0644\u062F\u064A\u0644\u0645\u064A",
            title: "\u0642\u0627\u062A\u0644 \u0645\u062F\u0639\u064A \u0627\u0644\u0646\u0628\u0648\u0629",
            story: "\u0645\u0646 (\u0627\u0644\u0623\u0628\u0646\u0627\u0621) \u0641\u064A \u0627\u0644\u064A\u0645\u0646. \u0643\u0644\u0641\u0647 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0628\u0627\u0644\u062A\u062E\u0644\u0635 \u0645\u0646 \u0627\u0644\u0623\u0633\u0648\u062F \u0627\u0644\u0639\u0646\u0633\u064A \u0627\u0644\u0630\u064A \u0627\u062F\u0639\u0649 \u0627\u0644\u0646\u0628\u0648\u0629 \u0648\u0643\u0641\u0631 \u0628\u0627\u0644\u0644\u0647\u060C \u0641\u062A\u0645\u0643\u0646 \u0645\u0646 \u0627\u0642\u062A\u062D\u0627\u0645 \u062D\u0635\u0646\u0647 \u0648\u0642\u062A\u0644\u0647\u060C \u0641\u0628\u0634\u0631 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0623\u0635\u062D\u0627\u0628\u0647 \u0642\u0627\u0626\u0644\u0627\u064B: (\u0642\u062A\u0644\u0647 \u0627\u0644\u0639\u0628\u062F \u0627\u0644\u0635\u0627\u0644\u062D \u0641\u064A\u0631\u0648\u0632).",
            lessons: "\u0627\u0644\u062D\u0632\u0645 \u0641\u064A \u0627\u0644\u0642\u0636\u0627\u0621 \u0639\u0644\u0649 \u0627\u0644\u0641\u062A\u0646 \u0641\u064A \u0645\u0647\u062F\u0647\u0627. \u0634\u062C\u0627\u0639\u0629 \u0627\u0644\u0641\u0631\u062F \u0627\u0644\u0648\u0627\u062D\u062F \u0642\u062F \u062A\u0646\u0642\u0630 \u0623\u0645\u0629 \u0643\u0627\u0645\u0644\u0629 \u0645\u0646 \u0627\u0644\u0636\u0644\u0627\u0644.",
            category_tag: "\u0627\u0644\u0635\u062D\u0627\u0628\u0629"
