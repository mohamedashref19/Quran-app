            "action": ""
        },
        "44_16": {
            "title": "\u064A\u064E\u0648\u0652\u0645\u064E \u0646\u064E\u0628\u0652\u0637\u0650\u0634\u064F \u0627\u0644\u0652\u0628\u064E\u0637\u0652\u0634\u064E\u0629\u064E \u0627\u0644\u0652\u0643\u064F\u0628\u0652\u0631\u064E\u0649\u0670 \u0625\u0650\u0646\u0651\u064E\u0627 \u0645\u064F\u0646\u0652\u062A\u064E\u0642\u0650\u0645\u064F\u0648\u0646\u064E",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 10 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
