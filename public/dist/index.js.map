        "6_54": {
            "title": "\u0648\u064E\u0625\u0650\u0630\u064E\u0627 \u062C\u064E\u0627\u0621\u064E\u0643\u064E \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u064A\u064F\u0624\u0652\u0645\u0650\u0646\u064F\u0648\u0646\u064E \u0628\u0650\u0622\u064A\u064E\u0627\u062A\u0650\u0646\u064E\u0627 \u0641\u064E\u0642\u064F\u0644\u0652 \u0633\u064E\u0644\u064E\u0627\u0645\u064C \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064F\u0645\u0652 \u06D6 \u0643\u064E\u062A\u064E\u0628\u064E \u0631\u064E\u0628\u0651\u064F\u0643\u064F\u0645\u0652 \u0639\u064E\u0644\u064E\u0649\u0670 \u0646\u064E\u0641\u0652\u0633\u0650\u0647\u0650 \u0627\u0644\u0631\u0651\u064E\u062D\u0652\u0645\u064E\u0629\u064E \u06D6 \u0623\u064E\u0646\u0651\u064E\u0647\u064F \u0645\u064E\u0646\u0652 \u0639\u064E\u0645\u0650\u0644\u064E \u0645\u0650\u0646\u0652\u0643\u064F\u0645\u0652 \u0633\u064F\u0648\u0621\u064B\u0627 \u0628\u0650\u062C\u064E\u0647\u064E\u0627\u0644\u064E\u0629\u064D \u062B\u064F\u0645\u0651\u064E \u062A\u064E\u0627\u0628\u064E \u0645\u0650\u0646\u0652 \u0628\u064E\u0639\u0652\u062F\u0650\u0647\u0650 \u0648\u064E\u0623\u064E\u0635\u0652\u0644\u064E\u062D\u064E \u0641\u064E\u0623\u064E\u0646\u0651\u064E\u0647\u064F \u063A\u064E\u0641\u064F\u0648\u0631\u064C \u0631\u064E\u062D\u0650\u064A\u0645\u064C",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 51 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
