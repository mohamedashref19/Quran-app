        },
        "33_35": {
            "title": "\u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0652\u0645\u064F\u0633\u0652\u0644\u0650\u0645\u0650\u064A\u0646\u064E \u0648\u064E\u0627\u0644\u0652\u0645\u064F\u0633\u0652\u0644\u0650\u0645\u064E\u0627\u062A\u0650 \u0648\u064E\u0627\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u0650\u064A\u0646\u064E \u0648\u064E\u0627\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u064E\u0627\u062A\u0650 \u0648\u064E\u0627\u0644\u0652\u0642\u064E\u0627\u0646\u0650\u062A\u0650\u064A\u0646\u064E \u0648\u064E\u0627\u0644\u0652\u0642\u064E\u0627\u0646\u0650\u062A\u064E\u0627\u062A\u0650 \u0648\u064E\u0627\u0644\u0635\u0651\u064E\u0627\u062F\u0650\u0642\u0650\u064A\u0646\u064E \u0648\u064E\u0627\u0644\u0635\u0651\u064E\u0627\u062F\u0650\u0642\u064E\u0627\u062A\u0650 \u0648\u064E\u0627\u0644\u0635\u0651\u064E\u0627\u0628\u0650\u0631\u0650\u064A\u0646\u064E \u0648\u064E\u0627\u0644\u0635\u0651\u064E\u0627\u0628\u0650\u0631\u064E\u0627\u062A\u0650 \u0648\u064E\u0627\u0644\u0652\u062E\u064E\u0627\u0634\u0650\u0639\u0650\u064A\u0646\u064E \u0648\u064E\u0627\u0644\u0652\u062E\u064E\u0627\u0634\u0650\u0639\u064E\u0627\u062A\u0650 \u0648\u064E\u0627\u0644\u0652\u0645\u064F\u062A\u064E\u0635\u064E\u062F\u0651\u0650\u0642\u0650\u064A\u0646\u064E \u0648\u064E\u0627\u0644\u0652\u0645\u064F\u062A\u064E\u0635\u064E\u062F\u0651\u0650\u0642\u064E\u0627\u062A\u0650 \u0648\u064E\u0627\u0644\u0635\u0651\u064E\u0627\u0626\u0650\u0645\u0650\u064A\u0646\u064E \u0648\u064E\u0627\u0644\u0635\u0651\u064E\u0627\u0626\u0650\u0645\u064E\u0627\u062A\u0650 \u0648\u064E\u0627\u0644\u0652\u062D\u064E\u0627\u0641\u0650\u0638\u0650\u064A\u0646\u064E \u0641\u064F\u0631\u064F\u0648\u062C\u064E\u0647\u064F\u0645\u0652 \u0648\u064E\u0627\u0644\u0652\u062D\u064E\u0627\u0641\u0650\u0638\u064E\u0627\u062A\u0650 \u0648\u064E\u0627\u0644\u0630\u0651\u064E\u0627\u0643\u0650\u0631\u0650\u064A\u0646\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064E \u0643\u064E\u062B\u0650\u064A\u0631\u064B\u0627 \u0648\u064E\u0627\u0644\u0630\u0651\u064E\u0627\u0643\u0650\u0631\u064E\u0627\u062A\u0650 \u0623\u064E\u0639\u064E\u062F\u0651\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0644\u064E\u0647\u064F\u0645\u0652 \u0645\u064E\u063A\u0652\u0641\u0650\u0631\u064E\u0629\u064B \u0648\u064E\u0623\u064E\u062C\u0652\u0631\u064B\u0627 \u0639\u064E\u0638\u0650\u064A\u0645\u064B\u0627",
            "sabab": "\u0639\u064E\u0646\u0652 \u0623\u064F\u0645\u0651\u0650 \u0639\u064F\u0645\u064E\u0627\u0631\u064E\u0629\u064E \u0627\u0644\u0652\u0623\u064E\u0646\u0652\u0635\u064E\u0627\u0631\u0650\u064A\u0651\u064E\u0629\u0650 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0627 \u0623\u064E\u0646\u0651\u064E\u0647\u064E\u0627 \u0623\u064E\u062A\u064E\u062A\u0650 \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064E \uFDFA \u0641\u064E\u0642\u064E\u0627\u0644\u064E\u062A\u0652: \u0645\u064E\u0627 \u0623\u064E\u0631\u064E\u0649 \u0643\u064F\u0644\u0651\u064E \u0634\u064E\u064A\u0652\u0621\u064D \u0625\u0650\u0644\u0651\u064E\u0627 \u0644\u0650\u0644\u0631\u0651\u0650\u062C\u064E\u0627\u0644\u0650\u060C \u0648\u064E\u0645\u064E\u0627 \u0623\u064E\u0631\u064E\u0649 \u0627\u0644\u0646\u0651\u0650\u0633\u064E\u0627\u0621\u064E \u064A\u064F\u0630\u0652\u0643\u064E\u0631\u0652\u0646\u064E \u0628\u0650\u0634\u064E\u064A\u0652\u0621\u064D\u060C \u0641\u064E\u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652 \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0622\u064A\u064E\u0629: { \u0625\u0650\u0646\u0651\u064E \u0671\u0644\u0652\u0645\u064F\u0633\u0652\u0644\u0650\u0645\u0650\u064A\u0646\u064E \u0648\u064E\u0671\u0644\u0652\u0645\u064F\u0633\u0652\u0644\u0650\u0645\u064E\u0640\u0670\u062A\u0650 \u0648\u064E\u0671\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u0650\u064A\u0646\u064E \u0648\u064E\u0671\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u064E\u0640\u0670\u062A\u0650 } \u0627\u0644\u0622\u064A\u0629.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0648\u0647\u0646\u0627\u0643 \u0633\u0628\u0628 \u062B\u0627\u0646 \u0644\u0644\u0646\u0632\u0648\u0644: \u0641\u0642\u062F \u062C\u0627\u0621 \u0639\u064E\u0646\u0652 \u0623\u064F\u0645\u0651\u0650 \u0633\u064E\u0644\u064E\u0645\u064E\u0629\u064E \u0642\u064E\u0627\u0644\u064E\u062A\u0652: \u0642\u064F\u0644\u0652\u062A\u064F: \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0645\u064E\u0627 \u0644\u064E\u0646\u064E\u0627 \u0644\u064E\u0627 \u0646\u064F\u0630\u0652\u0643\u064E\u0631\u064F \u0641\u0650\u064A \u0627\u0644\u0652\u0642\u064F\u0631\u0652\u0622\u0646\u0650 \u0643\u064E\u0645\u064E\u0627 \u064A\u064F\u0630\u0652\u0643\u064E\u0631\u064F \u0627\u0644\u0631\u0651\u0650\u062C\u064E\u0627\u0644\u064F\u061F \u0642\u064E\u0627\u0644\u064E\u062A\u0652: \u0641\u064E\u0644\u064E\u0645\u0652 \u064A\u064E\u0631\u064F\u0639\u0652\u0646\u0650\u064A \u0645\u0650\u0646\u0652\u0647\u064F \u064A\u064E\u0648\u0652\u0645\u0627\u064B \u0625\u0650\u0644\u0651\u064E\u0627 \u0648\u064E\u0646\u0650\u062F\u064E\u0627\u0624\u064F\u0647\u064F \u0639\u064E\u0644\u064E\u0649 \u0627\u0644\u0652\u0645\u0650\u0646\u0652\u0628\u064E\u0631\u0650: \xab \u064A\u064E\u0627 \u0623\u064E\u064A\u0651\u064F\u0647\u064E\u0627 \u0627\u0644\u0646\u0651\u064E\u0627\u0633\u064F \xbb \u0642\u064E\u0627\u0644\u064E\u062A\u0652: \u0648\u064E\u0623\u064E\u0646\u064E\u0627 \u0623\u064F\u0633\u064E\u0631\u0651\u0650\u062D\u064F \u0631\u064E\u0623\u0652\u0633\u0650\u064A\u060C \u0641\u064E\u0644\u064E\u0641\u064E\u0641\u0652\u062A\u064F \u0634\u064E\u0639\u0652\u0631\u0650\u064A\u060C \u062B\u064F\u0645\u0651\u064E \u062F\u064E\u0646\u064E\u0648\u0652\u062A\u064F \u0645\u0650\u0646\u064E \u0627\u0644\u0652\u0628\u064E\u0627\u0628\u0650\u060C \u0641\u064E\u062C\u064E\u0639\u064E\u0644\u0652\u062A\u064F \u0633\u064E\u0645\u0652\u0639\u0650\u064A \u0639\u0650\u0646\u0652\u062F\u064E \u0627\u0644\u0652\u062C\u064E\u0631\u0650\u064A\u062F\u0650\u060C \u0641\u064E\u0633\u064E\u0645\u0650\u0639\u0652\u062A\u064F\u0647\u064F \u064A\u064E\u0642\u064F\u0648\u0644\u064F: \u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0644\u0647\u064E \u0639\u0632 \u0648 \u062C\u0644 \u064A\u064E\u0642\u064F\u0648\u0644\u064F: { \u0625\u0650\u0646\u0651\u064E \u0671\u0644\u0652\u0645\u064F\u0633\u0652\u0644\u0650\u0645\u0650\u064A\u0646\u064E \u0648\u064E\u0671\u0644\u0652\u0645\u064F\u0633\u0652\u0644\u0650\u0645\u064E\u0640\u0670\u062A\u0650 \u0648\u064E\u0671\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u0650\u064A\u0646\u064E \u0648\u064E\u0671\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u064E\u0640\u0670\u062A\u0650 }\u060C \u0647\u064E\u0630\u0647 \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u064E\u060C \u0642\u064E\u0627\u0644\u064E \u0639\u064E\u0641\u0651\u064E\u0627\u0646\u064F: { \u0623\u064E\u0639\u064E\u062F\u0651\u064E \u0671\u0644\u0644\u0651\u064E\u0647\u064F \u0644\u064E\u0647\u064F\u0645 \u0645\u0651\u064E\u063A\u0652\u0641\u0650\u0631\u064E\u0629\u064B \u0648\u064E\u0623\u064E\u062C\u0652\u0631\u064B\u0627 \u0639\u064E\u0638\u0650\u064A\u0645\u064B\u0627 }.",
            "fadl": "",
            "action": ""
        },
        "33_36": {
            "title": "\u0627\u0644\u062A\u0633\u0644\u064A\u0645 \u0644\u0623\u0645\u0631 \u0627\u0644\u0644\u0647 \u0648\u0631\u0633\u0648\u0644\u0647",
            "sabab": "\u0646\u0632\u0644\u062A \u0641\u064A \u0632\u064A\u0646\u0628 \u0628\u0646\u062A \u062C\u062D\u0634 \u062D\u064A\u0646 \u062E\u0637\u0628\u0647\u0627 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0644\u0645\u0648\u0644\u0627\u0647 \u0632\u064A\u062F \u0628\u0646 \u062D\u0627\u0631\u062B\u0629 \u0641\u0627\u0645\u062A\u0646\u0639\u062A \u0644\u0638\u0646\u0647\u0627 \u0623\u0646\u0647 \u064A\u062E\u0637\u0628\u0647\u0627 \u0644\u0646\u0641\u0633\u0647\u060C \u0641\u0644\u0645\u0627 \u0646\u0632\u0644\u062A \u0627\u0644\u0622\u064A\u0629 \u0623\u0630\u0639\u0646\u062A.",
            "fadl": "",
            "action": "\u0642\u062F\u0651\u0645 \u0645\u0631\u0627\u062F \u0627\u0644\u0644\u0647 \u0648\u0631\u0633\u0648\u0644\u0647 \u0639\u0644\u0649 \u062D\u0638\u0648\u0638 \u0646\u0641\u0633\u0643 \u0648\u0623\u0647\u0648\u0627\u0626\u0647\u0627 \u0639\u0646\u062F \u062A\u0639\u0627\u0631\u0636\u0647\u0645\u0627\u060C \u0641\u0627\u0644\u062A\u0633\u0644\u064A\u0645 \u0627\u0644\u0645\u0637\u0644\u0642 \u0647\u0648 \u062D\u0642\u064A\u0642\u0629 \u0627\u0644\u0625\u064A\u0645\u0627\u0646."
        },
        "33_37": {
            "title": "\u0648\u064E\u0625\u0650\u0630\u0652 \u062A\u064E\u0642\u064F\u0648\u0644\u064F \u0644\u0650\u0644\u0651\u064E\u0630\u0650\u064A \u0623\u064E\u0646\u0652\u0639\u064E\u0645\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650 \u0648\u064E\u0623\u064E\u0646\u0652\u0639\u064E\u0645\u0652\u062A\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650 \u0623\u064E\u0645\u0652\u0633\u0650\u0643\u0652 \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064E \u0632\u064E\u0648\u0652\u062C\u064E\u0643\u064E \u0648\u064E\u0627\u062A\u0651\u064E\u0642\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u064E \u0648\u064E\u062A\u064F\u062E\u0652\u0641\u0650\u064A \u0641\u0650\u064A \u0646\u064E\u0641\u0652\u0633\u0650\u0643\u064E \u0645\u064E\u0627 \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0645\u064F\u0628\u0652\u062F\u0650\u064A\u0647\u0650 \u0648\u064E\u062A\u064E\u062E\u0652\u0634\u064E\u0649 \u0627\u0644\u0646\u0651\u064E\u0627\u0633\u064E \u0648\u064E\u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0623\u064E\u062D\u064E\u0642\u0651\u064F \u0623\u064E\u0646\u0652 \u062A\u064E\u062E\u0652\u0634\u064E\u0627\u0647\u064F \u06D6 \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0642\u064E\u0636\u064E\u0649\u0670 \u0632\u064E\u064A\u0652\u062F\u064C \u0645\u0650\u0646\u0652\u0647\u064E\u0627 \u0648\u064E\u0637\u064E\u0631\u064B\u0627 \u0632\u064E\u0648\u0651\u064E\u062C\u0652\u0646\u064E\u0627\u0643\u064E\u0647\u064E\u0627 \u0644\u0650\u0643\u064E\u064A\u0652 \u0644\u064E\u0627 \u064A\u064E\u0643\u064F\u0648\u0646\u064E \u0639\u064E\u0644\u064E\u0649 \u0627\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u0650\u064A\u0646\u064E \u062D\u064E\u0631\u064E\u062C\u064C \u0641\u0650\u064A \u0623\u064E\u0632\u0652\u0648\u064E\u0627\u062C\u0650 \u0623\u064E\u062F\u0652\u0639\u0650\u064A\u064E\u0627\u0626\u0650\u0647\u0650\u0645\u0652 \u0625\u0650\u0630\u064E\u0627 \u0642\u064E\u0636\u064E\u0648\u0652\u0627 \u0645\u0650\u0646\u0652\u0647\u064F\u0646\u0651\u064E \u0648\u064E\u0637\u064E\u0631\u064B\u0627 \u06DA \u0648\u064E\u0643\u064E\u0627\u0646\u064E \u0623\u064E\u0645\u0652\u0631\u064F \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u0645\u064E\u0641\u0652\u0639\u064F\u0648\u0644\u064B\u0627",
            "sabab": "\u0639\u064E\u0646\u0652 \u0623\u064E\u0646\u064E\u0633\u0650 \u0628\u0652\u0646\u0650 \u0645\u064E\u0627\u0644\u0650\u0643\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647: \u0623\u064E\u0646\u0651\u064E \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u064E { \u0648\u064E\u062A\u064F\u062E\u0652\u0641\u0650\u0649 \u0641\u0650\u0649 \u0646\u064E\u0641\u0652\u0633\u0650\u0643\u064E \u0645\u064E\u0627 \u0671\u0644\u0644\u0651\u064E\u0647\u064F \u0645\u064F\u0628\u0652\u062F\u0650\u064A\u0647\u0650 }\u060C \u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652 \u0641\u0650\u064A \u0634\u064E\u0623\u0652\u0646\u0650 \u0632\u064E\u064A\u0652\u0646\u064E\u0628\u064E \u0628\u0650\u0646\u0652\u062A\u0650 \u062C\u064E\u062D\u0652\u0634\u064D\u060C \u0648\u064E\u0632\u064E\u064A\u0652\u062F\u0650 \u0628\u0652\u0646\u0650 \u062D\u064E\u0627\u0631\u0650\u062B\u064E\u0629\u064E.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0639\u064E\u0646\u0652 \u0623\u064E\u0646\u064E\u0633\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u064E\u0627\u0644\u064E: \u062C\u064E\u0627\u0621\u064E \u0632\u064E\u064A\u0652\u062F\u064F \u0628\u0652\u0646\u064F \u062D\u064E\u0627\u0631\u0650\u062B\u064E\u0629\u064E \u064A\u064E\u0634\u0652\u0643\u064F\u0648\u060C \u0641\u064E\u062C\u064E\u0639\u064E\u0644\u064E \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064F \uFDFA \u064A\u064E\u0642\u064F\u0648\u0644\u064F: \xab \u0627\u062A\u0651\u064E\u0642\u0650 \u0627\u0644\u0644\u0647\u064E\u060C \u0648\u064E\u0623\u064E\u0645\u0652\u0633\u0650\u0643\u0652 \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064E \u0632\u064E\u0648\u0652\u062C\u064E\u0643\u064E \xbb\u060C \u0641\u064E\u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652: { \u0648\u064E\u062A\u064F\u062E\u0652\u0641\u0650\u0649 \u0641\u0650\u0649 \u0646\u064E\u0641\u0652\u0633\u0650\u0643\u064E \u0645\u064E\u0627 \u0671\u0644\u0644\u0651\u064E\u0647\u064F \u0645\u064F\u0628\u0652\u062F\u0650\u064A\u0647\u0650 }\u060C \u0642\u064E\u0627\u0644\u064E \u0623\u064E\u0646\u064E\u0633\u064C: \u0641\u064E\u0644\u064E\u0648\u0652 \u0643\u064E\u0627\u0646\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0643\u064E\u0627\u062A\u0650\u0645\u0627\u064B \u0634\u064E\u064A\u0652\u0626\u0627\u064B \u0644\u064E\u0643\u064E\u062A\u064E\u0645\u064E \u0647\u064E\u0630\u0650\u0647 \u0627\u0644\u0622\u064A\u0629\u060C \u0641\u0645\u0627 \u0623\u0648\u0644\u0645 \u0639\u0644\u0649 \u0627\u0645\u0631\u0623\u0629 \u0645\u0646 \u0646\u0633\u0627\u0626\u0647 \u0645\u0627 \u0623\u0648\u0644\u0645 \u0639\u0644\u064A\u0647\u0627\u060C \u0630\u0628\u062D \u0634\u0627\u0629\u060C { \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0642\u064E\u0636\u064E\u0649\u0670 \u0632\u064E\u064A\u0652\u062F\u064C \u0645\u0651\u0650\u0646\u0652\u0647\u064E\u0627 \u0648\u064E\u0637\u064E\u0631\u064B\u0627 \u0632\u064E\u0648\u0651\u064E\u062C\u0652\u0646\u064E\u0640\u0670\u0643\u064E\u0647\u064E\u0627 }\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0643\u064E\u0627\u0646\u064E\u062A\u0652 \u062A\u064E\u0641\u0652\u062E\u064E\u0631\u064F \u0639\u064E\u0644\u064E\u0649 \u0623\u064E\u0632\u0652\u0648\u064E\u0627\u062C\u0650 \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u0650 \uFDFA\u060C \u062A\u064E\u0642\u064F\u0648\u0644\u064F: \u0632\u064E\u0648\u0651\u064E\u062C\u064E\u0643\u064F\u0646\u0651\u064E \u0623\u064E\u0647\u064E\u0627\u0644\u0650\u064A\u0643\u064F\u0646\u0651\u064E\u060C \u0648\u064E\u0632\u064E\u0648\u0651\u064E\u062C\u064E\u0646\u064A \u0627\u0644\u0644\u0647\u064F \u062A\u064E\u0639\u064E\u0627\u0644\u064E\u0649 \u0645\u0650\u0646\u0652 \u0641\u064E\u0648\u0652\u0642\u0650 \u0633\u064E\u0628\u0652\u0639\u0650 \u0633\u064E\u0645\u064E\u0648\u064E\u0627\u062A\u064D.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0639\u064E\u0646\u0652 \u0623\u064E\u0646\u064E\u0633\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u064E\u0627\u0644\u064E: ( \u0644\u064E\u0645\u0651\u064E\u0627 \u0627\u0646\u0652\u0642\u064E\u0636\u064E\u062A\u0652 \u0639\u0650\u062F\u0651\u064E\u0629\u064F \u0632\u064E\u064A\u0652\u0646\u064E\u0628\u064E \u0642\u064E\u0627\u0644\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0644\u0650\u0632\u064E\u064A\u0652\u062F\u064D: \xab \u0641\u064E\u0627\u0630\u0652\u0643\u064F\u0631\u0652\u0647\u064E\u0627 \u0639\u064E\u0644\u064E\u064A\u0651\u064E \xbb \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0627\u0646\u0652\u0637\u064E\u0644\u064E\u0642\u064E \u0632\u064E\u064A\u0652\u062F\u064C \u062D\u064E\u062A\u0651\u064E\u0649 \u0623\u064E\u062A\u064E\u0627\u0647\u064E\u0627 \u0648\u064E\u0647\u0650\u064A\u064E \u062A\u064F\u062E\u064E\u0645\u0651\u0650\u0631\u064F \u0639\u064E\u062C\u0650\u064A\u0646\u064E\u0647\u064E\u0627\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0631\u064E\u0623\u064E\u064A\u0652\u062A\u064F\u0647\u064E\u0627 \u0639\u064E\u0638\u064F\u0645\u064E\u062A\u0652 \u0641\u0650\u064A \u0635\u064E\u062F\u0652\u0631\u0650\u064A\u060C \u062D\u064E\u062A\u0651\u064E\u0649 \u0645\u064E\u0627 \u0623\u064E\u0633\u0652\u062A\u064E\u0637\u0650\u064A\u0639\u064F \u0623\u064E\u0646\u0652 \u0623\u064E\u0646\u0652\u0638\u064F\u0631\u064E \u0625\u0650\u0644\u064E\u064A\u0652\u0647\u064E\u0627 \u0623\u064E\u0646\u0651\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0630\u064E\u0643\u064E\u0631\u064E\u0647\u064E\u0627\u060C \u0641\u064E\u0648\u064E\u0644\u0651\u064E\u064A\u0652\u062A\u064F\u0647\u064E\u0627 \u0638\u064E\u0647\u0652\u0631\u0650\u064A \u0648\u064E\u0646\u064E\u0643\u064E\u0635\u0652\u062A\u064F \u0639\u064E\u0644\u064E\u0649 \u0639\u064E\u0642\u0650\u0628\u0650\u064A\u060C \u0641\u064E\u0642\u064F\u0644\u0652\u062A\u064F: \u064A\u064E\u0627 \u0632\u064E\u064A\u0652\u0646\u064E\u0628\u064F\u060C \u0623\u064E\u0631\u0652\u0633\u064E\u0644\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u064A\u064E\u0630\u0652\u0643\u064F\u0631\u064F\u0643\u0650\u060C \u0642\u064E\u0627\u0644\u064E\u062A\u0652: \u0645\u064E\u0627 \u0623\u064E\u0646\u064E\u0627 \u0628\u0650\u0635\u064E\u0627\u0646\u0650\u0639\u064E\u0629\u064D \u0634\u064E\u064A\u0652\u0626\u064B\u0627 \u062D\u064E\u062A\u0651\u064E\u0649 \u0623\u064F\u0648\u064E\u0627\u0645\u0650\u0631\u064E \u0631\u064E\u0628\u0651\u0650\u064A. \u0641\u064E\u0642\u064E\u0627\u0645\u064E\u062A\u0652 \u0625\u0650\u0644\u064E\u0649 \u0645\u064E\u0633\u0652\u062C\u0650\u062F\u0650\u0647\u064E\u0627\u060C \u0648\u064E\u0646\u064E\u0632\u064E\u0644\u064E \u0627\u0644\u0652\u0642\u064F\u0631\u0652\u0622\u0646\u064F...).",
            "fadl": "",
            "action": ""
        },
        "33_51": {
            "title": "\u06DE \u062A\u064F\u0631\u0652\u062C\u0650\u064A \u0645\u064E\u0646\u0652 \u062A\u064E\u0634\u064E\u0627\u0621\u064F \u0645\u0650\u0646\u0652\u0647\u064F\u0646\u0651\u064E \u0648\u064E\u062A\u064F\u0624\u0652\u0648\u0650\u064A \u0625\u0650\u0644\u064E\u064A\u0652\u0643\u064E \u0645\u064E\u0646\u0652 \u062A\u064E\u0634\u064E\u0627\u0621\u064F \u06D6 \u0648\u064E\u0645\u064E\u0646\u0650 \u0627\u0628\u0652\u062A\u064E\u063A\u064E\u064A\u0652\u062A\u064E \u0645\u0650\u0645\u0651\u064E\u0646\u0652 \u0639\u064E\u0632\u064E\u0644\u0652\u062A\u064E \u0641\u064E\u0644\u064E\u0627 \u062C\u064F\u0646\u064E\u0627\u062D\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064E \u06DA \u0630\u064E\u0670\u0644\u0650\u0643\u064E \u0623\u064E\u062F\u0652\u0646\u064E\u0649\u0670 \u0623\u064E\u0646\u0652 \u062A\u064E\u0642\u064E\u0631\u0651\u064E \u0623\u064E\u0639\u0652\u064A\u064F\u0646\u064F\u0647\u064F\u0646\u0651\u064E \u0648\u064E\u0644\u064E\u0627 \u064A\u064E\u062D\u0652\u0632\u064E\u0646\u0651\u064E \u0648\u064E\u064A\u064E\u0631\u0652\u0636\u064E\u064A\u0652\u0646\u064E \u0628\u0650\u0645\u064E\u0627 \u0622\u062A\u064E\u064A\u0652\u062A\u064E\u0647\u064F\u0646\u0651\u064E \u0643\u064F\u0644\u0651\u064F\u0647\u064F\u0646\u0651\u064E \u06DA \u0648\u064E\u0627\u0644\u0644\u0651\u064E\u0647\u064F \u064A\u064E\u0639\u0652\u0644\u064E\u0645\u064F \u0645\u064E\u0627 \u0641\u0650\u064A \u0642\u064F\u0644\u064F\u0648\u0628\u0650\u0643\u064F\u0645\u0652 \u06DA \u0648\u064E\u0643\u064E\u0627\u0646\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0639\u064E\u0644\u0650\u064A\u0645\u064B\u0627 \u062D\u064E\u0644\u0650\u064A\u0645\u064B\u0627",
            "sabab": "\u0639\u064E\u0646\u0652 \u0639\u064E\u0627\u0626\u0650\u0634\u064E\u0629\u064E \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0627 \u0642\u064E\u0627\u0644\u064E\u062A\u0652: \u0643\u064F\u0646\u0652\u062A\u064F \u0623\u064E\u063A\u064E\u0627\u0631\u064F \u0639\u064E\u0644\u064E\u0649 \u0627\u0644\u0644\u0651\u064E\u0627\u062A\u0650\u064A \u0648\u064E\u0647\u064E\u0628\u0652\u0646\u064E \u0623\u064E\u0646\u0652\u0641\u064F\u0633\u064E\u0647\u064F\u0646\u0651\u064E \u0644\u0650\u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0627\u0644\u0644\u0647\u0650\u060C \u0648\u064E\u0623\u064E\u0642\u064F\u0648\u0644\u064F: \u0623\u064E\u062A\u064E\u0647\u064E\u0628\u064F \u0627\u0644\u0652\u0645\u064E\u0631\u0652\u0623\u064E\u0629\u064F \u0646\u064E\u0641\u0652\u0633\u064E\u0647\u064E\u0627\u061F \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u062A\u064E\u0639\u064E\u0627\u0644\u064E\u0649: { \u062A\u064F\u0631\u0652\u062C\u0650\u0649 \u0645\u064E\u0646 \u062A\u064E\u0634\u064E\u0627\u0653\u0621\u064F \u0645\u0650\u0646\u0652\u0647\u064F\u0646\u0651\u064E \u0648\u064E\u062A\u064F\u0640\u0654\u0652\u0648\u0650\u0649\u0653 \u0625\u0650\u0644\u064E\u064A\u0652\u0643\u064E \u0645\u064E\u0646 \u062A\u064E\u0634\u064E\u0627\u0653\u0621\u064F \u06D6 \u0648\u064E\u0645\u064E\u0646\u0650 \u0671\u0628\u0652\u062A\u064E\u063A\u064E\u064A\u0652\u062A\u064E \u0645\u0650\u0645\u0651\u064E\u0646\u0652 \u0639\u064E\u0632\u064E\u0644\u0652\u062A\u064E \u0641\u064E\u0644\u064E\u0627 \u062C\u064F\u0646\u064E\u0627\u062D\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064E \u06DA }\u060C \u0642\u064F\u0644\u0652\u062A\u064F: \u0648\u064E\u0627\u0644\u0644\u0647\u0650 \u0645\u064E\u0627 \u0623\u064E\u0631\u064E\u0649 \u0631\u064E\u0628\u0651\u064E\u0643\u064E \u0625\u0650\u0644\u0651\u064E\u0627 \u064A\u064F\u0633\u064E\u0627\u0631\u0650\u0639\u064F \u0641\u0650\u064A \u0647\u064E\u0648\u064E\u0627\u0643\u064E.",
            "fadl": "",
            "action": ""
        },
        "33_53": {
            "title": "\u064A\u064E\u0627 \u0623\u064E\u064A\u0651\u064F\u0647\u064E\u0627 \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0622\u0645\u064E\u0646\u064F\u0648\u0627 \u0644\u064E\u0627 \u062A\u064E\u062F\u0652\u062E\u064F\u0644\u064F\u0648\u0627 \u0628\u064F\u064A\u064F\u0648\u062A\u064E \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u0650 \u0625\u0650\u0644\u0651\u064E\u0627 \u0623\u064E\u0646\u0652 \u064A\u064F\u0624\u0652\u0630\u064E\u0646\u064E \u0644\u064E\u0643\u064F\u0645\u0652 \u0625\u0650\u0644\u064E\u0649\u0670 \u0637\u064E\u0639\u064E\u0627\u0645\u064D \u063A\u064E\u064A\u0652\u0631\u064E \u0646\u064E\u0627\u0638\u0650\u0631\u0650\u064A\u0646\u064E \u0625\u0650\u0646\u064E\u0627\u0647\u064F \u0648\u064E\u0644\u064E\u0670\u0643\u0650\u0646\u0652 \u0625\u0650\u0630\u064E\u0627 \u062F\u064F\u0639\u0650\u064A\u062A\u064F\u0645\u0652 \u0641\u064E\u0627\u062F\u0652\u062E\u064F\u0644\u064F\u0648\u0627 \u0641\u064E\u0625\u0650\u0630\u064E\u0627 \u0637\u064E\u0639\u0650\u0645\u0652\u062A\u064F\u0645\u0652 \u0641\u064E\u0627\u0646\u0652\u062A\u064E\u0634\u0650\u0631\u064F\u0648\u0627 \u0648\u064E\u0644\u064E\u0627 \u0645\u064F\u0633\u0652\u062A\u064E\u0623\u0652\u0646\u0650\u0633\u0650\u064A\u0646\u064E \u0644\u0650\u062D\u064E\u062F\u0650\u064A\u062B\u064D \u06DA \u0625\u0650\u0646\u0651\u064E \u0630\u064E\u0670\u0644\u0650\u0643\u064F\u0645\u0652 \u0643\u064E\u0627\u0646\u064E \u064A\u064F\u0624\u0652\u0630\u0650\u064A \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064E \u0641\u064E\u064A\u064E\u0633\u0652\u062A\u064E\u062D\u0652\u064A\u0650\u064A \u0645\u0650\u0646\u0652\u0643\u064F\u0645\u0652 \u06D6 \u0648\u064E\u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0644\u064E\u0627 \u064A\u064E\u0633\u0652\u062A\u064E\u062D\u0652\u064A\u0650\u064A \u0645\u0650\u0646\u064E \u0627\u0644\u0652\u062D\u064E\u0642\u0651\u0650 \u06DA \u0648\u064E\u0625\u0650\u0630\u064E\u0627 \u0633\u064E\u0623\u064E\u0644\u0652\u062A\u064F\u0645\u064F\u0648\u0647\u064F\u0646\u0651\u064E \u0645\u064E\u062A\u064E\u0627\u0639\u064B\u0627 \u0641\u064E\u0627\u0633\u0652\u0623\u064E\u0644\u064F\u0648\u0647\u064F\u0646\u0651\u064E \u0645\u0650\u0646\u0652 \u0648\u064E\u0631\u064E\u0627\u0621\u0650 \u062D\u0650\u062C\u064E\u0627\u0628\u064D \u06DA \u0630\u064E\u0670\u0644\u0650\u0643\u064F\u0645\u0652 \u0623\u064E\u0637\u0652\u0647\u064E\u0631\u064F \u0644\u0650\u0642\u064F\u0644\u064F\u0648\u0628\u0650\u0643\u064F\u0645\u0652 \u0648\u064E\u0642\u064F\u0644\u064F\u0648\u0628\u0650\u0647\u0650\u0646\u0651\u064E \u06DA \u0648\u064E\u0645\u064E\u0627 \u0643\u064E\u0627\u0646\u064E \u0644\u064E\u0643\u064F\u0645\u0652 \u0623\u064E\u0646\u0652 \u062A\u064F\u0624\u0652\u0630\u064F\u0648\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u0648\u064E\u0644\u064E\u0627 \u0623\u064E\u0646\u0652 \u062A\u064E\u0646\u0652\u0643\u0650\u062D\u064F\u0648\u0627 \u0623\u064E\u0632\u0652\u0648\u064E\u0627\u062C\u064E\u0647\u064F \u0645\u0650\u0646\u0652 \u0628\u064E\u0639\u0652\u062F\u0650\u0647\u0650 \u0623\u064E\u0628\u064E\u062F\u064B\u0627 \u06DA \u0625\u0650\u0646\u0651\u064E \u0630\u064E\u0670\u0644\u0650\u0643\u064F\u0645\u0652 \u0643\u064E\u0627\u0646\u064E \u0639\u0650\u0646\u0652\u062F\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u0639\u064E\u0638\u0650\u064A\u0645\u064B\u0627",
            "sabab": "\u0633\u0628\u0628 \u0645\u0646 \u0623\u0633\u0628\u0627\u0628 \u0627\u0644\u0646\u0632\u0648\u0644 \u0644\u0647\u0630\u0647 \u0627\u0644\u0622\u064A\u0629: \u0639\u064E\u0646\u0652 \u0623\u064E\u0646\u064E\u0633\u0650 \u0628\u0652\u0646\u0650 \u0645\u064E\u0627\u0644\u0650\u0643\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u064E\u0627\u0644\u064E: \u062A\u064E\u0632\u064E\u0648\u0651\u064E\u062C\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0641\u064E\u062F\u064E\u062E\u064E\u0644\u064E \u0628\u0650\u0623\u064E\u0647\u0652\u0644\u0650\u0647\u0650\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0635\u064E\u0646\u064E\u0639\u064E\u062A\u0652 \u0623\u064F\u0645\u0651\u0650\u064A \u0623\u064F\u0645\u0651\u064F \u0633\u064F\u0644\u064E\u064A\u0652\u0645\u064D \u062D\u064E\u064A\u0652\u0633\u0627\u064B \u0641\u064E\u062C\u064E\u0639\u064E\u0644\u064E\u062A\u0652\u0647\u064F \u0641\u0650\u064A \u062A\u064E\u0648\u0652\u0631\u064D\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E\u062A\u0652: \u064A\u064E\u0627 \u0623\u064E\u0646\u064E\u0633\u064F \u0627\u0630\u0652\u0647\u064E\u0628\u0652 \u0628\u0650\u0647\u064E\u0630\u064E\u0627 \u0625\u0650\u0644\u064E\u0649 \u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0627\u0644\u0644\u0647\u0650 \uFDFA\u060C \u0641\u064E\u0642\u064F\u0644\u0652 \u0644\u064E\u0647\u064F: \u0628\u064E\u0639\u064E\u062B\u064E\u062A\u0652 \u0628\u0650\u0647\u064E\u0630\u064E\u0627 \u0625\u0650\u0644\u064E\u064A\u0652\u0643\u064E \u0623\u064F\u0645\u0651\u0650\u064A\u060C \u0648\u064E\u0647\u0650\u064A\u064E \u062A\u064F\u0642\u0652\u0631\u0650\u0626\u064F\u0643\u064E \u0627\u0644\u0633\u0651\u064E\u0644\u064E\u0627\u0645\u064E\u060C \u0648\u064E\u062A\u064E\u0642\u064F\u0648\u0644\u064F: \u0625\u0650\u0646\u0651\u064E \u0647\u064E\u0630\u064E\u0627 \u0644\u064E\u0643\u064E \u0645\u0650\u0646\u0651\u064E\u0627 \u0642\u064E\u0644\u0650\u064A\u0644\u064C\u060C \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650. \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0630\u064E\u0647\u064E\u0628\u0652\u062A\u064F \u0628\u0650\u0647\u0650 \u0625\u0650\u0644\u064E\u0649 \u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0627\u0644\u0644\u0647\u0650 \uFDFA\u060C \u0641\u064E\u0642\u064F\u0644\u0652\u062A\u064F \u0625\u0650\u0646\u0651\u064E \u0623\u064F\u0645\u0651\u0650\u064A \u062A\u064F\u0642\u0652\u0631\u0650\u0626\u064F\u0643\u064E \u0627\u0644\u0633\u0651\u064E\u0644\u064E\u0627\u0645\u064E \u0648\u064E\u062A\u064E\u0642\u064F\u0648\u0644\u064F \u0625\u0650\u0646\u0651\u064E \u0647\u064E\u0630\u064E\u0627 \u0645\u0650\u0646\u0651\u064E\u0627 \u0644\u064E\u0643\u064E \u0642\u064E\u0644\u0650\u064A\u0644\u064C\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E: \xab \u0636\u064E\u0639\u0652\u0647\u064F \xbb \u062B\u064F\u0645\u0651\u064E \u0642\u064E\u0627\u0644\u064E: \xab \u0627\u0630\u0652\u0647\u064E\u0628\u0652 \u0641\u064E\u0627\u062F\u0652\u0639\u064F \u0644\u0650\u064A \u0641\u064F\u0644\u064E\u0627\u0646\u0627\u064B \u0648\u064E\u0641\u064F\u0644\u064E\u0627\u0646\u0627\u064B\u060C \u0648\u064E\u0641\u064F\u0644\u064E\u0627\u0646\u0627\u064B \u0648\u064E\u0645\u064E\u0646\u0652 \u0644\u064E\u0642\u0650\u064A\u062A\u064E \xbb \u0641\u064E\u0633\u064E\u0645\u0651\u064E\u0649 \u0631\u0650\u062C\u064E\u0627\u0644\u064B\u0627\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u062F\u064E\u0639\u064E\u0648\u0652\u062A\u064F \u0645\u064E\u0646\u0652 \u0633\u064E\u0645\u0651\u064E\u0649 \u0648\u064E\u0645\u064E\u0646\u0652 \u0644\u064E\u0642\u0650\u064A\u062A\u064F.\n\n\u0642\u064E\u0627\u0644\u064E: \u0642\u064F\u0644\u0652\u062A\u064F \u0644\u0650\u0623\u064E\u0646\u064E\u0633\u064D: \u0639\u064E\u062F\u064E\u062F\u064F \u0643\u064E\u0645\u0652 \u0643\u064E\u0627\u0646\u064F\u0648\u0627\u061F \u0642\u064E\u0627\u0644\u064E: \u0632\u064F\u0647\u064E\u0627\u0621\u064E \u062B\u064E\u0644\u064E\u0627\u062B\u0650 \u0645\u0650\u0627\u0626\u064E\u0629\u064D.\n\n\u0642\u064E\u0627\u0644\u064E: \u0648\u064E\u0642\u064E\u0627\u0644\u064E \u0644\u0650\u064A \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA: \xab \u064A\u064E\u0627 \u0623\u064E\u0646\u0633\u064F\u060C \u0647\u064E\u0627\u062A\u0650 \u0627\u0644\u062A\u0651\u064E\u0648\u0652\u0631\u064E \xbb. \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u062F\u064E\u062E\u064E\u0644\u064F\u0648\u0627 \u062D\u064E\u062A\u0651\u064E\u0649 \u0627\u0645\u0652\u062A\u064E\u0644\u064E\u0627\u062A\u0650 \u0627\u0644\u0635\u0651\u064F\u0641\u064E\u0629\u064F \u0648\u064E\u0627\u0644\u0652\u062D\u064F\u062C\u0652\u0631\u064E\u0629\u064F\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA: \xab \u0644\u0650\u064A\u064E\u062A\u064E\u062D\u064E\u0644\u0651\u064E\u0642\u0652 \u0639\u064E\u0634\u064E\u0631\u064E\u0629\u064C \u0639\u064E\u0634\u064E\u0631\u064E\u0629\u064C\u060C \u0648\u064E\u0644\u0652\u064A\u064E\u0623\u0652\u0643\u064F\u0644\u0652 \u0643\u064F\u0644\u0651\u064F \u0625\u0650\u0646\u0652\u0633\u064E\u0627\u0646\u064D \u0645\u0650\u0645\u0651\u064E\u0627 \u064A\u064E\u0644\u0650\u064A\u0647\u0650 \xbb\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0623\u064E\u0643\u064E\u0644\u064F\u0648\u0627 \u062D\u064E\u062A\u0651\u064E\u0649 \u0634\u064E\u0628\u0650\u0639\u064F\u0648\u0627\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u062E\u064E\u0631\u064E\u062C\u064E\u062A\u0652 \u0637\u064E\u0627\u0626\u0650\u0641\u064E\u0629\u064C \u0648\u064E\u062F\u064E\u062E\u064E\u0644\u064E\u062A\u0652 \u0637\u064E\u0627\u0626\u0650\u0641\u064E\u0629\u064C \u062D\u064E\u062A\u0651\u064E\u0649 \u0623\u064E\u0643\u064E\u0644\u064F\u0648\u0627 \u0643\u064F\u0644\u0651\u064F\u0647\u064F\u0645\u0652\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0644\u0650\u064A: \xab \u064A\u064E\u0627 \u0623\u064E\u0646\u064E\u0633\u064F \u0627\u0631\u0652\u0641\u064E\u0639\u0652 \xbb\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0631\u064E\u0641\u064E\u0639\u0652\u062A\u064F \u0641\u064E\u0645\u064E\u0627 \u0623\u064E\u062F\u0652\u0631\u0650\u064A \u062D\u0650\u064A\u0646\u064E \u0648\u064E\u0636\u064E\u0639\u0652\u062A\u064F \u0643\u064E\u0627\u0646\u064E \u0623\u064E\u0643\u0652\u062B\u064E\u0631\u064E \u0623\u064E\u0645\u0652 \u062D\u0650\u064A\u0646\u064E \u0631\u064E\u0641\u064E\u0639\u0652\u062A\u064F.\n\n\u0642\u064E\u0627\u0644\u064E: \u0648\u064E\u062C\u064E\u0644\u064E\u0633\u064E \u0645\u0650\u0646\u0652\u0647\u064F\u0645\u0652 \u0637\u064E\u0648\u064E\u0627\u0626\u0650\u0641\u064F \u064A\u064E\u062A\u064E\u062D\u064E\u062F\u0651\u064E\u062B\u064F\u0648\u0646\u064E \u0641\u0650\u064A \u0628\u064E\u064A\u0652\u062A\u0650 \u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0627\u0644\u0644\u0647\u0650 \uFDFA\u060C \u0648\u064E\u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u062C\u064E\u0627\u0644\u0650\u0633\u064C\u060C \u0648\u064E\u0632\u064E\u0648\u0652\u062C\u064E\u062A\u064F\u0647\u064F \u0645\u064F\u0648\u064E\u0644\u0651\u0650\u064A\u064E\u0629\u064C \u0648\u064E\u062C\u0652\u0647\u064E\u0647\u064E\u0627 \u0625\u0650\u0644\u064E\u0649 \u0627\u0644\u0652\u062D\u064E\u0627\u0626\u0650\u0637\u0650\u060C \u0641\u064E\u062B\u064E\u0642\u064F\u0644\u064F\u0648\u0627 \u0639\u064E\u0644\u064E\u0649 \u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0627\u0644\u0644\u0647\u0650 \uFDFA\u060C \u0641\u064E\u062E\u064E\u0631\u064E\u062C\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0641\u064E\u0633\u064E\u0644\u0651\u064E\u0645\u064E \u0639\u064E\u0644\u064E\u0649 \u0646\u0650\u0633\u064E\u0627\u0626\u0650\u0647\u0650 \u062B\u064F\u0645\u0651\u064E \u0631\u064E\u062C\u064E\u0639\u064E\u060C \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0631\u064E\u0623\u064E\u0648\u0652\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0642\u064E\u062F\u0652 \u0631\u064E\u062C\u064E\u0639\u064E \u0638\u064E\u0646\u0651\u064F\u0648\u0627 \u0623\u064E\u0646\u0651\u064E\u0647\u064F\u0645\u0652 \u0642\u064E\u062F\u0652 \u062B\u064E\u0642\u064F\u0644\u064F\u0648\u0627 \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0627\u0628\u0652\u062A\u064E\u062F\u064E\u0631\u064F\u0648\u0627 \u0627\u0644\u0652\u0628\u064E\u0627\u0628\u064E \u0641\u064E\u062E\u064E\u0631\u064E\u062C\u064F\u0648\u0627 \u0643\u064F\u0644\u0651\u064F\u0647\u064F\u0645\u0652\u060C \u0648\u064E\u062C\u064E\u0627\u0621\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u062D\u064E\u062A\u0651\u064E\u0649 \u0623\u064E\u0631\u0652\u062E\u064E\u0649 \u0627\u0644\u0633\u0651\u0650\u062A\u0652\u0631\u064E \u0648\u064E\u062F\u064E\u062E\u064E\u0644\u064E\u060C \u0648\u064E\u0623\u064E\u0646\u064E\u0627 \u062C\u064E\u0627\u0644\u0650\u0633\u064C \u0641\u0650\u064A \u0627\u0644\u0652\u062D\u064F\u062C\u0652\u0631\u064E\u0629\u0650\u060C \u0641\u064E\u0644\u064E\u0645\u0652 \u064A\u064E\u0644\u0652\u0628\u064E\u062B\u0652 \u0625\u0650\u0644\u0651\u064E\u0627 \u064A\u064E\u0633\u0650\u064A\u0631\u0627\u064B \u062D\u064E\u062A\u0651\u064E\u0649 \u062E\u064E\u0631\u064E\u062C\u064E \u0639\u064E\u0644\u064E\u064A\u0651\u064E\u060C \u0648\u064E\u0623\u064F\u0646\u0652\u0632\u0650\u0644\u064E\u062A\u0652 \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0622\u064A\u064E\u0627\u062A\u064F\u060C \u0641\u064E\u062E\u064E\u0631\u064E\u062C\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0641\u064E\u0642\u064E\u0631\u064E\u0623\u064E\u0647\u064F\u0646\u0651\u064E \u0639\u064E\u0644\u064E\u0649 \u0627\u0644\u0646\u0651\u064E\u0627\u0633\u0650: { \u064A\u064E\u0640\u0670\u0653\u0623\u064E\u064A\u0651\u064F\u0647\u064E\u0627 \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0621\u064E\u0627\u0645\u064E\u0646\u064F\u0648\u0627\u06DF \u0644\u064E\u0627 \u062A\u064E\u062F\u0652\u062E\u064F\u0644\u064F\u0648\u0627\u06DF \u0628\u064F\u064A\u064F\u0648\u062A\u064E \u0671\u0644\u0646\u0651\u064E\u0628\u0650\u0649\u0651\u0650 \u0625\u0650\u0644\u0651\u064E\u0627\u0653 \u0623\u064E\u0646 \u064A\u064F\u0624\u0652\u0630\u064E\u0646\u064E \u0644\u064E\u0643\u064F\u0645\u0652 \u0625\u0650\u0644\u064E\u0649\u0670 \u0637\u064E\u0639\u064E\u0627\u0645\u064D \u063A\u064E\u064A\u0652\u0631\u064E \u0646\u064E\u0640\u0670\u0638\u0650\u0631\u0650\u064A\u0646\u064E \u0625\u0650\u0646\u064E\u0649\u0670\u0647\u064F \u0648\u064E\u0644\u064E\u0670\u0643\u0650\u0646\u0652 \u0625\u0650\u0630\u064E\u0627 \u062F\u064F\u0639\u0650\u064A\u062A\u064F\u0645\u0652 \u0641\u064E\u0671\u062F\u0652\u062E\u064F\u0644\u064F\u0648\u0627\u06DF \u0641\u064E\u0625\u0650\u0630\u064E\u0627 \u0637\u064E\u0639\u0650\u0645\u0652\u062A\u064F\u0645\u0652 \u0641\u064E\u0671\u0646\u062A\u064E\u0634\u0650\u0631\u064F\u0648\u0627\u06DF \u0648\u064E\u0644\u064E\u0627 \u0645\u064F\u0633\u0652\u062A\u064E\u0640\u0654\u0652\u0646\u0650\u0633\u0650\u064A\u0646\u064E \u0644\u0650\u062D\u064E\u062F\u0650\u064A\u062B\u064D \u06DA \u0625\u0650\u0646\u0651\u064E \u0630\u064E\u0670\u0644\u0650\u0643\u064F\u0645\u0652 \u0643\u064E\u0627\u0646\u064E \u064A\u064F\u0624\u0652\u0630\u0650\u0649 \u0671\u0644\u0646\u0651\u064E\u0628\u0650\u0649\u0651\u064E } \u0625\u0650\u0644\u064E\u0649 \u0622\u062E\u0650\u0631\u0650 \u0627\u0644\u0622\u064A\u0629.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0648\u0633\u0628\u0628 \u0622\u062E\u0631: \u0641\u0642\u062F \u062C\u0627\u0621 \u0639\u064E\u0646\u0652 \u0623\u064E\u0646\u064E\u0633\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u064E\u0627\u0644\u064E: \u0642\u064E\u0627\u0644\u064E \u0639\u064F\u0645\u064E\u0631\u064F \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0627: (\u0648\u064E\u0627\u0641\u064E\u0642\u0652\u062A\u064F \u0627\u0644\u0644\u0647\u064E \u0641\u0650\u064A \u062B\u064E\u0644\u064E\u0627\u062B\u064D...) (\u0648\u064E\u0642\u064F\u0644\u0652\u062A\u064F: \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \u064A\u064E\u062F\u0652\u062E\u0650\u0644\u064F \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064E \u0627\u0644\u0652\u0628\u064E\u0631\u0651\u064F \u0648\u064E\u0627\u0644\u0652\u0641\u064E\u0627\u062C\u0650\u0631\u064F \u0641\u064E\u0644\u064E\u0648\u0652 \u0623\u064E\u0645\u064E\u0631\u0652\u062A\u064E \u0623\u064F\u0645\u0651\u064E\u0647\u064E\u0627\u062A\u0650 \u0627\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u0650\u064A\u0646\u064E \u0628\u0650\u0627\u0644\u0652\u062D\u0650\u062C\u064E\u0627\u0628\u0650\u060C \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0622\u064A\u064E\u0629\u064E \u0627\u0644\u0652\u062D\u0650\u062C\u064E\u0627\u0628\u0650....).\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0648\u0633\u0628\u0628 \u0622\u062E\u0631: \u0641\u0642\u062F \u062C\u0627\u0621 \u0639\u064E\u0646\u0652 \u0639\u064E\u0627\u0626\u0650\u0634\u064E\u0629\u064E \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0627: \u0623\u064E\u0646\u0651\u064E \u0623\u064E\u0632\u0652\u0648\u064E\u0627\u062C\u064E \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u0650 \uFDFA \u0643\u064F\u0646\u0651\u064E \u064A\u064E\u062E\u0652\u0631\u064F\u062C\u0652\u0646\u064E \u0628\u0650\u0627\u0644\u0644\u0651\u064E\u064A\u0652\u0644\u0650 \u0625\u0650\u0630\u064E\u0627 \u062A\u064E\u0628\u064E\u0631\u0651\u064E\u0632\u0652\u0646\u064E \u0625\u0650\u0644\u064E\u0649 \u0627\u0644\u0652\u0645\u064E\u0646\u064E\u0627\u0635\u0650\u0639 - \u0648\u064E\u0647\u064F\u0648\u064E \u0635\u064E\u0639\u0650\u064A\u062F\u064C \u0623\u064E\u0641\u0652\u064A\u064E\u062D\u064F - \u0648\u064E\u0643\u064E\u0627\u0646\u064E \u0639\u064F\u0645\u064E\u0631\u064F \u0628\u0652\u0646\u064F \u0627\u0644\u0652\u062E\u064E\u0637\u0651\u064E\u0627\u0628\u0650 \u064A\u064E\u0642\u064F\u0648\u0644\u064F \u0644\u0650\u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0627\u0644\u0644\u0647\u0650 \uFDFA: \u0627\u062D\u0652\u062C\u064F\u0628\u0652 \u0646\u0650\u0633\u064E\u0627\u0621\u064E\u0643\u064E\u060C \u0641\u064E\u0644\u064E\u0645\u0652 \u064A\u064E\u0643\u064F\u0646\u0652 \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u064A\u064E\u0641\u0652\u0639\u064E\u0644\u064F\u060C \u0641\u064E\u062E\u064E\u0631\u064E\u062C\u064E\u062A\u0652 \u0633\u064E\u0648\u0652\u062F\u064E\u0629\u064F \u0628\u0650\u0646\u0652\u062A\u064F \u0632\u064E\u0645\u0652\u0639\u064E\u0629\u064E \u0632\u064E\u0648\u0652\u062C\u064F \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u0650 \uFDFA \u0644\u064E\u064A\u0652\u0644\u064E\u0629\u064C \u0645\u0650\u0646\u064E \u0627\u0644\u0644\u0651\u064E\u064A\u064E\u0627\u0644\u0650\u064A \u0639\u0650\u0634\u064E\u0627\u0621\u064B\u060C \u0648\u064E\u0643\u064E\u0627\u0646\u064E\u062A\u0650 \u0627\u0645\u0652\u0631\u064E\u0623\u064E\u0629\u064B \u0637\u064E\u0648\u0650\u064A\u0644\u064E\u0629\u064B\u060C \u0641\u064E\u0646\u064E\u0627\u062F\u064E\u0627\u0647\u064E\u0627 \u0639\u064F\u0645\u064E\u0631\u064F: \u0623\u064E\u0644\u0627 \u0642\u064E\u062F\u0652 \u0639\u064E\u0631\u064E\u0641\u0652\u0646\u064E\u0627\u0643\u0650 \u064A\u064E\u0627 \u0633\u064E\u0648\u0652\u062F\u064E\u0629\u064F\u060C \u062D\u0650\u0631\u0652\u0635\u0627\u064B \u0639\u064E\u0644\u064E\u0649 \u0623\u064E\u0646\u0652 \u064A\u064F\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0652\u062D\u0650\u062C\u064E\u0627\u0628\u064F\u060C \u0642\u064E\u0627\u0644\u064E\u062A\u0652 \u0639\u064E\u0627\u0626\u0650\u0634\u064E\u0629\u064F: \u0641\u064E\u0623\u064F\u0646\u0652\u0632\u0650\u0644\u064E \u0627\u0644\u0652\u062D\u0650\u062C\u064E\u0627\u0628\u064F.",
            "fadl": "",
            "action": ""
        },
        "33_56": {
            "title": "\u0627\u0644\u0635\u0644\u0627\u0629 \u0648\u0627\u0644\u0633\u0644\u0627\u0645 \u0639\u0644\u0649 \u062E\u064A\u0631 \u0627\u0644\u0623\u0646\u0627\u0645",
            "sabab": "\u0623\u0645\u0631 \u0645\u0646 \u0627\u0644\u0644\u0647 \u0644\u0644\u0645\u0624\u0645\u0646\u064A\u0646 \u0628\u0627\u0644\u0635\u0644\u0627\u0629 \u0648\u0627\u0644\u0633\u0644\u0627\u0645 \u0639\u0644\u0649 \u0627\u0644\u0646\u0628\u064A \u0628\u0639\u062F \u0625\u062E\u0628\u0627\u0631\u0647 \u0628\u0635\u0644\u0627\u062A\u0647 \u0648\u0645\u0644\u0627\u0626\u0643\u062A\u0647 \u0639\u0644\u064A\u0647 \u062A\u0639\u0638\u064A\u0645\u0627\u064B \u0644\u0642\u062F\u0631\u0647.",
            "fadl": "\u0645\u0646 \u0635\u0644\u0649 \u0639\u0644\u064A\u0647 \u0635\u0644\u0627\u0629 \u0635\u0644\u0649 \u0627\u0644\u0644\u0647 \u0639\u0644\u064A\u0647 \u0628\u0647\u0627 \u0639\u0634\u0631\u0627\u064B\u060C \u0648\u064A\u0643\u0641\u0649 \u0647\u0645\u0647 \u0648\u064A\u063A\u0641\u0631 \u0630\u0646\u0628\u0647.",
            "action": "\u0623\u0643\u062B\u0631 \u0645\u0646 \u0627\u0644\u0635\u0644\u0627\u0629 \u0648\u0627\u0644\u0633\u0644\u0627\u0645 \u0639\u0644\u0649 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0648\u062E\u0627\u0635\u0629 \u064A\u0648\u0645 \u0627\u0644\u062C\u0645\u0639\u0629 \u0648\u0639\u0646\u062F \u0627\u0644\u062F\u0639\u0627\u0621\u060C \u0648\u0627\u0644\u062A\u0632\u0645 \u0628\u0627\u0644\u0635\u064A\u063A \u0627\u0644\u0646\u0628\u0648\u064A\u0629 \u0627\u0644\u0635\u062D\u064A\u062D\u0629."
        },
        "36_77": {
            "title": "\u0627\u0644\u0628\u0639\u062B \u0648\u0627\u0644\u0646\u0634\u0648\u0631",
            "sabab": "\u0646\u0632\u0644\u062A \u0641\u064A \u0623\u0628\u064A \u0628\u0646 \u062E\u0644\u0641 \u0623\u0648 \u0627\u0644\u0639\u0627\u0635 \u0628\u0646 \u0648\u0627\u0626\u0644 \u062D\u064A\u0646 \u062C\u0627\u0621 \u0644\u0644\u0646\u0628\u064A \uFDFA \u0648\u0641\u064A \u064A\u062F\u0647 \u0639\u0638\u0645 \u0631\u0645\u064A\u0645 \u064A\u0641\u062A\u0651\u0647 \u0641\u064A \u0627\u0644\u0647\u0648\u0627\u0621 \u0642\u0627\u0626\u0644\u0627\u064B: \u0623\u062A\u0632\u0639\u0645 \u0623\u0646 \u0627\u0644\u0644\u0647 \u064A\u0628\u0639\u062B \u0647\u0630\u0627\u061F",
            "fadl": "",
            "action": "\u0623\u064A\u0642\u0646 \u062A\u0645\u0627\u0645 \u0627\u0644\u064A\u0642\u064A\u0646 \u0628\u0627\u0644\u0628\u0639\u062B \u0648\u0627\u0644\u0645\u0635\u064A\u0631 \u0627\u0644\u0645\u062D\u062A\u0648\u0645\u060C \u0648\u0627\u0633\u062A\u0639\u062F \u0644\u0644\u0648\u0642\u0648\u0641 \u0628\u064A\u0646 \u064A\u062F\u064A \u0627\u0644\u0644\u0647 \u0628\u0635\u0627\u0644\u062D \u0627\u0644\u0623\u0639\u0645\u0627\u0644."
        },
        "36_78": {
            "title": "\u0648\u064E\u0636\u064E\u0631\u064E\u0628\u064E \u0644\u064E\u0646\u064E\u0627 \u0645\u064E\u062B\u064E\u0644\u064B\u0627 \u0648\u064E\u0646\u064E\u0633\u0650\u064A\u064E \u062E\u064E\u0644\u0652\u0642\u064E\u0647\u064F \u06D6 \u0642\u064E\u0627\u0644\u064E \u0645\u064E\u0646\u0652 \u064A\u064F\u062D\u0652\u064A\u0650\u064A \u0627\u0644\u0652\u0639\u0650\u0638\u064E\u0627\u0645\u064E \u0648\u064E\u0647\u0650\u064A\u064E \u0631\u064E\u0645\u0650\u064A\u0645\u064C",
            "sabab": "\u0639\u0646 \u0623\u0628\u064A \u0645\u0627\u0644\u0643 \u0631\u062D\u0645\u0647 \u0627\u0644\u0644\u0647 \u0642\u0627\u0644: \u0623\u0646 \u0623\u064F\u0628\u064E\u064A\u0651\u064E \u0628\u0646 \u062E\u0644\u0641 \u0627\u0644\u062C\u0645\u062D\u064A \u062C\u0627\u0621 \u0625\u0644\u0649 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \uFDFA \u0628\u0639\u0638\u0645 \u062D\u0627\u0626\u0644\u060C \u0641\u0641\u062A\u0647 \u0628\u064A\u0646 \u064A\u062F\u064A\u0647 \u0648\u0642\u0627\u0644: \u064A\u0627 \u0645\u062D\u0645\u062F\u060C \u064A\u0628\u0639\u062B \u0627\u0644\u0644\u0647 \u0647\u0630\u0627 \u0628\u0639\u062F \u0645\u0627 \u0623\u0631\u0645\u061F \u0641\u0642\u0627\u0644: \xab \u0646\u0639\u0645\u060C \u064A\u0628\u0639\u062B \u0627\u0644\u0644\u0647 \u062A\u0639\u0627\u0644\u0649 \u0647\u0630\u0627\u060C \u0648\u064A\u0645\u064A\u062A\u0643 \u062B\u0645 \u064A\u062D\u064A\u064A\u0643\u060C \u062B\u0645 \u064A\u062F\u062E\u0644\u0643 \u0646\u0627\u0631 \u062C\u0647\u0646\u0645 \xbb \u0641\u0646\u0632\u0644\u062A \u0647\u0630\u0647 \u0627\u0644\u0622\u064A\u0629.",
            "fadl": "",
            "action": ""
        },
        "38_1": {
            "title": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u0627\u0644\u0631\u0651\u064E\u062D\u0652\u0645\u064E\u0670\u0646\u0650 \u0627\u0644\u0631\u0651\u064E\u062D\u0650\u064A\u0645\u0650 \u0635 \u06DA \u0648\u064E\u0627\u0644\u0652\u0642\u064F\u0631\u0652\u0622\u0646\u0650 \u0630\u0650\u064A \u0627\u0644\u0630\u0651\u0650\u0643\u0652\u0631\u0650",
            "sabab": "\u0639\u064E\u0646\u0650 \u0627\u0628\u0652\u0646\u0650 \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u0642\u064E\u0627\u0644\u064E: \u0645\u064E\u0631\u0650\u0636\u064E \u0623\u064E\u0628\u064F\u0648 \u0637\u064E\u0627\u0644\u0650\u0628\u064D\u060C \u0641\u064E\u062C\u064E\u0627\u0621\u064E\u062A\u0652\u0647\u064F \u0642\u064F\u0631\u064E\u064A\u0652\u0634\u064C\u060C \u0648\u064E\u062C\u064E\u0627\u0621\u064E\u0647\u064F \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064F \uFDFA \u0648\u064E\u0639\u0650\u0646\u0652\u062F\u064E \u0623\u064E\u0628\u0650\u064A \u0637\u064E\u0627\u0644\u0650\u0628\u064D \u0645\u064E\u062C\u0652\u0644\u0650\u0633\u064F \u0631\u064E\u062C\u064F\u0644\u064D\u060C \u0641\u064E\u0642\u064E\u0627\u0645\u064E \u0623\u064E\u0628\u064F\u0648 \u062C\u064E\u0647\u0652\u0644\u064D \u0643\u064E\u064A\u0652 \u064A\u064E\u0645\u0652\u0646\u064E\u0639\u064E\u0647\u064F\u060C \u0648\u064E\u0634\u064E\u0643\u064E\u0648\u0652\u0647\u064F \u0625\u0650\u0644\u0649 \u0623\u064E\u0628\u0650\u064A \u0637\u064E\u0627\u0644\u0650\u0628\u064D\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E: \u064A\u064E\u0627 \u0627\u0628\u0652\u0646\u064E \u0623\u064E\u062E\u0650\u064A\u060C \u0645\u064E\u0627 \u062A\u064F\u0631\u0650\u064A\u062F\u064F \u0645\u0650\u0646\u0652 \u0642\u064E\u0648\u0652\u0645\u0650\u0643\u064E\u061F \u0642\u064E\u0627\u0644\u064E: \xab \u0625\u0650\u0646\u0651\u0650\u064A \u0623\u064F\u0631\u0650\u064A\u062F\u064F \u0645\u0650\u0646\u0652\u0647\u064F\u0645\u0652 \u0643\u064E\u0644\u0650\u0645\u064E\u0629\u064B \u0648\u064E\u0627\u062D\u0650\u062F\u064E\u0629\u064B\u060C \u062A\u064E\u062F\u0650\u064A\u0646\u064F \u0644\u064E\u0647\u064F\u0645\u0652 \u0628\u0650\u0647\u064E\u0627 \u0627\u0644\u0652\u0639\u064E\u0631\u064E\u0628\u064F\u060C \u0648\u064E\u062A\u064F\u0624\u064E\u062F\u0651\u0650\u064A \u0625\u0650\u0644\u064E\u064A\u0652\u0647\u0650\u0645\u0652 \u0627\u0644\u0652\u0639\u064E\u062C\u064E\u0645\u064F \u0627\u0644\u0652\u062C\u0650\u0632\u0652\u064A\u064E\u0629\u064E \xbb \u0642\u064E\u0627\u0644\u064E: \u0643\u064E\u0644\u0650\u0645\u064E\u0629\u064B \u0648\u064E\u0627\u062D\u0650\u062F\u064E\u0629\u061F \u0642\u064E\u0627\u0644\u064E: \xab \u0643\u064E\u0644\u0650\u0645\u064E\u0629\u064B \u0648\u064E\u0627\u062D\u0650\u062F\u064E\u0629\u064B \xbb. \u0642\u064E\u0627\u0644\u064E: \xab \u064A\u064E\u0627 \u0639\u064E\u0645\u0651\u0650\u060C \u0642\u064F\u0648\u0644\u064F\u0648\u0627 \u0644\u064E\u0627 \u0625\u0650\u0644\u064E\u0647\u064E \u0625\u0650\u0644\u0651\u064E\u0627 \u0627\u0644\u0644\u0647 \xbb \u0641\u064E\u0642\u064E\u0627\u0644\u064F\u0648\u0627: \u0625\u0650\u0644\u064E\u0647\u064E\u0627\u064B \u0648\u064E\u0627\u062D\u0650\u062F\u0627\u064B\u061F \u0645\u064E\u0627 \u0633\u064E\u0645\u0650\u0639\u0652\u0646\u064E\u0627 \u0628\u0650\u0647\u064E\u0630\u064E\u0627 \u0641\u0650\u064A \u0627\u0644\u0652\u0645\u0650\u0644\u0651\u064E\u0629\u0650 \u0627\u0644\u0652\u0622\u062E\u0650\u0631\u064E\u0629\u0650 \u0625\u0650\u0646\u0652 \u0647\u064E\u0630\u064E\u0627 \u0625\u0650\u0644\u0651\u064E\u0627 \u0627\u062E\u0652\u062A\u0650\u0644\u064E\u0627\u0642\u064C\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0646\u064E\u0632\u064E\u0644\u064E \u0641\u0650\u064A\u0647\u0650\u0645\u0652 \u0627\u0644\u0652\u0642\u064F\u0631\u0652\u0622\u0646\u064F: { \u0635\u0653 \u06DA \u0648\u064E\u0671\u0644\u0652\u0642\u064F\u0631\u0652\u0621\u064E\u0627\u0646\u0650 \u0630\u0650\u0649 \u0671\u0644\u0630\u0651\u0650\u0643\u0652\u0631\u0650 \uFD3F\u0661\uFD3E \u0628\u064E\u0644\u0650 \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0643\u064E\u0641\u064E\u0631\u064F\u0648\u0627\u06DF \u0641\u0650\u0649 \u0639\u0650\u0632\u0651\u064E\u0629\u064D \u0648\u064E\u0634\u0650\u0642\u064E\u0627\u0642\u064D \uFD3F\u0662\uFD3E } \u0625\u0650\u0644\u064E\u0649 \u0642\u064E\u0648\u0652\u0644\u0650\u0647\u0650 { \u0645\u064E\u0627 \u0633\u064E\u0645\u0650\u0639\u0652\u0646\u064E\u0627 \u0628\u0650\u0647\u064E\u0640\u0670\u0630\u064E\u0627 \u0641\u0650\u0649 \u0671\u0644\u0652\u0645\u0650\u0644\u0651\u064E\u0629\u0650 \u0671\u0644\u0652\u0640\u0654\u064E\u0627\u062E\u0650\u0631\u064E\u0629\u0650 \u0625\u0650\u0646\u0652 \u0647\u064E\u0640\u0670\u0630\u064E\u0627\u0653 \u0625\u0650\u0644\u0651\u064E\u0627 \u0671\u062E\u0652\u062A\u0650\u0644\u064E\u0640\u0670\u0642\u064C \uFD3F\u0667\uFD3E }.",
            "fadl": "",
            "action": ""
        },
        "38_2": {
            "title": "\u0628\u064E\u0644\u0650 \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0643\u064E\u0641\u064E\u0631\u064F\u0648\u0627 \u0641\u0650\u064A \u0639\u0650\u0632\u0651\u064E\u0629\u064D \u0648\u064E\u0634\u0650\u0642\u064E\u0627\u0642\u064D",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 1 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
            "fadl": "",
            "action": ""
        },
        "38_3": {
            "title": "\u0643\u064E\u0645\u0652 \u0623\u064E\u0647\u0652\u0644\u064E\u0643\u0652\u0646\u064E\u0627 \u0645\u0650\u0646\u0652 \u0642\u064E\u0628\u0652\u0644\u0650\u0647\u0650\u0645\u0652 \u0645\u0650\u0646\u0652 \u0642\u064E\u0631\u0652\u0646\u064D \u0641\u064E\u0646\u064E\u0627\u062F\u064E\u0648\u0652\u0627 \u0648\u064E\u0644\u064E\u0627\u062A\u064E \u062D\u0650\u064A\u0646\u064E \u0645\u064E\u0646\u064E\u0627\u0635\u064D",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 1 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
            "fadl": "",
            "action": ""
        },
        "39_23": {
            "title": "\u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0646\u064E\u0632\u0651\u064E\u0644\u064E \u0623\u064E\u062D\u0652\u0633\u064E\u0646\u064E \u0627\u0644\u0652\u062D\u064E\u062F\u0650\u064A\u062B\u0650 \u0643\u0650\u062A\u064E\u0627\u0628\u064B\u0627 \u0645\u064F\u062A\u064E\u0634\u064E\u0627\u0628\u0650\u0647\u064B\u0627 \u0645\u064E\u062B\u064E\u0627\u0646\u0650\u064A\u064E \u062A\u064E\u0642\u0652\u0634\u064E\u0639\u0650\u0631\u0651\u064F \u0645\u0650\u0646\u0652\u0647\u064F \u062C\u064F\u0644\u064F\u0648\u062F\u064F \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u064A\u064E\u062E\u0652\u0634\u064E\u0648\u0652\u0646\u064E \u0631\u064E\u0628\u0651\u064E\u0647\u064F\u0645\u0652 \u062B\u064F\u0645\u0651\u064E \u062A\u064E\u0644\u0650\u064A\u0646\u064F \u062C\u064F\u0644\u064F\u0648\u062F\u064F\u0647\u064F\u0645\u0652 \u0648\u064E\u0642\u064F\u0644\u064F\u0648\u0628\u064F\u0647\u064F\u0645\u0652 \u0625\u0650\u0644\u064E\u0649\u0670 \u0630\u0650\u0643\u0652\u0631\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u06DA \u0630\u064E\u0670\u0644\u0650\u0643\u064E \u0647\u064F\u062F\u064E\u0649 \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u064A\u064E\u0647\u0652\u062F\u0650\u064A \u0628\u0650\u0647\u0650 \u0645\u064E\u0646\u0652 \u064A\u064E\u0634\u064E\u0627\u0621\u064F \u06DA \u0648\u064E\u0645\u064E\u0646\u0652 \u064A\u064F\u0636\u0652\u0644\u0650\u0644\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0641\u064E\u0645\u064E\u0627 \u0644\u064E\u0647\u064F \u0645\u0650\u0646\u0652 \u0647\u064E\u0627\u062F\u064D",
            "sabab": "\u0639\u0646 \u0633\u0639\u062F \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u0627\u0644: \u0623\u0646\u0632\u0644 \u0639\u0644\u0649 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0627\u0644\u0642\u0631\u0622\u0646\u060C \u0642\u0627\u0644: \u0641\u062A\u0644\u0627\u0647 \u0639\u0644\u064A\u0647\u0645 \u0632\u0645\u0627\u0646\u0627\u060C \u0641\u0642\u0627\u0644\u0648\u0627: \u064A\u0627 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0644\u0648 \u0642\u0635\u0635\u062A \u0639\u0644\u064A\u0646\u0627\u061F \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u0639\u0632 \u0648 \u062C\u0644: { \u0627\u0644\u0653\u0631 \u06DA \u062A\u0650\u0644\u0652\u0643\u064E \u0621\u064E\u0627\u064A\u064E\u0640\u0670\u062A\u064F \u0671\u0644\u0652\u0643\u0650\u062A\u064E\u0640\u0670\u0628\u0650 \u0671\u0644\u0652\u0645\u064F\u0628\u0650\u064A\u0646\u0650 }\u060C \u0625\u0644\u0649 \u0642\u0648\u0644\u0647: { \u0644\u0651\u064E\u0639\u064E\u0644\u0651\u064E\u0643\u064F\u0645\u0652 \u062A\u064E\u0639\u0652\u0642\u0650\u0644\u064F\u0648\u0646\u064E }\u060C \u062B\u0645 \u062A\u0644\u0627\u0647 \u0639\u064A\u0647\u0645 \u0632\u0645\u0627\u0646\u0627\u060C \u0641\u0642\u0627\u0644\u0648\u0627: \u064A\u0627 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647\u060C \u0644\u0648 \u062D\u062F\u062B\u062A\u0646\u0627. \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u0639\u0632 \u0648 \u062C\u0644: { \u0671\u0644\u0644\u0651\u064E\u0647\u064F \u0646\u064E\u0632\u0651\u064E\u0644\u064E \u0623\u064E\u062D\u0652\u0633\u064E\u0646\u064E \u0671\u0644\u0652\u062D\u064E\u062F\u0650\u064A\u062B\u0650 } \u0627\u0644\u0622\u064A\u0629 \u0648\u0630\u0643\u0631 \u0627\u0644\u062D\u062F\u064A\u062B.",
            "fadl": "",
            "action": ""
        },
        "39_53": {
            "title": "\u064A\u0627 \u0639\u0628\u0627\u062F\u064A \u0627\u0644\u0630\u064A\u0646 \u0623\u0633\u0631\u0641\u0648\u0627 \u0639\u0644\u0649 \u0623\u0646\u0641\u0633\u0647\u0645",
            "sabab": "\u0639\u0646 \u0639\u0645\u0631 \u0628\u0646 \u0627\u0644\u062E\u0637\u0627\u0628 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u0627\u0644: \u0644\u0645\u0627 \u0627\u062C\u062A\u0645\u0639\u0646\u0627 \u0644\u0644\u0647\u062C\u0631\u0629 \u0627\u062A\u0639\u062F\u062A \u0623\u0646\u0627 \u0648\u0639\u064A\u0627\u0634 \u0628\u0646 \u0623\u0628\u064A \u0631\u0628\u064A\u0639\u0629 \u0648\u0647\u0634\u0627\u0645 \u0628\u0646 \u0627\u0644\u0639\u0627\u0635 \u0627\u0644\u0645\u064A\u0636\u0623\u0629\u060C \u0645\u064A\u0636\u0623\u0629 \u0628\u0646\u064A \u063A\u0641\u0627\u0631 \u0641\u0648\u0642 \u0634\u0631\u0641\u060C \u0648\u0642\u0644\u0646\u0627: \u0623\u064A\u0643\u0645 \u0644\u0645 \u064A\u0635\u0628\u062D \u0639\u0646\u062F\u0647\u0627 \u0641\u0642\u062F \u0627\u062D\u062A\u0628\u0633\u060C \u0641\u0644\u064A\u0645\u0636 \u0635\u0627\u062D\u0628\u0647\u060C \u0641\u062D\u0628\u0633 \u0639\u0646\u0627 \u0647\u0634\u0627\u0645 \u0628\u0646 \u0627\u0644\u0639\u0627\u0635\u060C \u0641\u0644\u0645\u0627 \u0642\u062F\u0645\u0646\u0627 \u0645\u0646\u0632\u0644\u0646\u0627 \u0641\u064A \u0628\u0646\u064A \u0639\u0645\u0631\u0648 \u0628\u0646 \u0639\u0648\u0641\u060C \u0648\u062E\u0631\u062C \u0623\u0628\u0648 \u062C\u0647\u0644 \u0628\u0646 \u0647\u0634\u0627\u0645\u060C \u0648\u0627\u0644\u062D\u0631\u062B \u0628\u0646 \u0647\u0634\u0627\u0645\u060C \u0625\u0644\u0649 \u0639\u064A\u0627\u0634 \u0628\u0646 \u0623\u0628\u064A \u0631\u0628\u064A\u0639\u0629\u060C \u0648\u0643\u0627\u0646 \u0627\u0628\u0646 \u0639\u0645\u0647\u0645\u0627\u060C \u0648\u0623\u062E\u0627\u0647\u0645\u0627 \u0644\u0623\u0645\u0647\u0645\u0627\u060C \u062D\u062A\u0649 \u0642\u062F\u0645\u0627 \u0639\u0644\u064A\u0646\u0627 \u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0641\u0643\u0644\u0645\u0627\u0647\u060C \u0641\u0642\u0627\u0644\u0627 \u0644\u0647: \u0625\u0646 \u0623\u0645\u0643 \u0646\u0630\u0631\u062A \u0623\u0646 \u0644\u0627 \u062A\u0645\u0633 \u0631\u0623\u0633\u0647\u0627 \u0645\u0634\u0637 \u062D\u062A\u0649 \u062A\u0631\u0627\u0643. \u0641\u0631\u0642 \u0644\u0647\u0627.\n\n\u0641\u0642\u0644\u062A \u0644\u0647: \u064A\u0627 \u0639\u064A\u0627\u0634 \u0648\u0627\u0644\u0644\u0647 \u0625\u0646 \u064A\u0631\u062F\u0643 \u0627\u0644\u0642\u0648\u0645 \u0625\u0644\u0627 \u0639\u0646 \u062F\u064A\u0646\u0643\u060C \u0641\u0627\u062D\u0630\u0631\u0647\u0645\u060C \u0641\u0648\u0627\u0644\u0644\u0647 \u0644\u0648 \u0642\u062F \u0622\u0630\u0649 \u0623\u0645\u0643 \u0627\u0644\u0642\u0645\u0644 \u0644\u0627\u0645\u062A\u0634\u0637\u062A\u060C \u0648\u0644\u0648 \u0642\u062F \u0627\u0634\u062A\u062F \u0639\u0644\u064A\u0647\u0627 \u062D\u0631 \u0645\u0643\u0629 \u0623\u062D\u0633\u0628\u0647 \u0642\u0627\u0644 \u0644\u0627\u0645\u062A\u0634\u0637\u062A\u060C \u0642\u0627\u0644: \u0625\u0646 \u0644\u064A \u0647\u0646\u0627\u0643 \u0645\u0627\u0644\u0627\u064B \u0641\u0623\u062E\u0630\u0647\u061F\u060C \u0642\u0627\u0644 \u0642\u0644\u062A: \u0648\u0627\u0644\u0644\u0647 \u0625\u0646\u0643 \u0644\u062A\u0639\u0644\u0645 \u0623\u0646\u064A \u0645\u0646 \u0623\u0643\u062B\u0631 \u0642\u0631\u064A\u0634 \u0645\u0627\u0644\u0627\u064B \u0641\u0644\u0643 \u0646\u0635\u0641 \u0645\u0627\u0644\u064A\u060C \u0648\u0644\u0627 \u062A\u0630\u0647\u0628 \u0645\u0639\u0647\u0645\u0627\u060C \u0641\u0623\u0628\u0649 \u0625\u0644\u0627 \u064A\u062E\u0631\u062C \u0645\u0639\u0647\u0645\u0627\u060C \u0641\u0642\u0644\u062A \u0644\u0647 \u0644\u0645\u0627 \u0623\u0628\u0649 \u0639\u0644\u064A: \u0623\u0645\u0627 \u0625\u0630 \u0641\u0639\u0644\u062A \u0645\u0627 \u0641\u0639\u0644\u062A \u0641\u062E\u0630 \u0646\u0627\u0642\u062A\u064A \u0647\u0630\u0647\u060C \u0641\u0625\u0646\u0647\u0627 \u0646\u0627\u0642\u0629 \u0630\u0644\u0648\u0644 \u0641\u0627\u0644\u0632\u0645 \u0638\u0647\u0631\u0647\u0627\u060C \u0641\u0625\u0646 \u0631\u0627\u0628\u0643 \u0645\u0646 \u0627\u0644\u0642\u0648\u0645 \u0631\u064A\u0628 \u0641\u0623\u0646\u062E \u0639\u0644\u064A\u0647\u0627\u060C \u0641\u062E\u0631\u062C \u0645\u0639\u0647\u0645\u0627 \u0639\u0644\u064A\u0647\u0627\u060C \u062D\u062A\u0649 \u0625\u0630\u0627 \u0643\u0627\u0646\u0648\u0627 \u0628\u0628\u0639\u0636 \u0627\u0644\u0637\u0631\u064A\u0642\u060C \u0642\u0627\u0644 \u0623\u0628\u0648 \u062C\u0647\u0644 \u0628\u0646 \u0647\u0634\u0627\u0645: \u0648\u0627\u0644\u0644\u0647 \u0644\u0642\u062F \u0627\u0633\u062A\u0628\u0637\u0623\u062A \u0628\u0639\u064A\u0631\u064A \u0647\u0630\u0627\u060C \u0623\u0641\u0644\u0627 \u062A\u062D\u0645\u0644\u0646\u064A \u0639\u0644\u0649 \u0646\u0627\u0642\u062A\u0643 \u0647\u0630\u0647\u061F \u0642\u0627\u0644: \u0628\u0644\u0649\u060C \u0641\u0623\u0646\u0627\u062E \u0648\u0623\u0646\u0627\u062E\u0627 \u0644\u064A\u062A\u062D\u0648\u0644 \u0639\u0644\u064A\u0647\u0627\u060C \u0641\u0644\u0645\u0627 \u0627\u0633\u062A\u0648\u0648\u0627 \u0628\u0627\u0644\u0623\u0631\u0636 \u0639\u062F\u064A\u0627 \u0639\u0644\u064A\u0647 \u0641\u0623\u0648\u062B\u0642\u0627\u0647\u060C \u062B\u0645 \u0623\u062F\u062E\u0644\u0627\u0647 \u0645\u0643\u0629\u060C \u0648\u0641\u062A\u0646\u0627\u0647 \u0641\u0627\u0641\u062A\u062A\u0646.\n\n\u0642\u0627\u0644: \u0641\u0643\u0646\u0627 \u0646\u0642\u0648\u0644: \u0648\u0627\u0644\u0644\u0647 \u0644\u0627 \u064A\u0642\u0628\u0644 \u0627\u0644\u0644\u0647 \u0645\u0645\u0646 \u0627\u0641\u062A\u062A\u0646 \u0635\u0631\u0641\u0627\u064B \u0648\u0644\u0627 \u0639\u062F\u0644\u0627\u064B\u060C \u0648\u0644\u0627 \u064A\u0642\u0628\u0644 \u062A\u0648\u0628\u0629 \u0642\u0648\u0645 \u0639\u0631\u0641\u0648\u0627 \u0627\u0644\u0644\u0647 \u062B\u0645 \u0631\u062C\u0639\u0648\u0627 \u0625\u0644\u0649 \u0627\u0644\u0643\u0641\u0631 \u0644\u0628\u0644\u0627\u0621 \u0623\u0635\u0627\u0628\u0647\u0645\u060C \u0642\u0627\u0644: \u0648\u0643\u0627\u0646\u0648\u0627 \u064A\u0642\u0648\u0644\u0648\u0646 \u0630\u0644\u0643 \u0644\u0623\u0646\u0641\u0633\u0647\u0645\u060C \u0641\u0644\u0645\u0627 \u0642\u062F\u0645 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \uFDFA \u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u0639\u0632 \u0648 \u062C\u0644 \u0641\u064A\u0647\u0645 \u0648\u0641\u064A \u0642\u0648\u0644\u0646\u0627 \u0644\u0647\u0645 \u0648\u0642\u0648\u0644\u0647\u0645 \u0644\u0623\u0646\u0641\u0633\u0647\u0645: { \u064A\u064E\u0640\u0670\u0639\u0650\u0628\u064E\u0627\u062F\u0650\u0649\u064E \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0623\u064E\u0633\u0652\u0631\u064E\u0641\u064F\u0648\u0627\u06DF \u0639\u064E\u0644\u064E\u0649\u0670\u0653 \u0623\u064E\u0646\u0641\u064F\u0633\u0650\u0647\u0650\u0645\u0652 \u0644\u064E\u0627 \u062A\u064E\u0642\u0652\u0646\u064E\u0637\u064F\u0648\u0627\u06DF \u0645\u0650\u0646 \u0631\u0651\u064E\u062D\u0652\u0645\u064E\u0629\u0650 \u0671\u0644\u0644\u0651\u064E\u0647\u0650 \u06DA \u0625\u0650\u0646\u0651\u064E \u0671\u0644\u0644\u0651\u064E\u0647\u064E \u064A\u064E\u063A\u0652\u0641\u0650\u0631\u064F \u0671\u0644\u0630\u0651\u064F\u0646\u064F\u0648\u0628\u064E \u062C\u064E\u0645\u0650\u064A\u0639\u064B\u0627 \u06DA \u0625\u0650\u0646\u0651\u064E\u0647\u064F\u06E5 \u0647\u064F\u0648\u064E \u0671\u0644\u0652\u063A\u064E\u0641\u064F\u0648\u0631\u064F \u0671\u0644\u0631\u0651\u064E\u062D\u0650\u064A\u0645\u064F } \u0625\u0644\u0640\u0649 \u0642\u0640\u0640\u0640\u0648\u0644\u0640\u0640\u0647: { \u0648\u064E\u0623\u064E\u0646\u062A\u064F\u0645\u0652 \u0644\u064E\u0627 \u062A\u064E\u0634\u0652\u0639\u064F\u0631\u064F\u0648\u0646\u064E }. \u0642\u0627\u0644 \u0639\u0645\u0631: \u0641\u0643\u062A\u0628\u062A\u0647\u0627 \u0641\u064A \u0635\u062D\u064A\u0641\u0629 \u0648\u0628\u0639\u062B\u062A \u0628\u0647\u0627 \u0625\u0644\u0649 \u0647\u0634\u0627\u0645 \u0628\u0646 \u0627\u0644\u0639\u0627\u0635\u060C \u0642\u0627\u0644 \u0647\u0634\u0627\u0645 \u0641\u0644\u0645 \u0623\u0632\u0644 \u0623\u0642\u0631\u0624\u0647\u0627 \u0628\u0630\u064A \u0637\u0648\u0649 \u0623\u0635\u0639\u062F \u0628\u0647\u0627 \u0641\u064A\u0647 \u062D\u062A\u0649 \u0641\u0647\u0645\u062A\u0647\u0627\u060C \u0642\u0627\u0644: \u0641\u0623\u0644\u0642\u064A \u0641\u064A \u0646\u0641\u0633\u064A \u0625\u0646\u0647\u0627 \u0625\u0646\u0645\u0627 \u0646\u0632\u0644\u062A \u0641\u064A\u0646\u0627\u060C \u0648\u0641\u064A\u0645\u0627 \u0643\u0646\u0627 \u0646\u0642\u0648\u0644 \u0641\u064A \u0623\u0646\u0641\u0633\u0646\u0627\u060C \u0648\u064A\u0642\u0627\u0644 \u0641\u064A\u0646\u0627. \u0641\u0631\u062C\u0639\u062A \u0641\u062C\u0644\u0633\u062A \u0639\u0644\u0649 \u0628\u0639\u064A\u0631\u064A\u060C \u0641\u0644\u062D\u0642\u062A \u0628\u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \uFDFA \u0628\u0627\u0644\u0645\u062F\u064A\u0646\u0629.",
            "fadl": "\u0647\u0630\u0647 \u0627\u0644\u0622\u064A\u0629 \u0633\u064A\u062F\u0629 \u0622\u064A\u0627\u062A \u0627\u0644\u0631\u062C\u0627\u0621 \u0641\u064A \u0627\u0644\u0642\u0631\u0622\u0646\u060C \u0646\u0632\u0644\u062A \u0631\u062D\u0645\u0629\u064B \u0628\u0623\u0647\u0644 \u0627\u0644\u0630\u0646\u0648\u0628 \u0648\u0627\u0644\u0645\u0633\u0631\u0641\u064A\u0646 \u0639\u0644\u0649 \u0623\u0646\u0641\u0633\u0647\u0645.",
            "action": "\u0645\u0647\u0645\u0627 \u0639\u0638\u0645 \u0630\u0646\u0628\u0643 \u0644\u0627 \u062A\u064A\u0623\u0633 \u0645\u0646 \u0631\u062D\u0645\u0629 \u0627\u0644\u0644\u0647\u060C \u0641\u0625\u0646 \u0627\u0644\u0644\u0647 \u064A\u063A\u0641\u0631 \u0627\u0644\u0630\u0646\u0648\u0628 \u062C\u0645\u064A\u0639\u0627\u064B \u0644\u0645\u0646 \u062A\u0627\u0628 \u0648\u0623\u0646\u0627\u0628."
        },
        "40_60": {
            "title": "\u0627\u062F\u0639\u0648\u0646\u064A \u0623\u0633\u062A\u062C\u0628 \u0644\u0643\u0645",
            "sabab": "",
            "fadl": "\u0648\u0639\u062F \u0625\u0644\u0647\u064A \u0645\u0637\u0644\u0642 \u0628\u0627\u0644\u0627\u0633\u062A\u062C\u0627\u0628\u0629\u060C \u0648\u062A\u0631\u0643\u064F \u0627\u0644\u062F\u0639\u0627\u0621 \u0627\u0633\u062A\u0643\u0628\u0627\u0631\u0627\u064B \u064A\u0633\u062A\u0648\u062C\u0628 \u062F\u062E\u0648\u0644 \u062C\u0647\u0646\u0645.",
            "action": "\u0644\u0627 \u062A\u062A\u0623\u062E\u0631 \u0641\u064A \u0627\u0644\u062F\u0639\u0627\u0621 \u0648\u0644\u0627 \u062A\u0639\u062C\u0644 \u0641\u064A \u0637\u0644\u0628 \u0627\u0644\u0627\u0633\u062A\u062C\u0627\u0628\u0629. \u0627\u0644\u0644\u0647\u0645 \u0625\u0646\u0643 \u0633\u0645\u064A\u0639 \u0645\u062C\u064A\u0628\u060C \u0623\u062F\u0639\u0648\u0643 \u062B\u0642\u0629\u064B \u0628\u0643 \u0644\u0627 \u0634\u0643\u0627\u064B."
        },
        "41_22": {
            "title": "\u0648\u064E\u0645\u064E\u0627 \u0643\u064F\u0646\u0652\u062A\u064F\u0645\u0652 \u062A\u064E\u0633\u0652\u062A\u064E\u062A\u0650\u0631\u064F\u0648\u0646\u064E \u0623\u064E\u0646\u0652 \u064A\u064E\u0634\u0652\u0647\u064E\u062F\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064F\u0645\u0652 \u0633\u064E\u0645\u0652\u0639\u064F\u0643\u064F\u0645\u0652 \u0648\u064E\u0644\u064E\u0627 \u0623\u064E\u0628\u0652\u0635\u064E\u0627\u0631\u064F\u0643\u064F\u0645\u0652 \u0648\u064E\u0644\u064E\u0627 \u062C\u064F\u0644\u064F\u0648\u062F\u064F\u0643\u064F\u0645\u0652 \u0648\u064E\u0644\u064E\u0670\u0643\u0650\u0646\u0652 \u0638\u064E\u0646\u064E\u0646\u0652\u062A\u064F\u0645\u0652 \u0623\u064E\u0646\u0651\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064E \u0644\u064E\u0627 \u064A\u064E\u0639\u0652\u0644\u064E\u0645\u064F \u0643\u064E\u062B\u0650\u064A\u0631\u064B\u0627 \u0645\u0650\u0645\u0651\u064E\u0627 \u062A\u064E\u0639\u0652\u0645\u064E\u0644\u064F\u0648\u0646\u064E",
            "sabab": "\u0639\u064E\u0646\u0652 \u0639\u064E\u0628\u0652\u062F\u0650 \u0627\u0644\u0644\u0647\u0650 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u064E\u0627\u0644\u064E: \u0627\u062C\u0652\u062A\u064E\u0645\u064E\u0639\u064E \u0639\u0650\u0646\u0652\u062F\u064E \u0627\u0644\u0652\u0628\u064E\u064A\u0652\u062A\u0650 \u0642\u064F\u0631\u064E\u0634\u0650\u064A\u0651\u064E\u0627\u0646\u0650 \u0648\u064E\u062B\u064E\u0642\u064E\u0641\u0650\u064A\u0651\u064C\u060C \u0623\u064E\u0648\u0652 \u062B\u064E\u0642\u064E\u0641\u0650\u064A\u0651\u064E\u0627\u0646\u0650 \u0648\u064E\u0642\u064F\u0631\u064E\u0634\u0650\u064A\u0651\u064C\u060C \u0643\u064E\u062B\u0650\u064A\u0631\u064E\u0629\u064C \u0634\u064E\u062D\u0652\u0645\u064F \u0628\u064F\u0637\u064F\u0648\u0646\u0650\u0647\u0650\u0645\u0652 \u0642\u064E\u0644\u0650\u064A\u0644\u064E\u0629\u064C \u0641\u0650\u0642\u0652\u0647\u064F \u0642\u064F\u0644\u064F\u0648\u0628\u0650\u0647\u0650\u0645\u0652\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0623\u064E\u062D\u064E\u062F\u064F\u0647\u064F\u0645\u0652: \u0623\u064E\u062A\u064E\u0631\u064E\u0648\u0652\u0646\u064E \u0623\u064E\u0646\u0651\u064E \u0627\u0644\u0644\u0647\u064E \u064A\u064E\u0633\u0652\u0645\u064E\u0639\u064F \u0645\u064E\u0627 \u0646\u064E\u0642\u064F\u0648\u0644\u064F\u061F \u0642\u064E\u0627\u0644\u064E \u0627\u0644\u0652\u0622\u062E\u064E\u0631\u064F: \u064A\u064E\u0633\u0652\u0645\u064E\u0639\u064F \u0625\u0650\u0646\u0652 \u062C\u064E\u0647\u064E\u0631\u0652\u0646\u064E\u0627\u060C \u0648\u064E\u0644\u064E\u0627 \u064A\u064E\u0633\u0652\u0645\u064E\u0639\u064F \u0625\u0650\u0646\u0652 \u0623\u064E\u062E\u0652\u0641\u064E\u064A\u0652\u0646\u064E\u0627. \u0648\u064E\u0642\u064E\u0627\u0644\u064E \u0627\u0644\u0652\u0622\u062E\u064E\u0631\u064F: \u0625\u0650\u0646\u0652 \u0643\u064E\u0627\u0646\u064E \u064A\u064E\u0633\u0652\u0645\u064E\u0639\u064F \u0625\u0650\u0630\u064E\u0627 \u062C\u064E\u0647\u064E\u0631\u0652\u0646\u064E\u0627 \u0641\u064E\u0625\u0650\u0646\u0651\u064E\u0647\u064F \u064A\u064E\u0633\u0652\u0645\u064E\u0639\u064F \u0625\u0650\u0630\u064E\u0627 \u0623\u064E\u062E\u0652\u0641\u064E\u064A\u0652\u0646\u064E\u0627\u060C \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0639\u0632 \u0648 \u062C\u0644: { \u0648\u064E\u0645\u064E\u0627 \u0643\u064F\u0646\u062A\u064F\u0645\u0652 \u062A\u064E\u0633\u0652\u062A\u064E\u062A\u0650\u0631\u064F\u0648\u0646\u064E \u0623\u064E\u0646 \u064A\u064E\u0634\u0652\u0647\u064E\u062F\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064F\u0645\u0652 \u0633\u064E\u0645\u0652\u0639\u064F\u0643\u064F\u0645\u0652 \u0648\u064E\u0644\u064E\u0627\u0653 \u0623\u064E\u0628\u0652\u0635\u064E\u0640\u0670\u0631\u064F\u0643\u064F\u0645\u0652 \u0648\u064E\u0644\u064E\u0627 \u062C\u064F\u0644\u064F\u0648\u062F\u064F\u0643\u064F\u0645\u0652 } \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u064E. \u0627\u0644\u0644\u0641\u0638 \u0644\u0644\u0628\u062E\u0627\u0631\u064A.",
            "fadl": "",
            "action": ""
        },
        "43_61": {
            "title": "\u0648\u064E\u0625\u0650\u0646\u0651\u064E\u0647\u064F \u0644\u064E\u0639\u0650\u0644\u0652\u0645\u064C \u0644\u0650\u0644\u0633\u0651\u064E\u0627\u0639\u064E\u0629\u0650 \u0641\u064E\u0644\u064E\u0627 \u062A\u064E\u0645\u0652\u062A\u064E\u0631\u064F\u0646\u0651\u064E \u0628\u0650\u0647\u064E\u0627 \u0648\u064E\u0627\u062A\u0651\u064E\u0628\u0650\u0639\u064F\u0648\u0646\u0650 \u06DA \u0647\u064E\u0670\u0630\u064E\u0627 \u0635\u0650\u0631\u064E\u0627\u0637\u064C \u0645\u064F\u0633\u0652\u062A\u064E\u0642\u0650\u064A\u0645\u064C",
            "sabab": "\u0639\u064E\u0646\u0652 \u0623\u064E\u0628\u0650\u064A \u064A\u064E\u062D\u0652\u064A\u064E\u0649\u060C \u0645\u064E\u0648\u0652\u0644\u064E\u0649 \u0627\u0628\u0652\u0646\u0650 \u0639\u064F\u0642\u064E\u064A\u0652\u0644\u064D \u0627\u0644\u0652\u0623\u064E\u0646\u0652\u0635\u064E\u0627\u0631\u0650\u064A\u0651\u0650\u060C \u0642\u064E\u0627\u0644\u064E: \u0642\u064E\u0627\u0644\u064E \u0627\u0628\u0652\u0646\u064F \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627: \u0644\u064E\u0642\u064E\u062F\u0652 \u0639\u064F\u0644\u0651\u0650\u0645\u0652\u062A\u064F \u0622\u064A\u064E\u0629\u064B \u0645\u0650\u0646\u0652 \u0627\u0644\u0652\u0642\u064F\u0631\u0652\u0622\u0646\u0650 \u0645\u064E\u0627 \u0633\u064E\u0623\u064E\u0644\u064E\u0646\u0650\u064A \u0639\u064E\u0646\u0652\u0647\u064E\u0627 \u0631\u064E\u062C\u064F\u0644\u064C \u0642\u064E\u0637\u0651\u064F\u060C \u0641\u064E\u0645\u064E\u0627 \u0623\u064E\u062F\u0652\u0631\u0650\u064A \u0623\u064E\u0639\u064E\u0644\u0650\u0645\u064E\u0647\u064E\u0627 \u0627\u0644\u0646\u0651\u064E\u0627\u0633\u064F\u060C \u0641\u064E\u0644\u064E\u0645\u0652 \u064A\u064E\u0633\u0652\u0623\u064E\u0644\u064F\u0648\u0627 \u0639\u064E\u0646\u0652\u0647\u064E\u0627\u060C \u0623\u064E\u0645\u0652 \u0644\u064E\u0645\u0652 \u064A\u064E\u0641\u0652\u0637\u0650\u0646\u064F\u0648\u0627 \u0644\u064E\u0647\u064E\u0627 \u0641\u064E\u064A\u064E\u0633\u0652\u0623\u064E\u0644\u064F\u0648\u0627 \u0639\u064E\u0646\u0652\u0647\u064E\u0627!! \u062B\u064F\u0645\u0651\u064E \u0637\u064E\u0641\u0650\u0642\u064E \u064A\u064F\u062D\u064E\u062F\u0651\u0650\u062B\u064F\u0646\u064E\u0627\u060C \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0642\u064E\u0627\u0645\u064E \u062A\u064E\u0644\u064E\u0627\u0648\u064E\u0645\u064F\u0646\u064E\u0627 \u0623\u064E\u0646\u0652 \u0644\u064E\u0627 \u0646\u064E\u0643\u064F\u0648\u0646\u064E \u0633\u064E\u0623\u064E\u0644\u0652\u0646\u064E\u0627\u0647\u064F \u0639\u064E\u0646\u0652\u0647\u064E\u0627\u060C \u0641\u064E\u0642\u064F\u0644\u0652\u062A\u064F: \u0623\u064E\u0646\u064E\u0627 \u0644\u064E\u0647\u064E\u0627 \u0625\u0650\u0630\u064E\u0627 \u0631\u064E\u0627\u062D\u064E \u063A\u064E\u062F\u0627\u064B\u060C \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0631\u064E\u0627\u062D\u064E \u0627\u0644\u0652\u063A\u064E\u062F\u064E\u060C \u0642\u064F\u0644\u0652\u062A\u064F: \u064A\u064E\u0627 \u0627\u0628\u0652\u0646\u064E \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D \u0630\u064E\u0643\u064E\u0631\u0652\u062A\u064E \u0623\u064E\u0645\u0652\u0633\u0650 \u0623\u064E\u0646\u0651\u064E \u0622\u064A\u064E\u0629\u064B \u0645\u0650\u0646\u0652 \u0627\u0644\u0652\u0642\u064F\u0631\u0652\u0622\u0646\u0650 \u0644\u064E\u0645\u0652 \u064A\u064E\u0633\u0652\u0623\u064E\u0644\u064F\u0643\u064E \u0639\u064E\u0646\u0652\u0647\u064E\u0627 \u0631\u064E\u062C\u064F\u0644\u064C \u0642\u064E\u0637\u0651\u064F\u060C \u0641\u064E\u0644\u064E\u0627 \u062A\u064E\u062F\u0652\u0631\u0650\u064A \u0623\u064E\u0639\u064E\u0644\u0650\u0645\u064E\u0647\u064E\u0627 \u0627\u0644\u0646\u0651\u064E\u0627\u0633\u064F \u0641\u064E\u0644\u064E\u0645\u0652 \u064A\u064E\u0633\u0652\u0623\u064E\u0644\u064F\u0648\u0627 \u0639\u064E\u0646\u0652\u0647\u064E\u0627 \u0623\u064E\u0645\u0652 \u0644\u064E\u0645\u0652 \u064A\u064E\u0641\u0652\u0637\u0650\u0646\u064F\u0648\u0627 \u0644\u064E\u0647\u064E\u0627! \u0641\u064E\u0642\u064F\u0644\u0652\u062A\u064F: \u0623\u064E\u062E\u0652\u0628\u0650\u0631\u0652\u0646\u0650\u064A \u0639\u064E\u0646\u0652\u0647\u064E\u0627\u060C \u0648\u064E\u0639\u064E\u0646\u0652 \u0627\u0644\u0644\u0651\u064E\u0627\u062A\u0650\u064A \u0642\u064E\u0631\u064E\u0623\u0652\u062A\u064E \u0642\u064E\u0628\u0652\u0644\u064E\u0647\u064E\u0627! \u0642\u064E\u0627\u0644\u064E: \u0646\u064E\u0639\u064E\u0645\u0652\u060C \u0625\u0650\u0646\u0651\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \uFDFA\u060C \u0642\u064E\u0627\u0644\u064E \u0644\u0650\u0642\u064F\u0631\u064E\u064A\u0652\u0634\u064D: \xab \u064A\u064E\u0627 \u0645\u064E\u0639\u0652\u0634\u064E\u0631\u064E \u0642\u064F\u0631\u064E\u064A\u0652\u0634\u064D \u0625\u0650\u0646\u0651\u064E\u0647\u064F \u0644\u064E\u064A\u0652\u0633\u064E \u0623\u064E\u062D\u064E\u062F\u064C \u064A\u064F\u0639\u0652\u0628\u064E\u062F\u064F \u0645\u0650\u0646\u0652 \u062F\u064F\u0648\u0646\u0650 \u0627\u0644\u0644\u0647\u0650 \u0641\u0650\u064A\u0647\u0650 \u062E\u064E\u064A\u0652\u0631\u064C \xbb \u0648\u064E\u0642\u064E\u062F\u0652 \u0639\u064E\u0644\u0650\u0645\u0652\u062A\u0652 \u0642\u064F\u0631\u064E\u064A\u0652\u0634\u064C \u0623\u064E\u0646\u0651\u064E \u0627\u0644\u0646\u0651\u064E\u0635\u064E\u0627\u0631\u064E\u0649 \u062A\u064E\u0639\u0652\u0628\u064F\u062F\u064F \u0639\u0650\u064A\u0633\u064E\u0649 \u0627\u0628\u0652\u0646\u064E \u0645\u064E\u0631\u0652\u064A\u064E\u0645\u064E\u060C \u0648\u064E\u0645\u064E\u0627 \u062A\u064E\u0642\u064F\u0648\u0644\u064F \u0641\u0650\u064A \u0645\u064F\u062D\u064E\u0645\u0651\u064E\u062F\u064D\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064F\u0648\u0627: \u064A\u064E\u0627 \u0645\u064F\u062D\u064E\u0645\u0651\u064E\u062F\u064F \u0623\u064E\u0644\u064E\u0633\u0652\u062A\u064E \u062A\u064E\u0632\u0652\u0639\u064F\u0645\u064F \u0623\u064E\u0646\u0651\u064E \u0639\u0650\u064A\u0633\u064E\u0649 \u0643\u064E\u0627\u0646\u064E \u0646\u064E\u0628\u0650\u064A\u0651\u064B\u0627 \u0648\u064E\u0639\u064E\u0628\u0652\u062F\u0627\u064B \u0645\u0650\u0646\u0652 \u0639\u0650\u0628\u064E\u0627\u062F\u0650 \u0627\u0644\u0644\u0647\u0650 \u0635\u064E\u0627\u0644\u0650\u062D\u0627\u064B\u060C \u0641\u064E\u0644\u064E\u0626\u0650\u0646\u0652 \u0643\u064F\u0646\u0652\u062A\u064E \u0635\u064E\u0627\u062F\u0650\u0642\u0627\u064B \u0641\u064E\u0625\u0650\u0646\u0651\u064E \u0622\u0644\u0650\u0647\u064E\u062A\u064E\u0647\u064F\u0645\u0652 \u0644\u064E\u0643\u064E\u0645\u064E\u0627 \u062A\u064E\u0642\u064F\u0648\u0644\u064F\u0648\u0646\u064E \u0642\u064E\u0627\u0644\u064E \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0639\u0632 \u0648 \u062C\u0644: { \u06DE \u0648\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0636\u064F\u0631\u0650\u0628\u064E \u0671\u0628\u0652\u0646\u064F \u0645\u064E\u0631\u0652\u064A\u064E\u0645\u064E \u0645\u064E\u062B\u064E\u0644\u064B\u0627 \u0625\u0650\u0630\u064E\u0627 \u0642\u064E\u0648\u0652\u0645\u064F\u0643\u064E \u0645\u0650\u0646\u0652\u0647\u064F \u064A\u064E\u0635\u0650\u062F\u0651\u064F\u0648\u0646\u064E \uFD3F\u0665\u0667\uFD3E } \u0642\u064E\u0627\u0644\u064E: \u0642\u064F\u0644\u0652\u062A\u064F: \u0645\u064E\u0627 \u064A\u064E\u0635\u0650\u062F\u0651\u064F\u0648\u0646\u064E\u061F \u0642\u064E\u0627\u0644\u064E: \u064A\u064E\u0636\u0650\u062C\u0651\u064F\u0648\u0646\u064E\u060C { \u0648\u064E\u0625\u0650\u0646\u0651\u064E\u0647\u064F\u06E5 \u0644\u064E\u0639\u0650\u0644\u0652\u0645\u064C \u0644\u0651\u0650\u0644\u0633\u0651\u064E\u0627\u0639\u064E\u0629\u0650 } \u0642\u064E\u0627\u0644\u064E: \u0647\u064F\u0648\u064E \u062E\u064F\u0631\u064F\u0648\u062C\u064F \u0639\u0650\u064A\u0633\u064E\u0649 \u0627\u0628\u0652\u0646\u0650 \u0645\u064E\u0631\u0652\u064A\u064E\u0645\u064E \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645\u060C \u0642\u064E\u0628\u0652\u0644\u064E \u064A\u064E\u0648\u0652\u0645\u0650 \u0627\u0644\u0652\u0642\u0650\u064A\u064E\u0627\u0645\u064E\u0629\u0650.",
            "fadl": "",
            "action": ""
        },
        "44_10": {
            "title": "\u0641\u064E\u0627\u0631\u0652\u062A\u064E\u0642\u0650\u0628\u0652 \u064A\u064E\u0648\u0652\u0645\u064E \u062A\u064E\u0623\u0652\u062A\u0650\u064A \u0627\u0644\u0633\u0651\u064E\u0645\u064E\u0627\u0621\u064F \u0628\u0650\u062F\u064F\u062E\u064E\u0627\u0646\u064D \u0645\u064F\u0628\u0650\u064A\u0646\u064D",
            "sabab": "\u0639\u064E\u0646\u0652 \u0645\u064E\u0633\u0652\u0631\u064F\u0648\u0642\u064D \u0642\u064E\u0627\u0644\u064E: \u0642\u064E\u0627\u0644\u064E \u0639\u064E\u0628\u0652\u062F\u064F \u0627\u0644\u0644\u0647\u0650 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647: \u0625\u0650\u0646\u0651\u064E\u0645\u064E\u0627 \u0643\u064E\u0627\u0646\u064E \u0647\u064E\u0630\u064E\u0627\u060C \u0644\u0650\u0623\u064E\u0646\u0651\u064E \u0642\u064F\u0631\u064E\u064A\u0652\u0634\u064B\u0627 \u0644\u064E\u0645\u0651\u064E\u0627 \u0627\u0633\u0652\u062A\u064E\u0639\u0652\u0635\u064E\u0648\u0652\u0627 \u0639\u064E\u0644\u064E\u0649 \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u0650 \uFDFA \u062F\u064E\u0639\u064E\u0627 \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650\u0645\u0652 \u0628\u0650\u0633\u0650\u0646\u0650\u064A\u0646\u064E \u0643\u064E\u0633\u0650\u0646\u0650\u064A \u064A\u064F\u0648\u0633\u064F\u0641\u064E\u060C \u0641\u064E\u0623\u064E\u0635\u064E\u0627\u0628\u064E\u0647\u064F\u0645\u0652 \u0642\u064E\u062D\u0652\u0637\u064C \u0648\u064E\u062C\u064E\u0647\u0652\u062F\u064C \u062D\u064E\u062A\u0651\u064E\u0649 \u0623\u064E\u0643\u064E\u0644\u064F\u0648\u0627 \u0627\u0644\u0652\u0639\u0650\u0638\u064E\u0627\u0645\u064E\u060C \u0641\u064E\u062C\u064E\u0639\u064E\u0644\u064E \u0627\u0644\u0631\u0651\u064E\u062C\u064F\u0644\u064F \u064A\u064E\u0646\u0652\u0638\u064F\u0631\u064F \u0625\u0650\u0644\u064E\u0649 \u0627\u0644\u0633\u0651\u064E\u0645\u064E\u0627\u0621\u0650 \u0641\u064E\u064A\u064E\u0631\u0649 \u0645\u064E\u0627 \u0628\u064E\u064A\u0652\u0646\u064E\u0647\u064F \u0648\u064E\u0628\u064E\u064A\u0652\u0646\u064E\u0647\u064E\u0627 \u0643\u064E\u0647\u064E\u064A\u0652\u0626\u064E\u0629\u0650 \u0627\u0644\u062F\u0651\u064F\u062E\u064E\u0627\u0646\u0650 \u0645\u0650\u0646\u064E \u0627\u0644\u0652\u062C\u064E\u0647\u0652\u062F\u0650\u060C \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u062A\u064E\u0639\u064E\u0627\u0644\u064E\u0649 { \u0641\u064E\u0671\u0631\u0652\u062A\u064E\u0642\u0650\u0628\u0652 \u064A\u064E\u0648\u0652\u0645\u064E \u062A\u064E\u0623\u0652\u062A\u0650\u0649 \u0671\u0644\u0633\u0651\u064E\u0645\u064E\u0627\u0653\u0621\u064F \u0628\u0650\u062F\u064F\u062E\u064E\u0627\u0646\u064D \u0645\u0651\u064F\u0628\u0650\u064A\u0646\u064D \uFD3F\u0661\u0660\uFD3E } { \u064A\u064E\u063A\u0652\u0634\u064E\u0649 \u0671\u0644\u0646\u0651\u064E\u0627\u0633\u064E \u06D6 \u0647\u064E\u0640\u0670\u0630\u064E\u0627 \u0639\u064E\u0630\u064E\u0627\u0628\u064C \u0623\u064E\u0644\u0650\u064A\u0645\u064C \uFD3F\u0661\u0661\uFD3E } \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0623\u064F\u062A\u0650\u064A\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0641\u064E\u0642\u0650\u064A\u0644\u064E \u0644\u064E\u0647\u064F: \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650\u060C \u0627\u0633\u0652\u062A\u064E\u0633\u0652\u0642\u0650 \u0627\u0644\u0644\u0647\u064E \u0644\u0650\u0645\u064F\u0636\u064E\u0631\u064E\u060C \u0641\u064E\u0625\u0650\u0646\u0651\u064E\u0647\u064E\u0627 \u0642\u064E\u062F\u0652 \u0647\u064E\u0644\u064E\u0643\u064E\u062A\u0652. \u0642\u064E\u0627\u0644\u064E: \xab \u0644\u0650\u0645\u064F\u0636\u064E\u0631\u064E\u061F \u0625\u0650\u0646\u0651\u064E\u0643\u064E \u0644\u064E\u062C\u064E\u0631\u0650\u064A\u0621\u064C \xbb. \u0641\u064E\u0627\u0633\u0652\u062A\u064E\u0633\u0652\u0642\u064E\u0649 \u0644\u064E\u0647\u064F\u0645\u0652 \u0641\u064E\u0633\u064F\u0642\u064F\u0648\u0627\u060C \u0641\u064E\u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652: { \u0625\u0650\u0646\u0651\u064E\u0643\u064F\u0645\u0652 \u0639\u064E\u0627\u0653\u0626\u0650\u062F\u064F\u0648\u0646\u064E } \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0623\u064E\u0635\u064E\u0627\u0628\u064E\u062A\u0652\u0647\u064F\u0645\u064F \u0627\u0644\u0631\u0651\u064E\u0641\u064E\u0627\u0647\u0650\u064A\u064E\u0629\u064F \u0639\u064E\u0627\u062F\u064F\u0648\u0627 \u0625\u0650\u0644\u064E\u0649 \u062D\u064E\u0627\u0644\u0650\u0647\u0650\u0645\u0652 \u062D\u0650\u064A\u0646\u064E \u0623\u064E\u0635\u064E\u0627\u0628\u064E\u062A\u0652\u0647\u064F\u0645\u064F \u0627\u0644\u0631\u0651\u064E\u0641\u064E\u0627\u0647\u0650\u064A\u064E\u0629\u064F \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0639\u0632 \u0648 \u062C\u0644 \u064A\u064E\u0648\u0652\u0645\u064E { \u064A\u064E\u0648\u0652\u0645\u064E \u0646\u064E\u0628\u0652\u0637\u0650\u0634\u064F \u0671\u0644\u0652\u0628\u064E\u0637\u0652\u0634\u064E\u0629\u064E \u0671\u0644\u0652\u0643\u064F\u0628\u0652\u0631\u064E\u0649\u0670\u0653 \u0625\u0650\u0646\u0651\u064E\u0627 \u0645\u064F\u0646\u062A\u064E\u0642\u0650\u0645\u064F\u0648\u0646\u064E \uFD3F\u0661\u0666\uFD3E }. \u0642\u064E\u0627\u0644\u064E \u064A\u064E\u0639\u0652\u0646\u0650\u064A \u064A\u064E\u0648\u0652\u0645\u064E \u0628\u064E\u062F\u0652\u0631\u064D. \n\n\u0648\u0641\u064A \u0644\u0641\u0638 \u0644\u0623\u062D\u0645\u062F \u0641\u064A \u0627\u0644\u0645\u0633\u0646\u062F: \u0639\u064E\u0646\u0652 \u0645\u064E\u0633\u0652\u0631\u064F\u0648\u0642\u064D \u0631\u062D\u0645\u0647 \u0627\u0644\u0644\u0647 \u0642\u064E\u0627\u0644\u064E: \u062C\u064E\u0627\u0621\u064E \u0631\u064E\u062C\u064F\u0644\u064C \u0625\u0650\u0644\u064E\u0649 \u0639\u064E\u0628\u0652\u062F\u0650 \u0627\u0644\u0644\u0647\u0650 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0641\u064E\u0642\u064E\u0627\u0644\u064E: \u0625\u0650\u0646\u0651\u0650\u064A \u062A\u064E\u0631\u064E\u0643\u0652\u062A\u064F \u0641\u0650\u064A \u0627\u0644\u0652\u0645\u064E\u0633\u0652\u062C\u0650\u062F\u0650 \u0631\u064E\u062C\u064F\u0644\u064B\u0627 \u064A\u064F\u0641\u064E\u0633\u0651\u0650\u0631\u064F \u0627\u0644\u0652\u0642\u064F\u0631\u0652\u0622\u0646\u064E \u0628\u0650\u0631\u064E\u0623\u0652\u064A\u0650\u0647\u0650\u060C \u064A\u064E\u0642\u064F\u0648\u0644\u064F \u0641\u0650\u064A \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u0650: { \u064A\u064E\u0648\u0652\u0645\u064E \u062A\u064E\u0623\u0652\u062A\u0650\u0649 \u0671\u0644\u0633\u0651\u064E\u0645\u064E\u0627\u0653\u0621\u064F \u0628\u0650\u062F\u064F\u062E\u064E\u0627\u0646\u064D \u0645\u0651\u064F\u0628\u0650\u064A\u0646\u064D } \u0625\u0650\u0644\u064E\u0649 \u0622\u062E\u0650\u0631\u0650\u0647\u064E\u0627 \u064A\u064E\u063A\u0652\u0634\u064E\u0627\u0647\u064F\u0645\u0652 \u064A\u064E\u0648\u0652\u0645\u064E \u0627\u0644\u0652\u0642\u0650\u064A\u064E\u0627\u0645\u064E\u0629\u0650\u060C \u062F\u064F\u062E\u064E\u0627\u0646\u064C \u064A\u064E\u0623\u0652\u062E\u064F\u0630\u064F \u0628\u0650\u0623\u064E\u0646\u0652\u0641\u064E\u0627\u0633\u0650\u0647\u0650\u0645\u0652 \u062D\u064E\u062A\u0651\u064E\u0649 \u064A\u064F\u0635\u0650\u064A\u0628\u064E\u0647\u064F\u0645\u0652 \u0645\u0650\u0646\u0652\u0647\u064F \u0643\u064E\u0647\u064E\u064A\u0652\u0626\u064E\u0629\u0650 \u0627\u0644\u0632\u0651\u064F\u0643\u064E\u0627\u0645\u0650! \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0639\u064E\u0628\u0652\u062F\u064F \u0627\u0644\u0644\u0647\u0650: \u0645\u064E\u0646\u0652 \u0639\u064E\u0644\u0650\u0645\u064E \u0639\u0650\u0644\u0652\u0645\u0627\u064B \u0641\u064E\u0644\u0652\u064A\u064E\u0642\u064F\u0644\u0652 \u0628\u0650\u0647\u0650\u060C \u0648\u064E\u0645\u064E\u0646\u0652 \u0644\u064E\u0645\u0652 \u064A\u064E\u0639\u0652\u0644\u064E\u0645\u0652\u060C \u0641\u064E\u0644\u0652\u064A\u064E\u0642\u064F\u0644\u0652: \u0627\u0644\u0644\u0647\u064F \u0623\u064E\u0639\u0652\u0644\u064E\u0645\u064F. \u0641\u064E\u0625\u0650\u0646\u0651\u064E \u0645\u0650\u0646\u0652 \u0641\u0650\u0642\u0652\u0647\u0650 \u0627\u0644\u0631\u0651\u064E\u062C\u064F\u0644\u0650\u060C \u0623\u064E\u0646\u0652 \u064A\u064E\u0642\u064F\u0648\u0644\u064E \u0644\u0650\u0645\u064E\u0627 \u0644\u064E\u0627 \u064A\u064E\u0639\u0652\u0644\u064E\u0645\u064F\u060C \u0627\u0644\u0644\u0647\u064F \u0623\u064E\u0639\u0652\u0644\u064E\u0645\u064F. \u0625\u0650\u0646\u0651\u064E\u0645\u064E\u0627 \u0643\u064E\u0627\u0646\u064E \u0647\u064E\u0630\u064E\u0627\u060C \u0644\u0650\u0623\u064E\u0646\u0651\u064E \u0642\u064F\u0631\u064E\u064A\u0652\u0634\u0627\u064B \u0644\u064E\u0645\u0651\u064E\u0627 \u0627\u0633\u0652\u062A\u064E\u0639\u0652\u0635\u064E\u062A\u0652 \u0639\u064E\u0644\u064E\u0649 \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u0650 \uFDFA\u060C \u062F\u064E\u0639\u064E\u0627 \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650\u0645 \u0628\u0650\u0633\u0650\u0646\u0650\u064A\u0646\u064E \u0643\u064E\u0633\u0650\u0646\u0650\u064A \u064A\u064F\u0648\u0633\u064F\u0641\u064E\u060C \u0641\u064E\u0623\u064E\u0635\u064E\u0627\u0628\u064E\u0647\u064F\u0645\u0652 \u0642\u064E\u062D\u0652\u0637\u064C \u0648\u064E\u062C\u064E\u0647\u0650\u062F\u064F\u0648\u0627 \u062D\u064E\u062A\u0651\u064E\u0649 \u0623\u064E\u0643\u064E\u0644\u064F\u0648\u0627 \u0627\u0644\u0652\u0639\u0650\u0638\u064E\u0627\u0645\u064E\u060C \u0648\u064E\u062C\u064E\u0639\u064E\u0644\u064E \u0627\u0644\u0631\u0651\u064E\u062C\u064F\u0644\u064F \u064A\u064E\u0646\u0652\u0638\u064F\u0631\u064F \u0625\u0650\u0644\u064E\u0649 \u0627\u0644\u0633\u0651\u064E\u0645\u064E\u0627\u0621\u0650\u060C \u0641\u064E\u064A\u064E\u0646\u0652\u0638\u064F\u0631\u064F \u0645\u064E\u0627 \u0628\u064E\u064A\u0652\u0646\u064E\u0647\u064F \u0648\u064E\u0628\u064E\u064A\u0652\u0646\u064E \u0627\u0644\u0633\u0651\u064E\u0645\u064E\u0627\u0621\u0650 \u0643\u064E\u0647\u064E\u064A\u0652\u0626\u064E\u0629\u0650 \u0627\u0644\u062F\u0651\u064F\u062E\u064E\u0627\u0646\u0650 \u0645\u0650\u0646\u0652 \u0627\u0644\u0652\u062C\u064E\u0647\u0652\u062F\u0650\u060C \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0639\u0632 \u0648 \u062C\u0644: { \u0641\u064E\u0671\u0631\u0652\u062A\u064E\u0642\u0650\u0628\u0652 \u064A\u064E\u0648\u0652\u0645\u064E \u062A\u064E\u0623\u0652\u062A\u0650\u0649 \u0671\u0644\u0633\u0651\u064E\u0645\u064E\u0627\u0653\u0621\u064F \u0628\u0650\u062F\u064F\u062E\u064E\u0627\u0646\u064D \u0645\u0651\u064F\u0628\u0650\u064A\u0646\u064D \uFD3F\u0661\u0660\uFD3E \u064A\u064E\u063A\u0652\u0634\u064E\u0649 \u0671\u0644\u0646\u0651\u064E\u0627\u0633\u064E \u06D6 \u0647\u064E\u0640\u0670\u0630\u064E\u0627 \u0639\u064E\u0630\u064E\u0627\u0628\u064C \u0623\u064E\u0644\u0650\u064A\u0645\u064C \uFD3F\u0661\u0661\uFD3E } \u0641\u064E\u0623\u064E\u062A\u064E\u0649 \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA\u060C \u0641\u064E\u0642\u0650\u064A\u0644\u064E: \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \u0627\u0633\u0652\u062A\u064E\u0633\u0652\u0642\u0650 \u0627\u0644\u0644\u0647\u064E \u0644\u0650\u0645\u064F\u0636\u064E\u0631\u064E\u060C \u0641\u064E\u0625\u0650\u0646\u0651\u064E\u0647\u064F\u0645\u0652 \u0642\u064E\u062F\u0652 \u0647\u064E\u0644\u064E\u0643\u064F\u0648\u0627\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u062F\u064E\u0639\u064E\u0627 \u0644\u064E\u0647\u064F\u0645\u0652\u060C \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0639\u0632 \u0648 \u062C\u0644: { \u0625\u0650\u0646\u0651\u064E\u0627 \u0643\u064E\u0627\u0634\u0650\u0641\u064F\u0648\u0627\u06DF \u0671\u0644\u0652\u0639\u064E\u0630\u064E\u0627\u0628\u0650 } \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0623\u064E\u0635\u064E\u0627\u0628\u064E\u0647\u064F\u0645\u064F \u0627\u0644\u0652\u0645\u064E\u0631\u0651\u064E\u0629\u064E \u0627\u0644\u062B\u0651\u064E\u0627\u0646\u0650\u064A\u064E\u0629\u064E \u0639\u064E\u0627\u062F\u064F\u0648\u0627\u060C \u0641\u064E\u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652: { \u064A\u064E\u0648\u0652\u0645\u064E \u0646\u064E\u0628\u0652\u0637\u0650\u0634\u064F \u0671\u0644\u0652\u0628\u064E\u0637\u0652\u0634\u064E\u0629\u064E \u0671\u0644\u0652\u0643\u064F\u0628\u0652\u0631\u064E\u0649\u0670\u0653 \u0625\u0650\u0646\u0651\u064E\u0627 \u0645\u064F\u0646\u062A\u064E\u0642\u0650\u0645\u064F\u0648\u0646\u064E \uFD3F\u0661\u0666\uFD3E }\u060C \u064A\u064E\u0648\u0652\u0645\u064E \u0628\u064E\u062F\u0652\u0631\u064D.",
            "fadl": "",
            "action": ""
        },
        "44_15": {
            "title": "\u0625\u0650\u0646\u0651\u064E\u0627 \u0643\u064E\u0627\u0634\u0650\u0641\u064F\u0648 \u0627\u0644\u0652\u0639\u064E\u0630\u064E\u0627\u0628\u0650 \u0642\u064E\u0644\u0650\u064A\u0644\u064B\u0627 \u06DA \u0625\u0650\u0646\u0651\u064E\u0643\u064F\u0645\u0652 \u0639\u064E\u0627\u0626\u0650\u062F\u064F\u0648\u0646\u064E",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 10 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
