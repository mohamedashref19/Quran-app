        "112_3": {
            "title": "\u0644\u064E\u0645\u0652 \u064A\u064E\u0644\u0650\u062F\u0652 \u0648\u064E\u0644\u064E\u0645\u0652 \u064A\u064F\u0648\u0644\u064E\u062F\u0652",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 1 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
            "fadl": "",
            "action": ""
        },
        "113_1": {
            "title": "\u0642\u0644 \u0623\u0639\u0648\u0630 \u0628\u0631\u0628 \u0627\u0644\u0641\u0644\u0642",
            "sabab": "\u0633\u064F\u062D\u0631 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0645\u0646 \u0642\u0650\u0628\u064E\u0644 \u064A\u0647\u0648\u062F\u064A \u064A\u064F\u062F\u0639\u0649 \u0644\u0628\u064A\u062F \u0628\u0646 \u0627\u0644\u0623\u0639\u0635\u0645\u060C \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u0627\u0644\u0645\u0639\u0648\u0630\u062A\u064A\u0646 \u0631\u0642\u064A\u0629\u064B \u0644\u0647\u060C \u0641\u0643\u0627\u0646 \u0643\u0644\u0645\u0627 \u0642\u0631\u0623 \u0622\u064A\u0629 \u0627\u0646\u062D\u0644\u062A \u0639\u0642\u062F\u0629 \u0645\u0646 \u0627\u0644\u0633\u062D\u0631.",
            "fadl": "\u0642\u0627\u0644 \u0627\u0644\u0646\u0628\u064A \uFDFA: \xab\u0623\u0644\u0645 \u062A\u0631 \u0622\u064A\u0627\u062A \u0623\u064F\u0646\u0632\u0644\u062A \u0627\u0644\u0644\u064A\u0644\u0629 \u0644\u0645 \u064A\u064F\u0631\u064E \u0645\u062B\u0644\u0647\u0646 \u0642\u0637\u061F \u0642\u0644 \u0623\u0639\u0648\u0630 \u0628\u0631\u0628 \u0627\u0644\u0641\u0644\u0642 \u0648\u0642\u0644 \u0623\u0639\u0648\u0630 \u0628\u0631\u0628 \u0627\u0644\u0646\u0627\u0633\xbb.",
            "action": "\u062D\u0635\u0646 \u0646\u0641\u0633\u0643 \u0648\u0623\u0648\u0644\u0627\u062F\u0643 \u064A\u0648\u0645\u064A\u0627\u064B \u0628\u0627\u0644\u0645\u0639\u0648\u0630\u062A\u064A\u0646\u060C \u0641\u0647\u0645\u0627 \u0623\u0639\u0638\u0645 \u0648\u0642\u0627\u064A\u0629 \u0645\u0646 \u0627\u0644\u0639\u064A\u0646 \u0648\u0627\u0644\u062D\u0633\u062F \u0648\u0627\u0644\u0633\u062D\u0631 \u0648\u0634\u0631\u0648\u0631 \u0627\u0644\u0628\u0634\u0631."
        },
        "114_1": {
            "title": "\u0642\u0644 \u0623\u0639\u0648\u0630 \u0628\u0631\u0628 \u0627\u0644\u0646\u0627\u0633",
            "sabab": "\u0646\u0632\u0644\u062A \u0645\u0639 \u0633\u0648\u0631\u0629 \u0627\u0644\u0641\u0644\u0642 \u062D\u064A\u0646 \u0633\u064F\u062D\u0631 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0644\u064A\u0633\u062A\u0631\u0642\u064A \u0628\u0647\u0627 \u0648\u064A\u062A\u0639\u0648\u0630 \u0645\u0646 \u0634\u0631 \u0634\u064A\u0627\u0637\u064A\u0646 \u0627\u0644\u0625\u0646\u0633 \u0648\u0627\u0644\u062C\u0646 \u0648\u0648\u0633\u0627\u0648\u0633 \u0627\u0644\u0635\u062F\u0648\u0631.",
            "fadl": "\u0645\u0646 \u0627\u0644\u0645\u0639\u0648\u0630\u062A\u064A\u0646 \u0627\u0644\u0644\u062A\u064A\u0646 \u0644\u0627 \u064A\u0633\u062A\u0639\u0627\u0630 \u0628\u0645\u062B\u0644\u0647\u0645\u0627 \u0642\u0637 \u0641\u064A \u062F\u0641\u0639 \u0643\u0644 \u0634\u0631.",
            "action": "\u0627\u0644\u0634\u064A\u0637\u0627\u0646 \u064A\u0628\u062F\u0623 \u0628\u0627\u0644\u0648\u0633\u0648\u0633\u0629 \u0627\u0644\u062E\u0641\u064A\u0629 \u0641\u064A \u0627\u0644\u0635\u062F\u0631 \u0644\u064A\u064F\u062D\u0632\u0646\u0643 \u0623\u0648 \u064A\u064F\u0641\u0633\u062F \u0639\u0644\u0627\u0642\u062A\u0643 \u0628\u0631\u0628\u0643. \u0627\u0642\u0637\u0639\u0647 \u0645\u0628\u0627\u0634\u0631\u0629 \u0628\u0627\u0644\u062A\u0639\u0648\u0630 \u0627\u0644\u0635\u0627\u062F\u0642."
        }
    },
    // === بيانات قصص الأنبياء ===
    // === بيانات قصص الأنبياء الـ25 المذكورين في القرآن الكريم ===
    prophets: [
        {
            id: 1,
            name: "\u0622\u062F\u0645 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0623\u0628\u0648 \u0627\u0644\u0628\u0634\u0631",
            story: "\u062E\u0644\u0642\u0647 \u0627\u0644\u0644\u0647 \u0628\u064A\u062F\u0647 \u0645\u0646 \u0637\u064A\u0646\u060C \u0648\u0646\u0641\u062E \u0641\u064A\u0647 \u0645\u0646 \u0631\u0648\u062D\u0647\u060C \u0648\u0623\u0633\u062C\u062F \u0644\u0647 \u0645\u0644\u0627\u0626\u0643\u062A\u0647. \u0623\u0633\u0643\u0646\u0647 \u0627\u0644\u0644\u0647 \u0627\u0644\u062C\u0646\u0629 \u062B\u0645 \u0623\u0647\u0628\u0637\u0647 \u0625\u0644\u0649 \u0627\u0644\u0623\u0631\u0636 \u0644\u064A\u0643\u0648\u0646 \u062E\u0644\u064A\u0641\u0629 \u0641\u064A\u0647\u0627 \u0628\u0639\u062F \u0623\u0646 \u0623\u0643\u0644 \u0645\u0646 \u0627\u0644\u0634\u062C\u0631\u0629 \u0628\u0627\u062C\u062A\u0647\u0627\u062F \u0648\u062A\u0623\u0648\u064A\u0644. \u0639\u0644\u0651\u0645\u0647 \u0627\u0644\u0644\u0647 \u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u0643\u0644\u0647\u0627 \u0648\u0641\u0636\u0644\u0647 \u0628\u0627\u0644\u0639\u0644\u0645.",
            lessons: "\u0628\u0627\u0628 \u0627\u0644\u062A\u0648\u0628\u0629 \u0645\u0641\u062A\u0648\u062D \u062F\u0627\u0626\u0645\u0627\u064B\u060C \u0641\u0643\u0645\u0627 \u0623\u062E\u0637\u0623 \u0622\u062F\u0645 \u0648\u062A\u0627\u0628 \u0641\u062A\u0627\u0628 \u0627\u0644\u0644\u0647 \u0639\u0644\u064A\u0647\u060C \u064A\u062C\u0628 \u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u0644\u0645 \u0623\u0646 \u064A\u0633\u0627\u0631\u0639 \u0644\u0644\u062A\u0648\u0628\u0629. \u0641\u0636\u0644 \u0627\u0644\u0639\u0644\u0645 \u0648\u0627\u0644\u062A\u0639\u0644\u0645 \u0627\u0644\u0630\u064A \u0631\u0641\u0639 \u0627\u0644\u0644\u0647 \u0628\u0647 \u0642\u062F\u0631 \u0622\u062F\u0645."
        },
        {
            id: 2,
            name: "\u0625\u062F\u0631\u064A\u0633 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0627\u0644\u0646\u0628\u064A \u0627\u0644\u0635\u0627\u0628\u0631",
            story: "\u0645\u0646 \u0623\u0648\u0627\u0626\u0644 \u0627\u0644\u0623\u0646\u0628\u064A\u0627\u0621 \u0628\u0639\u062F \u0622\u062F\u0645\u060C \u0648\u0647\u0648 \u062C\u062F \u0646\u0648\u062D \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645 \u0641\u064A \u0628\u0639\u0636 \u0627\u0644\u0631\u0648\u0627\u064A\u0627\u062A. \u0623\u0648\u0644 \u0645\u0646 \u062E\u0637\u0651 \u0628\u0627\u0644\u0642\u0644\u0645 \u0648\u062E\u0627\u0637 \u0627\u0644\u062B\u064A\u0627\u0628. \u0631\u0641\u0639\u0647 \u0627\u0644\u0644\u0647 \u0645\u0643\u0627\u0646\u0627\u064B \u0639\u0644\u064A\u0627\u064B\u060C \u0648\u0630\u0643\u0631\u0647 \u0627\u0644\u0642\u0631\u0622\u0646 \u0628\u0642\u0648\u0644\u0647: (\u0648\u064E\u0631\u064E\u0641\u064E\u0639\u0652\u0646\u064E\u0627\u0647\u064F \u0645\u064E\u0643\u064E\u0627\u0646\u064B\u0627 \u0639\u064E\u0644\u0650\u064A\u064B\u0651\u0627).",
            lessons: "\u0641\u0636\u0644 \u0627\u0644\u0639\u0644\u0645 \u0648\u0627\u0644\u0643\u062A\u0627\u0628\u0629 \u0648\u0627\u0644\u062D\u0631\u0641\u0629. \u0627\u0644\u0635\u0628\u0631 \u0648\u0627\u0644\u062A\u0642\u0648\u0649 \u0637\u0631\u064A\u0642 \u0644\u0644\u0631\u0641\u0639\u0629 \u0639\u0646\u062F \u0627\u0644\u0644\u0647."
        },
        {
            id: 3,
            name: "\u0646\u0648\u062D \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0634\u064A\u062E \u0627\u0644\u0645\u0631\u0633\u0644\u064A\u0646",
            story: "\u0644\u0628\u062B \u0641\u064A \u0642\u0648\u0645\u0647 \u0623\u0644\u0641 \u0633\u0646\u0629 \u0625\u0644\u0627 \u062E\u0645\u0633\u064A\u0646 \u0639\u0627\u0645\u0627\u064B \u064A\u062F\u0639\u0648\u0647\u0645 \u0625\u0644\u0649 \u0627\u0644\u062A\u0648\u062D\u064A\u062F \u0644\u064A\u0644\u0627\u064B \u0648\u0646\u0647\u0627\u0631\u0627\u064B \u0648\u0633\u0631\u0627\u064B \u0648\u062C\u0647\u0627\u0631\u0627\u064B \u0641\u0644\u0645 \u064A\u0624\u0645\u0646 \u0645\u0639\u0647 \u0625\u0644\u0627 \u0642\u0644\u064A\u0644. \u0623\u0645\u0631\u0647 \u0627\u0644\u0644\u0647 \u0628\u0628\u0646\u0627\u0621 \u0627\u0644\u0633\u0641\u064A\u0646\u0629 \u0648\u0646\u062C\u0627\u0647 \u0648\u0627\u0644\u0645\u0624\u0645\u0646\u064A\u0646 \u0648\u0623\u063A\u0631\u0642 \u0627\u0644\u0643\u0627\u0641\u0631\u064A\u0646 \u0628\u0627\u0644\u0637\u0648\u0641\u0627\u0646 \u0627\u0644\u0639\u0638\u064A\u0645 \u0627\u0644\u0630\u064A \u063A\u0637\u0649 \u0627\u0644\u0623\u0631\u0636.",
            lessons: "\u0627\u0644\u0635\u0628\u0631 \u0648\u0627\u0644\u0645\u062B\u0627\u0628\u0631\u0629 \u0639\u0644\u0649 \u0627\u0644\u062F\u0639\u0648\u0629 \u0648\u0627\u0644\u0639\u0645\u0644 \u0645\u0647\u0645\u0627 \u0637\u0627\u0644 \u0627\u0644\u0632\u0645\u0646. \u0627\u0644\u0646\u062C\u0627\u0629 \u062F\u0627\u0626\u0645\u0627\u064B \u062A\u0643\u0648\u0646 \u0641\u064A \u0637\u0627\u0639\u0629 \u0627\u0644\u0644\u0647 \u0648\u0627\u062A\u0628\u0627\u0639 \u0631\u0633\u0644\u0647."
        },
        {
            id: 4,
            name: "\u0647\u0648\u062F \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0646\u0628\u064A \u0639\u0627\u062F",
            story: "\u0623\u0631\u0633\u0644\u0647 \u0627\u0644\u0644\u0647 \u0625\u0644\u0649 \u0642\u0648\u0645 \u0639\u0627\u062F \u0641\u064A \u0627\u0644\u0623\u062D\u0642\u0627\u0641 \u0628\u0627\u0644\u064A\u0645\u0646\u060C \u0648\u0643\u0627\u0646\u0648\u0627 \u0623\u0634\u062F\u0627\u0621 \u0627\u0644\u0628\u0646\u064A\u0627\u0646 \u064A\u0642\u0648\u0644\u0648\u0646: \u0645\u0646 \u0623\u0634\u062F \u0645\u0646\u0627 \u0642\u0648\u0629. \u062F\u0639\u0627\u0647\u0645 \u0625\u0644\u0649 \u0627\u0644\u062A\u0648\u062D\u064A\u062F \u0641\u0631\u0641\u0636\u0648\u0627 \u0648\u0627\u0633\u062A\u0643\u0628\u0631\u0648\u0627\u060C \u0641\u0623\u0631\u0633\u0644 \u0627\u0644\u0644\u0647 \u0639\u0644\u064A\u0647\u0645 \u0631\u064A\u062D\u0627\u064B \u0635\u0631\u0635\u0631\u0627\u064B \u0639\u0627\u062A\u064A\u0627\u064B \u0633\u062E\u0631\u0647\u0627 \u0639\u0644\u064A\u0647\u0645 \u0633\u0628\u0639 \u0644\u064A\u0627\u0644\u064D \u0648\u062B\u0645\u0627\u0646\u064A\u0629 \u0623\u064A\u0627\u0645.",
            lessons: "\u0627\u0644\u0642\u0648\u0629 \u0627\u0644\u0645\u0627\u062F\u064A\u0629 \u0644\u0627 \u062A\u064F\u063A\u0646\u064A \u0639\u0646 \u0637\u0627\u0639\u0629 \u0627\u0644\u0644\u0647. \u0627\u0644\u0643\u0628\u0631 \u0648\u0627\u0644\u063A\u0631\u0648\u0631 \u0633\u0628\u0628 \u0627\u0644\u0647\u0644\u0627\u0643."
        },
        {
            id: 5,
            name: "\u0635\u0627\u0644\u062D \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0646\u0628\u064A \u062B\u0645\u0648\u062F",
            story: "\u0623\u0631\u0633\u0644\u0647 \u0627\u0644\u0644\u0647 \u0625\u0644\u0649 \u0642\u0648\u0645 \u062B\u0645\u0648\u062F \u0641\u064A \u0627\u0644\u062D\u0650\u062C\u0631 (\u0634\u0645\u0627\u0644 \u0627\u0644\u062C\u0632\u064A\u0631\u0629 \u0627\u0644\u0639\u0631\u0628\u064A\u0629). \u0622\u064A\u062A\u0647 \u0627\u0644\u0643\u0628\u0631\u0649: \u0627\u0644\u0646\u0627\u0642\u0629 \u0627\u0644\u062A\u064A \u0623\u062E\u0631\u062C\u0647\u0627 \u0627\u0644\u0644\u0647 \u0645\u0646 \u0627\u0644\u0635\u062E\u0631\u0629. \u0623\u0645\u0631\u0647\u0645 \u0628\u0625\u0637\u0644\u0627\u0642 \u0627\u0644\u0646\u0627\u0642\u0629 \u062A\u0631\u0639\u0649 \u0648\u0639\u062F\u0645 \u0625\u064A\u0630\u0627\u0626\u0647\u0627\u060C \u0641\u0639\u0642\u0631\u0648\u0647\u0627 \u0648\u062A\u062D\u062F\u0648\u0627 \u0627\u0644\u0644\u0647\u060C \u0641\u0623\u062E\u0630\u062A\u0647\u0645 \u0627\u0644\u0635\u064A\u062D\u0629 \u0648\u0623\u0647\u0644\u0643\u0647\u0645 \u0627\u0644\u0644\u0647.",
            lessons: "\u0646\u0639\u0645 \u0627\u0644\u0644\u0647 \u062A\u0643\u0648\u0646 \u0645\u062D\u0644 \u0627\u0628\u062A\u0644\u0627\u0621 \u0648\u0627\u062E\u062A\u0628\u0627\u0631. \u0627\u0644\u0639\u0642\u0648\u0642 \u0648\u0627\u0644\u062A\u062D\u062F\u064A \u0644\u0623\u0648\u0627\u0645\u0631 \u0627\u0644\u0644\u0647 \u064A\u062C\u0644\u0628 \u0627\u0644\u0647\u0644\u0627\u0643."
        },
        {
            id: 6,
            name: "\u0625\u0628\u0631\u0627\u0647\u064A\u0645 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u062E\u0644\u064A\u0644 \u0627\u0644\u0631\u062D\u0645\u0646",
            story: "\u0623\u0628\u0648 \u0627\u0644\u0623\u0646\u0628\u064A\u0627\u0621\u060C \u062D\u0637\u0645 \u0627\u0644\u0623\u0635\u0646\u0627\u0645 \u0648\u062A\u062D\u062F\u0649 \u0627\u0644\u0646\u0645\u0631\u0648\u062F. \u0623\u0644\u0642\u064A \u0641\u064A \u0627\u0644\u0646\u0627\u0631 \u0641\u062C\u0639\u0644\u0647\u0627 \u0627\u0644\u0644\u0647 \u0628\u0631\u062F\u0627\u064B \u0648\u0633\u0644\u0627\u0645\u0627\u064B \u0639\u0644\u064A\u0647. \u0623\u0645\u0631\u0647 \u0627\u0644\u0644\u0647 \u0628\u0630\u0628\u062D \u0627\u0628\u0646\u0647 \u0625\u0633\u0645\u0627\u0639\u064A\u0644 \u0641\u0627\u0633\u062A\u062C\u0627\u0628 \u0648\u0633\u0644\u0651\u0645\u060C \u0641\u0641\u062F\u0627\u0647 \u0627\u0644\u0644\u0647 \u0628\u0643\u0628\u0634 \u0639\u0638\u064A\u0645. \u0647\u0627\u062C\u0631 \u0648\u062A\u0631\u0643 \u0632\u0648\u062C\u062A\u0647 \u0647\u0627\u062C\u0631 \u0648\u0627\u0628\u0646\u0647 \u0625\u0633\u0645\u0627\u0639\u064A\u0644 \u0628\u0648\u0627\u062F\u064D \u063A\u064A\u0631 \u0630\u064A \u0632\u0631\u0639 \u0628\u0623\u0645\u0631 \u0627\u0644\u0644\u0647\u060C \u0648\u0628\u0646\u0649 \u0627\u0644\u0643\u0639\u0628\u0629 \u0627\u0644\u0645\u0634\u0631\u0641\u0629 \u0645\u0639 \u0627\u0628\u0646\u0647 \u0625\u0633\u0645\u0627\u0639\u064A\u0644.",
            lessons: "\u0627\u0644\u062A\u0648\u0643\u0644 \u0627\u0644\u0645\u0637\u0644\u0642 \u0639\u0644\u0649 \u0627\u0644\u0644\u0647 \u0648\u0627\u0644\u062B\u0642\u0629 \u0628\u0647 (\u062D\u0633\u0628\u0646\u0627 \u0627\u0644\u0644\u0647 \u0648\u0646\u0639\u0645 \u0627\u0644\u0648\u0643\u064A\u0644). \u0627\u0644\u062A\u0636\u062D\u064A\u0629 \u0648\u0627\u0644\u062A\u0633\u0644\u064A\u0645 \u0627\u0644\u062A\u0627\u0645 \u0644\u0623\u0648\u0627\u0645\u0631 \u0627\u0644\u0644\u0647."
        },
        {
            id: 7,
            name: "\u0644\u0648\u0637 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0646\u0628\u064A \u0633\u062F\u0648\u0645",
            story: "\u0627\u0628\u0646 \u0623\u062E\u064A \u0625\u0628\u0631\u0627\u0647\u064A\u0645 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645\u060C \u0623\u0631\u0633\u0644\u0647 \u0627\u0644\u0644\u0647 \u0625\u0644\u0649 \u0623\u0647\u0644 \u0633\u062F\u0648\u0645 \u0627\u0644\u0630\u064A\u0646 \u0627\u0628\u062A\u0644\u0648\u0627 \u0628\u0627\u0644\u0641\u0627\u062D\u0634\u0629 \u0627\u0644\u0643\u0628\u0631\u0649. \u0638\u0644 \u064A\u062F\u0639\u0648\u0647\u0645 \u0633\u0646\u0648\u0627\u062A \u0637\u0648\u064A\u0644\u0629 \u0641\u0644\u0645 \u064A\u0624\u0645\u0646 \u0628\u0647 \u0625\u0644\u0627 \u0627\u0628\u0646\u062A\u0627\u0647. \u0623\u0631\u0633\u0644 \u0627\u0644\u0644\u0647 \u0627\u0644\u0645\u0644\u0627\u0626\u0643\u0629 \u0644\u0625\u0646\u062C\u0627\u0626\u0647 \u0648\u0642\u0644\u0628\u062A \u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0639\u0644\u0649 \u0623\u0647\u0644\u0647\u0627 \u0648\u0623\u064F\u0645\u0637\u0631\u062A \u0628\u062D\u062C\u0627\u0631\u0629 \u0645\u0646 \u0633\u062C\u064A\u0644.",
            lessons: "\u0627\u0644\u0641\u0627\u062D\u0634\u0629 \u0648\u0627\u0644\u0627\u0646\u062D\u0644\u0627\u0644 \u0627\u0644\u0623\u062E\u0644\u0627\u0642\u064A \u064A\u062C\u0644\u0628 \u0627\u0644\u0639\u0642\u0648\u0628\u0629 \u0627\u0644\u0625\u0644\u0647\u064A\u0629. \u0627\u0644\u0627\u0644\u062A\u0632\u0627\u0645 \u0628\u0627\u0644\u0623\u062E\u0644\u0627\u0642 \u0648\u0627\u0644\u0641\u0636\u064A\u0644\u0629 \u0648\u0627\u062C\u0628."
        },
        {
            id: 8,
            name: "\u0625\u0633\u0645\u0627\u0639\u064A\u0644 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0630\u0628\u064A\u062D \u0627\u0644\u0644\u0647",
            story: "\u0627\u0628\u0646 \u0625\u0628\u0631\u0627\u0647\u064A\u0645 \u0645\u0646 \u0647\u0627\u062C\u0631\u060C \u0646\u0634\u0623 \u0628\u0645\u0643\u0629 \u0627\u0644\u0645\u0643\u0631\u0645\u0629. \u062B\u0628\u062A \u0645\u0639 \u0623\u0628\u064A\u0647 \u062D\u064A\u0646 \u0623\u0645\u0631 \u0627\u0644\u0644\u0647 \u0628\u0630\u0628\u062D\u0647 \u0648\u0642\u0627\u0644: (\u0633\u064E\u062A\u064E\u062C\u0650\u062F\u064F\u0646\u0650\u064A \u0625\u0650\u0646 \u0634\u064E\u0627\u0621\u064E \u0627\u0644\u0644\u064E\u0651\u0647\u064F \u0645\u0650\u0646\u064E \u0627\u0644\u0635\u064E\u0651\u0627\u0628\u0650\u0631\u0650\u064A\u0646\u064E)\u060C \u0641\u0641\u062F\u0627\u0647 \u0627\u0644\u0644\u0647 \u0628\u0630\u0628\u062D \u0639\u0638\u064A\u0645. \u0628\u0646\u0649 \u0645\u0639 \u0623\u0628\u064A\u0647 \u0627\u0644\u0643\u0639\u0628\u0629 \u0627\u0644\u0645\u0634\u0631\u0641\u0629 \u0648\u0623\u0642\u0627\u0645 \u0641\u064A\u0647\u0627 \u0634\u0639\u064A\u0631\u0629 \u0627\u0644\u062D\u062C. \u0623\u062C\u062F\u0627\u062F \u0627\u0644\u0639\u0631\u0628 \u0645\u0646\u0647.",
            lessons: "\u0627\u0644\u062A\u0633\u0644\u064A\u0645 \u0627\u0644\u0643\u0627\u0645\u0644 \u0644\u0623\u0645\u0631 \u0627\u0644\u0644\u0647 \u0645\u0646 \u0623\u0639\u0644\u0649 \u062F\u0631\u062C\u0627\u062A \u0627\u0644\u0625\u064A\u0645\u0627\u0646. \u0627\u0644\u0648\u0641\u0627\u0621 \u0628\u0627\u0644\u0648\u0639\u062F \u0645\u0646 \u0623\u062E\u0644\u0627\u0642 \u0627\u0644\u0623\u0646\u0628\u064A\u0627\u0621."
        },
        {
            id: 9,
            name: "\u0625\u0633\u062D\u0627\u0642 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0646\u0628\u064A \u0627\u0644\u0644\u0647 \u0627\u0644\u0628\u0627\u0631",
            story: "\u0627\u0628\u0646 \u0625\u0628\u0631\u0627\u0647\u064A\u0645 \u0645\u0646 \u0633\u0627\u0631\u0629\u060C \u0628\u064F\u0634\u0651\u0631 \u0628\u0647 \u0625\u0628\u0631\u0627\u0647\u064A\u0645 \u0639\u0644\u0649 \u0627\u0644\u0643\u0628\u0631. \u0623\u0628\u0648 \u064A\u0639\u0642\u0648\u0628 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645\u060C \u0648\u0645\u0646 \u0646\u0633\u0644\u0647 \u0633\u0627\u0626\u0631 \u0623\u0646\u0628\u064A\u0627\u0621 \u0628\u0646\u064A \u0625\u0633\u0631\u0627\u0626\u064A\u0644. \u0639\u064F\u0631\u0641 \u0628\u0627\u0644\u0628\u0631 \u0648\u0627\u0644\u0635\u0644\u0627\u062D\u060C \u0648\u0623\u0642\u0627\u0645 \u0641\u064A \u0623\u0631\u0636 \u0643\u0646\u0639\u0627\u0646 (\u0641\u0644\u0633\u0637\u064A\u0646) \u062F\u0627\u0639\u064A\u0627\u064B \u0625\u0644\u0649 \u0627\u0644\u062A\u0648\u062D\u064A\u062F.",
            lessons: "\u0627\u0644\u0628\u0634\u0627\u0631\u0629 \u0628\u0627\u0644\u0630\u0631\u064A\u0629 \u0627\u0644\u0635\u0627\u0644\u062D\u0629 \u0646\u0639\u0645\u0629 \u0639\u0638\u064A\u0645\u0629 \u0645\u0646 \u0627\u0644\u0644\u0647. \u0627\u0644\u0628\u0631 \u0648\u0627\u0644\u0635\u0644\u0627\u062D \u064A\u062A\u0648\u0627\u0631\u062B\u0647 \u0627\u0644\u0623\u0628\u0646\u0627\u0621 \u0639\u0646 \u0627\u0644\u0622\u0628\u0627\u0621."
        },
        {
            id: 10,
            name: "\u064A\u0639\u0642\u0648\u0628 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0625\u0633\u0631\u0627\u0626\u064A\u0644",
            story: "\u0627\u0628\u0646 \u0625\u0633\u062D\u0627\u0642 \u0648\u062D\u0641\u064A\u062F \u0625\u0628\u0631\u0627\u0647\u064A\u0645\u060C \u0633\u064F\u0645\u0651\u064A \u0625\u0633\u0631\u0627\u0626\u064A\u0644 \u0623\u064A \u0639\u0628\u062F \u0627\u0644\u0644\u0647. \u0623\u0628\u0648 \u0627\u0644\u0623\u0633\u0628\u0627\u0637 \u0627\u0644\u0627\u062B\u0646\u064A \u0639\u0634\u0631\u060C \u0623\u062D\u0628 \u0623\u0628\u0646\u0627\u0621\u0647 \u064A\u0648\u0633\u0641 \u0648\u0628\u0646\u064A\u0627\u0645\u064A\u0646. \u0641\u0642\u062F \u0628\u0635\u0631\u0647 \u0645\u0646 \u0643\u062B\u0631\u0629 \u0627\u0644\u0628\u0643\u0627\u0621 \u0639\u0644\u0649 \u064A\u0648\u0633\u0641\u060C \u062B\u0645 \u0631\u062F\u0651 \u0627\u0644\u0644\u0647 \u0639\u0644\u064A\u0647 \u0628\u0635\u0631\u0647 \u062D\u064A\u0646 \u0634\u0645 \u0642\u0645\u064A\u0635 \u064A\u0648\u0633\u0641 \u0648\u0635\u0628\u0631 \u0635\u0628\u0631\u0627\u064B \u062C\u0645\u064A\u0644\u0627\u064B.",
            lessons: "\u0627\u0644\u0635\u0628\u0631 \u0627\u0644\u062C\u0645\u064A\u0644 \u0627\u0644\u0630\u064A \u0644\u0627 \u0634\u0643\u0648\u0649 \u0641\u064A\u0647 \u0625\u0644\u0627 \u0644\u0644\u0647. \u0627\u0644\u062D\u0628 \u0627\u0644\u0635\u0627\u062F\u0642 \u0644\u0644\u0623\u0628\u0646\u0627\u0621 \u0648\u0627\u0644\u062F\u0639\u0627\u0621 \u0644\u0647\u0645."
        },
        {
            id: 11,
            name: "\u064A\u0648\u0633\u0641 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0627\u0644\u0635\u062F\u064A\u0642",
            story: "\u0627\u0628\u0646 \u064A\u0639\u0642\u0648\u0628\u060C \u0643\u064A\u062F\u0647 \u0625\u062E\u0648\u062A\u0647 \u0648\u0623\u0644\u0642\u0648\u0647 \u0641\u064A \u0627\u0644\u0628\u0626\u0631 \u0648\u0628\u0627\u0639\u0648\u0647 \u0639\u0628\u062F\u0627\u064B. \u0631\u0627\u0648\u062F\u062A\u0647 \u0627\u0645\u0631\u0623\u0629 \u0627\u0644\u0639\u0632\u064A\u0632 \u0641\u0623\u0628\u0649 \u0648\u0627\u0633\u062A\u0639\u0635\u0645\u060C \u0641\u0633\u064F\u062C\u0646 \u0638\u0644\u0645\u0627\u064B. \u0623\u0648\u0651\u0644 \u0627\u0644\u0644\u0647 \u0644\u0647 \u0627\u0644\u0623\u062D\u0644\u0627\u0645 \u0648\u0623\u062E\u0631\u062C\u0647 \u0645\u0646 \u0627\u0644\u0633\u062C\u0646 \u0648\u0631\u0641\u0639\u0647 \u0648\u0632\u064A\u0631\u0627\u064B \u0644\u0645\u0635\u0631. \u0639\u0641\u0627 \u0639\u0646 \u0625\u062E\u0648\u062A\u0647 \u0648\u0642\u0627\u0644: (\u0644\u064E\u0627 \u062A\u064E\u062B\u0652\u0631\u0650\u064A\u0628\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064F\u0645\u064F \u0627\u0644\u0652\u064A\u064E\u0648\u0652\u0645\u064E).",
            lessons: "\u0627\u0644\u0639\u0641\u0629 \u0648\u0627\u0644\u0627\u0633\u062A\u0639\u0635\u0627\u0645 \u0639\u0646 \u0627\u0644\u0645\u0639\u0635\u064A\u0629 \u0641\u064A \u0627\u0644\u0634\u062F\u0629. \u0627\u0644\u0639\u0641\u0648 \u0639\u0646\u062F \u0627\u0644\u0645\u0642\u062F\u0631\u0629 \u0645\u0646 \u0623\u0631\u0642\u0649 \u0627\u0644\u0623\u062E\u0644\u0627\u0642. \u0627\u0644\u0635\u0628\u0631 \u0648\u0627\u0644\u0625\u064A\u0645\u0627\u0646 \u064A\u0639\u0642\u0628\u0647\u0645\u0627 \u0627\u0644\u0641\u0631\u062C."
        },
        {
            id: 12,
            name: "\u0623\u064A\u0648\u0628 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0646\u0628\u064A \u0627\u0644\u0635\u0628\u0631",
            story: "\u0627\u0628\u062A\u0644\u0627\u0647 \u0627\u0644\u0644\u0647 \u0628\u0627\u0644\u0645\u0631\u0636 \u0627\u0644\u0634\u062F\u064A\u062F \u0641\u064A \u062C\u0633\u062F\u0647 \u0648\u0630\u0647\u0627\u0628 \u0645\u0627\u0644\u0647 \u0648\u0623\u0648\u0644\u0627\u062F\u0647\u060C \u0648\u0635\u0628\u0631 \u0639\u0644\u0649 \u0630\u0644\u0643 \u062B\u0645\u0627\u0646\u064A \u0639\u0634\u0631\u0629 \u0633\u0646\u0629 (\u0641\u064A \u0628\u0639\u0636 \u0627\u0644\u0631\u0648\u0627\u064A\u0627\u062A). \u0648\u0644\u0645 \u064A\u0634\u0643\u064F \u0625\u0644\u0627 \u0644\u0631\u0628\u0647 \u0642\u0627\u0626\u0644\u0627\u064B: (\u0623\u064E\u0646\u0650\u0651\u064A \u0645\u064E\u0633\u064E\u0651\u0646\u0650\u064A\u064E \u0627\u0644\u0636\u064F\u0651\u0631\u064F\u0651 \u0648\u064E\u0623\u064E\u0646\u062A\u064E \u0623\u064E\u0631\u0652\u062D\u064E\u0645\u064F \u0627\u0644\u0631\u064E\u0651\u0627\u062D\u0650\u0645\u0650\u064A\u0646\u064E). \u0641\u0643\u0634\u0641 \u0627\u0644\u0644\u0647 \u0636\u0631\u0647 \u0648\u0623\u0639\u0627\u062F \u0644\u0647 \u0623\u0647\u0644\u0647 \u0648\u0645\u0627\u0644\u0647.",
            lessons: "\u0627\u0644\u0635\u0628\u0631 \u0639\u0644\u0649 \u0627\u0644\u0628\u0644\u0627\u0621 \u0639\u0628\u0627\u062F\u0629 \u0639\u0638\u064A\u0645\u0629. \u0627\u0644\u0644\u062C\u0648\u0621 \u0625\u0644\u0649 \u0627\u0644\u0644\u0647 \u0641\u064A \u0627\u0644\u0634\u062F\u0629 \u064A\u0643\u0634\u0641 \u0627\u0644\u0647\u0645. \u0627\u0644\u0641\u0631\u062C \u064A\u0623\u062A\u064A \u0628\u0639\u062F \u0627\u0644\u0636\u064A\u0642."
        },
        {
            id: 13,
            name: "\u0634\u0639\u064A\u0628 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u062E\u0637\u064A\u0628 \u0627\u0644\u0623\u0646\u0628\u064A\u0627\u0621",
            story: "\u0623\u0631\u0633\u0644\u0647 \u0627\u0644\u0644\u0647 \u0625\u0644\u0649 \u0623\u0647\u0644 \u0645\u062F\u064A\u0646 \u0648\u0623\u0635\u062D\u0627\u0628 \u0627\u0644\u0623\u064A\u0643\u0629\u060C \u0648\u0643\u0627\u0646\u0648\u0627 \u064A\u0628\u062E\u0633\u0648\u0646 \u0627\u0644\u0646\u0627\u0633 \u0641\u064A \u0627\u0644\u0645\u0643\u064A\u0627\u0644 \u0648\u0627\u0644\u0645\u064A\u0632\u0627\u0646 \u0648\u064A\u0642\u0637\u0639\u0648\u0646 \u0627\u0644\u0637\u0631\u064A\u0642. \u062F\u0639\u0627\u0647\u0645 \u0625\u0644\u0649 \u0627\u0644\u062A\u0648\u062D\u064A\u062F \u0648\u0625\u0642\u0627\u0645\u0629 \u0627\u0644\u0639\u062F\u0644 \u0641\u064A \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0627\u062A. \u0643\u0630\u0628\u0648\u0647 \u0641\u0623\u062E\u0630\u062A\u0647\u0645 \u0627\u0644\u0635\u064A\u062D\u0629 \u0648\u0639\u0630\u0627\u0628 \u064A\u0648\u0645 \u0627\u0644\u0638\u064F\u0651\u0644\u0629.",
            lessons: "\u0627\u0644\u0639\u062F\u0644 \u0641\u064A \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0627\u062A \u0648\u0627\u0644\u0623\u0645\u0627\u0646\u0629 \u0627\u0644\u062A\u062C\u0627\u0631\u064A\u0629 \u0641\u0631\u064A\u0636\u0629 \u062F\u064A\u0646\u064A\u0629. \u0627\u0644\u063A\u0634 \u0648\u0627\u0644\u062E\u062F\u0627\u0639 \u0641\u064A \u0627\u0644\u0628\u064A\u0639 \u0648\u0627\u0644\u0634\u0631\u0627\u0621 \u0645\u062D\u0631\u0645."
        },
        {
            id: 14,
            name: "\u0645\u0648\u0633\u0649 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0643\u0644\u064A\u0645 \u0627\u0644\u0644\u0647",
            story: "\u062A\u0631\u0628\u0649 \u0641\u064A \u0628\u064A\u062A \u0641\u0631\u0639\u0648\u0646 \u0627\u0644\u0630\u064A \u0643\u0627\u0646 \u064A\u0630\u0628\u062D \u0627\u0644\u0623\u0637\u0641\u0627\u0644. \u0643\u0644\u0651\u0645\u0647 \u0627\u0644\u0644\u0647 \u0641\u064A \u0627\u0644\u0648\u0627\u062F\u064A \u0627\u0644\u0645\u0642\u062F\u0633 \u0637\u0648\u0649 \u0648\u0623\u0631\u0633\u0644\u0647 \u0628\u0627\u0644\u0622\u064A\u0627\u062A \u0627\u0644\u062A\u0633\u0639. \u0634\u0642 \u0627\u0644\u0644\u0647 \u0644\u0647 \u0627\u0644\u0628\u062D\u0631 \u0644\u064A\u0646\u062C\u0648 \u0628\u0642\u0648\u0645\u0647 \u0648\u0623\u063A\u0631\u0642 \u0641\u0631\u0639\u0648\u0646 \u0648\u062C\u0646\u0648\u062F\u0647. \u0623\u064F\u0646\u0632\u0644\u062A \u0639\u0644\u064A\u0647 \u0627\u0644\u062A\u0648\u0631\u0627\u0629\u060C \u0648\u0642\u0636\u0649 \u0623\u0631\u0628\u0639\u064A\u0646 \u0644\u064A\u0644\u0629 \u0641\u064A \u0627\u0644\u0645\u064A\u0642\u0627\u062A.",
            lessons: "\u0627\u0644\u0644\u0647 \u064A\u062D\u0641\u0638 \u0639\u0628\u0627\u062F\u0647 \u0627\u0644\u0645\u062E\u0644\u0635\u064A\u0646 \u062D\u062A\u0649 \u0641\u064A \u0623\u0634\u062F \u0627\u0644\u0623\u0645\u0627\u0643\u0646 \u062E\u0637\u0631\u0627\u064B. \u0627\u0644\u062D\u0642 \u064A\u0646\u062A\u0635\u0631 \u0641\u064A \u0627\u0644\u0646\u0647\u0627\u064A\u0629 \u0645\u0647\u0645\u0627 \u0628\u0644\u063A\u062A \u0642\u0648\u0629 \u0627\u0644\u0628\u0627\u0637\u0644."
        },
        {
            id: 15,
            name: "\u0647\u0627\u0631\u0648\u0646 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0648\u0632\u064A\u0631 \u0645\u0648\u0633\u0649",
            story: "\u0623\u062E\u0648 \u0645\u0648\u0633\u0649 \u0627\u0644\u0623\u0643\u0628\u0631\u060C \u0637\u0644\u0628 \u0645\u0648\u0633\u0649 \u0645\u0646 \u0627\u0644\u0644\u0647 \u0623\u0646 \u064A\u062C\u0639\u0644\u0647 \u0648\u0632\u064A\u0631\u0627\u064B \u0644\u0647. \u0643\u0627\u0646 \u0641\u0635\u064A\u062D \u0627\u0644\u0644\u0633\u0627\u0646 \u0628\u062E\u0644\u0627\u0641 \u0645\u0648\u0633\u0649. \u062E\u0644\u0641 \u0645\u0648\u0633\u0649 \u0641\u064A \u0642\u0648\u0645\u0647 \u062D\u064A\u0646 \u0630\u0647\u0628 \u0644\u0644\u0645\u064A\u0642\u0627\u062A\u060C \u0648\u062D\u064A\u0646 \u0639\u0628\u062F \u0642\u0648\u0645\u0647 \u0627\u0644\u0639\u062C\u0644 \u0644\u0645 \u064A\u0633\u062A\u0637\u0639 \u0645\u0646\u0639\u0647\u0645 \u062E\u0634\u064A\u0629 \u0627\u0644\u0641\u062A\u0646\u0629 \u0648\u0627\u0646\u062A\u0638\u0631 \u0639\u0648\u062F\u0629 \u0645\u0648\u0633\u0649.",
            lessons: "\u0627\u0644\u062A\u0639\u0627\u0648\u0646 \u0628\u064A\u0646 \u0627\u0644\u0625\u062E\u0648\u0629 \u0641\u064A \u0627\u0644\u062F\u0639\u0648\u0629 \u0625\u0644\u0649 \u0627\u0644\u0644\u0647. \u0627\u0644\u062D\u0643\u0645\u0629 \u0641\u064A \u0627\u0644\u062A\u0639\u0627\u0645\u0644 \u0645\u0639 \u0627\u0644\u0641\u062A\u0646 \u0648\u0627\u0644\u0623\u0632\u0645\u0627\u062A."
        },
        {
            id: 16,
            name: "\u0630\u0648 \u0627\u0644\u0643\u0641\u0644 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0627\u0644\u0635\u0627\u0628\u0631 \u0627\u0644\u0645\u062C\u062A\u0647\u062F",
            story: "\u0646\u0628\u064A \u0627\u062C\u062A\u0647\u0627\u062F\u064A \u0627\u0644\u062A\u0632\u0645 \u0628\u0635\u0644\u0627\u0629 \u0627\u0644\u0644\u064A\u0644 \u0648\u0635\u0648\u0645 \u0627\u0644\u0646\u0647\u0627\u0631 \u0648\u0627\u0644\u062D\u0643\u0645 \u0628\u064A\u0646 \u0627\u0644\u0646\u0627\u0633 \u0628\u0627\u0644\u0639\u062F\u0644\u060C \u0641\u0623\u0648\u0641\u0649 \u0628\u0645\u0627 \u0627\u0644\u062A\u0632\u0645 \u0641\u0633\u0645\u0627\u0647 \u0627\u0644\u0644\u0647 (\u0630\u0627 \u0627\u0644\u0643\u0641\u0644). \u0630\u0643\u0631\u0647 \u0627\u0644\u0642\u0631\u0622\u0646 \u0645\u0639 \u0627\u0644\u0635\u0627\u0628\u0631\u064A\u0646: (\u0648\u064E\u0625\u0650\u0633\u0652\u0645\u064E\u0627\u0639\u0650\u064A\u0644\u064E \u0648\u064E\u0625\u0650\u062F\u0652\u0631\u0650\u064A\u0633\u064E \u0648\u064E\u0630\u064E\u0627 \u0627\u0644\u0652\u0643\u0650\u0641\u0652\u0644\u0650 \u0643\u064F\u0644\u064C\u0651 \u0645\u0650\u0651\u0646\u064E \u0627\u0644\u0635\u064E\u0651\u0627\u0628\u0650\u0631\u0650\u064A\u0646\u064E).",
            lessons: "\u0627\u0644\u0648\u0641\u0627\u0621 \u0628\u0627\u0644\u0639\u0647\u0648\u062F \u0648\u0627\u0644\u0627\u0644\u062A\u0632\u0627\u0645\u0627\u062A \u0635\u0641\u0629 \u0627\u0644\u0645\u0624\u0645\u0646 \u0627\u0644\u0635\u0627\u062F\u0642. \u0627\u0644\u0639\u0628\u0627\u062F\u0629 \u0627\u0644\u0645\u0646\u062A\u0638\u0645\u0629 \u0645\u0646 \u0623\u0639\u0644\u0649 \u062F\u0631\u062C\u0627\u062A \u0627\u0644\u062A\u0642\u0648\u0649."
        },
        {
            id: 17,
            name: "\u062F\u0627\u0648\u062F \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0627\u0644\u0645\u0644\u0643 \u0627\u0644\u0646\u0628\u064A",
            story: "\u0641\u062A\u0649 \u0635\u063A\u064A\u0631 \u0642\u062A\u0644 \u062C\u0627\u0644\u0648\u062A \u0627\u0644\u0639\u0645\u0644\u0627\u0642 \u0628\u0645\u0642\u0644\u0627\u0639\u0647 \u0648\u062D\u062C\u0631\u0629 \u0641\u0646\u0635\u0631\u0647 \u0627\u0644\u0644\u0647. \u0622\u062A\u0627\u0647 \u0627\u0644\u0644\u0647 \u0627\u0644\u0645\u0644\u0643 \u0648\u0627\u0644\u0646\u0628\u0648\u0629 \u0648\u0639\u0644\u0651\u0645\u0647 \u0635\u0646\u0639\u0629 \u0627\u0644\u062F\u0631\u0648\u0639. \u0623\u064F\u0646\u0632\u0644 \u0639\u0644\u064A\u0647 \u0627\u0644\u0632\u0628\u0648\u0631. \u0643\u0627\u0646\u062A \u0627\u0644\u062C\u0628\u0627\u0644 \u0648\u0627\u0644\u0637\u064A\u0631 \u062A\u0633\u0628\u062D \u0645\u0639\u0647. \u0643\u0627\u0646 \u0643\u062B\u064A\u0631 \u0627\u0644\u0639\u0628\u0627\u062F\u0629 \u064A\u0635\u0648\u0645 \u064A\u0648\u0645\u0627\u064B \u0648\u064A\u0641\u0637\u0631 \u064A\u0648\u0645\u0627\u064B.",
            lessons: "\u0627\u0644\u0625\u064A\u0645\u0627\u0646 \u0628\u0627\u0644\u0644\u0647 \u064A\u0647\u0628 \u0627\u0644\u0634\u062C\u0627\u0639\u0629 \u0644\u0645\u0648\u0627\u062C\u0647\u0629 \u0623\u0639\u062A\u0649 \u0627\u0644\u0623\u0639\u062F\u0627\u0621. \u0634\u0643\u0631 \u0627\u0644\u0646\u0639\u0645\u0629 \u0628\u0627\u0644\u0639\u0628\u0627\u062F\u0629 \u0648\u0627\u0644\u0639\u0645\u0644 \u0627\u0644\u0635\u0627\u0644\u062D."
        },
        {
            id: 18,
            name: "\u0633\u0644\u064A\u0645\u0627\u0646 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0645\u0644\u0643 \u0627\u0644\u0623\u0646\u0628\u064A\u0627\u0621",
            story: "\u0627\u0628\u0646 \u062F\u0627\u0648\u062F\u060C \u0623\u0639\u0637\u0627\u0647 \u0627\u0644\u0644\u0647 \u0645\u0644\u0643\u0627\u064B \u0644\u0645 \u064A\u064F\u0639\u0637\u064E \u0644\u0623\u062D\u062F \u0645\u0646 \u0628\u0639\u062F\u0647: \u0633\u062E\u0651\u0631 \u0644\u0647 \u0627\u0644\u0631\u064A\u062D \u0648\u0627\u0644\u062C\u0646 \u0648\u0627\u0644\u0637\u064A\u0631 \u0648\u0627\u0644\u062D\u064A\u0648\u0627\u0646\u0627\u062A. \u0643\u0644\u0651\u0645\u0647 \u0627\u0644\u0647\u062F\u0647\u062F \u0648\u0623\u062E\u0628\u0631\u0647 \u0639\u0646 \u0645\u0644\u0643\u0629 \u0633\u0628\u0623 \u0628\u0644\u0642\u064A\u0633. \u0628\u0646\u0649 \u0628\u064A\u062A \u0627\u0644\u0645\u0642\u062F\u0633. \u0643\u0627\u0646 \u0631\u063A\u0645 \u0645\u0644\u0643\u0647 \u0627\u0644\u0639\u0638\u064A\u0645 \u0634\u0627\u0643\u0631\u0627\u064B \u0644\u0644\u0647 \u0642\u0627\u0626\u0644\u0627\u064B: (\u0647\u064E\u0670\u0630\u064E\u0627 \u0645\u0650\u0646 \u0641\u064E\u0636\u0652\u0644\u0650 \u0631\u064E\u0628\u0650\u0651\u064A).",
            lessons: "\u0627\u0644\u0634\u0643\u0631 \u0639\u0644\u0649 \u0627\u0644\u0646\u0639\u0645\u0629 \u064A\u0632\u064A\u062F\u0647\u0627. \u0627\u0644\u0645\u0644\u0643 \u0648\u0627\u0644\u0633\u0644\u0637\u0629 \u0644\u0627 \u062A\u064F\u0628\u0639\u062F \u0627\u0644\u0645\u0624\u0645\u0646 \u0639\u0646 \u0627\u0644\u0644\u0647."
        },
        {
            id: 19,
            name: "\u0625\u0644\u064A\u0627\u0633 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0646\u0628\u064A \u0628\u0639\u0644",
            story: "\u0623\u0631\u0633\u0644\u0647 \u0627\u0644\u0644\u0647 \u0625\u0644\u0649 \u0642\u0648\u0645\u0647 \u0645\u0646 \u0628\u0646\u064A \u0625\u0633\u0631\u0627\u0626\u064A\u0644 \u0627\u0644\u0630\u064A\u0646 \u064A\u0639\u0628\u062F\u0648\u0646 \u0635\u0646\u0645 \u0628\u0639\u0644. \u062F\u0639\u0627\u0647\u0645 \u0625\u0644\u0649 \u062A\u0631\u0643 \u0627\u0644\u0634\u0631\u0643 \u0648\u0627\u0644\u0639\u0648\u062F\u0629 \u0644\u0639\u0628\u0627\u062F\u0629 \u0627\u0644\u0644\u0647 \u0648\u062D\u062F\u0647\u060C \u0641\u0643\u0630\u0628\u0648\u0647 \u0648\u062A\u0647\u062F\u062F\u0648\u0647. \u0646\u062C\u0651\u0627\u0647 \u0627\u0644\u0644\u0647 \u0648\u0631\u0641\u0639\u0647 \u0648\u0645\u064F\u0633\u062E \u0627\u0644\u0645\u0643\u0630\u0628\u0648\u0646. \u0630\u0643\u0631\u0647 \u0627\u0644\u0642\u0631\u0622\u0646: (\u0648\u064E\u0625\u0650\u0646\u064E\u0651 \u0625\u0650\u0644\u0652\u064A\u064E\u0627\u0633\u064E \u0644\u064E\u0645\u0650\u0646\u064E \u0627\u0644\u0652\u0645\u064F\u0631\u0652\u0633\u064E\u0644\u0650\u064A\u0646\u064E).",
            lessons: "\u0627\u0644\u062B\u0628\u0627\u062A \u0639\u0644\u0649 \u0627\u0644\u062A\u0648\u062D\u064A\u062F \u0641\u064A \u0645\u062C\u062A\u0645\u0639\u0627\u062A \u0627\u0644\u0634\u0631\u0643. \u0627\u0644\u0634\u062C\u0627\u0639\u0629 \u0641\u064A \u0627\u0644\u062C\u0647\u0631 \u0628\u0627\u0644\u062D\u0642 \u062D\u062A\u0649 \u0641\u064A \u0648\u062C\u0647 \u0627\u0644\u0623\u0642\u0648\u064A\u0627\u0621."
        },
        {
            id: 20,
            name: "\u0627\u0644\u064A\u0633\u0639 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u062E\u0644\u064A\u0641\u0629 \u0625\u0644\u064A\u0627\u0633",
            story: "\u062A\u0644\u0645\u064A\u0630 \u0625\u0644\u064A\u0627\u0633 \u0648\u062E\u0644\u064A\u0641\u062A\u0647 \u0645\u0646 \u0628\u0639\u062F\u0647\u060C \u0630\u0643\u0631\u0647 \u0627\u0644\u0642\u0631\u0622\u0646 \u0645\u0631\u062A\u064A\u0646 \u0645\u0639 \u0623\u0641\u0636\u0644 \u0627\u0644\u0623\u0646\u0628\u064A\u0627\u0621: (\u0648\u064E\u0627\u0630\u0652\u0643\u064F\u0631\u0652 \u0625\u0650\u0633\u0652\u0645\u064E\u0627\u0639\u0650\u064A\u0644\u064E \u0648\u064E\u0627\u0644\u0652\u064A\u064E\u0633\u064E\u0639\u064E \u0648\u064E\u0630\u064E\u0627 \u0627\u0644\u0652\u0643\u0650\u0641\u0652\u0644\u0650 \u0648\u064E\u0643\u064F\u0644\u064C\u0651 \u0645\u0650\u0651\u0646\u064E \u0627\u0644\u0652\u0623\u064E\u062E\u0652\u064A\u064E\u0627\u0631\u0650). \u0648\u0627\u0635\u0644 \u062F\u0639\u0648\u062A\u0647 \u0641\u064A \u0628\u0646\u064A \u0625\u0633\u0631\u0627\u0626\u064A\u0644 \u0628\u0639\u062F \u0625\u0644\u064A\u0627\u0633 \u0648\u0643\u0627\u0646 \u0645\u0646 \u0627\u0644\u0635\u0627\u0644\u062D\u064A\u0646 \u0627\u0644\u0645\u062E\u062A\u0627\u0631\u064A\u0646.",
            lessons: "\u062A\u0648\u0627\u0635\u0644 \u0627\u0644\u062F\u0639\u0648\u0629 \u0648\u0646\u0642\u0644 \u0627\u0644\u0623\u0645\u0627\u0646\u0629 \u0628\u064A\u0646 \u0627\u0644\u0623\u062C\u064A\u0627\u0644 \u0648\u0627\u062C\u0628. \u0627\u0644\u062A\u0639\u0644\u0645 \u0645\u0646 \u0627\u0644\u0639\u0644\u0645\u0627\u0621 \u0648\u0627\u0644\u0635\u0627\u0644\u062D\u064A\u0646 \u0637\u0631\u064A\u0642 \u0644\u0644\u0647\u062F\u0627\u064A\u0629."
        },
        {
            id: 21,
            name: "\u064A\u0648\u0646\u0633 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0635\u0627\u062D\u0628 \u0627\u0644\u062D\u0648\u062A",
            story: "\u0623\u0631\u0633\u0644\u0647 \u0627\u0644\u0644\u0647 \u0625\u0644\u0649 \u0623\u0647\u0644 \u0646\u064A\u0646\u0648\u0649 \u0641\u064A \u0627\u0644\u0645\u0648\u0635\u0644. \u063A\u0636\u0628 \u0648\u062E\u0631\u062C \u0645\u063A\u0627\u0636\u0628\u0627\u064B \u0642\u0628\u0644 \u0623\u0646 \u064A\u0623\u0630\u0646 \u0627\u0644\u0644\u0647 \u0644\u0647\u060C \u0641\u0623\u064F\u0644\u0642\u064A \u0641\u064A \u0627\u0644\u0628\u062D\u0631 \u0648\u0627\u0628\u062A\u0644\u0639\u0647 \u0627\u0644\u062D\u0648\u062A. \u0646\u0627\u062F\u0649 \u0641\u064A \u0628\u0637\u0646 \u0627\u0644\u062D\u0648\u062A: (\u0644\u064E\u0651\u0627 \u0625\u0650\u0644\u064E\u0670\u0647\u064E \u0625\u0650\u0644\u064E\u0651\u0627 \u0623\u064E\u0646\u062A\u064E \u0633\u064F\u0628\u0652\u062D\u064E\u0627\u0646\u064E\u0643\u064E \u0625\u0650\u0646\u0650\u0651\u064A \u0643\u064F\u0646\u062A\u064F \u0645\u0650\u0646\u064E \u0627\u0644\u0638\u064E\u0651\u0627\u0644\u0650\u0645\u0650\u064A\u0646\u064E). \u0641\u0623\u0646\u062C\u0627\u0647 \u0627\u0644\u0644\u0647 \u0648\u0639\u0627\u062F \u0644\u0642\u0648\u0645\u0647 \u0641\u0622\u0645\u0646\u0648\u0627 \u062C\u0645\u064A\u0639\u0627\u064B.",
            lessons: "\u062F\u0639\u0627\u0621 \u064A\u0648\u0646\u0633 \u0645\u0646 \u0623\u0639\u0638\u0645 \u0623\u062F\u0639\u064A\u0629 \u0627\u0644\u0643\u0631\u0628. \u0627\u0644\u0639\u062C\u0644\u0629 \u0648\u0627\u0644\u062E\u0631\u0648\u062C \u0639\u0646 \u0627\u0644\u0623\u0645\u0631 \u0627\u0644\u0625\u0644\u0647\u064A \u062A\u062C\u0644\u0628 \u0627\u0644\u0645\u062D\u0646. \u0627\u0644\u062A\u0648\u0628\u0629 \u0627\u0644\u062E\u0627\u0644\u0635\u0629 \u062A\u0641\u062A\u062D \u0623\u0628\u0648\u0627\u0628 \u0627\u0644\u0631\u062D\u0645\u0629."
        },
        {
            id: 22,
            name: "\u0632\u0643\u0631\u064A\u0627 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0627\u0644\u0634\u064A\u062E \u0627\u0644\u062F\u0627\u0639\u064A",
            story: "\u0643\u0627\u0646 \u0643\u0627\u0647\u0646 \u0628\u064A\u062A \u0627\u0644\u0645\u0642\u062F\u0633 \u0648\u0643\u0641\u064A\u0644 \u0645\u0631\u064A\u0645 \u0639\u0644\u064A\u0647\u0627 \u0627\u0644\u0633\u0644\u0627\u0645. \u0631\u0623\u0649 \u0627\u0644\u0643\u0631\u0627\u0645\u0627\u062A \u0639\u0646\u062F \u0645\u0631\u064A\u0645 \u0641\u0637\u0644\u0628 \u0645\u0646 \u0627\u0644\u0644\u0647 \u0648\u0644\u062F\u0627\u064B \u0628\u0639\u062F \u0623\u0646 \u0628\u0644\u063A \u0645\u0646 \u0627\u0644\u0643\u0628\u0631 \u0639\u062A\u064A\u0627\u064B \u0648\u0643\u0627\u0646\u062A \u0632\u0648\u062C\u062A\u0647 \u0639\u0627\u0642\u0631\u0627\u064B\u060C \u0648\u062F\u0639\u0627 \u0631\u0628\u0647 \u0641\u064A \u0627\u0644\u0633\u0631: (\u0631\u064E\u0628\u0650\u0651 \u0647\u064E\u0628\u0652 \u0644\u0650\u064A \u0645\u0650\u0646 \u0644\u064E\u0651\u062F\u064F\u0646\u0643\u064E \u0630\u064F\u0631\u0650\u0651\u064A\u064E\u0651\u0629\u064B \u0637\u064E\u064A\u0650\u0651\u0628\u064E\u0629\u064B). \u0641\u0627\u0633\u062A\u062C\u0627\u0628 \u0627\u0644\u0644\u0647 \u0648\u0628\u0634\u0651\u0631\u0647 \u0628\u064A\u062D\u064A\u0649.",
            lessons: "\u0644\u0627 \u064A\u0623\u0633 \u0645\u0646 \u0631\u062D\u0645\u0629 \u0627\u0644\u0644\u0647 \u0645\u0647\u0645\u0627 \u0643\u0627\u0646\u062A \u0627\u0644\u0623\u0633\u0628\u0627\u0628 \u0645\u0633\u062A\u062D\u064A\u0644\u0629. \u0627\u0644\u062F\u0639\u0627\u0621 \u0633\u0644\u0627\u062D \u0627\u0644\u0645\u0624\u0645\u0646 \u0641\u064A \u0643\u0644 \u062D\u064A\u0646."
        },
        {
            id: 23,
            name: "\u064A\u062D\u064A\u0649 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0633\u064A\u062F \u0627\u0644\u0623\u062D\u0631\u0627\u0631",
            story: "\u0627\u0628\u0646 \u0632\u0643\u0631\u064A\u0627\u060C \u0648\u064F\u0644\u062F \u0645\u0639\u062C\u0632\u0629\u064B \u0645\u0646 \u0623\u0628\u0648\u064A\u0646 \u0634\u064A\u062E\u064A\u0646 \u0639\u0642\u064A\u0645\u064A\u0646. \u0622\u062A\u0627\u0647 \u0627\u0644\u0644\u0647 \u0627\u0644\u062D\u0643\u0645 \u0635\u0628\u064A\u0627\u064B. \u0643\u0627\u0646 \u0623\u0648\u0644 \u0645\u0646 \u0635\u062F\u0651\u0642 \u0628\u0639\u064A\u0633\u0649 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645 \u0648\u0647\u0645\u0627 \u0641\u064A \u0628\u0637\u0648\u0646 \u0623\u0645\u0647\u0627\u062A\u0647\u0645\u0627. \u0643\u0627\u0646 \u0633\u064A\u062F \u0627\u0644\u0623\u062D\u0631\u0627\u0631 \u0648\u062D\u0643\u0651\u0645 \u0634\u0631\u064A\u0639\u0629 \u0627\u0644\u0644\u0647 \u0641\u0642\u062A\u0644\u0647 \u0627\u0644\u0645\u0644\u0643 \u0627\u0644\u062C\u0627\u0626\u0631 \u0627\u0644\u0630\u064A \u0623\u0631\u0627\u062F \u0627\u0644\u0632\u0648\u0627\u062C \u0627\u0644\u0645\u062D\u0631\u0645.",
            lessons: "\u0627\u0644\u062B\u0628\u0627\u062A \u0639\u0644\u0649 \u0627\u0644\u062D\u0642 \u0648\u0627\u0644\u0634\u0647\u0627\u062F\u0629 \u0641\u064A\u0647 \u0623\u0633\u0645\u0649 \u0627\u0644\u0645\u0631\u0627\u062A\u0628. \u0625\u062D\u064A\u0627\u0621 \u0627\u0644\u0634\u0631\u064A\u0639\u0629 \u0641\u064A \u0645\u0648\u0627\u062C\u0647\u0629 \u0627\u0644\u0637\u063A\u0627\u0629 \u0648\u0627\u062C\u0628."
        },
        {
            id: 24,
            name: "\u0639\u064A\u0633\u0649 \u0639\u0644\u064A\u0647 \u0627\u0644\u0633\u0644\u0627\u0645",
            title: "\u0631\u0648\u062D \u0627\u0644\u0644\u0647 \u0648\u0643\u0644\u0645\u062A\u0647",
            story: "\u0648\u064F\u0644\u062F \u0645\u0646 \u0623\u0645 \u0628\u0644\u0627 \u0623\u0628\u060C \u0643\u0644\u0645\u0629 \u0627\u0644\u0644\u0647 \u0623\u0644\u0642\u0627\u0647\u0627 \u0625\u0644\u0649 \u0645\u0631\u064A\u0645 \u0648\u0631\u0648\u062D \u0645\u0646\u0647. \u0623\u062C\u0631\u0649 \u0627\u0644\u0645\u0639\u062C\u0632\u0627\u062A \u0628\u0625\u0630\u0646 \u0627\u0644\u0644\u0647: \u0623\u0628\u0631\u0623 \u0627\u0644\u0623\u0643\u0645\u0647 \u0648\u0627\u0644\u0623\u0628\u0631\u0635 \u0648\u0623\u062D\u064A\u0627 \u0627\u0644\u0645\u0648\u062A\u0649. \u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u0639\u0644\u064A\u0647 \u0627\u0644\u0625\u0646\u062C\u064A\u0644. \u0631\u0641\u0639\u0647 \u0627\u0644\u0644\u0647 \u0625\u0644\u064A\u0647 \u062D\u064A\u0646 \u0623\u0631\u0627\u062F\u0648\u0627 \u0635\u0644\u0628\u0647\u060C \u0648\u0633\u064A\u0646\u0632\u0644 \u0641\u064A \u0622\u062E\u0631 \u0627\u0644\u0632\u0645\u0627\u0646 \u0648\u064A\u0642\u062A\u0644 \u0627\u0644\u062F\u062C\u0627\u0644.",
            lessons: "\u0627\u0644\u0625\u064A\u0645\u0627\u0646 \u0627\u0644\u0635\u0627\u062F\u0642 \u064A\u064F\u0628\u0631\u0626 \u0627\u0644\u0642\u0644\u0648\u0628 \u0642\u0628\u0644 \u0627\u0644\u0623\u062C\u0633\u0627\u062F. \u0627\u0644\u062A\u0648\u0643\u0644 \u0639\u0644\u0649 \u0627\u0644\u0644\u0647 \u0645\u0639 \u0627\u0644\u0623\u062E\u0630 \u0628\u0627\u0644\u0623\u0633\u0628\u0627\u0628."
        },
        {
            id: 25,
            name: "\u0645\u062D\u0645\u062F \uFDFA",
            title: "\u062E\u0627\u062A\u0645 \u0627\u0644\u0623\u0646\u0628\u064A\u0627\u0621 \u0648\u0627\u0644\u0645\u0631\u0633\u0644\u064A\u0646",
            story: "\u0648\u0644\u062F \u064A\u062A\u064A\u0645\u0627\u064B \u0641\u064A \u0645\u0643\u0629 \u0639\u0627\u0645 \u0627\u0644\u0641\u064A\u0644\u060C \u0648\u0639\u064F\u0631\u0641 \u0628\u0627\u0644\u0635\u0627\u062F\u0642 \u0627\u0644\u0623\u0645\u064A\u0646. \u0646\u0632\u0644 \u0639\u0644\u064A\u0647 \u0627\u0644\u0648\u062D\u064A \u0641\u064A \u063A\u0627\u0631 \u062D\u0631\u0627\u0621 \u0648\u0647\u0648 \u0641\u064A \u0627\u0644\u0623\u0631\u0628\u0639\u064A\u0646. \u0639\u0627\u0646\u0649 \u0645\u0646 \u0623\u0630\u0649 \u0642\u0631\u064A\u0634 \u0648\u0647\u0627\u062C\u0631 \u0644\u0644\u0645\u062F\u064A\u0646\u0629 \u0648\u0628\u0646\u0649 \u062F\u0648\u0644\u0629 \u0627\u0644\u0625\u0633\u0644\u0627\u0645. \u0641\u062A\u062D \u0645\u0643\u0629 \u0648\u0639\u0641\u0627 \u0639\u0646 \u0623\u0639\u062F\u0627\u0626\u0647. \u0623\u064F\u0631\u0633\u0644 \u0631\u062D\u0645\u0629\u064B \u0644\u0644\u0639\u0627\u0644\u0645\u064A\u0646 \u0648\u0623\u064F\u0646\u0632\u0644 \u0639\u0644\u064A\u0647 \u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064A\u0645 \u062E\u0627\u062A\u0645\u0627\u064B \u0644\u0644\u0631\u0633\u0627\u0644\u0627\u062A.",
            lessons: "\u0623\u0647\u0645\u064A\u0629 \u0627\u0644\u0623\u062E\u0644\u0627\u0642 \u0627\u0644\u0643\u0631\u064A\u0645\u0629 \u0641\u064A \u0628\u0646\u0627\u0621 \u0627\u0644\u0623\u0645\u0645. \u0627\u0644\u0631\u062D\u0645\u0629 \u0648\u0627\u0644\u0639\u0641\u0648 \u0639\u0646\u062F \u0627\u0644\u0645\u0642\u062F\u0631\u0629 \u0643\u0645\u0627 \u0641\u0639\u0644 \u0639\u0646\u062F \u0641\u062A\u062D \u0645\u0643\u0629. \u0627\u0644\u0635\u0628\u0631 \u0639\u0644\u0649 \u0627\u0644\u0623\u0630\u0649 \u0641\u064A \u0633\u0628\u064A\u0644 \u0627\u0644\u062F\u0639\u0648\u0629."
        }
    ],
    // === بيانات سير الصحابة الكرام ===
    sahaba: [
        // ========== الخلفاء الراشدون ==========
        {
            id: 1,
            category: "\u0627\u0644\u062E\u0644\u0641\u0627\u0621 \u0627\u0644\u0631\u0627\u0634\u062F\u0648\u0646",
            name: "\u0623\u0628\u0648 \u0628\u0643\u0631 \u0627\u0644\u0635\u062F\u064A\u0642",
            title: "\u0623\u0648\u0644 \u0627\u0644\u062E\u0644\u0641\u0627\u0621 \u0627\u0644\u0631\u0627\u0634\u062F\u064A\u0646",
            story: "\u0623\u0648\u0644 \u0645\u0646 \u0622\u0645\u0646 \u0645\u0646 \u0627\u0644\u0631\u062C\u0627\u0644 \u0627\u0644\u0623\u062D\u0631\u0627\u0631\u060C \u0648\u0635\u0627\u062D\u0628 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0641\u064A \u0627\u0644\u063A\u0627\u0631 \u0648\u0627\u0644\u0647\u062C\u0631\u0629. \u0623\u0646\u0641\u0642 \u0645\u0627\u0644\u0647 \u0643\u0644\u0647 \u0641\u064A \u0633\u0628\u064A\u0644 \u0627\u0644\u0644\u0647 \u062D\u062A\u0649 \u0642\u0627\u0644 \u0627\u0644\u0646\u0628\u064A \uFDFA: (\u0645\u0627 \u0646\u0641\u0639\u0646\u064A \u0645\u0627\u0644 \u0623\u062D\u062F \u0645\u0627 \u0646\u0641\u0639\u0646\u064A \u0645\u0627\u0644 \u0623\u0628\u064A \u0628\u0643\u0631). \u062A\u0648\u0644\u0649 \u0627\u0644\u062E\u0644\u0627\u0641\u0629 \u0628\u0639\u062F \u0648\u0641\u0627\u0629 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0648\u0648\u0627\u062C\u0647 \u062D\u0631\u0648\u0628 \u0627\u0644\u0631\u062F\u0629 \u0648\u062C\u0645\u0639 \u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064A\u0645 \u0648\u0623\u0631\u0633\u0644 \u062C\u064A\u0634 \u0623\u0633\u0627\u0645\u0629.",
            lessons: "\u0627\u0644\u0635\u062F\u0642 \u0648\u0627\u0644\u0625\u064A\u0645\u0627\u0646 \u0627\u0644\u0631\u0627\u0633\u062E \u0627\u0644\u0630\u064A \u0644\u0627 \u064A\u062A\u0632\u0639\u0632\u0639. \u0627\u0644\u0645\u0633\u0627\u0631\u0639\u0629 \u0641\u064A \u0627\u0644\u062E\u064A\u0631\u0627\u062A \u0648\u0628\u0630\u0644 \u0627\u0644\u063A\u0627\u0644\u064A \u0648\u0627\u0644\u0646\u0641\u064A\u0633 \u0644\u0646\u0635\u0631\u0629 \u0627\u0644\u062D\u0642.",
            category_tag: "\u0627\u0644\u062E\u0644\u0641\u0627\u0621 \u0627\u0644\u0631\u0627\u0634\u062F\u0648\u0646"
        },
        {
            id: 2,
            category: "\u0627\u0644\u062E\u0644\u0641\u0627\u0621 \u0627\u0644\u0631\u0627\u0634\u062F\u0648\u0646",
            name: "\u0639\u0645\u0631 \u0628\u0646 \u0627\u0644\u062E\u0637\u0627\u0628",
            title: "\u0627\u0644\u0641\u0627\u0631\u0648\u0642",
            story: "\u062B\u0627\u0646\u064A \u0627\u0644\u062E\u0644\u0641\u0627\u0621 \u0627\u0644\u0631\u0627\u0634\u062F\u064A\u0646\u060C \u0643\u0627\u0646 \u0625\u0633\u0644\u0627\u0645\u0647 \u0641\u062A\u062D\u0627\u064B \u0648\u0639\u0632\u0627\u064B \u0644\u0644\u0645\u0633\u0644\u0645\u064A\u0646. \u0641\u0631\u0651\u0642 \u0627\u0644\u0644\u0647 \u0628\u0647 \u0628\u064A\u0646 \u0627\u0644\u062D\u0642 \u0648\u0627\u0644\u0628\u0627\u0637\u0644. \u0641\u064A \u0639\u0647\u062F\u0647 \u0641\u064F\u062A\u062D\u062A \u0627\u0644\u0634\u0627\u0645 \u0648\u0627\u0644\u0639\u0631\u0627\u0642 \u0648\u0645\u0635\u0631 \u0648\u0627\u0644\u0642\u062F\u0633. \u0623\u0633\u0651\u0633 \u0627\u0644\u062F\u0648\u0627\u0648\u064A\u0646 \u0648\u0627\u0644\u062A\u0642\u0648\u064A\u0645 \u0627\u0644\u0647\u062C\u0631\u064A. \u0639\u064F\u0631\u0641 \u0628\u0639\u062F\u0644\u0647 \u0648\u062A\u0648\u0627\u0636\u0639\u0647 \u062D\u062A\u0649 \u0643\u0627\u0646 \u064A\u062D\u0645\u0644 \u0627\u0644\u0642\u0631\u0628\u0629 \u0639\u0644\u0649 \u0638\u0647\u0631\u0647 \u0648\u064A\u0646\u0627\u0645 \u062A\u062D\u062A \u0627\u0644\u0634\u062C\u0631\u0629.",
            lessons: "\u0627\u0644\u0639\u062F\u0644 \u0623\u0633\u0627\u0633 \u0627\u0644\u0645\u0644\u0643. \u0627\u0644\u0642\u0648\u0629 \u0641\u064A \u0627\u0644\u062D\u0642 \u0648\u0639\u062F\u0645 \u0627\u0644\u062E\u0648\u0641 \u0645\u0646 \u0644\u0648\u0645\u0629 \u0644\u0627\u0626\u0645. \u0627\u0644\u062A\u0648\u0627\u0636\u0639 \u0631\u063A\u0645 \u0627\u0645\u062A\u0644\u0627\u0643 \u0627\u0644\u0633\u0644\u0637\u0629.",
            category_tag: "\u0627\u0644\u062E\u0644\u0641\u0627\u0621 \u0627\u0644\u0631\u0627\u0634\u062F\u0648\u0646"
        },
        {
            id: 3,
            category: "\u0627\u0644\u062E\u0644\u0641\u0627\u0621 \u0627\u0644\u0631\u0627\u0634\u062F\u0648\u0646",
            name: "\u0639\u062B\u0645\u0627\u0646 \u0628\u0646 \u0639\u0641\u0627\u0646",
            title: "\u0630\u0648 \u0627\u0644\u0646\u0648\u0631\u064A\u0646",
            story: "\u062B\u0627\u0644\u062B \u0627\u0644\u062E\u0644\u0641\u0627\u0621 \u0627\u0644\u0631\u0627\u0634\u062F\u064A\u0646\u060C \u062A\u0632\u0648\u062C \u0628\u0646\u062A\u064A \u0627\u0644\u0646\u0628\u064A \uFDFA \u0631\u0642\u064A\u0629 \u062B\u0645 \u0623\u0645 \u0643\u0644\u062B\u0648\u0645. \u062C\u0647\u0651\u0632 \u062C\u064A\u0634 \u0627\u0644\u0639\u0633\u0631\u0629 \u0628\u062B\u0644\u062B\u0645\u0627\u0626\u0629 \u0628\u0639\u064A\u0631 \u0648\u0639\u0634\u0631\u0629 \u0622\u0644\u0627\u0641 \u062F\u064A\u0646\u0627\u0631\u060C \u0648\u0627\u0634\u062A\u0631\u0649 \u0628\u0626\u0631 \u0631\u0648\u0645\u0629 \u0644\u0644\u0645\u0633\u0644\u0645\u064A\u0646. \u0641\u064A \u0639\u0647\u062F\u0647 \u062A\u0645 \u062C\u0645\u0639 \u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064A\u0645 \u0641\u064A \u0645\u0635\u062D\u0641 \u0648\u0627\u062D\u062F \u0648\u0648\u064F\u0632\u0651\u0639 \u0639\u0644\u0649 \u0627\u0644\u0623\u0645\u0635\u0627\u0631. \u0627\u0633\u062A\u064F\u0634\u0647\u062F \u0648\u0647\u0648 \u064A\u0642\u0631\u0623 \u0627\u0644\u0642\u0631\u0622\u0646.",
            lessons: "\u0627\u0644\u062D\u064A\u0627\u0621 \u0627\u0644\u0630\u064A \u062A\u0633\u062A\u062D\u064A \u0645\u0646\u0647 \u0627\u0644\u0645\u0644\u0627\u0626\u0643\u0629. \u0627\u0644\u0633\u062E\u0627\u0621 \u0648\u0627\u0644\u0625\u0646\u0641\u0627\u0642 \u0641\u064A \u0623\u0648\u0642\u0627\u062A \u0627\u0644\u0623\u0632\u0645\u0627\u062A. \u0627\u0644\u062A\u0639\u0644\u0642 \u0628\u0643\u062A\u0627\u0628 \u0627\u0644\u0644\u0647.",
            category_tag: "\u0627\u0644\u062E\u0644\u0641\u0627\u0621 \u0627\u0644\u0631\u0627\u0634\u062F\u0648\u0646"
        },
        {
            id: 4,
            category: "\u0627\u0644\u062E\u0644\u0641\u0627\u0621 \u0627\u0644\u0631\u0627\u0634\u062F\u0648\u0646",
            name: "\u0639\u0644\u064A \u0628\u0646 \u0623\u0628\u064A \u0637\u0627\u0644\u0628",
            title: "\u0623\u0628\u0648 \u0627\u0644\u062D\u0633\u0646",
            story: "\u0631\u0627\u0628\u0639 \u0627\u0644\u062E\u0644\u0641\u0627\u0621 \u0627\u0644\u0631\u0627\u0634\u062F\u064A\u0646 \u0648\u0627\u0628\u0646 \u0639\u0645 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0648\u0632\u0648\u062C \u0627\u0628\u0646\u062A\u0647 \u0641\u0627\u0637\u0645\u0629 \u0627\u0644\u0632\u0647\u0631\u0627\u0621. \u0623\u0648\u0644 \u0645\u0646 \u0622\u0645\u0646 \u0645\u0646 \u0627\u0644\u0635\u0628\u064A\u0627\u0646\u060C \u0648\u0646\u0627\u0645 \u0641\u064A \u0641\u0631\u0627\u0634 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0644\u064A\u0644\u0629 \u0627\u0644\u0647\u062C\u0631\u0629 \u0641\u062F\u0627\u0621\u064B \u0644\u0647. \u0643\u0627\u0646 \u0645\u0646 \u0623\u0634\u062C\u0639 \u0627\u0644\u0641\u0631\u0633\u0627\u0646 \u0648\u0623\u0639\u0644\u0645 \u0627\u0644\u0635\u062D\u0627\u0628\u0629 \u0628\u0627\u0644\u0642\u0636\u0627\u0621 \u0648\u0627\u0644\u0641\u0642\u0647. \u0642\u0627\u0644 \u0641\u064A\u0647 \u0627\u0644\u0646\u0628\u064A \uFDFA: (\u0623\u0646\u0627 \u0645\u062F\u064A\u0646\u0629 \u0627\u0644\u0639\u0644\u0645 \u0648\u0639\u0644\u064A \u0628\u0627\u0628\u0647\u0627).",
            lessons: "\u0627\u0644\u0634\u062C\u0627\u0639\u0629 \u0648\u0627\u0644\u0641\u062F\u0627\u0621 \u0648\u0627\u0644\u062A\u0636\u062D\u064A\u0629 \u0628\u0627\u0644\u0646\u0641\u0633. \u0627\u0644\u0639\u0644\u0645 \u0627\u0644\u063A\u0632\u064A\u0631 \u0648\u0627\u0644\u0641\u0635\u0627\u062D\u0629 \u0648\u0627\u0644\u062D\u0643\u0645\u0629 \u0641\u064A \u0627\u0644\u0642\u0636\u0627\u0621.",
            category_tag: "\u0627\u0644\u062E\u0644\u0641\u0627\u0621 \u0627\u0644\u0631\u0627\u0634\u062F\u0648\u0646"
        },
        // ========== العشرة المبشرون بالجنة ==========
        {
            id: 5,
            category: "\u0627\u0644\u0639\u0634\u0631\u0629 \u0627\u0644\u0645\u0628\u0634\u0631\u0648\u0646 \u0628\u0627\u0644\u062C\u0646\u0629",
            name: "\u0637\u0644\u062D\u0629 \u0628\u0646 \u0639\u0628\u064A\u062F \u0627\u0644\u0644\u0647",
            title: "\u0637\u0644\u062D\u0629 \u0627\u0644\u062E\u064A\u0631",
            story: "\u0645\u0646 \u0627\u0644\u0633\u0627\u0628\u0642\u064A\u0646 \u0627\u0644\u0623\u0648\u0644\u064A\u0646 \u0644\u0644\u0625\u0633\u0644\u0627\u0645 \u0648\u0645\u0646 \u0623\u062C\u0648\u062F \u0627\u0644\u0635\u062D\u0627\u0628\u0629. \u0641\u064A \u063A\u0632\u0648\u0629 \u0623\u064F\u062D\u062F \u0648\u0642\u0649 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0628\u062C\u0633\u062F\u0647 \u062D\u062A\u0649 \u0634\u064F\u0644\u0651\u062A \u064A\u062F\u0647\u060C \u0641\u0642\u0627\u0644 \u0627\u0644\u0646\u0628\u064A \uFDFA: (\u0623\u0648\u062C\u0628 \u0637\u0644\u062D\u0629). \u0643\u0627\u0646\u062A \u062A\u0635\u062F\u0642\u0627\u062A\u0647 \u062A\u0628\u0644\u063A \u0627\u0644\u0622\u0644\u0627\u0641 \u0641\u064A \u0627\u0644\u064A\u0648\u0645 \u0627\u0644\u0648\u0627\u062D\u062F. \u0627\u0633\u062A\u064F\u0634\u0647\u062F \u064A\u0648\u0645 \u0627\u0644\u062C\u0645\u0644.",
            lessons: "\u0627\u0644\u0641\u062F\u0627\u0621 \u0627\u0644\u062D\u0642\u064A\u0642\u064A \u0628\u0627\u0644\u0646\u0641\u0633 \u0641\u064A \u0633\u0628\u064A\u0644 \u0627\u0644\u062D\u0642. \u0627\u0644\u062C\u0648\u062F \u0627\u0644\u0630\u064A \u0644\u0627 \u064A\u0639\u0631\u0641 \u0627\u0644\u062D\u062F\u0648\u062F \u0641\u064A \u0633\u0628\u064A\u0644 \u0627\u0644\u0644\u0647.",
            category_tag: "\u0627\u0644\u0639\u0634\u0631\u0629 \u0627\u0644\u0645\u0628\u0634\u0631\u0648\u0646 \u0628\u0627\u0644\u062C\u0646\u0629"
        },
        {
            id: 6,
            category: "\u0627\u0644\u0639\u0634\u0631\u0629 \u0627\u0644\u0645\u0628\u0634\u0631\u0648\u0646 \u0628\u0627\u0644\u062C\u0646\u0629",
            name: "\u0627\u0644\u0632\u0628\u064A\u0631 \u0628\u0646 \u0627\u0644\u0639\u0648\u0627\u0645",
            title: "\u062D\u0648\u0627\u0631\u064A \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647",
            story: "\u0627\u0628\u0646 \u0639\u0645\u0629 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0635\u0641\u064A\u0629\u060C \u0648\u0632\u0648\u062C \u0623\u0633\u0645\u0627\u0621 \u0628\u0646\u062A \u0623\u0628\u064A \u0628\u0643\u0631. \u0623\u0648\u0644 \u0645\u0646 \u0633\u0644\u0651 \u0633\u064A\u0641\u0627\u064B \u0641\u064A \u0633\u0628\u064A\u0644 \u0627\u0644\u0644\u0647. \u0642\u0627\u0644 \u0641\u064A\u0647 \u0627\u0644\u0646\u0628\u064A \uFDFA: (\u0625\u0646 \u0644\u0643\u0644 \u0646\u0628\u064A \u062D\u0648\u0627\u0631\u064A\u0627 \u0648\u062D\u0648\u0627\u0631\u064A \u0627\u0644\u0632\u0628\u064A\u0631). \u0634\u0647\u062F \u0628\u062F\u0631\u0627\u064B \u0648\u0623\u064F\u062D\u062F\u0627\u064B \u0648\u0633\u0627\u0626\u0631 \u0627\u0644\u0645\u0634\u0627\u0647\u062F. \u0643\u0627\u0646 \u0641\u0627\u0631\u0633\u0627\u064B \u0644\u0627 \u064A\u064F\u0634\u0642\u0651 \u0644\u0647 \u063A\u0628\u0627\u0631.",
