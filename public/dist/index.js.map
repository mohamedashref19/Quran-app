            story: "\u0627\u0628\u0646\u0629 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0645\u0646 \u062E\u062F\u064A\u062C\u0629 \u0648\u0632\u0648\u062C \u0639\u0644\u064A. \u0639\u0627\u0634\u062A \u062D\u064A\u0627\u0629 \u0632\u0627\u0647\u062F\u0629 \u062A\u0637\u062D\u0646 \u0628\u064A\u062F\u0647\u0627 \u0648\u062A\u062D\u0645\u0644 \u0627\u0644\u0645\u0627\u0621. \u0643\u0627\u0646\u062A \u0623\u0634\u0628\u0647 \u0627\u0644\u0646\u0627\u0633 \u0628\u0627\u0644\u0646\u0628\u064A \uFDFA \u0645\u0634\u064A\u0629\u064B \u0648\u0647\u062F\u064A\u0627\u064B. \u0623\u0633\u0631\u0651 \u0625\u0644\u064A\u0647\u0627 \u0627\u0644\u0646\u0628\u064A \u0642\u0628\u0644 \u0648\u0641\u0627\u062A\u0647 \u0623\u0646\u0647\u0627 \u0623\u0648\u0644 \u0623\u0647\u0644\u0647 \u0644\u062D\u0648\u0642\u0627\u064B \u0628\u0647.",
            lessons: "\u0627\u0644\u0632\u0647\u062F \u0641\u064A \u0627\u0644\u062F\u0646\u064A\u0627 \u0645\u0639 \u0627\u0644\u0634\u0631\u0641 \u0648\u0627\u0644\u0645\u0643\u0627\u0646\u0629 \u0627\u0644\u0631\u0641\u064A\u0639\u0629. \u0627\u0644\u062A\u0648\u0627\u0636\u0639 \u0648\u062E\u062F\u0645\u0629 \u0627\u0644\u0632\u0648\u062C \u0648\u0627\u0644\u0623\u0633\u0631\u0629 \u0642\u064A\u0645\u0629 \u0639\u0644\u064A\u0627.",
