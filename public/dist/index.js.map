        },
        "2_284": {
            "title": "\u0644\u0650\u0644\u0651\u064E\u0647\u0650 \u0645\u064E\u0627 \u0641\u0650\u064A \u0627\u0644\u0633\u0651\u064E\u0645\u064E\u0627\u0648\u064E\u0627\u062A\u0650 \u0648\u064E\u0645\u064E\u0627 \u0641\u0650\u064A \u0627\u0644\u0652\u0623\u064E\u0631\u0652\u0636\u0650 \u06D7 \u0648\u064E\u0625\u0650\u0646\u0652 \u062A\u064F\u0628\u0652\u062F\u064F\u0648\u0627 \u0645\u064E\u0627 \u0641\u0650\u064A \u0623\u064E\u0646\u0652\u0641\u064F\u0633\u0650\u0643\u064F\u0645\u0652 \u0623\u064E\u0648\u0652 \u062A\u064F\u062E\u0652\u0641\u064F\u0648\u0647\u064F \u064A\u064F\u062D\u064E\u0627\u0633\u0650\u0628\u0652\u0643\u064F\u0645\u0652 \u0628\u0650\u0647\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u06D6 \u0641\u064E\u064A\u064E\u063A\u0652\u0641\u0650\u0631\u064F \u0644\u0650\u0645\u064E\u0646\u0652 \u064A\u064E\u0634\u064E\u0627\u0621\u064F \u0648\u064E\u064A\u064F\u0639\u064E\u0630\u0651\u0650\u0628\u064F \u0645\u064E\u0646\u0652 \u064A\u064E\u0634\u064E\u0627\u0621\u064F \u06D7 \u0648\u064E\u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0639\u064E\u0644\u064E\u0649\u0670 \u0643\u064F\u0644\u0651\u0650 \u0634\u064E\u064A\u0652\u0621\u064D \u0642\u064E\u062F\u0650\u064A\u0631\u064C",
            "sabab": "\u0639\u064E\u0646\u0652 \u0623\u064E\u0628\u0650\u064A \u0647\u064F\u0631\u064E\u064A\u0652\u0631\u064E\u0629\u064E \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u064E\u0627\u0644\u064E: \u0644\u064E\u0645\u0651\u064E\u0627 \u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652 \u0639\u064E\u0644\u064E\u0649 \u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0627\u0644\u0644\u0647\u0650 \uFDFA: { \u0644\u0651\u0650\u0644\u0651\u064E\u0647\u0650 \u0645\u064E\u0627 \u0641\u0650\u0649 \u0671\u0644\u0633\u0651\u064E\u0645\u064E\u0640\u0670\u0648\u064E\u0670\u062A\u0650 \u0648\u064E\u0645\u064E\u0627 \u0641\u0650\u0649 \u0671\u0644\u0652\u0623\u064E\u0631\u0652\u0636\u0650 \u06D7 \u0648\u064E\u0625\u0650\u0646 \u062A\u064F\u0628\u0652\u062F\u064F\u0648\u0627\u06DF \u0645\u064E\u0627 \u0641\u0650\u0649\u0653 \u0623\u064E\u0646\u0641\u064F\u0633\u0650\u0643\u064F\u0645\u0652 \u0623\u064E\u0648\u0652 \u062A\u064F\u062E\u0652\u0641\u064F\u0648\u0647\u064F \u064A\u064F\u062D\u064E\u0627\u0633\u0650\u0628\u0652\u0643\u064F\u0645 \u0628\u0650\u0647\u0650 \u0671\u0644\u0644\u0651\u064E\u0647\u064F \u06D6 \u0641\u064E\u064A\u064E\u063A\u0652\u0641\u0650\u0631\u064F \u0644\u0650\u0645\u064E\u0646 \u064A\u064E\u0634\u064E\u0627\u0653\u0621\u064F \u0648\u064E\u064A\u064F\u0639\u064E\u0630\u0651\u0650\u0628\u064F \u0645\u064E\u0646 \u064A\u064E\u0634\u064E\u0627\u0653\u0621\u064F \u06D7 \u0648\u064E\u0671\u0644\u0644\u0651\u064E\u0647\u064F \u0639\u064E\u0644\u064E\u0649\u0670 \u0643\u064F\u0644\u0651\u0650 \u0634\u064E\u0649\u0652\u0621\u064D \u0642\u064E\u062F\u0650\u064A\u0631\u064C \uFD3F\u0662\u0668\u0664\uFD3E } \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0627\u0634\u0652\u062A\u064E\u062F\u0651\u064E \u0630\u064E\u0644\u0650\u0643\u064E \u0639\u064E\u0644\u064E\u0649 \u0623\u064E\u0635\u0652\u062D\u064E\u0627\u0628\u0650 \u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0641\u064E\u0623\u064E\u062A\u064E\u0648\u0652\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \uFDFA\u060C \u062B\u064F\u0645\u0651\u064E \u0628\u064E\u0631\u064E\u0643\u064F\u0648\u0627 \u0639\u064E\u0644\u064E\u0649 \u0627\u0644\u0631\u0651\u064F\u0643\u064E\u0628\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064F\u0648\u0627: \u0623\u064E\u064A \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650\u060C \u0643\u064F\u0644\u0651\u0650\u0641\u0652\u0646\u064E\u0627 \u0645\u0650\u0646\u0652 \u0627\u0644\u0652\u0623\u064E\u0639\u0652\u0645\u064E\u0627\u0644\u0650 \u0645\u064E\u0627 \u0646\u064F\u0637\u0650\u064A\u0642\u064F: \u0627\u0644\u0635\u0651\u064E\u0644\u0627\u0629\u064E\u060C \u0648\u064E\u0627\u0644\u0635\u0651\u0650\u064A\u064E\u0627\u0645\u064E\u060C \u0648\u064E\u0627\u0644\u0652\u062C\u0650\u0647\u064E\u0627\u062F\u064E\u060C \u0648\u064E\u0627\u0644\u0635\u0651\u064E\u062F\u064E\u0642\u064E\u0629\u064E\u060C \u0648\u064E\u0642\u064E\u062F\u0652 \u0623\u064F\u0646\u0652\u0632\u0650\u0644\u064E\u062A\u0652 \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064E \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u064F\u060C \u0648\u064E\u0644\u064E\u0627 \u0646\u064F\u0637\u0650\u064A\u0642\u064F\u0647\u064E\u0627.\n\n\u0642\u064E\u0627\u0644\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA: \xab \u0623\u064E\u062A\u064F\u0631\u0650\u064A\u062F\u064F\u0648\u0646\u064E \u0623\u064E\u0646\u0652 \u062A\u064E\u0642\u064F\u0648\u0644\u064F\u0648\u0627 \u0643\u064E\u0645\u064E\u0627 \u0642\u064E\u0627\u0644\u064E \u0623\u064E\u0647\u0652\u0644\u064F \u0627\u0644\u0652\u0643\u0650\u062A\u064E\u0627\u0628\u064E\u064A\u0652\u0646\u0650 \u0645\u0650\u0646\u0652 \u0642\u064E\u0628\u0652\u0644\u0650\u0643\u064F\u0645\u0652\u060C \u0633\u064E\u0645\u0650\u0639\u0652\u0646\u064E\u0627 \u0648\u064E\u0639\u064E\u0635\u064E\u064A\u0652\u0646\u064E\u0627\u061F \u0628\u064E\u0644\u0652 \u0642\u064F\u0648\u0644\u064F\u0648\u0627: \u0633\u064E\u0645\u0650\u0639\u0652\u0646\u064E\u0627 \u0648\u064E\u0623\u064E\u0637\u064E\u0639\u0652\u0646\u064E\u0627 \u063A\u064F\u0641\u0652\u0631\u064E\u0627\u0646\u064E\u0643\u064E \u0631\u064E\u0628\u0651\u064E\u0646\u064E\u0627 \u0648\u064E\u0625\u0650\u0644\u064E\u064A\u0652\u0643\u064E \u0627\u0644\u0652\u0645\u064E\u0635\u0650\u064A\u0631\u064F \xbb.\n\u0642\u064E\u0627\u0644\u064F\u0648\u0627: { \u0633\u064E\u0645\u0650\u0639\u0652\u0646\u064E\u0627 \u0648\u064E\u0623\u064E\u0637\u064E\u0639\u0652\u0646\u064E\u0627 \u06D6 \u063A\u064F\u0641\u0652\u0631\u064E\u0627\u0646\u064E\u0643\u064E \u0631\u064E\u0628\u0651\u064E\u0646\u064E\u0627 \u0648\u064E\u0625\u0650\u0644\u064E\u064A\u0652\u0643\u064E \u0671\u0644\u0652\u0645\u064E\u0635\u0650\u064A\u0631\u064F } \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0627\u0642\u0652\u062A\u064E\u0631\u064E\u0623\u064E\u0647\u064E\u0627 \u0627\u0644\u0652\u0642\u064E\u0648\u0652\u0645\u064F \u0630\u064E\u0644\u0651\u064E\u062A\u0652 \u0628\u0650\u0647\u064E\u0627 \u0623\u064E\u0644\u0652\u0633\u0650\u0646\u064E\u062A\u064F\u0647\u064F\u0645\u0652\u061F\n\n\u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0641\u0650\u064A \u0625\u0650\u062B\u0652\u0631\u0650\u0647\u064E\u0627: { \u0621\u064E\u0627\u0645\u064E\u0646\u064E \u0671\u0644\u0631\u0651\u064E\u0633\u064F\u0648\u0644\u064F \u0628\u0650\u0645\u064E\u0627\u0653 \u0623\u064F\u0646\u0632\u0650\u0644\u064E \u0625\u0650\u0644\u064E\u064A\u0652\u0647\u0650 \u0645\u0650\u0646 \u0631\u0651\u064E\u0628\u0651\u0650\u0647\u0650\u06E6 \u0648\u064E\u0671\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u064F\u0648\u0646\u064E \u06DA \u0643\u064F\u0644\u0651\u064C \u0621\u064E\u0627\u0645\u064E\u0646\u064E \u0628\u0650\u0671\u0644\u0644\u0651\u064E\u0647\u0650 \u0648\u064E\u0645\u064E\u0644\u064E\u0640\u0670\u0653\u0626\u0650\u0643\u064E\u062A\u0650\u0647\u0650\u06E6 \u0648\u064E\u0643\u064F\u062A\u064F\u0628\u0650\u0647\u0650\u06E6 \u0648\u064E\u0631\u064F\u0633\u064F\u0644\u0650\u0647\u0650\u06E6 \u0644\u064E\u0627 \u0646\u064F\u0641\u064E\u0631\u0651\u0650\u0642\u064F \u0628\u064E\u064A\u0652\u0646\u064E \u0623\u064E\u062D\u064E\u062F\u064D \u0645\u0651\u0650\u0646 \u0631\u0651\u064F\u0633\u064F\u0644\u0650\u0647\u0650\u06E6 \u06DA \u0648\u064E\u0642\u064E\u0627\u0644\u064F\u0648\u0627\u06DF \u0633\u064E\u0645\u0650\u0639\u0652\u0646\u064E\u0627 \u0648\u064E\u0623\u064E\u0637\u064E\u0639\u0652\u0646\u064E\u0627 \u06D6 \u063A\u064F\u0641\u0652\u0631\u064E\u0627\u0646\u064E\u0643\u064E \u0631\u064E\u0628\u0651\u064E\u0646\u064E\u0627 \u0648\u064E\u0625\u0650\u0644\u064E\u064A\u0652\u0643\u064E \u0671\u0644\u0652\u0645\u064E\u0635\u0650\u064A\u0631\u064F \uFD3F\u0662\u0668\u0665\uFD3E }\u060C \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0641\u064E\u0639\u064E\u0644\u064F\u0648\u0627 \u0630\u064E\u0644\u0650\u0643\u064E \u0646\u064E\u0633\u064E\u062E\u064E\u0647\u064E\u0627 \u0627\u0644\u0644\u0647\u064F \u062A\u064E\u0639\u064E\u0627\u0644\u064E\u0649\u060C \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0639\u0632 \u0648 \u062C\u0644: { \u0644\u064E\u0627 \u064A\u064F\u0643\u064E\u0644\u0651\u0650\u0641\u064F \u0671\u0644\u0644\u0651\u064E\u0647\u064F \u0646\u064E\u0641\u0652\u0633\u064B\u0627 \u0625\u0650\u0644\u0651\u064E\u0627 \u0648\u064F\u0633\u0652\u0639\u064E\u0647\u064E\u0627 \u06DA \u0644\u064E\u0647\u064E\u0627 \u0645\u064E\u0627 \u0643\u064E\u0633\u064E\u0628\u064E\u062A\u0652 \u0648\u064E\u0639\u064E\u0644\u064E\u064A\u0652\u0647\u064E\u0627 \u0645\u064E\u0627 \u0671\u0643\u0652\u062A\u064E\u0633\u064E\u0628\u064E\u062A\u0652 \u06D7 \u0631\u064E\u0628\u0651\u064E\u0646\u064E\u0627 \u0644\u064E\u0627 \u062A\u064F\u0624\u064E\u0627\u062E\u0650\u0630\u0652\u0646\u064E\u0627\u0653 \u0625\u0650\u0646 \u0646\u0651\u064E\u0633\u0650\u064A\u0646\u064E\u0627\u0653 \u0623\u064E\u0648\u0652 \u0623\u064E\u062E\u0652\u0637\u064E\u0623\u0652\u0646\u064E\u0627 \u06DA } \n\u0642\u064E\u0627\u0644\u064E: \u0646\u064E\u0639\u064E\u0645\u0652\u060C { \u0631\u064E\u0628\u0651\u064E\u0646\u064E\u0627 \u0648\u064E\u0644\u064E\u0627 \u062A\u064E\u062D\u0652\u0645\u0650\u0644\u0652 \u0639\u064E\u0644\u064E\u064A\u0652\u0646\u064E\u0627\u0653 \u0625\u0650\u0635\u0652\u0631\u064B\u0627 \u0643\u064E\u0645\u064E\u0627 \u062D\u064E\u0645\u064E\u0644\u0652\u062A\u064E\u0647\u064F\u06E5 \u0639\u064E\u0644\u064E\u0649 \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0645\u0650\u0646 \u0642\u064E\u0628\u0652\u0644\u0650\u0646\u064E\u0627 \u06DA } \n\u0642\u064E\u0627\u0644\u064E: \u0646\u064E\u0639\u064E\u0645\u0652\u060C { \u0631\u064E\u0628\u0651\u064E\u0646\u064E\u0627 \u0648\u064E\u0644\u064E\u0627 \u062A\u064F\u062D\u064E\u0645\u0651\u0650\u0644\u0652\u0646\u064E\u0627 \u0645\u064E\u0627 \u0644\u064E\u0627 \u0637\u064E\u0627\u0642\u064E\u0629\u064E \u0644\u064E\u0646\u064E\u0627 \u0628\u0650\u0647\u0650\u06E6 \u06D6  } \n\u0642\u064E\u0627\u0644\u064E: \u0646\u064E\u0639\u064E\u0645\u0652\u060C { \u0671\u0639\u0652\u0641\u064F \u0639\u064E\u0646\u0651\u064E\u0627 \u0648\u064E\u0671\u063A\u0652\u0641\u0650\u0631\u0652 \u0644\u064E\u0646\u064E\u0627 \u0648\u064E\u0671\u0631\u0652\u062D\u064E\u0645\u0652\u0646\u064E\u0627\u0653 \u06DA \u0623\u064E\u0646\u062A\u064E \u0645\u064E\u0648\u0652\u0644\u064E\u0649\u0670\u0646\u064E\u0627 \u0641\u064E\u0671\u0646\u0635\u064F\u0631\u0652\u0646\u064E\u0627 \u0639\u064E\u0644\u064E\u0649 \u0671\u0644\u0652\u0642\u064E\u0648\u0652\u0645\u0650 \u0671\u0644\u0652\u0643\u064E\u0640\u0670\u0641\u0650\u0631\u0650\u064A\u0646\u064E } \u0642\u064E\u0627\u0644\u064E: \u0646\u064E\u0639\u064E\u0645\u0652.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0639\u064E\u0646\u0650 \u0627\u0628\u0652\u0646\u0650 \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u0650 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u