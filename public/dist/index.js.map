        },
        "108_3": {
            "title": "\u0625\u0650\u0646\u0651\u064E \u0634\u064E\u0627\u0646\u0650\u0626\u064E\u0643\u064E \u0647\u064F\u0648\u064E \u0627\u0644\u0652\u0623\u064E\u0628\u0652\u062A\u064E\u0631\u064F",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 1 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
            "fadl": "",
            "action": ""
        },
        "109_1": {
            "title": "\u0642\u0644 \u064A\u0627 \u0623\u064A\u0647\u0627 \u0627\u0644\u0643\u0627\u0641\u0631\u0648\u0646",
            "sabab": "\u0639\u0631\u0636 \u0643\u0641\u0627\u0631 \u0642\u0631\u064A\u0634 \u0639\u0644\u0649 \u0627\u0644\u0646\u0628\u064A \uFDFA \u062A\u0633\u0648\u064A\u0629 \u0645\u0636\u062D\u0643\u0629: \u0623\u0646 \u064A\u0639\u0628\u062F \u0622\u0644\u0647\u062A\u0647\u0645 \u0633\u0646\u0629\u060C \u0648\u064A\u0639\u0628\u062F\u0648\u0646 \u0625\u0644\u0647\u0647 \u0633\u0646\u0629! \u0641\u0646\u0632\u0644\u062A \u0627\u0644\u0633\u0648\u0631\u0629 \u062A\u0642\u0637\u0639 \u0623\u064A \u0645\u0633\u0627\u0648\u0645\u0629 \u0641\u064A \u0627\u0644\u0639\u0642\u064A\u062F\u0629.",
            "fadl": "\u062A\u0639\u062F\u0644 \u0631\u0628\u0639 \u0627\u0644\u0642\u0631\u0622\u0646\u060C \u0648\u0642\u0631\u0627\u0621\u062A\u0647\u0627 \u0642\u0628\u0644 \u0627\u0644\u0646\u0648\u0645 \u0628\u0631\u0627\u0621\u0629 \u0645\u0646 \u0627\u0644\u0634\u0631\u0643.",
            "action": "\u0627\u0644\u0645\u0628\u0627\u062F\u0626 \u0644\u0627 \u062A\u0642\u0628\u0644 \u0627\u0644\u0645\u0633\u0627\u0648\u0645\u0629 \u0648\u0644\u0627 \u0623\u0646\u0635\u0627\u0641 \u0627\u0644\u062D\u0644\u0648\u0644. \u0643\u0646 \u0648\u0627\u0636\u062D\u0627\u064B \u0648\u0635\u0631\u064A\u062D\u0627\u064B \u0641\u064A \u062D\u0642\u0643 \u0648\u062F\u064A\u0646\u0643 \u0648\u0644\u0627 \u062A\u062A\u0646\u0627\u0632\u0644 \u0625\u0631\u0636\u0627\u0621\u064B \u0644\u0644\u0622\u062E\u0631\u064A\u0646."
        },
        "111_1": {
            "title": "\u062A\u0628\u062A \u064A\u062F\u0627 \u0623\u0628\u064A \u0644\u0647\u0628 \u0648\u062A\u0628",
            "sabab": "\u062C\u0645\u0639 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0642\u0631\u064A\u0634\u0627\u064B \u0639\u0644\u0649 \u062C\u0628\u0644 \u0627\u0644\u0635\u0641\u0627 \u0644\u062F\u0639\u0648\u062A\u0647\u0645\u060C \u0641\u0642\u0627\u0644 \u0644\u0647 \u0639\u0645\u0647 \u0623\u0628\u0648 \u0644\u0647\u0628: \u062A\u0628\u0627\u064B \u0644\u0643 \u0633\u0627\u0626\u0631 \u0627\u0644\u064A\u0648\u0645\u060C \u0623\u0644\u0647\u0630\u0627 \u062C\u0645\u0639\u062A\u0646\u0627\u061F \u0641\u0646\u0632\u0644\u062A \u0627\u0644\u0633\u0648\u0631\u0629 \u0631\u062F\u0627\u064B \u0639\u0644\u064A\u0647 \u0648\u0625\u0628\u0637\u0627\u0644\u0627\u064B \u0644\u0643\u064A\u062F\u0647.",
            "fadl": "",
            "action": "\u0627\u0644\u0642\u0631\u0627\u0628\u0629 \u0648\u0627\u0644\u0646\u0633\u0628 \u0644\u0627 \u062A\u0646\u0641\u0639 \u0628\u062F\u0648\u0646 \u0625\u064A\u0645\u0627\u0646 \u0648\u0639\u0645\u0644. \u0623\u0628\u0648 \u0644\u0647\u0628 \u0639\u0645 \u0627\u0644\u0646\u0628\u064A \u0641\u064A \u0627\u0644\u0646\u0627\u0631\u060C \u0648\u0628\u0644\u0627\u0644 \u0627\u0644\u062D\u0628\u0634\u064A \u0641\u064A \u0627\u0644\u062C\u0646\u0629."
        },
        "111_2": {
