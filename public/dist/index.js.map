            "sabab": "\u0642\u0627\u0644\u0647\u0627 \u064A\u0639\u0642\u0648\u0628 \uFDFA \u0644\u0623\u0628\u0646\u0627\u0626\u0647 \u0648\u0647\u0648 \u064A\u0628\u0639\u062B\u0647\u0645 \u064A\u0628\u062D\u062B\u0648\u0646 \u0639\u0646 \u064A\u0648\u0633\u0641 \u0628\u0639\u062F \u0633\u0646\u0648\u0627\u062A \u0637\u0648\u064A\u0644\u0629 \u0645\u0646 \u0627\u0644\u0641\u0631\u0627\u0642 \u0648\u0627\u0644\u0623\u0644\u0645.",
