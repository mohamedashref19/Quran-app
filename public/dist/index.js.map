        "62_11": {
            "title": "\u0648\u064E\u0625\u0650\u0630\u064E\u0627 \u0631\u064E\u0623\u064E\u0648\u0652\u0627 \u062A\u0650\u062C\u064E\u0627\u0631\u064E\u0629\u064B \u0623\u064E\u0648\u0652 \u0644\u064E\u0647\u0652\u0648\u064B\u0627 \u0627\u0646\u0652\u0641\u064E\u0636\u0651\u064F\u0648\u0627 \u0625\u0650\u0644\u064E\u064A\u0652\u0647\u064E\u0627 \u0648\u064E\u062A\u064E\u0631\u064E\u0643\u064F\u0648\u0643\u064E \u0642\u064E\u0627\u0626\u0650\u0645\u064B\u0627 \u06DA \u0642\u064F\u0644\u0652 \u0645\u064E\u0627 \u0639\u0650\u0646\u0652\u062F\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u062E\u064E\u064A\u0652\u0631\u064C \u0645\u0650\u0646\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u0652\u0648\u0650 \u0648\u064E\u0645\u0650\u0646\u064E \u0627\u0644\u062A\u0651\u0650\u062C\u064E\u0627\u0631\u064E\u0629\u0650 \u06DA \u0648\u064E\u0627\u0644\u0644\u0651\u064E\u0647\u064F \u062E\u064E\u064A\u0652\u0631\u064F \u0627\u0644\u0631\u0651\u064E\u0627\u0632\u0650\u0642\u0650\u064A\u0646\u064E",
            "sabab": "\u0639\u064E\u0646\u0652 \u062C\u064E\u0627\u0628\u0650\u0631\u0650 \u0628\u0652\u0646\u0650 \u0639\u064E\u0628\u0652\u062F\u0650 \u0627\u0644\u0644\u0647\u0650 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u0642\u064E\u0627\u0644\u064E: \u0623\u064E\u0642\u0652\u0628\u064E\u0644\u064E\u062A\u0652 \u0639\u0650\u064A\u0631\u064C \u064A\u064E\u0648\u0652\u0645\u064E \u0627\u0644\u0652\u062C\u064F\u0645\u064F\u0639\u064E\u0629\u0650\u060C \u0648\u064E\u0646\u064E\u062D\u0652\u0646\u064F \u0645\u064E\u0639\u064E \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u0650 \uFDFA\u060C \u0641\u064E\u062B\u064E\u0627\u0631\u064E \u0627\u0644\u0646\u0651\u064E\u0627\u0633\u064F \u0625\u0650\u0644\u0651\u064E\u0627 \u0627\u062B\u0652\u0646\u064E\u064A\u0652 \u0639\u064E\u0634\u064E\u0631\u064E \u0631\u064E\u062C\u064F\u0644\u064B\u0627\u060C \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647: { \u0648\u064E\u0625\u0650\u0630\u064E\u0627 \u0631\u064E\u0623\u064E\u0648\u0652\u0627\u06DF \u062A\u0650\u062C\u064E\u0640\u0670\u0631\u064E\u0629\u064B \u0623\u064E\u0648\u0652 \u0644\u064E\u0647\u0652\u0648\u064B\u0627 \u0671\u0646\u0641\u064E\u0636\u0651\u064F\u0648\u0653\u0627\u06DF \u0625\u0650\u0644\u064E\u064A\u0652\u0647\u064E\u0627 \u0648\u064E\u062A\u064E\u0631\u064E\u0643\u064F\u0648\u0643\u064E \u0642\u064E\u0627\u0653\u0626\u0650\u0645\u064B\u0627 \u06DA }.",
            "fadl": "",
            "action": ""
        },
        "63_1": {
            "title": "\u0625\u0630\u0627 \u062C\u0627\u0621\u0643 \u0627\u0644\u0645\u0646\u0627\u0641\u0642\u0648\u0646",
            "sabab": "\u0646\u0632\u0644\u062A \u062A\u0641\u0636\u062D \u0631\u0623\u0633 \u0627\u0644\u0645\u0646\u0627\u0641\u0642\u064A\u0646 \u0639\u0628\u062F \u0627\u0644\u0644\u0647 \u0628\u0646 \u0623\u0628\u064A \u0628\u0646 \u0633\u0644\u0648\u0644 \u0627\u0644\u0630\u064A \u062D\u0644\u0641 \u0643\u0630\u0628\u0627\u064B \u0623\u0646\u0647 \u0644\u0645 \u064A\u0642\u0644 \xab\u0644\u0626\u0646 \u0631\u062C\u0639\u0646\u0627 \u0625\u0644\u0649 \u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0644\u064A\u062E\u0631\u062C\u0646 \u0627\u0644\u0623\u0639\u0632 \u0645\u0646\u0647\u0627 \u0627\u0644\u0623\u0630\u0644\xbb\u060C \u0641\u0641\u0636\u062D\u0647 \u0627\u0644\u0644\u0647.",
            "fadl": "",
            "action": "\u0627\u062D\u0630\u0631 \u0645\u0646 \u0627\u0644\u0646\u0641\u0627\u0642 \u0627\u0644\u0642\u0648\u0644\u064A \u0648\u0627\u0644\u0639\u0645\u0644\u064A. \u0643\u0646 \u0635\u0627\u062F\u0642\u0627\u064B \u0645\u0639 \u0627\u0644\u0644\u0647 \u0645\u0646 \u0627\u0644\u062F\u0627\u062E\u0644 \u0643\u0645\u0627 \u062A\u0638\u0647\u0631 \u0644\u0644\u0646\u0627\u0633 \u0645\u0646 \u0627\u0644\u062E\u0627\u0631\u062C."
        },
        "63_2": {
            "title": "\u0627\u062A\u0651\u064E\u062E\u064E\u0630\u064F\u0648\u0627 \u0623\u064E\u064A\u0652\u0645\u064E\u0627\u0646\u064E\u0647\u064F\u0645\u0652 \u062C\u064F\u0646\u0651\u064E\u0629\u064B \u0641\u064E\u0635\u064E\u062F\u0651\u064F\u0648\u0627 \u0639\u064E\u0646\u0652 \u0633\u064E\u0628\u0650\u064A\u0644\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u06DA \u0625\u0650\u0646\u0651\u064E\u0647\u064F\u0645\u0652 \u0633\u064E\u0627\u0621\u064E \u0645\u064E\u0627 \u0643\u064E\u0627\u0646\u064F\u0648\u0627 \u064A\u064E\u0639\u0652\u0645\u064E\u0644\u064F\u0648\u0646\u064E",
