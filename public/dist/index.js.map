        "4_127": {
            "title": "\u0648\u064E\u064A\u064E\u0633\u0652\u062A\u064E\u0641\u0652\u062A\u064F\u0648\u0646\u064E\u0643\u064E \u0641\u0650\u064A \u0627\u0644\u0646\u0651\u0650\u0633\u064E\u0627\u0621\u0650 \u06D6 \u0642\u064F\u0644\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u064A\u064F\u0641\u0652\u062A\u0650\u064A\u0643\u064F\u0645\u0652 \u0641\u0650\u064A\u0647\u0650\u0646\u0651\u064E \u0648\u064E\u0645\u064E\u0627 \u064A\u064F\u062A\u0652\u0644\u064E\u0649\u0670 \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064F\u0645\u0652 \u0641\u0650\u064A \u0627\u0644\u0652\u0643\u0650\u062A\u064E\u0627\u0628\u0650 \u0641\u0650\u064A \u064A\u064E\u062A\u064E\u0627\u0645\u064E\u0649 \u0627\u0644\u0646\u0651\u0650\u0633\u064E\u0627\u0621\u0650 \u0627\u0644\u0644\u0651\u064E\u0627\u062A\u0650\u064A \u0644\u064E\u0627 \u062A\u064F\u0624\u0652\u062A\u064F\u0648\u0646\u064E\u0647\u064F\u0646\u0651\u064E \u0645\u064E\u0627 \u0643\u064F\u062A\u0650\u0628\u064E \u0644\u064E\u0647\u064F\u0646\u0651\u064E \u0648\u064E\u062A\u064E\u0631\u0652\u063A\u064E\u0628\u064F\u0648\u0646\u064E \u0623\u064E\u0646\u0652 \u062A\u064E\u0646\u0652\u0643\u0650\u062D\u064F\u0648\u0647\u064F\u0646\u0651\u064E \u0648\u064E\u0627\u0644\u0652\u0645\u064F\u0633\u0652\u062A\u064E\u0636\u0652\u0639\u064E\u0641\u0650\u064A\u0646\u064E \u0645\u0650\u0646\u064E \u0627\u0644\u0652\u0648\u0650\u0644\u0652\u062F\u064E\u0627\u0646\u0650 \u0648\u064E\u0623\u064E\u0646\u0652 \u062A\u064E\u0642\u064F\u0648\u0645\u064F\u0648\u0627 \u0644\u0650\u0644\u0652\u064A\u064E\u062A\u064E\u0627\u0645\u064E\u0649\u0670 \u0628\u0650\u0627\u0644\u0652\u0642\u0650\u0633\u0652\u0637\u0650 \u06DA \u0648\u064E\u0645\u064E\u0627 \u062A\u064E\u0641\u0652\u0639\u064E\u0644\u064F\u0648\u0627 \u0645\u0650\u0646\u0652 \u062E\u064E\u064A\u0652\u0631\u064D \u0641\u064E\u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064E \u0643\u064E\u0627\u0646\u064E \u0628\u0650\u0647\u0650 \u0639\u064E\u0644\u0650\u064A\u0645\u064B\u0627",
            "sabab": ".. \u0642\u064E\u0627\u0644\u064E \u0639\u064F\u0631\u0652\u0648\u064E\u0629\u064F \u0631\u062D\u0645\u0647 \u0627\u0644\u0644\u0647: \u0642\u064E\u0627\u0644\u064E\u062A\u0652 \u0639\u064E\u0627\u0626\u0650\u0634\u064E\u0629\u064F \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0627: \u062B\u064F\u0645\u0651\u064E \u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0646\u0651\u064E\u0627\u0633\u064E \u0627\u0633\u0652\u062A\u064E\u0641\u0652\u062A\u064E\u0648\u0652\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0628\u064E\u0639\u0652\u062F\u064E \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u0650 (\u0628\u0639\u062F \u0646\u0632\u0648\u0644 \u0622\u064A\u0629 \u0631\u0642\u0645: 3 \u0645\u0646 \u0633\u0648\u0631\u0629 \u0627\u0644\u0646\u0633\u0627\u0621.): \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F { \u0648\u064E\u064A\u064E\u0633\u0652\u062A\u064E\u0641\u0652\u062A\u064F\u0648\u0646\u064E\u0643\u064E \u0641\u0650\u0649 \u0671\u0644\u0646\u0651\u0650\u0633\u064E\u0627\u0653\u0621\u0650 \u06D6 } \u0625\u0650\u0644\u064E\u0649 \u0642\u064E\u0648\u0652\u0644\u0650\u0647\u0650 { \u0648\u064E\u062A\u064E\u0631\u0652\u063A\u064E\u0628\u064F\u0648\u0646\u064E \u0623\u064E\u0646 \u062A\u064E\u0646\u0643\u0650\u062D\u064F\u0648\u0647\u064F\u0646\u0651\u064E }...",
