        "63_7": {
            "title": "\u0647\u064F\u0645\u064F \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u064A\u064E\u0642\u064F\u0648\u0644\u064F\u0648\u0646\u064E \u0644\u064E\u0627 \u062A\u064F\u0646\u0652\u0641\u0650\u0642\u064F\u0648\u0627 \u0639\u064E\u0644\u064E\u0649\u0670 \u0645\u064E\u0646\u0652 \u0639\u0650\u0646\u0652\u062F\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u062D\u064E\u062A\u0651\u064E\u0649\u0670 \u064A\u064E\u0646\u0652\u0641\u064E\u0636\u0651\u064F\u0648\u0627 \u06D7 \u0648\u064E\u0644\u0650\u0644\u0651\u064E\u0647\u0650 \u062E\u064E\u0632\u064E\u0627\u0626\u0650\u0646\u064F \u0627\u0644\u0633\u0651\u064E\u0645\u064E\u0627\u0648\u064E\u0627\u062A\u0650 \u0648\u064E\u0627\u0644\u0652\u0623\u064E\u0631\u0652\u0636\u0650 \u0648\u064E\u0644\u064E\u0670\u0643\u0650\u0646\u0651\u064E \u0627\u0644\u0652\u0645\u064F\u0646\u064E\u0627\u0641\u0650\u0642\u0650\u064A\u0646\u064E \u0644\u064E\u0627 \u064A\u064E\u0641\u0652\u0642\u064E\u0647\u064F\u0648\u0646\u064E",
            "sabab": "\u0639\u064E\u0646\u0652 \u0632\u064E\u064A\u0652\u062F\u0650 \u0628\u0652\u0646\u0650 \u0623\u064E\u0631\u0652\u0642\u064E\u0645\u064E \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u064E\u0627\u0644\u064E: \u0644\u064E\u0645\u0651\u064E\u0627 \u0642\u064E\u0627\u0644\u064E \u0639\u064E\u0628\u0652\u062F\u064F \u0627\u0644\u0644\u0647\u0650 \u0628\u0652\u0646\u064F \u0623\u064F\u0628\u064E\u064A\u0651\u064D: { \u0644\u064E\u0627 \u062A\u064F\u0646\u0641\u0650\u0642\u064F\u0648\u0627\u06DF \u0639\u064E\u0644\u064E\u0649\u0670 \u0645\u064E\u0646\u0652 \u0639\u0650\u0646\u062F\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0671\u0644\u0644\u0651\u064E\u0647\u0650 }\u060C \u0648\u064E\u0642\u064E\u0627\u0644\u064E \u0623\u064E\u064A\u0652\u0636\u0627\u064B: { \u0644\u064E\u0626\u0650\u0646 \u0631\u0651\u064E\u062C\u064E\u0639\u0652\u0646\u064E\u0627\u0653 \u0625\u0650\u0644\u064E\u0649 \u0671\u0644\u0652\u0645\u064E\u062F\u0650\u064A\u0646\u064E\u0629\u0650 } \u0623\u064E\u062E\u0652\u0628\u064E\u0631\u0652\u062A\u064F \u0628\u0650\u0647\u0650 \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064E \uFDFA \u0641\u064E\u0644\u064E\u0627\u0645\u064E\u0646\u0650\u064A \u0627\u0644\u0652\u0623\u064E\u0646\u0652\u0635\u064E\u0627\u0631\u064F\u060C \u0648\u064E\u062D\u064E\u0644\u064E\u0641\u064E \u0639\u064E\u0628\u064E\u062F\u064F \u0627\u0644\u0644\u0647\u0650 \u0628\u0652\u0646\u064F \u0623\u064F\u0628\u064E\u064A\u0651\u064D \u0645\u064E\u0627 \u0642\u064E\u0627\u0644\u064E \u0630\u064E\u0644\u0650\u0643\u064E\u060C \u0641\u064E\u0631\u064E\u062C\u064E\u0639\u0652\u062A\u064F \u0625\u0650\u0644\u064E\u0649 \u0627\u0644\u0652\u0645\u064E\u0646\u0652\u0632\u0650\u0644\u0650 \u0641\u064E\u0646\u0650\u0645\u0652\u062A\u064F\u060C \u0641\u064E\u062F\u064E\u0639\u064E\u0627\u0646\u0650\u064A \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0641\u064E\u0623\u064E\u062A\u064E\u064A\u0652\u062A\u064F\u0647\u064F\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E: \xab \u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0644\u0647\u064E \u0642\u064E\u062F\u0652 \u0635\u064E\u062F\u0651\u064E\u0642\u064E\u0643\u064E \xbb \u0648\u064E\u0646\u064E\u0632\u064E\u0644\u064E: { \u0647\u064F\u0645\u064F \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u064A\u064E\u0642\u064F\u0648\u0644\u064F\u0648\u0646\u064E \u0644\u064E\u0627 \u062A\u064F\u0646\u0641\u0650\u0642\u064F\u0648\u0627\u06DF } \u0627\u0644\u0622\u064A\u064E\u0629\u064E. \n\n\u0648\u0641\u064A \u0644\u0641\u0638 \u0644\u0623\u062D\u0645\u062F: \u0639\u064E\u0646\u0652 \u0632\u064E\u064A\u0652\u062F\u0650 \u0628\u0652\u0646\u0650 \u0623\u064E\u0631\u0652\u0642\u064E\u0645\u064E \u0642\u064E\u0627\u0644\u064E: \u0643\u064F\u0646\u0652\u062A\u064F \u0645\u064E\u0639\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0641\u0650\u064A \u063A\u064E\u0632\u0652\u0648\u064E\u0629\u064D \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0639\u064E\u0628\u0652\u062F\u064F \u0627\u0644\u0644\u0647\u0650 \u0628\u0652\u0646\u064F \u0623\u064F\u0628\u064E\u064A\u0651\u064D: \u0644\u064E\u0626\u0650\u0646\u0652 \u0631\u064E\u062C\u064E\u0639\u0652\u0646\u064E\u0627 \u0625\u0650\u0644\u064E\u0649 \u0627\u0644\u0652\u0645\u064E\u062F\u0650\u064A\u0646\u064E\u0629\u0650 \u0644\u064E\u064A\u064F\u062E\u0652\u0631\u0650\u062C\u064E\u0646\u0651\u064E \u0627\u0644\u0652\u0623\u064E\u0639\u064E\u0632\u0651\u064F \u0645\u0650\u0646\u0652\u0647\u064E\u0627 \u0627\u0644\u0652\u0623\u064E\u0630\u064E\u0644\u0651\u064E. \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0623\u064E\u062A\u064E\u064A\u0652\u062A\u064F \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0641\u064E\u0623\u064E\u062E\u0652\u0628\u064E\u0631\u0652\u062A\u064F\u0647\u064F\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u062D\u064E\u0644\u064E\u0641\u064E \u0639\u064E\u0628\u0652\u062F\u064F \u0627\u0644\u0644\u0647\u0650 \u0628\u0652\u0646\u064F \u0623\u064F\u0628\u0650\u064A\u0651\u064D \u0623\u064E\u0646\u0651\u064E\u0647\u064F \u0644\u064E\u0645\u0652 \u064A\u064E\u0643\u064F\u0646\u0652 \u0634\u064E\u064A\u0652\u0621\u064C \u0645\u0650\u0646\u0652 \u0630\u064E\u0644\u0650\u0643\u064E\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0644\u064E\u0627\u0645\u064E\u0646\u0650\u064A \u0642\u064E\u0648\u0652\u0645\u0650\u064A\u060C \u0648\u064E\u0642\u064E\u0627\u0644\u064F\u0648\u0627: \u0645\u064E\u0627 \u0623\u064E\u0631\u064E\u062F\u0652\u062A\u064E \u0625\u0650\u0644\u064E\u0649 \u0647\u064E\u0630\u064E\u0627\u061F!\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0627\u0646\u0652\u0637\u064E\u0644\u064E\u0642\u0652\u062A\u064F \u0641\u064E\u0646\u0650\u0645\u0652\u062A\u064F \u0643\u064E\u0626\u0650\u064A\u0628\u0627\u064B \u0623\u064E\u0648\u0652 \u062D\u064E\u0632\u0650\u064A\u0646\u0627\u064B\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0623\u064E\u0631\u0652\u0633\u064E\u0644\u064E \u0625\u0650\u0644\u064E\u064A\u0651\u064E \u0646\u064E\u0628\u0650\u064A\u0651\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA\u060C \u0623\u064E\u0648\u0652 \u0623\u064E\u062A\u064E\u064A\u0652\u062A\u064F \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \uFDFA\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E: \u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0644\u0647\u064E \u0639\u0632 \u0648 \u062C\u0644 \u0642\u064E\u062F\u0652 \u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0639\u064F\u0630\u0652\u0631\u064E\u0643\u064E \u0648\u064E\u0635\u064E\u062F\u0651\u064E\u0642\u064E\u0643\u064E\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652 \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u064F: { \u0647\u064F\u0645\u064F \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u064A\u064E\u0642\u064F\u0648\u0644\u064F\u0648\u0646\u064E \u0644\u064E\u0627 \u062A\u064F\u0646\u0641\u0650\u0642\u064F\u0648\u0627\u06DF \u0639\u064E\u0644\u064E\u0649\u0670 \u0645\u064E\u0646\u0652 \u0639\u0650\u0646\u062F\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0671\u0644\u0644\u0651\u064E\u0647\u0650 \u062D\u064E\u062A\u0651\u064E\u0649\u0670 \u064A\u064E\u0646\u0641\u064E\u0636\u0651\u064F\u0648\u0627\u06DF \u06D7 } \u062D\u062A\u064A \u0628\u0644\u063A { \u0644\u064E\u0626\u0650\u0646 \u0631\u0651\u064E\u062C\u064E\u0639\u0652\u0646\u064E\u0627\u0653 \u0625\u0650\u0644\u064E\u0649 \u0671\u0644\u0652\u0645\u064E\u062F\u0650\u064A\u0646\u064E\u0629\u0650 \u0644\u064E\u064A\u064F\u062E\u0652\u0631\u0650\u062C\u064E\u0646\u0651\u064E \u0671\u0644\u0652\u0623\u064E\u0639\u064E\u0632\u0651\u064F \u0645\u0650\u0646\u0652\u0647\u064E\u0627 \u0671\u0644\u0652\u0623\u064E\u0630\u064E\u0644\u0651\u064E \u06DA }.",
            "fadl": "",
            "action": ""
        },
        "63_8": {
            "title": "\u064A\u064E\u0642\u064F\u0648\u0644\u064F\u0648\u0646\u064E \u0644\u064E\u0626\u0650\u0646\u0652 \u0631\u064E\u062C\u064E\u0639\u0652\u0646\u064E\u0627 \u0625\u0650\u0644\u064E\u0649 \u0627\u0644\u0652\u0645\u064E\u062F\u0650\u064A\u0646\u064E\u0629\u0650 \u0644\u064E\u064A\u064F\u062E\u0652\u0631\u0650\u062C\u064E\u0646\u0651\u064E \u0627\u0644\u0652\u0623\u064E\u0639\u064E\u0632\u0651\u064F \u0645\u0650\u0646\u0652\u0647\u064E\u0627 \u0627\u0644\u0652\u0623\u064E\u0630\u064E\u0644\u0651\u064E \u06DA \u0648\u064E\u0644\u0650\u0644\u0651\u064E\u0647\u0650 \u0627\u0644\u0652\u0639\u0650\u0632\u0651\u064E\u0629\u064F \u0648\u064E\u0644\u0650\u0631\u064E\u0633\u064F\u0648\u0644\u0650\u0647\u0650 \u0648\u064E\u0644\u0650\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u0650\u064A\u0646\u064E \u0648\u064E\u0644\u064E\u0670\u0643\u0650\u0646\u0651\u064E \u0627\u0644\u0652\u0645\u064F\u0646\u064E\u0627\u0641\u0650\u0642\u0650\u064A\u0646\u064E \u0644\u064E\u0627 \u064A\u064E\u0639\u0652\u0644\u064E\u0645\u064F\u0648\u0646\u064E",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 7 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
            "fadl": "",
            "action": ""
        },
        "63_9": {
            "title": "\u064A\u0627 \u0623\u064A\u0647\u0627 \u0627\u0644\u0630\u064A\u0646 \u0622\u0645\u0646\u0648\u0627 \u0644\u0627 \u062A\u0644\u0647\u0643\u0645 \u0623\u0645\u0648\u0627\u0644\u0643\u0645",
            "sabab": "\u062A\u062D\u0630\u064A\u0631 \u0645\u0646 \u0627\u0644\u0644\u0647 \u0644\u0644\u0645\u0624\u0645\u0646\u064A\u0646 \u0623\u0644\u0627 \u062A\u0634\u063A\u0644\u0647\u0645 \u0627\u0644\u062F\u0646\u064A\u0627 (\u0627\u0644\u0645\u0627\u0644 \u0648\u0627\u0644\u0623\u0648\u0644\u0627\u062F) \u0639\u0646 \u0627\u0644\u0635\u0644\u0627\u0629 \u0648\u0627\u0644\u0637\u0627\u0639\u0629 \u0643\u0645\u0627 \u0634\u063A\u0644\u062A \u0627\u0644\u0645\u0646\u0627\u0641\u0642\u064A\u0646.",
            "fadl": "",
            "action": "\u0627\u0644\u0645\u0627\u0644 \u0648\u0627\u0644\u0623\u0648\u0644\u0627\u062F \u0632\u064A\u0646\u0629 \u0648\u0646\u0639\u0645\u0629\u060C \u0641\u0644\u0627 \u062A\u062C\u0639\u0644\u0647\u0627 \u0633\u0628\u0628\u0627\u064B \u0641\u064A \u063A\u0641\u0644\u062A\u0643 \u0639\u0646 \u0635\u0644\u0627\u062A\u0643 \u0648\u0642\u0631\u0622\u0646\u0643 \u0644\u0643\u064A \u0644\u0627 \u062A\u0643\u0648\u0646 \u0645\u0646 \u0627\u0644\u062E\u0627\u0633\u0631\u064A\u0646."
        },
        "64_14": {
            "title": "\u064A\u064E\u0627 \u0623\u064E\u064A\u0651\u064F\u0647\u064E\u0627 \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0622\u0645\u064E\u0646\u064F\u0648\u0627 \u0625\u0650\u0646\u0651\u064E \u0645\u0650\u0646\u0652 \u0623\u064E\u0632\u0652\u0648\u064E\u0627\u062C\u0650\u0643\u064F\u0645\u0652 \u0648\u064E\u0623\u064E\u0648\u0652\u0644\u064E\u0627\u062F\u0650\u0643\u064F\u0645\u0652 \u0639\u064E\u062F\u064F\u0648\u0651\u064B\u0627 \u0644\u064E\u0643\u064F\u0645\u0652 \u0641\u064E\u0627\u062D\u0652\u0630\u064E\u0631\u064F\u0648\u0647\u064F\u0645\u0652 \u06DA \u0648\u064E\u0625\u0650\u0646\u0652 \u062A\u064E\u0639\u0652\u0641\u064F\u0648\u0627 \u0648\u064E\u062A\u064E\u0635\u0652\u0641\u064E\u062D\u064F\u0648\u0627 \u0648\u064E\u062A\u064E\u063A\u0652\u0641\u0650\u0631\u064F\u0648\u0627 \u0641\u064E\u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064E \u063A\u064E\u0641\u064F\u0648\u0631\u064C \u0631\u064E\u062D\u0650\u064A\u0645\u064C",
            "sabab": "\u0639\u064E\u0646\u0650 \u0627\u0628\u0652\u0646\u0650 \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u0648\u064E\u0633\u064E\u0623\u064E\u0644\u064E\u0647\u064F \u0631\u064E\u062C\u064F\u0644\u064C \u0639\u064E\u0646\u0652 \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u0650: { \u064A\u064E\u0640\u0670\u0653\u0623\u064E\u064A\u0651\u064F\u0647\u064E\u0627 \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0621\u064E\u0627\u0645\u064E\u0646\u064F\u0648\u0653\u0627\u06DF \u0625\u0650\u0646\u0651\u064E \u0645\u0650\u0646\u0652 \u0623\u064E\u0632\u0652\u0648\u064E\u0670\u062C\u0650\u0643\u064F\u0645\u0652 \u0648\u064E\u0623\u064E\u0648\u0652\u0644\u064E\u0640\u0670\u062F\u0650\u0643\u064F\u0645\u0652 \u0639\u064E\u062F\u064F\u0648\u0651\u064B\u0627 \u0644\u0651\u064E\u0643\u064F\u0645\u0652 \u0641\u064E\u0671\u062D\u0652\u0630\u064E\u0631\u064F\u0648\u0647\u064F\u0645\u0652 \u06DA }\u060C \u0642\u064E\u0627\u0644\u064E: \u0647\u064E\u0624\u064F\u0644\u064E\u0627\u0621\u0650 \u0631\u0650\u062C\u064E\u0627\u0644\u064C \u0623\u064E\u0633\u0652\u0644\u064E\u0645\u064F\u0648\u0627 \u0645\u0650\u0646\u0652 \u0623\u064E\u0647\u0652\u0644\u0650 \u0645\u064E\u0643\u0651\u064E\u0629\u064E\u060C \u0648\u064E\u0623\u064E\u0631\u064E\u0627\u062F\u064F\u0648\u0627 \u0623\u064E\u0646\u0652 \u064A\u064E\u0623\u0652\u062A\u064F\u0648\u0627 \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064E \uFDFA\u060C \u0641\u064E\u0623\u064E\u0628\u064E\u0649 \u0623\u064E\u0632\u0652\u0648\u064E\u0627\u062C\u064F\u0647\u064F\u0645\u0652 \u0648\u064E\u0623\u064E\u0648\u0652\u0644\u064E\u0627\u062F\u064F\u0647\u064F\u0645\u0652 \u0623\u064E\u0646\u0652 \u064A\u064E\u062F\u064E\u0639\u064F\u0648\u0647\u064F\u0645\u0652 \u0623\u064E\u0646\u0652 \u064A\u064E\u0623\u0652\u062A\u064F\u0648\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \uFDFA\u060C \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0623\u064E\u062A\u064E\u0648\u0652\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0631\u064E\u0623\u064E\u0648\u0652\u0627 \u0627\u0644\u0646\u0651\u064E\u0627\u0633\u064E \u0642\u064E\u062F\u0652 \u0641\u064E\u0642\u064F\u0647\u064F\u0648\u0627 \u0641\u0650\u064A \u0627\u0644\u062F\u0651\u0650\u064A\u0646\u0650\u060C \u0647\u064E\u0645\u0651\u064F\u0648\u0627 \u0623\u064E\u0646\u0652 \u064A\u064F\u0639\u064E\u0627\u0642\u0650\u0628\u064F\u0648\u0647\u064F\u0645\u0652\u060C \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0639\u0632 \u0648 \u062C\u0644: { \u064A\u064E\u0640\u0670\u0653\u0623\u064E\u064A\u0651\u064F\u0647\u064E\u0627 \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0621\u064E\u0627\u0645\u064E\u0646\u064F\u0648\u0653\u0627\u06DF \u0625\u0650\u0646\u0651\u064E \u0645\u0650\u0646\u0652 \u0623\u064E\u0632\u0652\u0648\u064E\u0670\u062C\u0650\u0643\u064F\u0645\u0652 \u0648\u064E\u0623\u064E\u0648\u0652\u0644\u064E\u0640\u0670\u062F\u0650\u0643\u064F\u0645\u0652 \u0639\u064E\u062F\u064F\u0648\u0651\u064B\u0627 \u0644\u0651\u064E\u0643\u064F\u0645\u0652 \u0641\u064E\u0671\u062D\u0652\u0630\u064E\u0631\u064F\u0648\u0647\u064F\u0645\u0652 \u06DA } \u0627\u0644\u0622\u064A\u0629.",
            "fadl": "",
            "action": ""
        },
        "65_2": {
            "title": "\u0648\u0645\u0646 \u064A\u062A\u0642 \u0627\u0644\u0644\u0647 \u064A\u062C\u0639\u0644 \u0644\u0647 \u0645\u062E\u0631\u062C\u0627",
            "sabab": "\u0646\u0632\u0644\u062A \u0641\u064A \u0639\u0648\u0641 \u0628\u0646 \u0645\u0627\u0644\u0643 \u0627\u0644\u0623\u0634\u062C\u0639\u064A \u062D\u064A\u0646 \u0623\u064F\u0633\u0631 \u0627\u0628\u0646\u0647 \u0648\u0627\u0634\u062A\u062F \u0641\u0642\u0631\u0647\u060C \u0641\u0623\u0645\u0631\u0647 \u0627\u0644\u0646\u0628\u064A \u0628\u0643\u062B\u0631\u0629 (\u0644\u0627 \u062D\u0648\u0644 \u0648\u0644\u0627 \u0642\u0648\u0629 \u0625\u0644\u0627 \u0628\u0627\u0644\u0644\u0647)\u060C \u0641\u0641\u0643 \u0627\u0644\u0644\u0647 \u0623\u0633\u0631 \u0627\u0628\u0646\u0647 \u0648\u0631\u062C\u0639 \u0628\u063A\u0646\u0627\u0626\u0645.",
            "fadl": "",
            "action": "\u0645\u0641\u062A\u0627\u062D \u0643\u0644 \u0645\u0634\u0643\u0644\u0629 \u0645\u063A\u0644\u0642\u0629 \u0647\u0648 (\u0627\u0644\u062A\u0642\u0648\u0649). \u0627\u062A\u0631\u0643 \u0627\u0644\u0630\u0646\u0648\u0628\u060C \u0648\u0627\u0644\u062A\u0632\u0645 \u0628\u0623\u0645\u0631 \u0627\u0644\u0644\u0647\u060C \u0648\u0633\u064A\u0631\u0632\u0642\u0643 \u0645\u0646 \u0628\u0627\u0628 \u0644\u0627 \u062A\u062A\u062E\u064A\u0644\u0647 \u0623\u0628\u062F\u0627\u064B."
        },
        "65_3": {
            "title": "\u0648\u0645\u0646 \u064A\u062A\u0648\u0643\u0644 \u0639\u0644\u0649 \u0627\u0644\u0644\u0647 \u0641\u0647\u0648 \u062D\u0633\u0628\u0647",
            "sabab": "",
            "fadl": "\u0648\u0639\u062F \u0631\u0628\u0651\u0627\u0646\u064A \u0628\u0623\u0646 \u0627\u0644\u0644\u0647 \u0643\u0627\u0641\u064D \u0644\u0645\u0646 \u062A\u0648\u0643\u0644 \u0639\u0644\u064A\u0647 \u062D\u0642 \u0627\u0644\u062A\u0648\u0643\u0644 \u0645\u0639 \u0627\u0644\u0623\u062E\u0630 \u0628\u0627\u0644\u0623\u0633\u0628\u0627\u0628.",
            "action": "\u062E\u064F\u0630 \u0628\u0627\u0644\u0623\u0633\u0628\u0627\u0628 \u0643\u0627\u0645\u0644\u0627\u064B\u060C \u062B\u0645 \u0623\u0633\u0644\u0645 \u0623\u0645\u0631\u0643 \u0644\u0644\u0647\u060C \u0641\u0627\u0644\u062A\u0648\u0643\u0644 \u0644\u0627 \u064A\u0639\u0646\u064A \u0627\u0644\u0643\u0633\u0644 \u0628\u0644 \u064A\u0639\u0646\u064A \u0627\u0644\u062B\u0642\u0629 \u0628\u0639\u062F \u0627\u0644\u0639\u0645\u0644."
        },
        "66_1": {
            "title": "\u064A\u0627 \u0623\u064A\u0647\u0627 \u0627\u0644\u0646\u0628\u064A \u0644\u0645 \u062A\u062D\u0631\u0645 \u0645\u0627 \u0623\u062D\u0644 \u0627\u0644\u0644\u0647 \u0644\u0643",
            "sabab": "\u0627\u0645\u062A\u0646\u0639 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0639\u0646 \u0634\u0631\u0628 \u0627\u0644\u0639\u0633\u0644 \u0625\u0631\u0636\u0627\u0621\u064B \u0644\u0628\u0639\u0636 \u0632\u0648\u062C\u0627\u062A\u0647 \u0628\u0639\u062F \u0623\u0646 \u062A\u0638\u0627\u0647\u0631\u0646 \u0628\u0623\u0646 \u0631\u0627\u0626\u062D\u062A\u0647 \u0633\u064A\u0626\u0629\u060C \u0641\u0639\u0627\u062A\u0628\u0647 \u0627\u0644\u0644\u0647 \u0628\u0623\u0644\u0627 \u064A\u062D\u0631\u0645 \u062D\u0644\u0627\u0644\u0627\u064B \u0625\u0631\u0636\u0627\u0621\u064B \u0644\u0623\u062D\u062F.",
            "fadl": "",
            "action": "\u0644\u0627 \u062A\u062A\u0631\u0643 \u062D\u0642\u0627\u064B \u0623\u0648 \u062D\u0644\u0627\u0644\u0627\u064B \u0623\u0648 \u0645\u062A\u0639\u0629 \u0645\u0628\u0627\u062D\u0629 \u0625\u0631\u0636\u0627\u0621\u064B \u0644\u0644\u0646\u0627\u0633 \u0639\u0644\u0649 \u062D\u0633\u0627\u0628 \u0646\u0641\u0633\u0643. \u0627\u0644\u062A\u0648\u0627\u0632\u0646 \u0648\u0627\u0644\u0639\u062F\u0644 \u0645\u0637\u0644\u0628 \u0634\u0631\u0639\u064A."
        },
        "66_4": {
            "title": "\u0625\u0650\u0646\u0652 \u062A\u064E\u062A\u064F\u0648\u0628\u064E\u0627 \u0625\u0650\u0644\u064E\u0649 \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u0641\u064E\u0642\u064E\u062F\u0652 \u0635\u064E\u063A\u064E\u062A\u0652 \u0642\u064F\u0644\u064F\u0648\u0628\u064F\u0643\u064F\u0645\u064E\u0627 \u06D6 \u0648\u064E\u0625\u0650\u0646\u0652 \u062A\u064E\u0638\u064E\u0627\u0647\u064E\u0631\u064E\u0627 \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650 \u0641\u064E\u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064E \u0647\u064F\u0648\u064E \u0645\u064E\u0648\u0652\u0644\u064E\u0627\u0647\u064F \u0648\u064E\u062C\u0650\u0628\u0652\u0631\u0650\u064A\u0644\u064F \u0648\u064E\u0635\u064E\u0627\u0644\u0650\u062D\u064F \u0627\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u0650\u064A\u0646\u064E \u06D6 \u0648\u064E\u0627\u0644\u0652\u0645\u064E\u0644\u064E\u0627\u0626\u0650\u0643\u064E\u0629\u064F \u0628\u064E\u0639\u0652\u062F\u064E \u0630\u064E\u0670\u0644\u0650\u0643\u064E \u0638\u064E\u0647\u0650\u064A\u0631\u064C",
            "sabab": "\u0639\u064E\u0646\u0652 \u0623\u064E\u0646\u064E\u0633\u0650 \u0628\u0652\u0646\u0650 \u0645\u064E\u0627\u0644\u0650\u0643\u064D \u0642\u064E\u0627\u0644\u064E: \u0642\u064E\u0627\u0644\u064E \u0639\u064F\u0645\u064E\u0631\u064F \u0628\u0652\u0646\u064F \u0627\u0644\u0652\u062E\u064E\u0637\u0651\u064E\u0627\u0628\u0650 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647: (\u0648\u064E\u0627\u0641\u064E\u0642\u0652\u062A\u064F \u0631\u064E\u0628\u0651\u0650\u064A \u0641\u0650\u064A \u062B\u064E\u0644\u064E\u0627\u062B\u064D... ) (... \u0648\u064E\u0627\u062C\u0652\u062A\u064E\u0645\u064E\u0639\u064E \u0646\u0650\u0633\u064E\u0627\u0621\u064F \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u0650 \uFDFA \u0641\u0650\u064A \u0627\u0644\u0652\u063A\u064E\u064A\u0652\u0631\u064E\u0629\u0650 \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650\u060C \u0641\u064E\u0642\u064F\u0644\u0652\u062A\u064F \u0644\u064E\u0647\u064F\u0646\u0651\u064E: { \u0639\u064E\u0633\u064E\u0649\u0670 \u0631\u064E\u0628\u0651\u064F\u0647\u064F\u06E5\u0653 \u0625\u0650\u0646 \u0637\u064E\u0644\u0651\u064E\u0642\u064E\u0643\u064F\u0646\u0651\u064E \u0623\u064E\u0646 \u064A\u064F\u0628\u0652\u062F\u0650\u0644\u064E\u0647\u064F\u06E5\u0653 \u0623\u064E\u0632\u0652\u0648\u064E\u0670\u062C\u064B\u0627 \u062E\u064E\u064A\u0652\u0631\u064B\u0627 \u0645\u0651\u0650\u0646\u0643\u064F\u0646\u0651\u064E } \u0641\u064E\u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652 \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0622\u064A\u0629\u064F ).\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0639\u064E\u0646\u0652 \u0639\u064E\u0628\u0652\u062F\u0650 \u0627\u0644\u0644\u0647\u0650 \u0628\u0652\u0646\u0650 \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627: \u062D\u064E\u062F\u0651\u064E\u062B\u064E\u0646\u0650\u064A \u0639\u064F\u0645\u064E\u0631\u064F \u0628\u0652\u0646\u064F \u0627\u0644\u0652\u062E\u064E\u0637\u0651\u064E\u0627\u0628\u0650 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u064E\u0627\u0644\u064E: ( \u0644\u064E\u0645\u0651\u064E\u0627 \u0627\u0639\u0652\u062A\u064E\u0632\u064E\u0644\u064E \u0646\u064E\u0628\u0650\u064A\u0651\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0646\u0650\u0633\u064E\u0627\u0621\u064E\u0647\u064F... ) (... \u0648\u064E\u062F\u064E\u062E\u064E\u0644\u0652\u062A\u064F \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650 \u062D\u0650\u064A\u0646\u064E \u062F\u064E\u062E\u064E\u0644\u0652\u062A\u064F\u060C \u0648\u064E\u0623\u064E\u0646\u064E\u0627 \u0623\u064E\u0631\u064E\u0649 \u0641\u0650\u064A \u0648\u064E\u062C\u0652\u0647\u0650\u0647\u0650 \u0627\u0644\u0652\u063A\u064E\u0636\u064E\u0628\u064E\u060C \u0641\u064E\u0642\u064F\u0644\u0652\u062A\u064F: \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650\u060C \u0645\u064E\u0627 \u064A\u064E\u0634\u064F\u0642\u0651\u064F \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064E \u0645\u0650\u0646\u0652 \u0634\u064E\u0623\u0652\u0646\u0650 \u0627\u0644\u0646\u0651\u0650\u0633\u064E\u0627\u0621\u0650\u060C \u0641\u064E\u0625\u0650\u0646\u0652 \u0643\u064F\u0646\u0652\u062A\u064E \u0637\u064E\u0644\u0651\u064E\u0642\u0652\u062A\u064E\u0647\u064F\u0646\u0651\u064E\u060C \u0641\u064E\u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0644\u0647\u064E \u0645\u064E\u0639\u064E\u0643\u064E\u060C \u0648\u064E\u0645\u064E\u0644\u064E\u0627\u0626\u0650\u0643\u064E\u062A\u064E\u0647\u064F\u060C \u0648\u064E\u062C\u0650\u0628\u0652\u0631\u0650\u064A\u0644\u064E\u060C \u0648\u064E\u0645\u0650\u064A\u0643\u064E\u0627\u0626\u0650\u064A\u0644\u064E \u0648\u064E\u0623\u064E\u0646\u064E\u0627 \u0648\u064E\u0623\u064E\u0628\u064F\u0648 \u0628\u064E\u0643\u0652\u0631\u064D\u060C \u0648\u064E\u0627\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u064F\u0648\u0646\u064E \u0645\u064E\u0639\u064E\u0643\u064E. \u0648\u064E\u0642\u064E\u0644\u0651\u064E\u0645\u064E\u0627 \u062A\u064E\u0643\u064E\u0644\u0651\u064E\u0645\u0652\u062A\u064F - \u0648\u064E\u0623\u064E\u062D\u0652\u0645\u064E\u062F\u064F \u0627\u0644\u0644\u0647\u064E - \u0628\u0650\u0643\u064E\u0644\u064E\u0627\u0645\u064D \u0625\u0650\u0644\u0651\u064E\u0627 \u0631\u064E\u062C\u064E\u0648\u0652\u062A\u064F \u0623\u064E\u0646\u0652 \u064A\u064E\u0643\u064F\u0648\u0646\u064E \u0627\u0644\u0644\u0647\u064F \u064A\u064F\u0635\u064E\u062F\u0651\u0650\u0642\u064F \u0642\u064E\u0648\u0652\u0644\u0650\u064A \u0627\u0644\u0651\u064E\u0630\u0650\u064A \u0623\u064E\u0642\u064F\u0648\u0644\u064F\u060C \u0648\u064E\u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652 \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u064F \u0622\u064A\u064E\u0629\u064F \u0627\u0644\u062A\u0651\u064E\u062D\u0652\u064A\u0650\u064A\u0631\u0650 { \u0639\u064E\u0633\u064E\u0649\u0670 \u0631\u064E\u0628\u0651\u064F\u0647\u064F\u06E5\u0653 \u0625\u0650\u0646 \u0637\u064E\u0644\u0651\u064E\u0642\u064E\u0643\u064F\u0646\u0651\u064E \u0623\u064E\u0646 \u064A\u064F\u0628\u0652\u062F\u0650\u0644\u064E\u0647\u064F\u06E5\u0653 \u0623\u064E\u0632\u0652\u0648\u064E\u0670\u062C\u064B\u0627 \u062E\u064E\u064A\u0652\u0631\u064B\u0627 \u0645\u0651\u0650\u0646\u0643\u064F\u0646\u0651\u064E }... { \u0648\u064E\u0625\u0650\u0646 \u062A\u064E\u0638\u064E\u0640\u0670\u0647\u064E\u0631\u064E\u0627 \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650 \u0641\u064E\u0625\u0650\u0646\u0651\u064E \u0671\u0644\u0644\u0651\u064E\u0647\u064E \u0647\u064F\u0648\u064E \u0645\u064E\u0648\u0652\u0644\u064E\u0649\u0670\u0647\u064F \u0648\u064E\u062C\u0650\u0628\u0652\u0631\u0650\u064A\u0644\u064F \u0648\u064E\u0635\u064E\u0640\u0670\u0644\u0650\u062D\u064F \u0671\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u0650\u064A\u0646\u064E \u06D6 \u0648\u064E\u0671\u0644\u0652\u0645\u064E\u0644\u064E\u0640\u0670\u0653\u0626\u0650\u0643\u064E\u0629\u064F \u0628\u064E\u0639\u0652\u062F\u064E \u0630\u064E\u0670\u0644\u0650\u0643\u064E \u0638\u064E\u0647\u0650\u064A\u0631\u064C }.\n\n\u0648\u064E\u0643\u064E\u0627\u0646\u064E\u062A\u0652 \u0639\u064E\u0627\u0626\u0650\u0634\u064E\u0629\u064F \u0628\u0650\u0646\u0652\u062A\u064F \u0623\u064E\u0628\u0650\u064A \u0628\u064E\u0643\u0652\u0631\u064D\u060C \u0648\u064E\u062D\u064E\u0641\u0652\u0635\u064E\u0629\u064F\u060C \u062A\u064E\u0638\u064E\u0627\u0647\u064E\u0631\u064E\u0627\u0646\u0650 \u0639\u064E\u0644\u064E\u0649 \u0633\u064E\u0627\u0626\u0650\u0631\u0650 \u0646\u0650\u0633\u064E\u0627\u0621\u0650 \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u0650 \uFDFA\u060C \u0641\u064E\u0642\u064F\u0644\u0652\u062A\u064F: \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650\u060C \u0623\u064E\u0637\u064E\u0644\u0651\u064E\u0642\u0652\u062A\u064E\u0647\u064F\u0646\u0651\u064E\u061F \u0642\u064E\u0627\u0644\u064E: \xab \u0644\u0627 \xbb\u060C \u0642\u064F\u0644\u0652\u062A\u064F: \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \u0625\u0650\u0646\u0651\u0650\u064A \u062F\u064E\u062E\u064E\u0644\u0652\u062A\u064F \u0627\u0644\u0652\u0645\u064E\u0633\u0652\u062C\u0650\u062F\u064E\u060C \u0648\u064E\u0627\u0644\u0652\u0645\u064F\u0633\u0652\u0644\u0650\u0645\u064F\u0648\u0646\u064E \u064A\u064E\u0646\u0652\u0643\u064F\u062A\u064F\u0648\u0646\u064E \u0628\u0650\u0627\u0644\u0652\u062D\u064E\u0635\u064E\u0649\u060C \u064A\u064E\u0642\u064F\u0648\u0644\u064F\u0648\u0646\u064E: \u0637\u064E\u0644\u0651\u064E\u0642\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0646\u0650\u0633\u064E\u0627\u0621\u064E\u0647\u064F\u060C \u0623\u064E\u0641\u064E\u0623\u064E\u0646\u0652\u0632\u0650\u0644\u064F \u0641\u064E\u0623\u064F\u062E\u0652\u0628\u0650\u0631\u064E\u0647\u064F\u0645\u0652 \u0623\u064E\u0646\u0651\u064E\u0643\u064E \u0644\u064E\u0645\u0652 \u062A\u064F\u0637\u064E\u0644\u0651\u0650\u0642\u0652\u0647\u064F\u0646\u0651\u064E\u061F \u0642\u064E\u0627\u0644\u064E: \xab \u0646\u064E\u0639\u064E\u0645\u0652\u060C \u0625\u0650\u0646\u0652 \u0634\u0650\u0626\u0652\u062A\u064E \xbb. \u0641\u064E\u0644\u064E\u0645\u0652 \u0623\u064E\u0632\u064E\u0644\u0652 \u0623\u064F\u062D\u064E\u062F\u0651\u0650\u062B\u064F\u0647\u064F \u062D\u064E\u062A\u0651\u064E\u0649 \u062A\u064E\u062D\u064E\u0633\u0651\u064E\u0631\u064E \u0627\u0644\u0652\u063A\u064E\u0636\u064E\u0628\u064F \u0639\u064E\u0646\u0652 \u0648\u064E\u062C\u0652\u0647\u0650\u0647\u0650\u060C \u0648\u064E\u062D\u064E\u062A\u0651\u064E\u0649 \u0643\u064E\u0634\u064E\u0631\u064E \u0641\u064E\u0636\u064E\u062D\u0650\u0643\u064E\u060C \u0648\u064E\u0643\u064E\u0627\u0646\u064E \u0645\u0650\u0646\u0652 \u0623\u064E\u062D\u0652\u0633\u064E\u0646\u0650 \u0627\u0644\u0646\u0651\u064E\u0627\u0633\u0650 \u062B\u064E\u063A\u0652\u0631\u0627\u064B.\n\n\u062B\u064F\u0645\u0651\u064E \u0646\u064E\u0632\u064E\u0644\u064E \u0646\u064E\u0628\u0650\u064A\u0651\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0648\u064E\u0646\u064E\u0632\u064E\u0644\u0652\u062A\u064F\u060C \u0641\u064E\u0646\u064E\u0632\u064E\u0644\u0652\u062A\u064F \u0623\u064E\u062A\u064E\u0634\u064E\u0628\u0651\u064E\u062B\u064F \u0628\u0650\u0627\u0644\u0652\u062C\u0650\u0630\u0652\u0639\u0650\u060C \u0648\u064E\u0646\u064E\u0632\u064E\u0644\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0643\u064E\u0623\u064E\u0646\u0651\u064E\u0645\u064E\u0627 \u064A\u064E\u0645\u0652\u0634\u0650\u064A \u0639\u064E\u0644\u064E\u0649 \u0627\u0644\u0652\u0623\u064E\u0631\u0652\u0636\u0650 \u0645\u064E\u0627 \u064A\u064E\u0645\u064E\u0633\u0651\u064F\u0647\u064F \u0628\u0650\u064A\u064E\u062F\u0650\u0647\u0650\u060C \u0641\u064E\u0642\u064F\u0644\u0652\u062A\u064F: \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650\u060C \u0625\u0650\u0646\u0651\u064E\u0645\u064E\u0627 \u0643\u064F\u0646\u0652\u062A\u064E \u0641\u0650\u064A \u0627\u0644\u0652\u063A\u064F\u0631\u0652\u0641\u064E\u0629\u0650 \u062A\u0650\u0633\u0652\u0639\u064E\u0629\u064B \u0648\u064E\u0639\u0650\u0634\u0652\u0631\u0650\u064A\u0646\u064E\u060C \u0642\u064E\u0627\u0644\u064E: \xab \u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0634\u0651\u064E\u0647\u0652\u0631\u064E \u064A\u064E\u0643\u064F\u0648\u0646\u064F \u062A\u0650\u0633\u0652\u0639\u0627\u064B \u0648\u064E\u0639\u0650\u0634\u0652\u0631\u0650\u064A\u0646\u064E \xbb\u060C \u0641\u064E\u0642\u064F\u0645\u0652\u062A\u064F \u0639\u064E\u0644\u064E\u0649 \u0628\u064E\u0627\u0628\u0650 \u0627\u0644\u0652\u0645\u064E\u0633\u0652\u062C\u0650\u062F\u0650\u060C \u0641\u064E\u0646\u064E\u0627\u062F\u064E\u064A\u0652\u062A\u064F \u0628\u0650\u0623\u064E\u0639\u0652\u0644\u064E\u0649 \u0635\u064E\u0648\u0652\u062A\u0650\u064A: \u0644\u064E\u0645\u0652 \u064A\u064F\u0637\u064E\u0644\u0651\u0650\u0642\u0652 \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0646\u0650\u0633\u064E\u0627\u0621\u064E\u0647\u064F\u060C \u0648\u064E\u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652 \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u064F: { \u0648\u064E\u0625\u0650\u0630\u064E\u0627 \u062C\u064E\u0627\u0653\u0621\u064E\u0647\u064F\u0645\u0652 \u0623\u064E\u0645\u0652\u0631\u064C \u0645\u0651\u0650\u0646\u064E \u0671\u0644\u0652\u0623\u064E\u0645\u0652\u0646\u0650 \u0623\u064E\u0648\u0650 \u0671\u0644\u0652\u062E\u064E\u0648\u0652\u0641\u0650 \u0623\u064E\u0630\u064E\u0627\u0639\u064F\u0648\u0627\u06DF \u0628\u0650\u0647\u0650\u06E6 \u06D6 \u0648\u064E\u0644\u064E\u0648\u0652 \u0631\u064E\u062F\u0651\u064F\u0648\u0647\u064F \u0625\u0650\u0644\u064E\u0649 \u0671\u0644\u0631\u0651\u064E\u0633\u064F\u0648\u0644\u0650 \u0648\u064E\u0625\u0650\u0644\u064E\u0649\u0670\u0653 \u0623\u064F\u0648\u06DF\u0644\u0650\u0649 \u0671\u0644\u0652\u0623\u064E\u0645\u0652\u0631\u0650 \u0645\u0650\u0646\u0652\u0647\u064F\u0645\u0652 \u0644\u064E\u0639\u064E\u0644\u0650\u0645\u064E\u0647\u064F \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u064A\u064E\u0633\u0652\u062A\u064E\u0646\u06E2\u0628\u0650\u0637\u064F\u0648\u0646\u064E\u0647\u064F\u06E5 \u0645\u0650\u0646\u0652\u0647\u064F\u0645\u0652 \u06D7 }\u060C \u0641\u064E\u0643\u064F\u0646\u0652\u062A\u064F \u0623\u064E\u0646\u064E\u0627 \u0627\u0633\u0652\u062A\u064E\u0646\u0652\u0628\u064E\u0637\u0652\u062A\u064F \u0630\u064E\u0644\u0650\u0643\u064E \u0627\u0644\u0652\u0623\u064E\u0645\u0652\u0631\u064E \u0648\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0639\u0632 \u0648 \u062C\u0644 \u0622\u064A\u064E\u0629\u064E \u0627\u0644\u062A\u0651\u064E\u062E\u0652\u064A\u0650\u064A\u0631\u0650.",
            "fadl": "",
            "action": ""
        },
        "66_5": {
            "title": "\u0639\u064E\u0633\u064E\u0649\u0670 \u0631\u064E\u0628\u0651\u064F\u0647\u064F \u0625\u0650\u0646\u0652 \u0637\u064E\u0644\u0651\u064E\u0642\u064E\u0643\u064F\u0646\u0651\u064E \u0623\u064E\u0646\u0652 \u064A\u064F\u0628\u0652\u062F\u0650\u0644\u064E\u0647\u064F \u0623\u064E\u0632\u0652\u0648\u064E\u0627\u062C\u064B\u0627 \u062E\u064E\u064A\u0652\u0631\u064B\u0627 \u0645\u0650\u0646\u0652\u0643\u064F\u0646\u0651\u064E \u0645\u064F\u0633\u0652\u0644\u0650\u0645\u064E\u0627\u062A\u064D \u0645\u064F\u0624\u0652\u0645\u0650\u0646\u064E\u0627\u062A\u064D \u0642\u064E\u0627\u0646\u0650\u062A\u064E\u0627\u062A\u064D \u062A\u064E\u0627\u0626\u0650\u0628\u064E\u0627\u062A\u064D \u0639\u064E\u0627\u0628\u0650\u062F\u064E\u0627\u062A\u064D \u0633\u064E\u0627\u0626\u0650\u062D\u064E\u0627\u062A\u064D \u062B\u064E\u064A\u0651\u0650\u0628\u064E\u0627\u062A\u064D \u0648\u064E\u0623\u064E\u0628\u0652\u0643\u064E\u0627\u0631\u064B\u0627",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 4 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
            "fadl": "",
            "action": ""
        },
        "67_2": {
            "title": "\u0627\u0644\u0630\u064A \u062E\u0644\u0642 \u0627\u0644\u0645\u0648\u062A \u0648\u0627\u0644\u062D\u064A\u0627\u0629 \u0644\u064A\u0628\u0644\u0648\u0643\u0645",
            "sabab": "",
            "fadl": "",
            "action": "\u0627\u0644\u062D\u064A\u0627\u0629 \u0643\u0644\u0647\u0627 \u0627\u062E\u062A\u0628\u0627\u0631\u060C \u0648\u0627\u0644\u0627\u0628\u062A\u0644\u0627\u0621 \u0644\u0644\u062A\u0645\u064A\u064A\u0632 \u0644\u0627 \u0644\u0644\u062A\u0639\u0630\u064A\u0628. \u0627\u0633\u0623\u0644 \u0646\u0641\u0633\u0643 \u0641\u064A \u0643\u0644 \u0645\u0648\u0642\u0641: \u0647\u0644 \u0623\u062D\u0633\u0646\u062A \u0627\u0644\u0639\u0645\u0644\u061F"
        },
        "72_1": {
            "title": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u0627\u0644\u0631\u0651\u064E\u062D\u0652\u0645\u064E\u0670\u0646\u0650 \u0627\u0644\u0631\u0651\u064E\u062D\u0650\u064A\u0645\u0650 \u0642\u064F\u0644\u0652 \u0623\u064F\u0648\u062D\u0650\u064A\u064E \u0625\u0650\u0644\u064E\u064A\u0651\u064E \u0623\u064E\u0646\u0651\u064E\u0647\u064F \u0627\u0633\u0652\u062A\u064E\u0645\u064E\u0639\u064E \u0646\u064E\u0641\u064E\u0631\u064C \u0645\u0650\u0646\u064E \u0627\u0644\u0652\u062C\u0650\u0646\u0651\u0650 \u0641\u064E\u0642\u064E\u0627\u0644\u064F\u0648\u0627 \u0625\u0650\u0646\u0651\u064E\u0627 \u0633\u064E\u0645\u0650\u0639\u0652\u0646\u064E\u0627 \u0642\u064F\u0631\u0652\u0622\u0646\u064B\u0627 \u0639\u064E\u062C\u064E\u0628\u064B\u0627",
            "sabab": "\u0639\u064E\u0646\u0650 \u0627\u0628\u0652\u0646\u0650 \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u0642\u064E\u0627\u0644\u064E: \u0627\u0646\u0652\u0637\u064E\u0644\u064E\u0642\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0641\u0650\u064A \u0637\u064E\u0627\u0626\u0650\u0641\u064E\u0629\u064D \u0645\u0650\u0646\u0652 \u0623\u064E\u0635\u0652\u062D\u064E\u0627\u0628\u0650\u0647\u0650\u060C \u0639\u064E\u0627\u0645\u0650\u062F\u0650\u064A\u0646\u064E \u0625\u0650\u0644\u064E\u0649 \u0633\u064F\u0648\u0642\u0650 \u0639\u064F\u0643\u064E\u0627\u0638\u064D\u060C \u0648\u064E\u0642\u064E\u062F\u0652 \u062D\u0650\u064A\u0644\u064E \u0628\u064E\u064A\u0652\u0646\u064E \u0627\u0644\u0634\u0651\u064E\u064A\u0652\u0627\u0637\u0650\u064A\u0646\u0650 \u0648\u064E\u0628\u064E\u064A\u0652\u0646\u064E \u062E\u064E\u0628\u064E\u0631\u0650 \u0627\u0644\u0633\u0651\u064E\u0645\u064E\u0627\u0621\u0650\u060C \u0648\u064E\u0623\u064F\u0631\u0652\u0633\u0650\u0644\u064E\u062A\u0652 \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650\u0645\u0652 \u0627\u0644\u0634\u0651\u064F\u0647\u064F\u0628\u064F\u060C \u0641\u064E\u0631\u064E\u062C\u064E\u0639\u064E\u062A\u0650 \u0627\u0644\u0634\u0651\u064E\u064A\u064E\u0627\u0637\u0650\u064A\u0646\u064F\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064F\u0648\u0627: \u0645\u064E\u0627 \u0644\u064E\u0643\u064F\u0645\u0652\u061F \u0641\u064E\u0642\u064E\u0627\u0644\u064F\u0648\u0627: \u062D\u0650\u064A\u064E\u0644\u064E \u0628\u064E\u064A\u0652\u0646\u064E\u0646\u064E\u0627 \u0648\u064E\u0628\u064E\u064A\u0652\u0646\u064E \u062E\u064E\u0628\u064E\u0631\u0650 \u0627\u0644\u0633\u0651\u064E\u0645\u064E\u0627\u0621\u0650\u060C \u0648\u064E\u0623\u064F\u0631\u0652\u0633\u0650\u0644\u064E\u062A\u0652 \u0639\u064E\u0644\u064E\u064A\u0652\u0646\u064E\u0627 \u0627\u0644\u0634\u0651\u064F\u0647\u064F\u0628\u064F\u060C \u0642\u064E\u0627\u0644\u064E: \u0645\u064E\u0627 \u062D\u064E\u0627\u0644\u064E \u0628\u064E\u064A\u0652\u0646\u064E\u0643\u064F\u0645\u0652 \u0648\u064E\u0628\u064E\u064A\u0652\u0646\u064E \u062E\u064E\u0628\u064E\u0631\u0650 \u0627\u0644\u0633\u0651\u064E\u0645\u064E\u0627\u0621\u0650 \u0625\u0650\u0644\u0651\u064E\u0627 \u0645\u064E\u0627 \u062D\u064E\u062F\u064E\u062B\u064E\u060C \u0641\u064E\u0627\u0636\u0652\u0631\u0650\u0628\u064F\u0648\u0627 \u0645\u064E\u0634\u064E\u0627\u0631\u0650\u0642\u064E \u0627\u0644\u0652\u0623\u064E\u0631\u0652\u0636\u0650 \u0648\u064E\u0645\u064E\u063A\u064E\u0627\u0631\u0650\u0628\u064E\u0647\u064E\u0627\u060C \u0641\u064E\u0627\u0646\u0652\u0638\u064F\u0631\u064F\u0648\u0627 \u0645\u064E\u0627 \u0647\u064E\u0630\u064E\u0627 \u0627\u0644\u0652\u0623\u064E\u0645\u0652\u0631\u064F \u0627\u0644\u0651\u064E\u0630\u0650\u064A \u062D\u064E\u062F\u064E\u062B\u064E. \u0641\u064E\u0627\u0646\u0652\u0637\u064E\u0644\u064E\u0642\u064F\u0648\u0627 \u0641\u064E\u0636\u064E\u0631\u064E\u0628\u064F\u0648\u0627 \u0645\u064E\u0634\u064E\u0627\u0631\u0650\u0642\u064E \u0627\u0644\u0652\u0623\u064E\u0631\u0652\u0636\u0650 \u0648\u064E\u0645\u064E\u063A\u064E\u0627\u0631\u0650\u0628\u064E\u0647\u064E\u0627\u060C \u064A\u064E\u0646\u0652\u0638\u064F\u0631\u064F\u0648\u0646\u064E \u0645\u064E\u0627 \u0647\u064E\u0630\u064E\u0627 \u0627\u0644\u0623\u064E\u0645\u0652\u0631\u064F \u0627\u0644\u0651\u064E\u0630\u0650\u064A \u062D\u064E\u0627\u0644\u064E \u0628\u064E\u064A\u0652\u0646\u064E\u0647\u064F\u0645\u0652 \u0648\u064E\u0628\u064E\u064A\u0652\u0646\u064E \u062E\u064E\u0628\u064E\u0631\u0650 \u0627\u0644\u0633\u0651\u064E\u0645\u064E\u0627\u0621\u0650\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0627\u0646\u0652\u0637\u064E\u0644\u064E\u0642\u064E \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u062A\u064E\u0648\u064E\u062C\u0651\u064E\u0647\u064F\u0648\u0627 \u0646\u064E\u062D\u0652\u0648\u064E \u062A\u0650\u0647\u064E\u0627\u0645\u064E\u0629\u064E \u0625\u0650\u0644\u064E\u0649 \u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0628\u0650\u0646\u064E\u062E\u0652\u0644\u064E\u0629\u064E\u060C \u0648\u064E\u0647\u064F\u0648\u064E \u0639\u064E\u0627\u0645\u0650\u062F\u064C \u0625\u0650\u0644\u064E\u0649 \u0633\u064F\u0648\u0642\u0650 \u0639\u064F\u0643\u064E\u0627\u0638\u064D\u060C \u0648\u064E\u0647\u064F\u0648\u064E \u064A\u064F\u0635\u064E\u0644\u0651\u0650\u064A \u0628\u0650\u0623\u064E\u0635\u0652\u062D\u064E\u0627\u0628\u0650\u0647\u0650 \u0635\u064E\u0644\u064E\u0627\u0629\u064E \u0627\u0644\u0652\u0641\u064E\u062C\u0652\u0631\u0650\u060C \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0633\u064E\u0645\u0650\u0639\u064F\u0648\u0627 \u0627\u0644\u0652\u0642\u064F\u0631\u0652\u0622\u0646\u064E \u062A\u064E\u0633\u064E\u0645\u0651\u064E\u0639\u064F\u0648\u0627 \u0644\u064E\u0647\u064F\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064F\u0648\u0627: \u0647\u064E\u0630\u064E\u0627 \u0627\u0644\u0651\u064E\u0630\u0650\u064A \u062D\u064E\u0627\u0644\u064E \u0628\u064E\u064A\u0652\u0646\u064E\u0643\u064F\u0645\u0652 \u0648\u064E\u0628\u064E\u064A\u0652\u0646\u064E \u062E\u064E\u0628\u064E\u0631\u0650 \u0627\u0644\u0633\u0651\u064E\u0645\u064E\u0627\u0621\u0650. \u0641\u064E\u0647\u064F\u0646\u064E\u0627\u0644\u0650\u0643\u064E \u0631\u064E\u062C\u064E\u0639\u064F\u0648\u0627 \u0625\u0650\u0644\u064E\u0649 \u0642\u064E\u0648\u0652\u0645\u0650\u0647\u0650\u0645\u0652\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064F\u0648\u0627: \u064A\u064E\u0627 \u0642\u064E\u0648\u0652\u0645\u064E\u0646\u064E\u0627 {... \u0625\u0650\u0646\u0651\u064E\u0627 \u0633\u064E\u0645\u0650\u0639\u0652\u0646\u064E\u0627 \u0642\u064F\u0631\u0652\u0621\u064E\u0627\u0646\u064B\u0627 \u0639\u064E\u062C\u064E\u0628\u064B\u0627 \uFD3F\u0661\uFD3E \u064A\u064E\u0647\u0652\u062F\u0650\u0649\u0653 \u0625\u0650\u0644\u064E\u0649 \u0671\u0644\u0631\u0651\u064F\u0634\u0652\u062F\u0650 \u0641\u064E\u0640\u0654\u064E\u0627\u0645\u064E\u0646\u0651\u064E\u0627 \u0628\u0650\u0647\u0650\u06E6 \u06D6 \u0648\u064E\u0644\u064E\u0646 \u0646\u0651\u064F\u0634\u0652\u0631\u0650\u0643\u064E \u0628\u0650\u0631\u064E\u0628\u0651\u0650\u0646\u064E\u0627\u0653 \u0623\u064E\u062D\u064E\u062F\u064B\u0627 \uFD3F\u0662\uFD3E }\u060C \u0648\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0639\u0632 \u0648 \u062C\u0644 \u0639\u064E\u0644\u064E\u0649 \u0646\u064E\u0628\u0650\u064A\u0651\u0650\u0647\u0650 \uFDFA: { \u0642\u064F\u0644\u0652 \u0623\u064F\u0648\u062D\u0650\u0649\u064E \u0625\u0650\u0644\u064E\u0649\u0651\u064E \u0623\u064E\u0646\u0651\u064E\u0647\u064F \u0671\u0633\u0652\u062A\u064E\u0645\u064E\u0639\u064E \u0646\u064E\u0641\u064E\u0631\u064C \u0645\u0651\u0650\u0646\u064E \u0671\u0644\u0652\u062C\u0650\u0646\u0651\u0650 } \u0648\u064E\u0625\u0650\u0646\u0651\u064E\u0645\u064E\u0627 \u0623\u064F\u0648\u062D\u0650\u064A\u064E \u0625\u0650\u0644\u064E\u064A\u0652\u0647\u0650 \u0642\u064E\u0648\u0652\u0644\u064F \u0627\u0644\u0652\u062C\u0650\u0646\u0651\u0650.",
            "fadl": "",
            "action": ""
        },
        "74_1": {
            "title": "\u064A\u0627 \u0623\u064A\u0647\u0627 \u0627\u0644\u0645\u062F\u062B\u0631 \u0642\u0645 \u0641\u0623\u0646\u0630\u0631",
            "sabab": "\u0639\u0627\u062F \u0627\u0644\u0646\u0628\u064A \uFDFA \u0645\u0646 \u063A\u0627\u0631 \u062D\u0631\u0627\u0621 \u064A\u0631\u062A\u062C\u0641 \u0645\u0646 \u0631\u0624\u064A\u0629 \u062C\u0628\u0631\u064A\u0644 \u0648\u0642\u0627\u0644 \u0644\u0632\u0648\u062C\u062A\u0647 \u062E\u062F\u064A\u062C\u0629: \u062F\u062B\u0631\u0648\u0646\u064A \u062F\u062B\u0631\u0648\u0646\u064A\u060C \u0641\u0646\u0627\u062F\u0627\u0647 \u0627\u0644\u0644\u0647 \u0644\u064A\u0642\u0648\u0645 \u0648\u064A\u0628\u062F\u0623 \u0631\u062D\u0644\u0629 \u0627\u0644\u062F\u0639\u0648\u0629 \u0627\u0644\u0637\u0648\u064A\u0644\u0629.",
            "fadl": "",
            "action": "\u0627\u0644\u0631\u0627\u062D\u0629 \u0627\u0646\u062A\u0647\u062A \u062D\u064A\u0646 \u0628\u062F\u0623 \u0627\u0644\u062A\u0643\u0644\u064A\u0641. \u0627\u0646\u0647\u0636 \u0645\u0646 \u0633\u0631\u064A\u0631\u0643 \u0648\u063A\u0637\u0627\u0621 \u0643\u0633\u0644\u0643\u060C \u0648\u0627\u0639\u0645\u0644 \u0644\u062F\u0646\u064A\u0627\u0643 \u0648\u0622\u062E\u0631\u062A\u0643 \u0628\u062D\u0645\u0627\u0633 \u0648\u0646\u0634\u0627\u0637."
        },
        "74_11": {
            "title": "\u062C\u0632\u0627\u0621 \u0627\u0644\u062A\u0643\u0630\u064A\u0628 \u0628\u0622\u064A\u0627\u062A \u0627\u0644\u0644\u0647",
            "sabab": "\u0646\u0632\u0644\u062A \u0641\u064A \u0627\u0644\u0648\u0644\u064A\u062F \u0628\u0646 \u0627\u0644\u0645\u063A\u064A\u0631\u0629 \u0627\u0644\u0645\u062E\u0632\u0648\u0645\u064A\u060C \u0627\u0644\u0630\u064A \u0643\u0641\u0631 \u0628\u0646\u0639\u0645\u0629 \u0627\u0644\u0644\u0647 \u0648\u0622\u0630\u0649 \u0627\u0644\u0631\u0633\u0648\u0644 \uFDFA \u0628\u0639\u062F \u0623\u0646 \u0628\u0633\u0637 \u0627\u0644\u0644\u0647 \u0644\u0647 \u0641\u064A \u0627\u0644\u0645\u0627\u0644 \u0648\u0627\u0644\u0648\u0644\u062F.",
            "fadl": "",
            "action": "\u0627\u062D\u0630\u0631 \u0645\u0646 \u0643\u0641\u0631\u0627\u0646 \u0627\u0644\u0646\u0639\u0645 \u0648\u0627\u0644\u0627\u063A\u062A\u0631\u0627\u0631 \u0628\u0645\u0627\u0644\u0643\u060C \u0648\u0627\u0634\u0643\u0631 \u0627\u0644\u0644\u0647 \u0639\u0644\u0649 \u0641\u0636\u0644\u0647 \u0644\u062A\u062A\u062C\u0646\u0628 \u0632\u0648\u0627\u0644 \u0627\u0644\u0646\u0639\u0645\u0629 \u0648\u0627\u0644\u0639\u0642\u0648\u0628\u0629."
        },
        "75_16": {
            "title": "\u0644\u064E\u0627 \u062A\u064F\u062D\u064E\u0631\u0651\u0650\u0643\u0652 \u0628\u0650\u0647\u0650 \u0644\u0650\u0633\u064E\u0627\u0646\u064E\u0643\u064E \u0644\u0650\u062A\u064E\u0639\u0652\u062C\u064E\u0644\u064E \u0628\u0650\u0647\u0650",
            "sabab": "\u0639\u064E\u0646\u0650 \u0627\u0628\u0652\u0646\u0650 \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u0641\u0650\u064A \u0642\u064E\u0648\u0652\u0644\u0650\u0647\u0650 \u062A\u064E\u0639\u064E\u0627\u0644\u064E\u0649: { \u0644\u064E\u0627 \u062A\u064F\u062D\u064E\u0631\u0651\u0650\u0643\u0652 \u0628\u0650\u0647\u0650\u06E6 \u0644\u0650\u0633\u064E\u0627\u0646\u064E\u0643\u064E \u0644\u0650\u062A\u064E\u0639\u0652\u062C\u064E\u0644\u064E \u0628\u0650\u0647\u0650\u06E6\u0653 \uFD3F\u0661\u0666\uFD3E } \u0642\u064E\u0627\u0644\u064E: \u0643\u064E\u0627\u0646\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u064A\u064F\u0639\u064E\u0627\u0644\u0650\u062C\u064F \u0645\u0650\u0646\u0652 \u0627\u0644\u062A\u0651\u064E\u0646\u0652\u0632\u0650\u064A\u0644\u0650 \u0634\u0650\u062F\u0651\u064E\u0629\u064B\u060C \u0648\u064E\u0643\u064E\u0627\u0646\u064E \u0645\u0650\u0645\u0651\u064E\u0627 \u064A\u064F\u062D\u064E\u0631\u0651\u0650\u0643\u064F \u0634\u064E\u0641\u064E\u062A\u064E\u064A\u0652\u0647\u0650\u060C - \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0627\u0628\u0652\u0646\u064F \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D: \u0641\u064E\u0623\u064E\u0646\u064E\u0627 \u0623\u064F\u062D\u064E\u0631\u0651\u0650\u0643\u064F\u0647\u064F\u0645\u064E\u0627 \u0644\u064E\u0643\u064F\u0645\u0652 \u0643\u064E\u0645\u064E\u0627 \u0643\u064E\u0627\u0646\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u064A\u064F\u062D\u064E\u0631\u0651\u0650\u0643\u064F\u0647\u064F\u0645\u064E\u0627\u060C \u0648\u064E\u0642\u064E\u0627\u0644\u064E \u0633\u064E\u0639\u0650\u064A\u062F\u064C: \u0623\u064E\u0646\u064E\u0627 \u0623\u064F\u062D\u064E\u0631\u0651\u0650\u0643\u064F\u0647\u064F\u0645\u064E\u0627 \u0643\u064E\u0645\u064E\u0627 \u0631\u064E\u0623\u064E\u064A\u0652\u062A\u064F \u0627\u0628\u0652\u0646\u064E \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D \u064A\u064F\u062D\u064E\u0631\u0651\u0650\u0643\u064F\u0647\u064F\u0645\u064E\u0627\u060C \u0641\u064E\u062D\u064E\u0631\u0651\u064E\u0643\u064E \u0634\u064E\u0641\u064E\u062A\u0652\u064A\u064E\u0647\u0650 - \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u0644 \u0627\u0644\u0644\u0647\u064F \u062A\u064E\u0639\u064E\u0627\u0644\u064E\u0649: { \u0644\u064E\u0627 \u062A\u064F\u062D\u064E\u0631\u0651\u0650\u0643\u0652 \u0628\u0650\u0647\u0650\u06E6 \u0644\u0650\u0633\u064E\u0627\u0646\u064E\u0643\u064E \u0644\u0650\u062A\u064E\u0639\u0652\u062C\u064E\u0644\u064E \u0628\u0650\u0647\u0650\u06E6\u0653 \uFD3F\u0661\u0666\uFD3E \u0625\u0650\u0646\u0651\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0646\u064E\u0627 \u062C\u064E\u0645\u0652\u0639\u064E\u0647\u064F\u06E5 \u0648\u064E\u0642\u064F\u0631\u0652\u0621\u064E\u0627\u0646\u064E\u0647\u064F\u06E5 \uFD3F\u0661\u0667\uFD3E }\u060C \u0642\u064E\u0627\u0644\u064E: \u062C\u064E\u0645\u0652\u0639\u064F\u0647\u064F \u0644\u064E\u0643\u064E \u0641\u0650\u064A \u0635\u064E\u062F\u0652\u0631\u0650\u0643\u064E\u060C \u0648\u064E\u062A\u064E\u0642\u0652\u0631\u064E\u0623\u064E\u0647\u064F\u060C { \u0641\u064E\u0625\u0650\u0630\u064E\u0627 \u0642\u064E\u0631\u064E\u0623\u0652\u0646\u064E\u0640\u0670\u0647\u064F \u0641\u064E\u0671\u062A\u0651\u064E\u0628\u0650\u0639\u0652 \u0642\u064F\u0631\u0652\u0621\u064E\u0627\u0646\u064E\u0647\u064F\u06E5 \uFD3F\u0661\u0668\uFD3E }\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0627\u0633\u0652\u062A\u064E\u0645\u0650\u0639\u0652 \u0644\u064E\u0647\u064F \u0648\u064E\u0623\u064E\u0646\u0652\u0635\u0650\u062A\u0652\u060C { \u062B\u064F\u0645\u0651\u064E \u0625\u0650\u0646\u0651\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0646\u064E\u0627 \u0628\u064E\u064A\u064E\u0627\u0646\u064E\u0647\u064F\u06E5 \uFD3F\u0661\u0669\uFD3E } \u062B\u064F\u0645\u0651\u064E \u0625\u0650\u0646\u0651\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0646\u064E\u0627 \u0623\u064E\u0646\u0652 \u062A\u064E\u0642\u0652\u0631\u064E\u0623\u064E\u0647\u064F. \u0641\u064E\u0643\u064E\u0627\u0646\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0628\u064E\u0639\u0652\u062F\u064E \u0630\u064E\u0644\u0650\u0643\u064E \u0625\u0650\u0630\u064E\u0627 \u0623\u064E\u062A\u064E\u0627\u0647\u064F \u062C\u0650\u0628\u0652\u0631\u0650\u064A\u0644\u064F \u0627\u0633\u0652\u062A\u064E\u0645\u064E\u0639\u064E\u060C \u0641\u064E\u0625\u0650\u0630\u064E\u0627 \u0627\u0646\u0652\u0637\u064E\u0644\u064E\u0642\u064E \u062C\u0650\u0628\u0652\u0631\u0650\u064A\u0644\u064F\u060C \u0642\u064E\u0631\u064E\u0623\u064E\u0647\u064F \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064F \uFDFA \u0643\u064E\u0645\u064E\u0627 \u0642\u064E\u0631\u064E\u0623\u064E\u0647\u064F.",
