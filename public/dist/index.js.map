        "24_6": {
            "title": "\u0648\u064E\u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u064A\u064E\u0631\u0652\u0645\u064F\u0648\u0646\u064E \u0623\u064E\u0632\u0652\u0648\u064E\u0627\u062C\u064E\u0647\u064F\u0645\u0652 \u0648\u064E\u0644\u064E\u0645\u0652 \u064A\u064E\u0643\u064F\u0646\u0652 \u0644\u064E\u0647\u064F\u0645\u0652 \u0634\u064F\u0647\u064E\u062F\u064E\u0627\u0621\u064F \u0625\u0650\u0644\u0651\u064E\u0627 \u0623\u064E\u0646\u0652\u0641\u064F\u0633\u064F\u0647\u064F\u0645\u0652 \u0641\u064E\u0634\u064E\u0647\u064E\u0627\u062F\u064E\u0629\u064F \u0623\u064E\u062D\u064E\u062F\u0650\u0647\u0650\u0645\u0652 \u0623\u064E\u0631\u0652\u0628\u064E\u0639\u064F \u0634\u064E\u0647\u064E\u0627\u062F\u064E\u0627\u062A\u064D \u0628\u0650\u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u06D9 \u0625\u0650\u0646\u0651\u064E\u0647\u064F \u0644\u064E\u0645\u0650\u0646\u064E \u0627\u0644\u0635\u0651\u064E\u0627\u062F\u0650\u0642\u0650\u064A\u0646\u064E",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 4 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
