            story: "\u0627\u0628\u0646\u0629 \u0639\u0645\u0631 \u0628\u0646 \u0627\u0644\u062E\u0637\u0627\u0628 \u0648\u0632\u0648\u062C \u0627\u0644\u0646\u0628\u064A \uFDFA. \u062D\u0641\u0638\u062A \u0627\u0644\u0642\u0631\u0622\u0646 \u0648\u0639\u064F\u0631\u0641\u062A \u0628\u0643\u062B\u0631\u0629 \u0627\u0644\u0635\u064A\u0627\u0645 \u0648\u0627\u0644\u0642\u064A\u0627\u0645. \u062D\u064A\u0646 \u062C\u064F\u0645\u0639 \u0627\u0644\u0642\u0631\u0622\u0646 \u0641\u064A \u0639\u0647\u062F \u0623\u0628\u064A \u0628\u0643\u0631 \u0623\u064F\u0648\u062F\u0639 \u0627\u0644\u0645\u0635\u062D\u0641 \u0627\u0644\u0623\u0648\u0644 \u0648\u0627\u0644\u0623\u0635\u0644\u064A \u0623\u0645\u0627\u0646\u0629\u064B \u0641\u064A \u0628\u064A\u062A\u0647\u0627 \u0644\u062B\u0642\u0629 \u0627\u0644\u0635\u062D\u0627\u0628\u0629 \u0628\u0647\u0627.",
