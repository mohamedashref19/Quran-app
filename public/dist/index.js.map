        "112_1": {
            "title": "\u0642\u0644 \u0647\u0648 \u0627\u0644\u0644\u0647 \u0623\u062D\u062F",
            "sabab": "\u0633\u0623\u0644 \u0627\u0644\u0645\u0634\u0631\u0643\u0648\u0646 \u0623\u0648 \u0627\u0644\u064A\u0647\u0648\u062F \u0627\u0644\u0646\u0628\u064A \uFDFA \u0639\u0646 \u0635\u0641\u0629 \u0631\u0628\u0647 \u0648\u0623\u0635\u0644\u0647 \u0648\u0646\u0633\u0628\u0647\u060C \u0641\u0646\u0632\u0644\u062A \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629 \u062C\u0648\u0627\u0628\u0627\u064B \u0634\u0627\u0645\u0644\u0627\u064B \u0648\u0627\u0641\u064A\u0627\u064B.",
            "fadl": "\u0645\u0646 \u0642\u0631\u0623 \u0642\u0644 \u0647\u0648 \u0627\u0644\u0644\u0647 \u0623\u062D\u062F \u0645\u0631\u0629 \u0648\u0627\u062D\u062F\u0629 \u0643\u064F\u062A\u0628 \u0644\u0647 \u062B\u0648\u0627\u0628 \u0639\u0634\u0631\u0629 \u0623\u0639\u0645\u0627\u0644 \u0635\u0627\u0644\u062D\u0629 \u0648\u062A\u0639\u062F\u0644 \u062B\u0644\u062B \u0627\u0644\u0642\u0631\u0622\u0646.",
            "action": "\u0642\u0631\u0623\u062A\u064E \u0627\u0644\u0622\u0646 \u0622\u064A\u0629 \u062A\u0639\u062F\u0644 \u062B\u0644\u062B \u0627\u0644\u0642\u0631\u0622\u0646. \u0631\u062F\u062F\u0647\u0627 \u0628\u0642\u0644\u0628\u0643 \u0648\u062A\u0641\u0643\u0651\u0631: \u0627\u0644\u0644\u0647 \u0627\u0644\u0648\u0627\u062D\u062F \u0627\u0644\u0635\u0645\u062F \u0647\u0648 \u062E\u0627\u0644\u0642\u0643 \u0648\u0645\u0639\u0628\u0648\u062F\u0643."
        },
        "112_2": {
            "title": "\u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0627\u0644\u0635\u0651\u064E\u0645\u064E\u062F\u064F",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 1 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
