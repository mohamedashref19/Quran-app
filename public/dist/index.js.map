        "19_77": {
            "title": "\u0623\u064E\u0641\u064E\u0631\u064E\u0623\u064E\u064A\u0652\u062A\u064E \u0627\u0644\u0651\u064E\u0630\u0650\u064A \u0643\u064E\u0641\u064E\u0631\u064E \u0628\u0650\u0622\u064A\u064E\u0627\u062A\u0650\u0646\u064E\u0627 \u0648\u064E\u0642\u064E\u0627\u0644\u064E \u0644\u064E\u0623\u064F\u0648\u062A\u064E\u064A\u064E\u0646\u0651\u064E \u0645\u064E\u0627\u0644\u064B\u0627 \u0648\u064E\u0648\u064E\u0644\u064E\u062F\u064B\u0627",
            "sabab": "\u0639\u064E\u0646\u0652 \u062E\u064E\u0628\u0651\u064E\u0627\u0628\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u064E\u0627\u0644\u064E: \u0643\u064F\u0646\u0652\u062A\u064F \u0642\u064E\u064A\u0652\u0646\u0627\u064B \u0641\u0650\u064A \u0627\u0644\u0652\u062C\u064E\u0627\u0647\u0650\u0644\u0650\u064A\u0651\u064E\u0629\u0650\u060C \u0648\u064E\u0643\u064E\u0627\u0646\u064E \u0644\u0650\u064A \u0639\u064E\u0644\u064E\u0649 \u0627\u0644\u0652\u0639\u064E\u0627\u0635\u0650 \u0628\u0652\u0646\u0650 \u0648\u064E\u0627\u0626\u0650\u0644\u064D \u062F\u064E\u064A\u0652\u0646\u064C\u060C \u0641\u064E\u0623\u064E\u062A\u064E\u064A\u0652\u062A\u064F\u0647\u064F \u0623\u064E\u062A\u064E\u0642\u064E\u0627\u0636\u064E\u0627\u0647\u064F\u060C \u0642\u064E\u0627\u0644\u064E: \u0644\u064E\u0627 \u0623\u064F\u0639\u0652\u0637\u0650\u064A\u0643\u064E \u062D\u064E\u062A\u0651\u064E\u0649 \u062A\u064E\u0643\u0652\u0641\u064F\u0631\u064E \u0628\u0650\u0645\u064F\u062D\u064E\u0645\u0651\u064E\u062F\u064D \uFDFA\u060C \u0641\u064E\u0642\u064F\u0644\u0652\u062A\u064F: \u0644\u064E\u0627 \u0623\u064E\u0643\u0652\u0641\u064F\u0631\u064F \u062D\u064E\u062A\u0651\u064E\u0649 \u064A\u064F\u0645\u0650\u064A\u062A\u064E\u0643\u064E \u0627\u0644\u0644\u0647\u064F \u062B\u064F\u0645\u0651\u064E \u062A\u064F\u0628\u0652\u0639\u064E\u062B\u064E\u060C \u0642\u064E\u0627\u0644\u064E: \u062F\u064E\u0639\u0652\u0646\u0650\u064A \u062D\u064E\u062A\u0651\u064E\u0649 \u0623\u064E\u0645\u064F\u0648\u062A\u064E \u0648\u064E\u0623\u064E\u0628\u0652\u0639\u064E\u062B\u064E\u060C \u0641\u064E\u0633\u064E\u0623\u064F\u0648\u062A\u064E\u0649 \u0645\u064E\u0627\u0644\u064B\u0627 \u0648\u064E\u0648\u064E\u0644\u064E\u062F\u0627\u064B \u0641\u064E\u0623\u064E\u0642\u0652\u0636\u0650\u064A\u0643\u064E. \u0641\u064E\u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652 { \u0623\u064E\u0641\u064E\u0631\u064E\u0621\u064E\u064A\u0652\u062A\u064E \u0671\u0644\u0651\u064E\u0630\u0650\u0649 \u0643\u064E\u0641\u064E\u0631\u064E \u0628\u0650\u0640\u0654\u064E\u0627\u064A\u064E\u0640\u0670\u062A\u0650\u0646\u064E\u0627 \u0648\u064E\u0642\u064E\u0627\u0644\u064E \u0644\u064E\u0623\u064F\u0648\u062A\u064E\u064A\u064E\u0646\u0651\u064E \u0645\u064E\u0627\u0644\u064B\u0627 \u0648\u064E\u0648\u064E\u0644\u064E\u062F\u064B\u0627 \uFD3F\u0667\u0667\uFD3E \u0623\u064E\u0637\u0651\u064E\u0644\u064E\u0639\u064E \u0671\u0644\u0652\u063A\u064E\u064A\u0652\u0628\u064E \u0623\u064E\u0645\u0650 \u0671\u062A\u0651\u064E\u062E\u064E\u0630\u064E \u0639\u0650\u0646\u062F\u064E \u0671\u0644\u0631\u0651\u064E\u062D\u0652\u0645\u064E\u0640\u0670\u0646\u0650 \u0639\u064E\u0647\u0652\u062F\u064B\u0627 \uFD3F\u0667\u0668\uFD3E }.",
            "fadl": "",
            "action": ""
        },
        "19_78": {
            "title": "\u0623\u064E\u0637\u0651\u064E\u0644\u064E\u0639\u064E \u0627\u0644\u0652\u063A\u064E\u064A\u0652\u0628\u064E \u0623\u064E\u0645\u0650 \u0627\u062A\u0651\u064E\u062E\u064E\u0630\u064E \u0639\u0650\u0646\u0652\u062F\u064E \u0627\u0644\u0631\u0651\u064E\u062D\u0652\u0645\u064E\u0670\u0646\u0650 \u0639\u064E\u0647\u0652\u062F\u064B\u0627",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 77 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
