        },
        "4_65": {
            "title": "\u0641\u064E\u0644\u064E\u0627 \u0648\u064E\u0631\u064E\u0628\u0651\u0650\u0643\u064E \u0644\u064E\u0627 \u064A\u064F\u0624\u0652\u0645\u0650\u0646\u064F\u0648\u0646\u064E \u062D\u064E\u062A\u0651\u064E\u0649\u0670 \u064A\u064F\u062D\u064E\u0643\u0651\u0650\u0645\u064F\u0648\u0643\u064E \u0641\u0650\u064A\u0645\u064E\u0627 \u0634\u064E\u062C\u064E\u0631\u064E \u0628\u064E\u064A\u0652\u0646\u064E\u0647\u064F\u0645\u0652 \u062B\u064F\u0645\u0651\u064E \u0644\u064E\u0627 \u064A\u064E\u062C\u0650\u062F\u064F\u0648\u0627 \u0641\u0650\u064A \u0623\u064E\u0646\u0652\u0641\u064F\u0633\u0650\u0647\u0650\u0645\u0652 \u062D\u064E\u0631\u064E\u062C\u064B\u0627 \u0645\u0650\u0645\u0651\u064E\u0627 \u0642\u064E\u0636\u064E\u064A\u0652\u062A\u064E \u0648\u064E\u064A\u064F\u0633\u064E\u0644\u0651\u0650\u0645\u064F\u0648\u0627 \u062A\u064E\u0633\u0652\u0644\u0650\u064A\u0645\u064B\u0627",
            "sabab": "\u0639\u0646 \u0639\u064F\u0631\u0652\u0648\u064E\u0629\u064E \u0628\u0652\u0646\u0650 \u0627\u0644\u0632\u0651\u064F\u0628\u064E\u064A\u0652\u0631\u0650 \u0631\u062D\u0645\u0647 \u0627\u0644\u0644\u0647: \u0623\u064E\u0646\u0651\u064E \u0627\u0644\u0632\u0651\u064F\u0628\u064E\u064A\u0652\u0631\u064E \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0643\u064E\u0627\u0646\u064E \u064A\u064F\u062D\u064E\u062F\u0651\u0650\u062B\u064F: \u0623\u064E\u0646\u0651\u064E\u0647\u064F \u062E\u064E\u0627\u0635\u064E\u0645\u064E \u0631\u064E\u062C\u064F\u0644\u064B\u0627 \u0645\u0650\u0646\u0652 \u0627\u0644\u0652\u0623\u064E\u0646\u0652\u0635\u064E\u0627\u0631\u0650 \u0642\u064E\u062F\u0652 \u0634\u064E\u0647\u0650\u062F\u064E \u0628\u064E\u062F\u0652\u0631\u0627\u064B\u060C \u0625\u0650\u0644\u064E\u0649 \u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \uFDFA \u0641\u0650\u064A \u0634\u0650\u0631\u064E\u0627\u062C\u064D \u0645\u0650\u0646\u0652 \u0627\u0644\u0652\u062D\u064E\u0631\u0651\u064E\u0629\u0650\u060C \u0643\u064E\u0627\u0646\u064E\u0627 \u064A\u064E\u0633\u0652\u0642\u0650\u064A\u064E\u0627\u0646\u0650 \u0628\u0650\u0647\u0650 \u0643\u0650\u0644\u064E\u0627\u0647\u064F\u0645\u064E\u0627\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647 \uFDFA \u0644\u0650\u0644\u0632\u0651\u064F\u0628\u064E\u064A\u0652\u0631\u0650: \xab \u0627\u0633\u0652\u0642\u0650 \u064A\u064E\u0627 \u0632\u064F\u0628\u064E\u064A\u0652\u0631\u064F\u060C \u062B\u064F\u0645\u0651\u064E \u0623\u064E\u0631\u0652\u0633\u0650\u0644\u0652 \u0625\u0650\u0644\u064E\u0649 \u062C\u064E\u0627\u0631\u0650\u0643\u064E \xbb\u060C \u0641\u064E\u063A\u064E\u0636\u0650\u0628\u064E \u0627\u0644\u0652\u0623\u064E\u0646\u0652\u0635\u064E\u0627\u0631\u0650\u064A\u0651\u064F\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E: \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u0650\u060C \u0623\u064E\u0646\u0652 \u0643\u064E\u0627\u0646\u064E \u0627\u0628\u0652\u0646\u064E \u0639\u064E\u0645\u0651\u064E\u062A\u0650\u0643\u064E\u061F \u0641\u064E\u062A\u064E\u0644\u064E\u0648\u0651\u064E\u0646\u064E \u0648\u064E\u062C\u0652\u0647\u064F \u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0627\u0644\u0644\u0647\u0650 \uFDFA\u060C \u062B\u064F\u0645\u0651\u064E \u0642\u064E\u0627\u0644\u064E: \xab \u0627\u0633\u0652\u0642\u0650\u060C \u062B\u064F\u0645\u0651\u064E \u0627\u062D\u0652\u0628\u0650\u0633\u064F \u062D\u064E\u062A\u0651\u064E\u0649 \u064A\u064E\u0628\u0652\u0644\u064F\u063A\u064E \u0627\u0644\u0652\u062C\u064E\u062F\u0652\u0631\u064E \xbb. \u0641\u064E\u0627\u0633\u0652\u062A\u064E\u0648\u0652\u0639\u064E\u0649 \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u062D\u0650\u064A\u0646\u064E\u0626\u0650\u0630\u064D \u062D\u064E\u0642\u0651\u064E\u0647\u064F \u0644\u0650\u0644\u0652\u0632\u0651\u064F\u0628\u064E\u064A\u0652\u0631\u0650\u060C \u0648\u064E\u0643\u064E\u0627\u0646\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \uFDFA \u0642\u064E\u0628\u0652\u0644\u064E \u0630\u064E\u0644\u0650\u0643\u064E \u0623\u064E\u0634\u064E\u0627\u0631\u064E \u0639\u064E\u0644\u064E\u0649 \u0627\u0644\u0632\u0651\u064F\u0628\u064E\u064A\u0652\u0631\u0650 \u0628\u0650\u0631\u064E\u0623\u0652\u064A \u0633\u064E\u0639\u064E\u0629\u064D \u0644\u064E\u0647\u064F \u0648\u064E\u0644\u0650\u0644\u0652\u0623\u064E\u0646\u0652\u0635\u064E\u0627\u0631\u0650\u064A\u0651\u0650\u060C \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0623\u064E\u062D\u0652\u0641\u064E\u0638\u064E \u0627\u0644\u0652\u0623\u064E\u0646\u0652\u0635\u064E\u0627\u0631\u0650\u064A\u0651\u064F \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0627\u0633\u0652\u062A\u064E\u0648\u0652\u0639\u064E\u0649 \u0644\u0650\u0644\u0652\u0632\u0651\u064F\u0628\u064E\u064A\u0652\u0631\u0650 \u062D\u064E\u0642\u0651\u064E\u0647\u064F \u0641\u0650\u064A \u0635\u064E\u0631\u0650\u064A\u062D\u0650 \u0627\u0644\u0652\u062D\u064F\u0643\u0652\u0645\u0650. \u0642\u064E\u0627\u0644\u064E \u0639\u064F\u0631\u0652\u0648\u064E\u0629\u064F: \u0642\u064E\u0627\u0644\u064E \u0627\u0644\u0632\u0651\u064F\u0628\u064E\u064A\u0652\u0631\u064F: \u0648\u064E\u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u0645\u064E\u0627 \u0623\u064E\u062D\u0652\u0633\u0650\u0628\u064F \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u064E \u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652 \u0625\u0650\u0644\u0651\u064E\u0627 \u0641\u0650\u064A \u0630\u064E\u0644\u0650\u0643\u064E\u060C { \u0641\u064E\u0644\u064E\u0627 \u0648\u064E\u0631\u064E\u0628\u0651\u0650\u0643\u064E \u0644\u064E\u0627 \u064A\u064F\u0624\u0652\u0645\u0650\u0646\u064F\u0648\u0646\u064E \u062D\u064E\u062A\u0651\u064E\u0649\u0670 \u064A\u064F\u062D\u064E\u0643\u0651\u0650\u0645\u064F\u0648\u0643\u064E \u0641\u0650\u064A\u0645\u064E\u0627 \u0634\u064E\u062C\u064E\u0631\u064E \u0628\u064E\u064A\u0652\u0646\u064E\u0647\u064F\u0645\u0652 } \u0627\u0644\u0622\u064A\u0629.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0648\u062C\u0627\u0621 \u0639\u064E\u0646\u0652 \u0639\u064E\u0628\u0652\u062F\u0650 \u0627\u0644\u0644\u0647\u0650 \u0628\u0652\u0646\u0650 \u0627\u0644\u0632\u0651\u064F\u0628\u064E\u064A\u0652\u0631\u0650 \u0644\u0627 \u0634\u0628\u064A\u0647\u0627\u064B \u0628\u0647.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0648\u062C\u0627\u0621 \u0639\u0646 \u0623\u0645 \u0633\u0644\u0645\u0629 \u0634\u0628\u064A\u0647\u0627\u064B \u0628\u0647 \u0623\u064A\u0636\u0627\u064B.",
            "fadl": "",
            "action": ""
        },
        "4_69": {
            "title": "\u0648\u064E\u0645\u064E\u0646\u0652 \u064A\u064F\u0637\u0650\u0639\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u064E \u0648\u064E\u0627\u0644\u0631\u0651\u064E\u0633\u064F\u0648\u0644\u064E \u0641\u064E\u0623\u064F\u0648\u0644\u064E\u0670\u0626\u0650\u0643\u064E \u0645\u064E\u0639\u064E \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0623\u064E\u0646\u0652\u0639\u064E\u0645\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650\u0645\u0652 \u0645\u0650\u0646\u064E \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u0650\u064A\u0646\u064E \u0648\u064E\u0627\u0644\u0635\u0651\u0650\u062F\u0651\u0650\u064A\u0642\u0650\u064A\u0646\u064E \u0648\u064E\u0627\u0644\u0634\u0651\u064F\u0647\u064E\u062F\u064E\u0627\u0621\u0650 \u0648\u064E\u0627\u0644\u0635\u0651\u064E\u0627\u0644\u0650\u062D\u0650\u064A\u0646\u064E \u06DA \u0648\u064E\u062D\u064E\u0633\u064F\u0646\u064E \u0623\u064F\u0648\u0644\u064E\u0670\u0626\u0650\u0643\u064E \u0631\u064E\u0641\u0650\u064A\u0642\u064B\u0627",
            "sabab": "\u0639\u0646 \u0639\u0627\u0626\u0634\u0629 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0627 \u0642\u0627\u0644\u062A: \u062C\u0627\u0621 \u0631\u062C\u0644 \u0625\u0644\u0649 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0641\u0642\u0627\u0644: \u064A\u0627 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647\u060C \u0625\u0646\u0643 \u0644\u0623\u062D\u0628 \u0625\u0644\u064A \u0645\u0646 \u0646\u0641\u0633\u064A\u060C \u0648\u0625\u0646\u0643 \u0644\u0623\u062D\u0628 \u0625\u0644\u064A \u0645\u0646 \u0648\u0644\u062F\u064A\u060C \u0648\u0625\u0646\u064A \u0644\u0623\u0643\u0648\u0646 \u0641\u064A \u0627\u0644\u0628\u064A\u062A \u0641\u0623\u0630\u0643\u0631\u0643 \u0641\u0645\u0627 \u0623\u0635\u0628\u0631 \u062D\u062A\u0649 \u0622\u062A\u064A\u060C \u0641\u0623\u0646\u0638\u0631 \u0625\u0644\u064A\u0643\u060C \u0648\u0625\u0630\u0627 \u0630\u0643\u0631\u062A \u0645\u0648\u062A\u064A \u0648\u0645\u0648\u062A\u0643 \u0639\u0631\u0641\u062A \u0623\u0646\u0643 \u0625\u0630\u0627 \u062F\u062E\u0644\u062A \u0627\u0644\u062C\u0646\u0629 \u0631\u0641\u0639\u062A \u0645\u0639 \u0627\u0644\u0646\u0628\u064A\u064A\u0646\u060C \u0648\u0623\u0646\u064A \u0625\u0630\u0627 \u062F\u062E\u0644\u062A \u0627\u0644\u062C\u0646\u0629 \u062E\u0634\u064A\u062A \u0623\u0646 \u0644\u0627 \u0623\u0631\u0627\u0643. \u0641\u0644\u0645 \u064A\u0631\u062F \u0639\u0644\u064A\u0647 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0634\u064A\u0626\u0627\u064B\u060C \u062D\u062A\u0649 \u0646\u0632\u0644 \u062C\u0628\u0631\u064A\u0644 \u0628\u0647\u0630\u0647 \u0627\u0644\u0622\u064A\u0629 { \u0648\u064E\u0645\u064E\u0646 \u064A\u064F\u0637\u0650\u0639\u0650 \u0671\u0644\u0644\u0651\u064E\u0647\u064E \u0648\u064E\u0671\u0644\u0631\u0651\u064E\u0633\u064F\u0648\u0644\u064E \u0641\u064E\u0623\u064F\u0648\u06DF\u0644\u064E\u0670\u0653\u0626\u0650\u0643\u064E \u0645\u064E\u0639\u064E \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0623\u064E\u0646\u0652\u0639\u064E\u0645\u064E \u0671\u0644\u0644\u0651\u064E\u0647\u064F \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650\u0645 \u0645\u0651\u0650\u0646\u064E \u0671\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u0650\u0640\u06E7\u0646\u064E \u0648\u064E\u0671\u0644\u0635\u0651\u0650\u062F\u0651\u0650\u064A\u0642\u0650\u064A\u0646\u064E \u0648\u064E\u0671\u0644\u0634\u0651\u064F\u0647\u064E\u062F\u064E\u0627\u0653\u0621\u0650 \u0648\u064E\u0671\u0644\u0635\u0651\u064E\u0640\u0670\u0644\u0650\u062D\u0650\u064A\u0646\u064E \u06DA }.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0648\u0645\u0646 \u0634\u0648\u0627\u0647\u062F\u0647 \u0639\u0646 \u0627\u0628\u0646 \u0639\u0628\u0627\u0633 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u0634\u0628\u064A\u0647\u0627\u064B \u0628\u0647.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0648\u0639\u0646 \u0627\u0644\u0631\u0628\u064A\u0639 \u0634\u0628\u064A\u0647\u0627\u064B \u0628\u0647.",
            "fadl": "",
            "action": ""
        },
        "4_77": {
            "title": "\u0623\u064E\u0644\u064E\u0645\u0652 \u062A\u064E\u0631\u064E \u0625\u0650\u0644\u064E\u0649 \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0642\u0650\u064A\u0644\u064E \u0644\u064E\u0647\u064F\u0645\u0652 \u0643\u064F\u0641\u0651\u064F\u0648\u0627 \u0623\u064E\u064A\u0652\u062F\u0650\u064A\u064E\u0643\u064F\u0645\u0652 \u0648\u064E\u0623\u064E\u0642\u0650\u064A\u0645\u064F\u0648\u0627 \u0627\u0644\u0635\u0651\u064E\u0644\u064E\u0627\u0629\u064E \u0648\u064E\u0622\u062A\u064F\u0648\u0627 \u0627\u0644\u0632\u0651\u064E\u0643\u064E\u0627\u0629\u064E \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0643\u064F\u062A\u0650\u0628\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650\u0645\u064F \u0627\u0644\u0652\u0642\u0650\u062A\u064E\u0627\u0644\u064F \u0625\u0650\u0630\u064E\u0627 \u0641\u064E\u0631\u0650\u064A\u0642\u064C \u0645\u0650\u0646\u0652\u0647\u064F\u0645\u0652 \u064A\u064E\u062E\u0652\u0634\u064E\u0648\u0652\u0646\u064E \u0627\u0644\u0646\u0651\u064E\u0627\u0633\u064E \u0643\u064E\u062E\u064E\u0634\u0652\u064A\u064E\u0629\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u0623\u064E\u0648\u0652 \u0623\u064E\u0634\u064E\u062F\u0651\u064E \u062E\u064E\u0634\u0652\u064A\u064E\u0629\u064B \u06DA \u0648\u064E\u0642\u064E\u0627\u0644\u064F\u0648\u0627 \u0631\u064E\u0628\u0651\u064E\u0646\u064E\u0627 \u0644\u0650\u0645\u064E \u0643\u064E\u062A\u064E\u0628\u0652\u062A\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0646\u064E\u0627 \u0627\u0644\u0652\u0642\u0650\u062A\u064E\u0627\u0644\u064E \u0644\u064E\u0648\u0652\u0644\u064E\u0627 \u0623\u064E\u062E\u0651\u064E\u0631\u0652\u062A\u064E\u0646\u064E\u0627 \u0625\u0650\u0644\u064E\u0649\u0670 \u0623\u064E\u062C\u064E\u0644\u064D \u0642\u064E\u0631\u0650\u064A\u0628\u064D \u06D7 \u0642\u064F\u0644\u0652 \u0645\u064E\u062A\u064E\u0627\u0639\u064F \u0627\u0644\u062F\u0651\u064F\u0646\u0652\u064A\u064E\u0627 \u0642\u064E\u0644\u0650\u064A\u0644\u064C \u0648\u064E\u0627\u0644\u0652\u0622\u062E\u0650\u0631\u064E\u0629\u064F \u062E\u064E\u064A\u0652\u0631\u064C \u0644\u0650\u0645\u064E\u0646\u0650 \u0627\u062A\u0651\u064E\u0642\u064E\u0649\u0670 \u0648\u064E\u0644\u064E\u0627 \u062A\u064F\u0638\u0652\u0644\u064E\u0645\u064F\u0648\u0646\u064E \u0641\u064E\u062A\u0650\u064A\u0644\u064B\u0627",
            "sabab": "\u0639\u064E\u0646\u0650 \u0627\u0628\u0652\u0646\u0650 \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627: \u0623\u064E\u0646\u0651\u064E \u0639\u064E\u0628\u0652\u062F\u064E \u0627\u0644\u0631\u0651\u064E\u062D\u0652\u0645\u064E\u0646\u0650 \u0628\u0652\u0646\u0650 \u0639\u064E\u0648\u0652\u0641\u064D \u0648\u064E\u0623\u064E\u0635\u0652\u062D\u064E\u0627\u0628\u0650\u0627\u064B \u0644\u064E\u0647\u064F \u0623\u064E\u062A\u064E\u0648\u0652\u0627 \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064E \uFDFA \u0628\u0650\u0645\u064E\u0643\u0651\u064E\u0629\u064E\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064F\u0648\u0627: \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u0625\u0650\u0646\u0651\u064E\u0627 \u0643\u064F\u0646\u0651\u064E\u0627 \u0641\u0650\u064A \u0639\u0650\u0632\u0651\u064D \u0648\u064E\u0646\u064E\u062D\u0652\u0646\u064F \u0645\u064F\u0634\u0652\u0631\u0650\u0643\u064F\u0648\u0646\u064E\u060C \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0622\u0645\u064E\u0646\u0651\u064E\u0627 \u0635\u0650\u0631\u0652\u0646\u064E\u0627 \u0623\u064E\u0630\u0650\u0644\u0651\u064E\u0629\u064C\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E: \xab \u0625\u0650\u0646\u0651\u0650\u064A \u0623\u064F\u0645\u0650\u0631\u0652\u062A\u064F \u0628\u0650\u0627\u0644\u0652\u0639\u064E\u0641\u0652\u0648\u0650\u060C \u0641\u064E\u0644\u064E\u0627 \u062A\u064F\u0642\u064E\u0627\u062A\u0650\u0644\u064F\u0648\u0627 \xbb\u060C \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u062D\u064E\u0648\u0651\u064E\u0644\u064E\u0646\u064E\u0627 \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0625\u0650\u0644\u064E\u0649 \u0627\u0644\u0652\u0645\u064E\u062F\u0650\u064A\u0646\u064E\u0629\u0650 \u0623\u064E\u0645\u064E\u0631\u064E\u0646\u064E\u0627 \u0628\u0650\u0627\u0644\u0652\u0642\u0650\u062A\u064E\u0627\u0644\u0650\u060C \u0641\u064E\u0643\u064E\u0641\u064F\u0651\u0648\u0627\u060C \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0639\u0632 \u0648 \u062C\u0644 { \u0623\u064E\u0644\u064E\u0645\u0652 \u062A\u064E\u0631\u064E \u0625\u0650\u0644\u064E\u0649 \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0642\u0650\u064A\u0644\u064E \u0644\u064E\u0647\u064F\u0645\u0652 \u0643\u064F\u0641\u0651\u064F\u0648\u0653\u0627\u06DF \u0623\u064E\u064A\u0652\u062F\u0650\u064A\u064E\u0643\u064F\u0645\u0652 \u0648\u064E\u0623\u064E\u0642\u0650\u064A\u0645\u064F\u0648\u0627\u06DF \u0671\u0644\u0635\u0651\u064E\u0644\u064E\u0648\u0670\u0629\u064E }.",
            "fadl": "",
            "action": ""
        },
        "4_83": {
            "title": "\u0648\u064E\u0625\u0650\u0630\u064E\u0627 \u062C\u064E\u0627\u0621\u064E\u0647\u064F\u0645\u0652 \u0623\u064E\u0645\u0652\u0631\u064C \u0645\u0650\u0646\u064E \u0627\u0644\u0652\u0623\u064E\u0645\u0652\u0646\u0650 \u0623\u064E\u0648\u0650 \u0627\u0644\u0652\u062E\u064E\u0648\u0652\u0641\u0650 \u0623\u064E\u0630\u064E\u0627\u0639\u064F\u0648\u0627 \u0628\u0650\u0647\u0650 \u06D6 \u0648\u064E\u0644\u064E\u0648\u0652 \u0631\u064E\u062F\u0651\u064F\u0648\u0647\u064F \u0625\u0650\u0644\u064E\u0649 \u0627\u0644\u0631\u0651\u064E\u0633\u064F\u0648\u0644\u0650 \u0648\u064E\u0625\u0650\u0644\u064E\u0649\u0670 \u0623\u064F\u0648\u0644\u0650\u064A \u0627\u0644\u0652\u0623\u064E\u0645\u0652\u0631\u0650 \u0645\u0650\u0646\u0652\u0647\u064F\u0645\u0652 \u0644\u064E\u0639\u064E\u0644\u0650\u0645\u064E\u0647\u064F \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u064A\u064E\u0633\u0652\u062A\u064E\u0646\u0652\u0628\u0650\u0637\u064F\u0648\u0646\u064E\u0647\u064F \u0645\u0650\u0646\u0652\u0647\u064F\u0645\u0652 \u06D7 \u0648\u064E\u0644\u064E\u0648\u0652\u0644\u064E\u0627 \u0641\u064E\u0636\u0652\u0644\u064F \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064F\u0645\u0652 \u0648\u064E\u0631\u064E\u062D\u0652\u0645\u064E\u062A\u064F\u0647\u064F \u0644\u064E\u0627\u062A\u0651\u064E\u0628\u064E\u0639\u0652\u062A\u064F\u0645\u064F \u0627\u0644\u0634\u0651\u064E\u064A\u0652\u0637\u064E\u0627\u0646\u064E \u0625\u0650\u0644\u0651\u064E\u0627 \u0642\u064E\u0644\u0650\u064A\u0644\u064B\u0627",
            "sabab": "\u0639\u064E\u0646\u0652 \u0639\u064E\u0628\u0652\u062F\u0650 \u0627\u0644\u0644\u0647\u0650 \u0628\u0652\u0646\u0650 \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627: \u062D\u064E\u062F\u0651\u064E\u062B\u064E\u0646\u0650\u064A \u0639\u064F\u0645\u064E\u0631\u064F \u0628\u0652\u0646\u064F \u0627\u0644\u0652\u062E\u064E\u0637\u0651\u064E\u0627\u0628\u0650 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u064E\u0627\u0644\u064E: \u0644\u064E\u0645\u0651\u064E\u0627 \u0627\u0639\u0652\u062A\u064E\u0632\u064E\u0644\u064E \u0646\u064E\u0628\u0650\u064A\u0651\u064F \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \uFDFA \u0646\u0650\u0633\u064E\u0627\u0621\u064E\u0647\u064F\u060C \u0642\u064E\u0627\u0644\u064E: ( \u062F\u064E\u062E\u064E\u0644\u0652\u062A\u064F \u0627\u0644\u0652\u0645\u064E\u0633\u064E\u062C\u0650\u062F\u064E... ) (... \u0641\u064E\u0642\u064F\u0644\u0652\u062A\u064F \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u0650\u060C \u0623\u064E\u0637\u064E\u0644\u0651\u064E\u0642\u0652\u062A\u064E\u0647\u064F\u0646\u0651\u064E\u061F \u0642\u064E\u0627\u0644\u064E: \xab \u0644\u0627\u064E \xbb\u060C \u0642\u064F\u0644\u0652\u062A\u064F: \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u0650\u060C \u0625\u0650\u0646\u0651\u0650\u064A \u062F\u064E\u062E\u064E\u0644\u0652\u062A\u064F \u0627\u0644\u0652\u0645\u064E\u0633\u0652\u062C\u0650\u062F\u064E \u0648\u064E\u0627\u0644\u0652\u0645\u064F\u0633\u0652\u0644\u0650\u0645\u064F\u0648\u0646\u064E \u064A\u064E\u0646\u0652\u0643\u064F\u062A\u064F\u0648\u0646\u064E \u0628\u0650\u0627\u0644\u0652\u062D\u064E\u0635\u064E\u0649\u060C \u064A\u064E\u0642\u064F\u0648\u0644\u064F\u0648\u0646\u064E: \u0637\u064E\u0644\u0651\u064E\u0642\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \uFDFA \u0646\u0650\u0633\u064E\u0627\u0621\u064E\u0647\u064F\u060C \u0623\u064E\u0641\u064E\u0623\u064E\u0646\u0652\u0632\u0650\u0644\u064F \u0641\u064E\u0623\u064E\u062E\u0652\u0628\u0650\u0631\u064E\u0647\u064F\u0645\u0652 \u0623\u064E\u0646\u0651\u064E\u0643\u064E \u0644\u064E\u0645\u0652 \u062A\u064F\u0637\u064E\u0644\u0651\u0650\u0642\u064E\u0647\u064F\u0646\u0651\u064E\u061F \u0642\u064E\u0627\u0644\u064E: \xab \u0646\u064E\u0639\u064E\u0645\u0652\u060C \u0625\u0650\u0646\u0652 \u0634\u0650\u0626\u0652\u062A\u064E \xbb\u060C \u0641\u064E\u0644\u064E\u0645\u0652 \u0623\u064E\u0632\u064E\u0644\u0652 \u0623\u064F\u062D\u064E\u062F\u0651\u0650\u062B\u064F\u0647\u064F \u062D\u064E\u062A\u0651\u064E\u0649 \u062A\u064E\u062D\u064E\u0633\u0651\u064E\u0631\u064E \u0627\u0644\u0652\u063A\u064E\u0636\u064E\u0628\u064F \u0639\u064E\u0646\u0652 \u0648\u064E\u062C\u0652\u0647\u0650\u0647\u0650\u060C \u0648\u064E\u062D\u064E\u062A\u0651\u064E\u0649 \u0643\u064E\u0634\u064E\u0631\u064E \u0641\u064E\u0636\u064E\u062D\u0650\u0643\u064E - \u0648\u064E\u0643\u064E\u0627\u0646\u064E \u0645\u0650\u0646\u0652 \u0623\u064E\u062D\u0652\u0633\u064E\u0646\u0650 \u0627\u0644\u0646\u0651\u064E\u0627\u0633\u0650 \u062A\u064E\u063A\u0652\u0631\u0627\u064B - \u062B\u064F\u0645\u0651\u064E \u0646\u064E\u0632\u064E\u0644\u064E \u0646\u064E\u0628\u0650\u064A\u0651\u064F \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \uFDFA \u0648\u064E\u0646\u064E\u0632\u064E\u0644\u0652\u062A\u064F\u060C \u0641\u064E\u0646\u064E\u0632\u064E\u0644\u0652\u062A\u064F \u0623\u064E\u062A\u064E\u0634\u064E\u0628\u0651\u064E\u062B\u064F \u0628\u0650\u0627\u0644\u0652\u062C\u0650\u0630\u0652\u0639\u0650\u060C \u0648\u064E\u0646\u064E\u0632\u064E\u0644\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \uFDFA \u0643\u064E\u0623\u064E\u0646\u0651\u064E\u0645\u064E\u0627 \u064A\u064E\u0645\u0652\u0634\u0650\u064A \u0639\u064E\u0644\u064E\u0649 \u0627\u0644\u0652\u0623\u064E\u0631\u0652\u0636\u0650 \u0645\u064E\u0627 \u064A\u064E\u0645\u064E\u0633\u0651\u064F\u0647\u064F \u0628\u0650\u064A\u064E\u062F\u0650\u0647\u0650\u060C \u0641\u064E\u0642\u064F\u0644\u0652\u062A\u064F: \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u0650\u060C \u0625\u0650\u0646\u0651\u064E\u0645\u064E\u0627 \u0643\u064F\u0646\u0652\u062A\u064E \u0641\u0650\u064A \u0627\u0644\u0652\u063A\u064F\u0631\u0652\u0641\u064E\u0629\u0650 \u062A\u0650\u0633\u0652\u0639\u064E\u0629\u064B \u0648\u064E\u0639\u0650\u0634\u0652\u0631\u0650\u064A\u0646\u064E\u060C \u0642\u064E\u0627\u0644\u064E: \xab \u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0634\u0651\u064E\u0647\u0652\u0631\u064E \u064A\u064E\u0643\u064F\u0648\u0646\u064F \u062A\u0650\u0633\u0652\u0639\u0627\u064B \u0648\u064E\u0639\u0650\u0634\u0652\u0631\u0650\u064A\u0646\u064E \xbb\u060C \u0641\u064E\u0642\u064F\u0645\u0652\u062A\u064F \u0639\u064E\u0644\u064E\u0649 \u0628\u064E\u0627\u0628\u0650 \u0627\u0644\u0652\u0645\u064E\u0633\u0652\u062C\u0650\u062F\u0650\u060C \u0641\u064E\u0646\u064E\u0627\u062F\u064E\u064A\u0652\u062A\u064F \u0628\u0650\u0623\u064E\u0639\u0652\u0644\u064E\u0649 \u0635\u064E\u0648\u0652\u062A\u0650\u064A: \u0644\u064E\u0645\u0652 \u064A\u064F\u0637\u064E\u0644\u0651\u0650\u0642\u064F \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \uFDFA \u0646\u0650\u0633\u064E\u0627\u0621\u064E\u0647\u064F\u060C \u0648\u064E\u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652 \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u064F: { \u0648\u064E\u0625\u0650\u0630\u064E\u0627 \u062C\u064E\u0627\u0653\u0621\u064E\u0647\u064F\u0645\u0652 \u0623\u064E\u0645\u0652\u0631\u064C \u0645\u0651\u0650\u0646\u064E \u0671\u0644\u0652\u0623\u064E\u0645\u0652\u0646\u0650 \u0623\u064E\u0648\u0650 \u0671\u0644\u0652\u062E\u064E\u0648\u0652\u0641\u0650 \u0623\u064E\u0630\u064E\u0627\u0639\u064F\u0648\u0627\u06DF \u0628\u0650\u0647\u0650\u06E6 \u06D6 \u0648\u064E\u0644\u064E\u0648\u0652 \u0631\u064E\u062F\u0651\u064F\u0648\u0647\u064F \u0625\u0650\u0644\u064E\u0649 \u0671\u0644\u0631\u0651\u064E\u0633\u064F\u0648\u0644\u0650 \u0648\u064E\u0625\u0650\u0644\u064E\u0649\u0670\u0653 \u0623\u064F\u0648\u06DF\u0644\u0650\u0649 \u0671\u0644\u0652\u0623\u064E\u0645\u0652\u0631\u0650 \u0645\u0650\u0646\u0652\u0647\u064F\u0645\u0652 \u0644\u064E\u0639\u064E\u0644\u0650\u0645\u064E\u0647\u064F \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u064A\u064E\u0633\u0652\u062A\u064E\u0646\u06E2\u0628\u0650\u0637\u064F\u0648\u0646\u064E\u0647\u064F\u06E5 \u0645\u0650\u0646\u0652\u0647\u064F\u0645\u0652 \u06D7 }\u060C \u0641\u064E\u0643\u064F\u0646\u0652\u062A\u064F \u0623\u064E\u0646\u064E\u0627 \u0627\u0633\u0652\u062A\u064E\u0646\u0628\u064E\u0637\u0652\u062A\u064F \u0630\u064E\u0644\u0650\u0643\u064E \u0627\u0644\u0652\u0623\u064E\u0645\u0652\u0631\u064E \u0648\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0639\u0632 \u0648 \u062C\u0644 \u0622\u064A\u0629 \u0627\u0644\u062A\u062E\u064A\u064A\u0631 ).",
