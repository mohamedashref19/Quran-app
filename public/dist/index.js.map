            title: "\u0623\u0645 \u0627\u0644\u0645\u0624\u0645\u0646\u064A\u0646 \u0627\u0644\u0641\u0642\u064A\u0647\u0629",
            story: "\u0647\u0627\u062C\u0631\u062A \u0627\u0644\u0647\u062C\u0631\u062A\u064A\u0646. \u062D\u064A\u0646 \u062A\u064F\u0648\u0641\u064A \u0632\u0648\u062C\u0647\u0627 \u062F\u0639\u062A \u0642\u0627\u0626\u0644\u0629: (\u0627\u0644\u0644\u0647\u0645 \u0623\u062C\u0631\u0646\u064A \u0641\u064A \u0645\u0635\u064A\u0628\u062A\u064A \u0648\u0623\u062E\u0644\u0641 \u0644\u064A \u062E\u064A\u0631\u0627\u064B \u0645\u0646\u0647\u0627)\u060C \u0641\u062A\u0632\u0648\u062C\u0647\u0627 \u0627\u0644\u0646\u0628\u064A \uFDFA. \u0646\u0635\u062D\u062A \u0627\u0644\u0646\u0628\u064A \uFDFA \u0628\u0631\u0623\u064A \u062D\u0643\u064A\u0645 \u0641\u064A \u0635\u0644\u062D \u0627\u0644\u062D\u062F\u064A\u0628\u064A\u0629 \u0641\u0623\u0646\u0642\u0630\u062A \u0627\u0644\u0645\u0648\u0642\u0641.",
            lessons: "\u0627\u0644\u0635\u0628\u0631 \u0639\u0644\u0649 \u0627\u0644\u0645\u0635\u064A\u0628\u0629 \u0628\u0627\u0644\u062F\u0639\u0627\u0621 \u064A\u064F\u0639\u0642\u0628\u0647 \u0627\u0644\u0644\u0647 \u062E\u064A\u0631\u0627\u064B. \u0627\u0644\u0645\u0631\u0623\u0629 \u0627\u0644\u0645\u0633\u0644\u0645\u0629 \u0634\u0631\u064A\u0643\u0629 \u0641\u064A \u0627\u0644\u0631\u0623\u064A \u0648\u0627\u0644\u0645\u0634\u0648\u0631\u0629.",
