            title: "\u062D\u0627\u0645\u0644 \u0633\u0631 \u0627\u0644\u0646\u0628\u064A \uFDFA",
            story: "\u0623\u0648\u0644 \u0645\u0646 \u062C\u0647\u0631 \u0628\u0627\u0644\u0642\u0631\u0622\u0646 \u0641\u064A \u0645\u0643\u0629 \u0641\u064A \u0627\u0644\u0645\u0633\u062C\u062F \u0627\u0644\u062D\u0631\u0627\u0645 \u062D\u062A\u0649 \u0636\u0631\u0628\u0647 \u0627\u0644\u0645\u0634\u0631\u0643\u0648\u0646. \u0643\u0627\u0646 \u064A\u0636\u0639 \u0646\u0639\u0644 \u0627\u0644\u0646\u0628\u064A \uFDFA \u062D\u064A\u0646 \u064A\u0642\u0648\u0645 \u0648\u064A\u0645\u0634\u0637 \u0634\u0639\u0631\u0647. \u0642\u0627\u0644 \u0627\u0644\u0646\u0628\u064A \uFDFA: (\u0645\u0646 \u0623\u062D\u0628 \u0623\u0646 \u064A\u0642\u0631\u0623 \u0627\u0644\u0642\u0631\u0622\u0646 \u063A\u0636\u0627\u064B \u0643\u0645\u0627 \u0623\u0646\u0632\u0644 \u0641\u0644\u064A\u0642\u0631\u0623\u0647 \u0639\u0644\u0649 \u0642\u0631\u0627\u0621\u0629 \u0627\u0628\u0646 \u0623\u0645 \u0639\u0628\u062F).",
            lessons: "\u0627\u0644\u0634\u062C\u0627\u0639\u0629 \u0641\u064A \u0627\u0644\u062C\u0647\u0631 \u0628\u0627\u0644\u062D\u0642. \u062E\u062F\u0645\u0629 \u0623\u0647\u0644 \u0627\u0644\u0639\u0644\u0645 \u0648\u0627\u0644\u0641\u0636\u0644 \u0637\u0631\u064A\u0642 \u0644\u0644\u0631\u0641\u0639\u0629 \u0648\u0627\u0644\u0639\u0644\u0645.",
            category_tag: "\u0623\u0647\u0644 \u0628\u062F\u0631"
        },
        {
            id: 14,
            category: "\u0623\u0647\u0644 \u0628\u062F\u0631",
            name: "\u0639\u0645\u0627\u0631 \u0628\u0646 \u064A\u0627\u0633\u0631",
            title: "\u0627\u0644\u0645\u0639\u0630\u0651\u0628 \u0641\u064A \u0627\u0644\u0644\u0647",
            story: "\u0645\u0646 \u0627\u0644\u0633\u0627\u0628\u0642\u064A\u0646 \u0644\u0644\u0625\u0633\u0644\u0627\u0645. \u0639\u064F\u0630\u0651\u0628 \u0647\u0648 \u0648\u0623\u0628\u0648\u0647 \u0648\u0623\u0645\u0647 \u0633\u0645\u064A\u0629 \u0628\u0623\u0634\u062F \u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u062A\u0639\u0630\u064A\u0628. \u062D\u064A\u0646 \u0646\u0637\u0642 \u0628\u0643\u0644\u0645\u0629 \u0627\u0644\u0643\u0641\u0631 \u0645\u064F\u0643\u0631\u0647\u0627\u064B \u062C\u0627\u0621 \u064A\u0628\u0643\u064A \u0644\u0644\u0646\u0628\u064A \uFDFA \u0641\u0646\u0632\u0644 \u0642\u0648\u0644\u0647 \u062A\u0639\u0627\u0644\u0649: (\u0625\u0650\u0644\u064E\u0651\u0627 \u0645\u064E\u0646 \u0623\u064F\u0643\u0652\u0631\u0650\u0647\u064E \u0648\u064E\u0642\u064E\u0644\u0652\u0628\u064F\u0647\u064F \u0645\u064F\u0637\u0652\u0645\u064E\u0626\u0650\u0646\u064C\u0651 \u0628\u0650\u0627\u0644\u0652\u0625\u0650\u064A\u0645\u064E\u0627\u0646\u0650). \u0642\u0627\u062A\u0644 \u0645\u0639 \u0639\u0644\u064A \u0628\u0646 \u0623\u0628\u064A \u0637\u0627\u0644\u0628 \u062D\u062A\u0649 \u0627\u0633\u062A\u064F\u0634\u0647\u062F \u0648\u0639\u0645\u0631\u0647 \u0641\u0648\u0642 \u0627\u0644\u062A\u0633\u0639\u064A\u0646.",
            lessons: "\u0627\u0644\u0625\u0643\u0631\u0627\u0647 \u0644\u0627 \u064A\u0641\u0633\u062F \u0627\u0644\u0625\u064A\u0645\u0627\u0646 \u0627\u0644\u0635\u0627\u062F\u0642 \u0641\u064A \u0627\u0644\u0642\u0644\u0628. \u0627\u0644\u062B\u0628\u0627\u062A \u0639\u0644\u0649 \u0627\u0644\u062D\u0642 \u062D\u062A\u0649 \u0622\u062E\u0631 \u0644\u062D\u0638\u0629 \u0641\u064A \u0627\u0644\u0639\u0645\u0631.",
            category_tag: "\u0623\u0647\u0644 \u0628\u062F\u0631"
        },
        {
            id: 15,
            category: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631",
            name: "\u0633\u0639\u062F \u0628\u0646 \u0645\u0639\u0627\u0630",
            title: "\u0633\u064A\u062F \u0627\u0644\u0623\u0646\u0635\u0627\u0631",
            story: "\u0633\u064A\u062F \u0627\u0644\u0623\u0648\u0633 \u0648\u0623\u062D\u062F \u0623\u0628\u0631\u0632 \u0627\u0644\u0623\u0646\u0635\u0627\u0631. \u0623\u0633\u0644\u0645 \u0639\u0644\u0649 \u064A\u062F \u0645\u0635\u0639\u0628 \u0628\u0646 \u0639\u0645\u064A\u0631 \u0641\u0623\u0633\u0644\u0645 \u0628\u0625\u0633\u0644\u0627\u0645\u0647 \u0628\u0646\u0648 \u0627\u0644\u0623\u0634\u0647\u0644 \u0643\u0644\u0647\u0645. \u0641\u064A \u063A\u0632\u0648\u0629 \u0627\u0644\u062E\u0646\u062F\u0642 \u0623\u0635\u064A\u0628 \u0628\u0633\u0647\u0645 \u0641\u062D\u0643\u0645 \u0641\u064A \u0628\u0646\u064A \u0642\u0631\u064A\u0638\u0629 \u0628\u0627\u0644\u062D\u0643\u0645 \u0627\u0644\u0639\u0627\u062F\u0644. \u0642\u0627\u0644 \u0627\u0644\u0646\u0628\u064A \uFDFA: (\u0627\u0647\u062A\u0632 \u0639\u0631\u0634 \u0627\u0644\u0631\u062D\u0645\u0646 \u0644\u0648\u0641\u0627\u0629 \u0633\u0639\u062F \u0628\u0646 \u0645\u0639\u0627\u0630).",
            lessons: "\u0627\u0644\u0642\u064A\u0627\u062F\u0629 \u0627\u0644\u062D\u0643\u064A\u0645\u0629 \u062A\u0628\u0646\u064A \u0627\u0644\u0623\u0645\u0645. \u0627\u0644\u062D\u0643\u0645 \u0628\u0627\u0644\u0639\u062F\u0644 \u0648\u0627\u062C\u0628 \u0648\u0627\u0644\u0625\u062E\u0644\u0627\u0635 \u0641\u064A \u0646\u0635\u0631\u0629 \u0627\u0644\u062F\u064A\u0646 \u064A\u0631\u0641\u0639 \u0627\u0644\u062F\u0631\u062C\u0627\u062A.",
            category_tag: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631"
        },
        {
            id: 16,
            category: "\u0623\u0647\u0644 \u0628\u062F\u0631",
            name: "\u062E\u0628\u064A\u0628 \u0628\u0646 \u0639\u062F\u064A",
            title: "\u0627\u0644\u0634\u0647\u064A\u062F \u0627\u0644\u0645\u0635\u0644\u0648\u0628",
            story: "\u0634\u0647\u062F \u0628\u062F\u0631\u0627\u064B\u060C \u0648\u0648\u0642\u0639 \u0641\u064A \u0623\u0633\u0631 \u0627\u0644\u0645\u0634\u0631\u0643\u064A\u0646 \u0648\u0628\u0627\u0639\u0648\u0647 \u0644\u0623\u0647\u0644 \u0645\u0643\u0629. \u0637\u0644\u0628 \u0623\u0646 \u064A\u0635\u0644\u064A \u0631\u0643\u0639\u062A\u064A\u0646 \u0642\u0628\u0644 \u0642\u062A\u0644\u0647 \u0641\u0635\u0644\u0649 \u0648\u0642\u0627\u0644: \u0644\u0648\u0644\u0627 \u0623\u0646 \u062A\u0638\u0646\u0648\u0627 \u0623\u0646\u064A \u062C\u0632\u0639\u062A \u0644\u0623\u0637\u0644\u062A\u0647\u0645\u0627. \u062D\u064A\u0646 \u0635\u0644\u0628\u0648\u0647 \u0642\u0627\u0644 \u0634\u0639\u0631\u0647 \u0627\u0644\u062E\u0627\u0644\u062F: \u0648\u0644\u0633\u062A \u0623\u0628\u0627\u0644\u064A \u062D\u064A\u0646 \u0623\u064F\u0642\u062A\u0644 \u0645\u0633\u0644\u0645\u0627\u064B \u0639\u0644\u0649 \u0623\u064A \u062C\u0646\u0628 \u0643\u0627\u0646 \u0641\u064A \u0627\u0644\u0644\u0647 \u0645\u0635\u0631\u0639\u064A.",
            lessons: "\u0627\u0644\u062B\u0628\u0627\u062A \u0639\u0644\u0649 \u0627\u0644\u0625\u064A\u0645\u0627\u0646 \u0623\u0645\u0627\u0645 \u0627\u0644\u0645\u0648\u062A \u0623\u0639\u0644\u0649 \u062F\u0631\u062C\u0627\u062A \u0627\u0644\u064A\u0642\u064A\u0646. \u0627\u0644\u0635\u0644\u0627\u0629 \u0645\u0644\u062C\u0623 \u0627\u0644\u0645\u0624\u0645\u0646 \u0641\u064A \u0643\u0644 \u0623\u062D\u0648\u0627\u0644\u0647.",
            category_tag: "\u0623\u0647\u0644 \u0628\u062F\u0631"
        },
        {
            id: 17,
            category: "\u0623\u0647\u0644 \u0628\u062F\u0631",
            name: "\u0628\u0644\u0627\u0644 \u0628\u0646 \u0631\u0628\u0627\u062D",
            title: "\u0645\u0624\u0630\u0646 \u0627\u0644\u0646\u0628\u064A \uFDFA",
            story: "\u0639\u0628\u062F \u062D\u0628\u0634\u064A \u0639\u064F\u0630\u0651\u0628 \u0628\u0642\u0633\u0648\u0629 \u0644\u0625\u0639\u0644\u0627\u0646\u0647 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u060C \u0643\u0627\u0646 \u0623\u0645\u064A\u0629 \u0628\u0646 \u062E\u0644\u0641 \u064A\u0636\u0639\u0647 \u062A\u062D\u062A \u0627\u0644\u0634\u0645\u0633 \u0627\u0644\u062D\u0627\u0631\u0642\u0629 \u0628\u0635\u062E\u0631\u0629 \u0639\u0644\u0649 \u0635\u062F\u0631\u0647 \u0648\u0647\u0648 \u064A\u0642\u0648\u0644: (\u0623\u062D\u062F \u0623\u062D\u062F). \u0623\u0639\u062A\u0642\u0647 \u0623\u0628\u0648 \u0628\u0643\u0631 \u0648\u0635\u0627\u0631 \u0623\u0648\u0644 \u0645\u0624\u0630\u0646 \u0641\u064A \u0627\u0644\u0625\u0633\u0644\u0627\u0645. \u0631\u0642\u0649 \u0639\u0644\u0649 \u0627\u0644\u0643\u0639\u0628\u0629 \u0648\u0623\u0630\u0651\u0646 \u064A\u0648\u0645 \u0641\u062A\u062D \u0645\u0643\u0629.",
            lessons: "\u0627\u0644\u062D\u0631\u064A\u0629 \u0627\u0644\u062D\u0642\u064A\u0642\u064A\u0629 \u0641\u064A \u0627\u0644\u062A\u0648\u062D\u064A\u062F \u0644\u0627 \u0641\u064A \u0627\u0644\u062C\u0633\u062F. \u0627\u0644\u062B\u0628\u0627\u062A \u0639\u0644\u0649 \u0627\u0644\u0625\u064A\u0645\u0627\u0646 \u0623\u0645\u0627\u0645 \u0623\u0634\u062F \u0627\u0644\u0639\u0630\u0627\u0628 \u064A\u0648\u0631\u062B \u0627\u0644\u0639\u0632\u0629.",
            category_tag: "\u0623\u0647\u0644 \u0628\u062F\u0631"
        },
        {
            id: 18,
            category: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631",
            name: "\u0623\u0628\u0648 \u0623\u064A\u0648\u0628 \u0627\u0644\u0623\u0646\u0635\u0627\u0631\u064A",
            title: "\u0645\u0636\u064A\u0641 \u0627\u0644\u0646\u0628\u064A \uFDFA",
            story: "\u062E\u0627\u0644\u062F \u0628\u0646 \u0632\u064A\u062F\u060C \u0646\u0632\u0644 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0641\u064A \u062F\u0627\u0631\u0647 \u062D\u064A\u0646 \u0642\u062F\u0645 \u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0648\u0623\u0642\u0627\u0645 \u0641\u064A\u0647\u0627 \u0633\u0628\u0639\u0629 \u0623\u0634\u0647\u0631. \u0623\u0635\u0631\u0651 \u0639\u0644\u0649 \u0623\u0646 \u064A\u0643\u0648\u0646 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0641\u064A \u0627\u0644\u0637\u0627\u0628\u0642 \u0627\u0644\u0623\u0639\u0644\u0649 \u0625\u062C\u0644\u0627\u0644\u0627\u064B \u0644\u0647. \u062E\u0631\u062C \u0644\u0644\u062C\u0647\u0627\u062F \u0648\u0647\u0648 \u0634\u064A\u062E \u0643\u0628\u064A\u0631 \u0648\u0645\u0627\u062A \u0639\u0644\u0649 \u0623\u0633\u0648\u0627\u0631 \u0627\u0644\u0642\u0633\u0637\u0646\u0637\u064A\u0646\u064A\u0629 \u0645\u062C\u0627\u0647\u062F\u0627\u064B.",
            lessons: "\u062D\u0633\u0646 \u0627\u0644\u0636\u064A\u0627\u0641\u0629 \u0648\u0625\u0643\u0631\u0627\u0645 \u0636\u064A\u0641 \u0627\u0644\u0644\u0647 \u0648\u0631\u0633\u0648\u0644\u0647. \u0627\u0644\u062C\u0647\u0627\u062F \u0641\u064A \u0633\u0628\u064A\u0644 \u0627\u0644\u0644\u0647 \u0644\u0627 \u064A\u0639\u0631\u0641 \u0643\u0628\u0631\u0627\u064B \u0641\u064A \u0627\u0644\u0633\u0646.",
            category_tag: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631"
        },
        {
            id: 19,
            category: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631",
            name: "\u0623\u0628\u0648 \u0627\u0644\u062F\u0631\u062F\u0627\u0621",
            title: "\u062D\u0643\u064A\u0645 \u0627\u0644\u0623\u0645\u0629",
            story: "\u0623\u0633\u0644\u0645 \u064A\u0648\u0645 \u0628\u062F\u0631\u060C \u0648\u0643\u0627\u0646 \u062A\u0627\u062C\u0631\u0627\u064B \u0641\u062A\u0631\u0643 \u0627\u0644\u062A\u062C\u0627\u0631\u0629 \u0648\u0627\u0646\u0642\u0637\u0639 \u0644\u0644\u0639\u0628\u0627\u062F\u0629 \u0648\u0627\u0644\u0639\u0644\u0645. \u062C\u0639\u0644\u0647 \u0639\u0645\u0631 \u0642\u0627\u0636\u064A\u0627\u064B \u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0645. \u0639\u064F\u0631\u0641 \u0628\u062D\u0643\u0645\u062A\u0647 \u0627\u0644\u0628\u0627\u0644\u063A\u0629 \u0648\u0642\u0648\u0644\u0647: (\u0646\u0639\u0645 \u0627\u0644\u0635\u0648\u0645\u0639\u0629 \u0627\u0644\u0628\u064A\u062A \u064A\u0643\u0641 \u0641\u064A\u0647 \u0627\u0644\u0645\u0631\u0621 \u0628\u0635\u0631\u0647 \u0648\u0644\u0633\u0627\u0646\u0647).",
            lessons: "\u0627\u0644\u0632\u0647\u062F \u0641\u064A \u0627\u0644\u062F\u0646\u064A\u0627 \u0628\u0639\u062F \u0627\u0644\u062A\u0645\u0643\u0646 \u0645\u0646\u0647\u0627 \u0623\u0639\u0644\u0649 \u062F\u0631\u062C\u0627\u062A \u0627\u0644\u062A\u0642\u0648\u0649. \u0637\u0644\u0628 \u0627\u0644\u0639\u0644\u0645 \u0648\u0627\u0644\u062D\u0643\u0645\u0629 \u0645\u0637\u0644\u0628 \u0639\u0638\u064A\u0645.",
            category_tag: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631"
        },
        {
            id: 20,
            category: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631",
            name: "\u0627\u0644\u0646\u0639\u0645\u0627\u0646 \u0628\u0646 \u0645\u0642\u0631\u0646",
            title: "\u0641\u0627\u062A\u062D \u0646\u0647\u0627\u0648\u0646\u062F",
            story: "\u0623\u0633\u0644\u0645 \u0645\u0639 \u0625\u062E\u0648\u062A\u0647 \u0627\u0644\u0633\u0628\u0639\u0629 \u0648\u0647\u0627\u062C\u0631\u0648\u0627 \u062C\u0645\u064A\u0639\u0627\u064B. \u0643\u0627\u0646 \u0642\u0627\u0626\u062F \u0645\u0639\u0631\u0643\u0629 (\u0646\u0647\u0627\u0648\u0646\u062F) \u0627\u0644\u0641\u0627\u0635\u0644\u0629 \u0627\u0644\u062A\u064A \u0633\u064F\u0645\u064A\u062A \u0641\u062A\u062D \u0627\u0644\u0641\u062A\u0648\u062D. \u0627\u0633\u062A\u064F\u0634\u0647\u062F \u0641\u064A \u0627\u0644\u0645\u0639\u0631\u0643\u0629 \u0648\u0623\u0643\u0645\u0644 \u0623\u062E\u0648\u0647 \u0627\u0644\u0642\u064A\u0627\u062F\u0629 \u062D\u062A\u0649 \u062A\u0645 \u0627\u0644\u0646\u0635\u0631 \u0628\u062A\u0648\u0641\u064A\u0642 \u0627\u0644\u0644\u0647.",
            lessons: "\u0627\u0644\u0642\u064A\u0627\u062F\u0629 \u0627\u0644\u062D\u0643\u064A\u0645\u0629 \u0648\u0627\u0644\u0634\u0648\u0631\u0649 \u0641\u064A \u0627\u062A\u062E\u0627\u0630 \u0627\u0644\u0642\u0631\u0627\u0631\u0627\u062A \u0627\u0644\u0639\u0633\u0643\u0631\u064A\u0629. \u0627\u0644\u0641\u062F\u0627\u0621 \u0628\u0627\u0644\u0646\u0641\u0633 \u0645\u0646 \u0623\u062C\u0644 \u0627\u0644\u0623\u0645\u0629.",
            category_tag: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631"
        },
        {
            id: 21,
            category: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631",
            name: "\u062C\u0627\u0628\u0631\u0628\u0646 \u0639\u0628\u062F \u0627\u0644\u0644\u0647",
            title: "\u0645\u062D\u062F\u062B \u0627\u0644\u0623\u0646\u0635\u0627\u0631",
            story: "\u0635\u062D\u0627\u0628\u064A \u062C\u0644\u064A\u0644 \u0634\u0647\u062F \u0627\u0644\u0639\u0642\u0628\u0629 \u0627\u0644\u062B\u0627\u0646\u064A\u0629. \u0631\u0648\u0649 \u0623\u0643\u062B\u0631 \u0645\u0646 \u0623\u0644\u0641 \u0648\u062E\u0645\u0633\u0645\u0627\u0626\u0629 \u062D\u062F\u064A\u062B \u0639\u0646 \u0627\u0644\u0646\u0628\u064A \uFDFA. \u0633\u0627\u0641\u0631 \u0634\u0647\u0631\u0627\u064B \u0643\u0627\u0645\u0644\u0627\u064B \u0625\u0644\u0649 \u0627\u0644\u0634\u0627\u0645 \u0644\u0633\u0645\u0627\u0639 \u062D\u062F\u064A\u062B \u0648\u0627\u062D\u062F \u0641\u0642\u0637\u060C \u0648\u0639\u064F\u0631\u0641 \u0628\u0633\u0639\u0629 \u0627\u0644\u0639\u0644\u0645 \u0648\u062D\u0633\u0646 \u0627\u0644\u062E\u0644\u0642.",
            lessons: "\u0627\u0644\u0631\u062D\u0644\u0629 \u0641\u064A \u0637\u0644\u0628 \u0627\u0644\u0639\u0644\u0645 \u0648\u0627\u0644\u0645\u0634\u0642\u0629 \u0641\u064A\u0647 \u0645\u0646 \u0623\u0639\u0644\u0649 \u062F\u0631\u062C\u0627\u062A \u0627\u0644\u0639\u0628\u0627\u062F\u0629. \u0627\u0644\u062D\u0631\u0635 \u0639\u0644\u0649 \u062D\u0641\u0638 \u0627\u0644\u0633\u0646\u0629 \u0627\u0644\u0646\u0628\u0648\u064A\u0629.",
            category_tag: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631"
        },
        {
            id: 22,
            category: "\u0627\u0644\u0645\u0647\u0627\u062C\u0631\u0648\u0646",
            name: "\u0623\u0628\u0648 \u0630\u0631 \u0627\u0644\u063A\u0641\u0627\u0631\u064A",
            title: "\u0627\u0644\u0635\u0627\u062F\u0642 \u0627\u0644\u0632\u0627\u0647\u062F",
            story: "\u0623\u0633\u0644\u0645 \u0645\u0628\u0643\u0631\u0627\u064B \u0648\u062C\u0627\u0647\u0631 \u0628\u0625\u0633\u0644\u0627\u0645\u0647 \u0641\u064A \u0627\u0644\u0645\u0633\u062C\u062F \u0627\u0644\u062D\u0631\u0627\u0645 \u062D\u062A\u0649 \u0636\u064F\u0631\u0628. \u0639\u064F\u0631\u0641 \u0628\u0634\u062F\u0629 \u0627\u0644\u0632\u0647\u062F \u0648\u0642\u0648\u0644 \u0627\u0644\u062D\u0642. \u0642\u0627\u0644 \u0641\u064A\u0647 \u0627\u0644\u0646\u0628\u064A \uFDFA: (\u0645\u0627 \u0623\u0638\u0644\u0651\u062A \u0627\u0644\u062E\u0636\u0631\u0627\u0621 \u0648\u0644\u0627 \u0623\u0642\u0644\u0651\u062A \u0627\u0644\u063A\u0628\u0631\u0627\u0621 \u0623\u0635\u062F\u0642 \u0644\u0647\u062C\u0629 \u0645\u0646 \u0623\u0628\u064A \u0630\u0631).",
            lessons: "\u0627\u0644\u0635\u062F\u0642 \u0627\u0644\u0645\u0637\u0644\u0642 \u0648\u0627\u0644\u062C\u0647\u0631 \u0628\u0627\u0644\u062D\u0642 \u0644\u0627 \u064A\u062E\u0634\u0649 \u0641\u064A\u0647 \u0644\u0648\u0645\u0629 \u0644\u0627\u0626\u0645. \u0627\u0644\u0632\u0647\u062F \u0627\u0644\u062D\u0642\u064A\u0642\u064A \u0639\u0635\u0645\u0629 \u0645\u0646 \u0627\u0644\u0641\u062A\u0646.",
            category_tag: "\u0627\u0644\u0645\u0647\u0627\u062C\u0631\u0648\u0646"
        },
        {
            id: 23,
            category: "\u0627\u0644\u0642\u0627\u062F\u0629",
            name: "\u062E\u0627\u0644\u062F \u0628\u0646 \u0627\u0644\u0648\u0644\u064A\u062F",
            title: "\u0633\u064A\u0641 \u0627\u0644\u0644\u0647 \u0627\u0644\u0645\u0633\u0644\u0648\u0644",
            story: "\u0623\u0639\u0638\u0645 \u0642\u0627\u0626\u062F \u0639\u0633\u0643\u0631\u064A\u060C \u0644\u0645 \u064A\u064F\u0647\u0632\u0645 \u0641\u064A \u0645\u0639\u0631\u0643\u0629 \u0642\u0637. \u0623\u0633\u0644\u0645 \u0642\u0628\u0644 \u0627\u0644\u0641\u062A\u062D. \u0642\u0627\u062F \u0645\u0626\u0629 \u0648\u062E\u0645\u0633\u064A\u0646 \u0645\u0639\u0631\u0643\u0629\u060C \u0648\u0641\u064A \u064A\u0648\u0645 \u0645\u0624\u062A\u0629 \u0627\u0646\u0643\u0633\u0631\u062A \u0641\u064A \u064A\u062F\u0647 \u062A\u0633\u0639\u0629 \u0623\u0633\u064A\u0627\u0641. \u0645\u0627\u062A \u0639\u0644\u0649 \u0641\u0631\u0627\u0634\u0647 \u0648\u0628\u0643\u0649 \u0642\u0627\u0626\u0644\u0627\u064B: (\u0641\u0644\u0627 \u0646\u0627\u0645\u062A \u0623\u0639\u064A\u0646 \u0627\u0644\u062C\u0628\u0646\u0627\u0621).",
            lessons: "\u0627\u0644\u0645\u0648\u0647\u0628\u0629 \u062A\u0648\u0638\u0641 \u0641\u064A \u0637\u0627\u0639\u0629 \u0627\u0644\u0644\u0647. \u0627\u0644\u062A\u0648\u0628\u0629 \u0627\u0644\u0635\u0627\u062F\u0642\u0629 \u062A\u0645\u062D\u0648 \u0645\u0627 \u0642\u0628\u0644\u0647\u0627\u060C \u0648\u0627\u0644\u0625\u062E\u0644\u0627\u0635 \u0641\u064A \u0646\u0635\u0631\u0629 \u0627\u0644\u062F\u064A\u0646.",
            category_tag: "\u0627\u0644\u0642\u0627\u062F\u0629"
        },
        {
            id: 24,
            category: "\u0627\u0644\u0642\u0627\u062F\u0629",
            name: "\u0639\u0645\u0631\u0648 \u0628\u0646 \u0627\u0644\u0639\u0627\u0635",
            title: "\u0641\u0627\u062A\u062D \u0645\u0635\u0631",
            story: "\u0645\u0646 \u0623\u0630\u0643\u064A\u0627\u0621 \u0627\u0644\u0639\u0631\u0628 \u0648\u062F\u064F\u0647\u0627\u062A\u0647\u0645. \u0623\u0633\u0644\u0645 \u0642\u0628\u0644 \u0641\u062A\u062D \u0645\u0643\u0629\u060C \u0648\u0627\u0639\u062A\u0645\u062F \u0639\u0644\u064A\u0647 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0644\u0630\u0643\u0627\u0626\u0647 \u0641\u0648\u0644\u0627\u0651\u0647 \u063A\u0632\u0648\u0629 \u0630\u0627\u062A \u0627\u0644\u0633\u0644\u0627\u0633\u0644. \u0627\u0641\u062A\u062A\u062D \u0627\u0644\u0634\u0627\u0645 \u0648\u0641\u0644\u0633\u0637\u064A\u0646\u060C \u062B\u0645 \u0641\u062A\u062D \u0645\u0635\u0631 \u0628\u0623\u0631\u0628\u0639\u0629 \u0622\u0644\u0627\u0641 \u062C\u0646\u062F\u064A \u0641\u0642\u0637 \u0648\u0635\u0627\u0631 \u0648\u0627\u0644\u064A\u0627\u064B \u0639\u0644\u064A\u0647\u0627.",
            lessons: "\u0627\u0644\u0630\u0643\u0627\u0621 \u0648\u0627\u0644\u062D\u0646\u0643\u0629 \u0627\u0644\u0633\u064A\u0627\u0633\u064A\u0629 \u0646\u0639\u0645\u0629 \u062A\u064F\u0633\u062A\u062E\u062F\u0645 \u0644\u062E\u062F\u0645\u0629 \u0627\u0644\u0625\u0633\u0644\u0627\u0645. \u0627\u0644\u0641\u062A\u062D \u0628\u0627\u0644\u0642\u0644\u0648\u0628 \u0648\u0627\u0644\u062F\u0647\u0627\u0621 \u0627\u0644\u0639\u0633\u0643\u0631\u064A.",
            category_tag: "\u0627\u0644\u0642\u0627\u062F\u0629"
        },
        {
            id: 25,
            category: "\u0627\u0644\u0639\u0644\u0645\u0627\u0621",
            name: "\u0623\u0628\u0648 \u0647\u0631\u064A\u0631\u0629",
            title: "\u062D\u0627\u0641\u0638 \u0627\u0644\u0633\u0646\u0629 \u0627\u0644\u0646\u0628\u0648\u064A\u0629",
            story: "\u0623\u0633\u0644\u0645 \u0639\u0627\u0645 \u062E\u064A\u0628\u0631 \u0648\u0644\u0632\u0645 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0628\u0634\u062F\u0629 \u0644\u0637\u0644\u0628 \u0627\u0644\u0639\u0644\u0645. \u062F\u0639\u0627 \u0644\u0647 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0628\u0642\u0648\u0629 \u0627\u0644\u062D\u0641\u0638\u060C \u0641\u0623\u0635\u0628\u062D \u0623\u0643\u062B\u0631 \u0627\u0644\u0635\u062D\u0627\u0628\u0629 \u0631\u0648\u0627\u064A\u0629 \u0644\u0644\u062D\u062F\u064A\u062B (\u0631\u0648\u0649 \u0623\u0643\u062B\u0631 \u0645\u0646 5000 \u062D\u062F\u064A\u062B). \u0643\u0627\u0646 \u0641\u0642\u064A\u0631\u0627\u064B \u0645\u0646 \u0623\u0647\u0644 \u0627\u0644\u0635\u064F\u0651\u0641\u0629.",
            lessons: "\u0627\u0644\u0645\u0644\u0627\u0632\u0645\u0629 \u0644\u0623\u0647\u0644 \u0627\u0644\u0639\u0644\u0645 \u0637\u0631\u064A\u0642 \u0644\u062A\u062D\u0635\u064A\u0644\u0647. \u0627\u0644\u0641\u0642\u0631 \u0644\u0627 \u064A\u0645\u0646\u0639 \u0627\u0644\u0625\u0646\u0633\u0627\u0646 \u0645\u0646 \u0627\u0644\u0631\u064A\u0627\u062F\u0629 \u0648\u0627\u0644\u062A\u0645\u064A\u0632 \u0648\u0627\u0644\u062A\u0623\u062B\u064A\u0631.",
            category_tag: "\u0627\u0644\u0645\u0647\u0627\u062C\u0631\u0648\u0646"
        },
        {
            id: 26,
            category: "\u0627\u0644\u0639\u0644\u0645\u0627\u0621",
            name: "\u0639\u0628\u062F \u0627\u0644\u0644\u0647 \u0628\u0646 \u0639\u0645\u0631",
            title: "\u0627\u0644\u0645\u062A\u0628\u0639 \u0644\u0644\u0623\u062B\u0631",
            story: "\u0627\u0628\u0646 \u0627\u0644\u0641\u0627\u0631\u0648\u0642\u060C \u0639\u064F\u0631\u0641 \u0628\u0634\u062F\u0629 \u0627\u062A\u0628\u0627\u0639\u0647 \u0648\u062A\u0642\u0644\u064A\u062F\u0647 \u0644\u0643\u0644 \u0623\u0641\u0639\u0627\u0644 \u0648\u062D\u0631\u0643\u0627\u062A \u0627\u0644\u0646\u0628\u064A \uFDFA. \u0643\u0627\u0646 \u063A\u0632\u064A\u0631 \u0627\u0644\u0639\u0644\u0645 \u0648\u0627\u0644\u0641\u062A\u0648\u0649\u060C \u0648\u0643\u062B\u064A\u0631 \u0627\u0644\u0635\u062F\u0642\u0629 \u0644\u0627 \u064A\u0623\u0643\u0644 \u0644\u062D\u0645\u0627\u064B \u0625\u0644\u0627 \u0648\u0639\u0644\u0649 \u064A\u062F\u0647 \u064A\u062A\u064A\u0645. \u0627\u0639\u062A\u0632\u0644 \u0627\u0644\u0641\u062A\u0646 \u062A\u0645\u0627\u0645\u0627\u064B \u0648\u0631\u0641\u0636 \u0627\u0644\u062E\u0644\u0627\u0641\u0629.",
            lessons: "\u0627\u0644\u0627\u062A\u0628\u0627\u0639 \u0627\u0644\u062F\u0642\u064A\u0642 \u0644\u0644\u0633\u0646\u0629 \u0627\u0644\u0646\u0628\u0648\u064A\u0629. \u0627\u0644\u0648\u0631\u0639 \u0648\u0627\u0644\u0627\u0628\u062A\u0639\u0627\u062F \u0639\u0646 \u0627\u0644\u0641\u062A\u0646\u060C \u0648\u0643\u062B\u0631\u0629 \u0627\u0644\u0635\u062F\u0642\u0629 \u0633\u0631\u0627\u064B \u0648\u0639\u0644\u0627\u0646\u064A\u0629.",
            category_tag: "\u0627\u0644\u0645\u0647\u0627\u062C\u0631\u0648\u0646"
        },
        {
            id: 27,
            category: "\u0627\u0644\u0639\u0644\u0645\u0627\u0621",
            name: "\u0639\u0628\u062F \u0627\u0644\u0644\u0647 \u0628\u0646 \u0639\u0628\u0627\u0633",
            title: "\u062D\u0628\u0631 \u0627\u0644\u0623\u0645\u0629 \u0648\u062A\u0631\u062C\u0645\u0627\u0646 \u0627\u0644\u0642\u0631\u0622\u0646",
            story: "\u0627\u0628\u0646 \u0639\u0645 \u0627\u0644\u0646\u0628\u064A \uFDFA\u060C \u062F\u0639\u0627 \u0644\u0647 \u0648\u0647\u0648 \u063A\u0644\u0627\u0645: (\u0627\u0644\u0644\u0647\u0645 \u0641\u0642\u0647\u0647 \u0641\u064A \u0627\u0644\u062F\u064A\u0646 \u0648\u0639\u0644\u0645\u0647 \u0627\u0644\u062A\u0623\u0648\u064A\u0644). \u062A\u0645\u064A\u0632 \u0628\u0641\u0647\u0645 \u0639\u0645\u064A\u0642 \u0644\u0644\u0642\u0631\u0622\u0646 \u0648\u0630\u0643\u0627\u0621 \u062E\u0627\u0631\u0642\u060C \u0643\u0627\u0646 \u0639\u0645\u0631 \u0628\u0646 \u0627\u0644\u062E\u0637\u0627\u0628 \u064A\u062F\u062E\u0644\u0647 \u0645\u0639 \u0643\u0628\u0627\u0631 \u0627\u0644\u0635\u062D\u0627\u0628\u0629 \u0641\u064A \u0627\u0644\u0634\u0648\u0631\u0649 \u0644\u0631\u062C\u0627\u062D\u0629 \u0639\u0642\u0644\u0647.",
            lessons: "\u0623\u0647\u0645\u064A\u0629 \u0627\u0644\u062F\u0639\u0627\u0621 \u0644\u0644\u0646\u0634\u0621. \u0627\u0644\u0633\u0639\u064A \u0627\u0644\u062F\u0624\u0648\u0628 \u0644\u0637\u0644\u0628 \u0627\u0644\u0639\u0644\u0645 \u064A\u062C\u0639\u0644 \u0627\u0644\u0634\u0627\u0628 \u064A\u062A\u0641\u0648\u0642 \u0639\u0644\u0649 \u0627\u0644\u0643\u0628\u0627\u0631 \u062D\u0643\u0645\u0629\u064B \u0648\u0639\u0644\u0645\u0627\u064B.",
            category_tag: "\u0622\u0644 \u0627\u0644\u0628\u064A\u062A"
        },
        {
            id: 28,
            category: "\u0627\u0644\u0639\u0644\u0645\u0627\u0621",
            name: "\u0645\u0639\u0627\u0630 \u0628\u0646 \u062C\u0628\u0644",
            title: "\u0623\u0639\u0644\u0645 \u0627\u0644\u0623\u0645\u0629 \u0628\u0627\u0644\u062D\u0644\u0627\u0644 \u0648\u0627\u0644\u062D\u0631\u0627\u0645",
            story: "\u0623\u0633\u0644\u0645 \u0648\u0647\u0648 \u0641\u062A\u0649\u060C \u0648\u0623\u062E\u0630 \u0627\u0644\u0642\u0631\u0622\u0646 \u063A\u0636\u0627\u064B \u0645\u0646 \u0627\u0644\u0646\u0628\u064A \uFDFA. \u0628\u0639\u062B\u0647 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0625\u0644\u0649 \u0627\u0644\u064A\u0645\u0646 \u0642\u0627\u0636\u064A\u0627\u064B \u0648\u0645\u0639\u0644\u0645\u0627\u064B. \u0642\u0627\u0644 \u0639\u0646\u0647 \u0627\u0644\u0646\u0628\u064A \uFDFA: (\u0623\u0639\u0644\u0645 \u0623\u0645\u062A\u064A \u0628\u0627\u0644\u062D\u0644\u0627\u0644 \u0648\u0627\u0644\u062D\u0631\u0627\u0645 \u0645\u0639\u0627\u0630 \u0628\u0646 \u062C\u0628\u0644). \u0645\u0627\u062A \u0641\u064A \u0637\u0627\u0639\u0648\u0646 \u0639\u0645\u0648\u0627\u0633 \u0645\u062D\u062A\u0633\u0628\u0627\u064B.",
            lessons: "\u0627\u0644\u0641\u0642\u0647 \u0641\u064A \u0627\u0644\u062F\u064A\u0646 \u064A\u0631\u0641\u0639 \u0645\u0643\u0627\u0646\u0629 \u0627\u0644\u0639\u0628\u062F. \u062A\u062D\u0645\u0644 \u0627\u0644\u0645\u0633\u0624\u0648\u0644\u064A\u0629 \u0641\u064A \u0627\u0644\u062F\u0639\u0648\u0629 \u0648\u0627\u0644\u0642\u0636\u0627\u0621\u060C \u0648\u0627\u0644\u0631\u0636\u0627 \u0628\u0642\u0636\u0627\u0621 \u0627\u0644\u0644\u0647.",
            category_tag: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631"
        },
        {
            id: 29,
            category: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631",
            name: "\u0623\u0628\u0648 \u062F\u062C\u0627\u0646\u0629",
            title: "\u0635\u0627\u062D\u0628 \u0627\u0644\u0639\u0635\u0627\u0628\u0629 \u0627\u0644\u062D\u0645\u0631\u0627\u0621",
            story: "\u0633\u0645\u0627\u0643 \u0628\u0646 \u062E\u0631\u0634\u0629\u060C \u0627\u0644\u0641\u0627\u0631\u0633 \u0627\u0644\u0634\u062C\u0627\u0639. \u0623\u062E\u0630 \u0633\u064A\u0641 \u0627\u0644\u0646\u0628\u064A \uFDFA \u064A\u0648\u0645 \u0623\u062D\u062F \u0628\u062D\u0642\u0647\u060C \u0641\u062A\u0639\u0635\u0628 \u0628\u0639\u0635\u0627\u0628\u062A\u0647 \u0627\u0644\u062D\u0645\u0631\u0627\u0621 \u0648\u0645\u0634\u0649 \u064A\u062A\u0628\u062E\u062A\u0631 \u0641\u064A \u0635\u0641\u0648\u0641 \u0627\u0644\u0623\u0639\u062F\u0627\u0621. \u0627\u0633\u062A\u064F\u0634\u0647\u062F \u0641\u064A \u062D\u0631\u0648\u0628 \u0627\u0644\u0631\u062F\u0629 \u0628\u0639\u062F \u0623\u0646 \u0627\u0642\u062A\u062D\u0645 \u062D\u062F\u064A\u0642\u0629 \u0645\u0633\u064A\u0644\u0645\u0629 \u0627\u0644\u0643\u0630\u0627\u0628.",
            lessons: "\u0625\u064A\u0641\u0627\u0621 \u0627\u0644\u0639\u0647\u0648\u062F\u060C \u0648\u0627\u0644\u0634\u062C\u0627\u0639\u0629 \u0648\u0627\u0644\u0627\u0639\u062A\u0632\u0627\u0632 \u0628\u0627\u0644\u062F\u064A\u0646 \u0641\u064A \u0645\u064A\u0627\u062F\u064A\u0646 \u0627\u0644\u0642\u062A\u0627\u0644. \u0633\u0644\u0627\u0645\u0629 \u0627\u0644\u0635\u062F\u0631 \u0644\u0625\u062E\u0648\u0627\u0646\u0647 \u0627\u0644\u0645\u0633\u0644\u0645\u064A\u0646.",
            category_tag: "\u0623\u0647\u0644 \u0628\u062F\u0631"
        },
        {
            id: 30,
            category: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631",
            name: "\u0643\u0639\u0628 \u0628\u0646 \u0645\u0627\u0644\u0643",
            title: "\u0627\u0644\u0634\u0627\u0639\u0631 \u0627\u0644\u062A\u0627\u0626\u0628",
            story: "\u0645\u0646 \u0634\u0639\u0631\u0627\u0621 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0648\u0641\u0631\u0633\u0627\u0646\u0647. \u062A\u062E\u0644\u0641 \u0639\u0646 \u063A\u0632\u0648\u0629 \u062A\u0628\u0648\u0643 \u0628\u063A\u064A\u0631 \u0639\u0630\u0631\u060C \u0641\u0635\u062F\u0642 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0648\u0644\u0645 \u064A\u062E\u062A\u0644\u0642 \u0623\u0639\u0630\u0627\u0631\u0627\u064B \u0643\u0627\u0630\u0628\u0629. \u0642\u0627\u0637\u0639\u0647 \u0627\u0644\u0645\u0633\u0644\u0645\u0648\u0646 50 \u064A\u0648\u0645\u0627\u064B \u0627\u0645\u062A\u062D\u0627\u0646\u0627\u064B \u0644\u0647\u060C \u062D\u062A\u0649 \u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u062A\u0648\u0628\u062A\u0647 \u0641\u064A \u0627\u0644\u0642\u0631\u0622\u0646 \u0627\u0644\u0643\u0631\u064A\u0645.",
            lessons: "\u0627\u0644\u0635\u062F\u0642 \u0637\u0645\u0623\u0646\u064A\u0646\u0629 \u0648\u0646\u062C\u0627\u0629 \u0648\u0644\u0648 \u0643\u0627\u0646 \u0638\u0627\u0647\u0631\u0647 \u0627\u0644\u0647\u0644\u0627\u0643. \u0627\u0644\u062B\u0628\u0627\u062A \u0639\u0644\u0649 \u0627\u0644\u0625\u064A\u0645\u0627\u0646 \u0641\u064A \u0644\u062D\u0638\u0627\u062A \u0627\u0644\u0627\u0628\u062A\u0644\u0627\u0621 \u0627\u0644\u0635\u0639\u0628\u0629.",
            category_tag: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631"
        },
        {
            id: 31,
            category: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631",
            name: "\u0639\u0645\u064A\u0631 \u0628\u0646 \u0627\u0644\u062D\u0645\u0627\u0645",
            title: "\u0623\u0648\u0644 \u0634\u0647\u064A\u062F \u0645\u0646 \u0627\u0644\u0623\u0646\u0635\u0627\u0631",
            story: "\u064A\u0648\u0645 \u0628\u062F\u0631 \u0633\u0645\u0639 \u0627\u0644\u0646\u0628\u064A \uFDFA \u064A\u062D\u062B \u0639\u0644\u0649 \u0627\u0644\u062C\u0646\u0629\u060C \u0648\u0641\u064A \u064A\u062F\u0647 \u062A\u0645\u0631\u0627\u062A \u064A\u0623\u0643\u0644\u0647\u0627\u060C \u0641\u0642\u0627\u0644: (\u0644\u0626\u0646 \u0623\u0646\u0627 \u062D\u064A\u064A\u062A \u062D\u062A\u0649 \u0622\u0643\u0644 \u062A\u0645\u0631\u0627\u062A\u064A \u0647\u0630\u0647 \u0625\u0646\u0647\u0627 \u0644\u062D\u064A\u0627\u0629 \u0637\u0648\u064A\u0644\u0629)\u060C \u0641\u0631\u0645\u0649 \u0627\u0644\u062A\u0645\u0631\u0627\u062A \u0648\u0627\u0646\u0637\u0644\u0642 \u064A\u0642\u0627\u062A\u0644 \u0628\u0628\u0633\u0627\u0644\u0629 \u062D\u062A\u0649 \u0646\u0627\u0644 \u0627\u0644\u0634\u0647\u0627\u062F\u0629.",
            lessons: "\u0627\u0644\u0645\u0633\u0627\u0631\u0639\u0629 \u0625\u0644\u0649 \u062A\u0644\u0628\u064A\u0629 \u0646\u062F\u0627\u0621 \u0627\u0644\u0644\u0647 \u0648\u0631\u0633\u0648\u0644\u0647\u060C \u0648\u0627\u0644\u064A\u0642\u064A\u0646 \u0628\u0648\u0639\u062F \u0627\u0644\u0644\u0647\u060C \u0648\u0627\u0633\u062A\u0635\u063A\u0627\u0631 \u0627\u0644\u062F\u0646\u064A\u0627 \u0623\u0645\u0627\u0645 \u0627\u0644\u0622\u062E\u0631\u0629.",
            category_tag: "\u0623\u0647\u0644 \u0628\u062F\u0631"
        },
        {
            id: 32,
            category: "\u0627\u0644\u0645\u0647\u0627\u062C\u0631\u0648\u0646",
            name: "\u0639\u064A\u0627\u0636 \u0628\u0646 \u063A\u0646\u0645",
            title: "\u0641\u0627\u062A\u062D \u0627\u0644\u062C\u0632\u064A\u0631\u0629 (\u0632\u0627\u062F \u0627\u0644\u0631\u0643\u0627\u0628)",
            story: "\u0645\u0646 \u0623\u0634\u0631\u0627\u0641 \u0642\u0631\u064A\u0634\u060C \u0634\u0647\u062F \u0627\u0644\u062D\u062F\u064A\u0628\u064A\u0629. \u0643\u0627\u0646 \u0642\u0627\u0626\u062F\u0627\u064B \u0639\u0633\u0643\u0631\u064A\u0627\u064B \u0641\u0630\u0627\u064B \u0641\u062A\u062D \u0627\u0644\u062C\u0632\u064A\u0631\u0629 \u0627\u0644\u0641\u0631\u0627\u062A\u064A\u0629. \u0639\u064F\u0631\u0641 \u0628\u0627\u0644\u0648\u0631\u0639 \u0627\u0644\u0634\u062F\u064A\u062F \u0648\u0627\u0644\u0643\u0631\u0645\u060C \u0641\u0643\u0627\u0646 \u064A\u0646\u0641\u0642 \u0632\u0627\u062F \u0627\u0644\u0633\u0641\u0631 \u0639\u0644\u0649 \u062C\u0646\u062F\u0647 \u062D\u062A\u0649 \u0633\u064F\u0645\u064A (\u0632\u0627\u062F \u0627\u0644\u0631\u0643\u0627\u0628). \u0645\u0627\u062A \u0648\u0644\u0645 \u064A\u062A\u0631\u0643 \u062F\u0631\u0647\u0645\u0627\u064B.",
            lessons: "\u0627\u0644\u062C\u0645\u0639 \u0628\u064A\u0646 \u0627\u0644\u0634\u062C\u0627\u0639\u0629 \u0627\u0644\u0639\u0633\u0643\u0631\u064A\u0629 \u0648\u0627\u0644\u0632\u0647\u062F \u0627\u0644\u0645\u0627\u062F\u064A. \u0627\u0644\u0639\u0637\u0627\u0621 \u0648\u0627\u0644\u062A\u0636\u062D\u064A\u0629 \u0644\u0644\u0642\u0627\u062F\u0629 \u0642\u0628\u0644 \u0627\u0644\u062C\u0646\u0648\u062F.",
            category_tag: "\u0627\u0644\u0642\u0627\u062F\u0629"
        },
        {
            id: 33,
            category: "\u0627\u0644\u0645\u0647\u0627\u062C\u0631\u0648\u0646",
            name: "\u0645\u0639\u0627\u0648\u064A\u0629 \u0628\u0646 \u062D\u062F\u064A\u062C",
            title: "\u0627\u0644\u0641\u0627\u062A\u062D \u0627\u0644\u062C\u0631\u064A\u0621",
            story: "\u0634\u0647\u062F \u0641\u062A\u062D \u0645\u0635\u0631 \u0648\u0627\u0644\u0645\u063A\u0631\u0628\u060C \u0648\u0643\u0627\u0646 \u0642\u0627\u0626\u062F\u0627\u064B \u0634\u062C\u0627\u0639\u0627\u064B \u0641\u0642\u062F \u0639\u064A\u0646\u0647 \u0641\u064A \u063A\u0632\u0648\u0629 \u0627\u0644\u0646\u0648\u0628\u0629. \u0639\u064F\u0631\u0641 \u0628\u0642\u0648\u0644 \u0627\u0644\u062D\u0642 \u0648\u0627\u0644\u062C\u0631\u0623\u0629 \u0641\u064A \u0625\u0646\u0643\u0627\u0631 \u0627\u0644\u0645\u0646\u0643\u0631 \u062D\u062A\u0649 \u0639\u0644\u0649 \u0627\u0644\u0648\u0644\u0627\u0629 \u0648\u0627\u0644\u0623\u0645\u0631\u0627\u0621 \u0644\u0636\u0645\u0627\u0646 \u0627\u0644\u0639\u062F\u0644 \u0628\u064A\u0646 \u0627\u0644\u0645\u0633\u0644\u0645\u064A\u0646.",
            lessons: "\u0627\u0644\u062C\u0631\u0623\u0629 \u0641\u064A \u0642\u0648\u0644 \u0627\u0644\u062D\u0642\u060C \u0648\u0627\u0644\u0623\u0645\u0631 \u0628\u0627\u0644\u0645\u0639\u0631\u0648\u0641 \u0648\u0627\u0644\u0646\u0647\u064A \u0639\u0646 \u0627\u0644\u0645\u0646\u0643\u0631 \u0644\u062D\u0645\u0627\u064A\u0629 \u0627\u0644\u0645\u062C\u062A\u0645\u0639 \u0645\u0646 \u0627\u0644\u0638\u0644\u0645.",
            category_tag: "\u0627\u0644\u0642\u0627\u062F\u0629"
        },
        {
            id: 34,
            category: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631",
            name: "\u0642\u062A\u0627\u062F\u0629 \u0628\u0646 \u0627\u0644\u0646\u0639\u0645\u0627\u0646",
            title: "\u0627\u0644\u0645\u0631\u062F\u0648\u062F\u0629 \u0639\u064A\u0646\u0647",
            story: "\u0623\u0635\u064A\u0628\u062A \u0639\u064A\u0646\u0647 \u064A\u0648\u0645 \u0623\u062D\u062F \u0648\u0633\u0642\u0637\u062A\u060C \u0641\u0631\u062F\u0647\u0627 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0628\u064A\u062F\u0647 \u0627\u0644\u0634\u0631\u064A\u0641\u0629 \u0641\u0643\u0627\u0646\u062A \u0623\u062D\u0633\u0646 \u0639\u064A\u0646\u064A\u0647. \u0643\u0627\u0646 \u0643\u062B\u064A\u0631 \u0627\u0644\u0639\u0628\u0627\u062F\u0629\u060C \u0642\u0631\u0623 (\u0642\u0644 \u0647\u0648 \u0627\u0644\u0644\u0647 \u0623\u062D\u062F) \u0644\u064A\u0644\u0629 \u0643\u0627\u0645\u0644\u0629 \u0641\u0628\u0634\u0631\u0647 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0628\u0641\u0636\u0644\u0647\u0627.",
            lessons: "\u0628\u0631\u0643\u0629 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0648\u0645\u0639\u062C\u0632\u0627\u062A\u0647. \u0641\u0636\u0644 \u0642\u0631\u0627\u0621\u0629 \u0633\u0648\u0631\u0629 \u0627\u0644\u0625\u062E\u0644\u0627\u0635 \u0648\u0627\u0644\u0627\u062C\u062A\u0647\u0627\u062F \u0641\u064A \u0642\u064A\u0627\u0645 \u0627\u0644\u0644\u064A\u0644.",
            category_tag: "\u0623\u0647\u0644 \u0628\u062F\u0631"
        },
        {
            id: 35,
            category: "\u0627\u0644\u0645\u0647\u0627\u062C\u0631\u0648\u0646",
            name: "\u0646\u0639\u064A\u0645 \u0628\u0646 \u0645\u0633\u0639\u0648\u062F",
            title: "\u0645\u064F\u0641\u0631\u0650\u0651\u0642 \u0627\u0644\u0623\u062D\u0632\u0627\u0628",
            story: "\u0623\u0633\u0644\u0645 \u0633\u0631\u0627\u064B \u0623\u062B\u0646\u0627\u0621 \u063A\u0632\u0648\u0629 \u0627\u0644\u062E\u0646\u062F\u0642 \u0648\u062C\u0627\u0621 \u0644\u0644\u0646\u0628\u064A \uFDFA \u064A\u0639\u0631\u0636 \u062E\u062F\u0645\u0627\u062A\u0647. \u0627\u0633\u062A\u062E\u062F\u0645\u0647 \u0627\u0644\u0646\u0628\u064A \u0641\u064A \u0625\u064A\u0642\u0627\u0639 \u0627\u0644\u0634\u0643 \u0648\u0627\u0644\u0641\u0631\u0642\u0629 \u0628\u064A\u0646 \u064A\u0647\u0648\u062F \u0628\u0646\u064A \u0642\u0631\u064A\u0638\u0629 \u0648\u0645\u0634\u0631\u0643\u064A \u0642\u0631\u064A\u0634\u060C \u0641\u0643\u0627\u0646 \u0627\u0644\u0633\u0628\u0628 \u0627\u0644\u0631\u0626\u064A\u0633\u064A \u0641\u064A \u062A\u0641\u0643\u0643 \u0627\u0644\u0623\u062D\u0632\u0627\u0628 \u0648\u0631\u062D\u064A\u0644\u0647\u0645.",
            lessons: "\u062A\u0648\u0638\u064A\u0641 \u0627\u0644\u0641\u0637\u0646\u0629 \u0648\u0627\u0644\u0630\u0643\u0627\u0621 \u0641\u064A \u062E\u062F\u0645\u0629 \u0627\u0644\u062F\u064A\u0646. (\u0627\u0644\u062D\u0631\u0628 \u062E\u062F\u0639\u0629) \u0648\u0623\u0647\u0645\u064A\u0629 \u0627\u0644\u0625\u0639\u0644\u0627\u0645 \u0648\u0627\u0644\u062A\u0648\u062C\u064A\u0647 \u0627\u0644\u0645\u0639\u0646\u0648\u064A.",
            category_tag: "\u0627\u0644\u0635\u062D\u0627\u0628\u0629"
        },
        {
            id: 36,
            category: "\u0627\u0644\u0645\u0647\u0627\u062C\u0631\u0648\u0646",
            name: "\u0627\u0644\u0637\u0641\u064A\u0644 \u0628\u0646 \u0639\u0645\u0631\u0648 \u0627\u0644\u062F\u0648\u0633\u064A",
            title: "\u0630\u0648 \u0627\u0644\u0646\u0648\u0631",
            story: "\u0633\u064A\u062F \u062F\u0648\u0633 \u0648\u0634\u0627\u0639\u0631\u0647\u0627. \u062D\u0630\u0631\u062A\u0647 \u0642\u0631\u064A\u0634 \u0645\u0646 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0641\u0633\u062F \u0623\u0630\u0646\u064A\u0647 \u0628\u0642\u0637\u0646\u060C \u0648\u0644\u0643\u0646\u0647 \u0627\u0633\u062A\u0645\u0639 \u062E\u0644\u0633\u0629 \u0641\u0623\u0633\u0644\u0645 \u0641\u0648\u0631\u0627\u064B \u0644\u062C\u0645\u0627\u0644 \u0627\u0644\u0642\u0631\u0622\u0646. \u062C\u0639\u0644 \u0627\u0644\u0644\u0647 \u0641\u064A \u0633\u0648\u0637\u0647 \u0646\u0648\u0631\u0627\u064B \u062F\u0644\u064A\u0644\u0627\u064B \u0644\u0642\u0648\u0645\u0647\u060C \u0648\u0643\u0627\u0646 \u0633\u0628\u0628 \u0647\u062F\u0627\u064A\u0629 \u0642\u0628\u064A\u0644\u062A\u0647 \u0648\u0645\u0646\u0647\u0645 \u0623\u0628\u0648 \u0647\u0631\u064A\u0631\u0629.",
            lessons: "\u0627\u0644\u0628\u062D\u062B \u0639\u0646 \u0627\u0644\u062D\u0642 \u0628\u0639\u0642\u0644 \u0645\u062A\u0641\u062A\u062D \u0628\u0639\u064A\u062F\u0627\u064B \u0639\u0646 \u0627\u0644\u0634\u0627\u0626\u0639\u0627\u062A. \u0627\u0644\u0645\u0628\u0627\u062F\u0631\u0629 \u0628\u062F\u0639\u0648\u0629 \u0627\u0644\u0623\u0647\u0644 \u0648\u0627\u0644\u0639\u0634\u064A\u0631\u0629 \u0644\u0644\u062E\u064A\u0631.",
            category_tag: "\u0627\u0644\u0635\u062D\u0627\u0628\u0629"
        },
        {
            id: 37,
            category: "\u0627\u0644\u0645\u0647\u0627\u062C\u0631\u0648\u0646",
            name: "\u0646\u0639\u064A\u0645 \u0627\u0644\u0646\u062D\u0627\u0645",
            title: "\u0627\u0644\u062C\u0648\u0627\u062F \u0627\u0644\u0645\u062E\u0641\u064A \u0644\u0644\u0625\u0633\u0644\u0627\u0645",
            story: "\u0623\u0633\u0644\u0645 \u0642\u062F\u064A\u0645\u0627\u064B \u0648\u0643\u062A\u0645 \u0625\u0633\u0644\u0627\u0645\u0647 \u0644\u062D\u0645\u0627\u064A\u0629 \u0623\u064A\u062A\u0627\u0645 \u0648\u0623\u0631\u0627\u0645\u0644 \u0642\u0648\u0645\u0647 \u0627\u0644\u0630\u064A\u0646 \u0643\u0627\u0646 \u064A\u0643\u0641\u0644\u0647\u0645 \u0648\u064A\u0646\u0641\u0642 \u0639\u0644\u064A\u0647\u0645. \u0633\u0645\u064A (\u0627\u0644\u0646\u062D\u0627\u0645) \u0644\u0623\u0646 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0633\u0645\u0639 \u062A\u0646\u062D\u0646\u062D\u0647 \u0641\u064A \u0627\u0644\u062C\u0646\u0629. \u0648\u0647\u0648 \u0627\u0644\u0630\u064A \u0635\u0631\u0641 \u0639\u0645\u0631 \u0628\u0646 \u0627\u0644\u062E\u0637\u0627\u0628 \u0639\u0646 \u0642\u062A\u0644 \u0627\u0644\u0646\u0628\u064A \u0642\u0628\u0644 \u0625\u0633\u0644\u0627\u0645\u0647.",
            lessons: "\u0643\u0641\u0627\u0644\u0629 \u0627\u0644\u0623\u064A\u062A\u0627\u0645 \u0648\u0627\u0644\u0623\u0631\u0627\u0645\u0644 \u0645\u0646 \u0623\u0639\u0638\u0645 \u0627\u0644\u0642\u0631\u0628\u0627\u062A. \u0627\u0644\u062A\u062F\u0628\u064A\u0631 \u0648\u0627\u0644\u062D\u0643\u0645\u0629 \u0641\u064A \u062D\u0645\u0627\u064A\u0629 \u0627\u0644\u062F\u064A\u0646 \u0648\u0627\u0644\u0645\u0633\u0644\u0645\u064A\u0646.",
            category_tag: "\u0627\u0644\u0645\u0647\u0627\u062C\u0631\u0648\u0646"
        },
        {
            id: 38,
            category: "\u0627\u0644\u0645\u0647\u0627\u062C\u0631\u0648\u0646",
            name: "\u0645\u0633\u0637\u062D \u0628\u0646 \u0623\u062B\u0627\u062B\u0629",
            title: "\u0627\u0644\u0628\u062F\u0631\u064A \u0627\u0644\u0645\u0647\u0627\u062C\u0631",
            story: "\u0645\u0646 \u0627\u0644\u0633\u0627\u0628\u0642\u064A\u0646\u060C \u062E\u0627\u0644\u0647 \u0623\u0628\u0648 \u0628\u0643\u0631 \u0627\u0644\u0635\u062F\u064A\u0642 \u0648\u0643\u0627\u0646 \u064A\u0646\u0641\u0642 \u0639\u0644\u064A\u0647 \u0644\u0641\u0642\u0631\u0647. \u0632\u0644\u0651\u062A \u0642\u062F\u0645\u0647 \u0641\u064A \u062D\u0627\u062F\u062B\u0629 \u0627\u0644\u0625\u0641\u0643\u060C \u0641\u0642\u0637\u0639 \u0623\u0628\u0648 \u0628\u0643\u0631 \u0627\u0644\u0646\u0641\u0642\u0629 \u0639\u0646\u0647\u060C \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 (\u0648\u0644\u064A\u0639\u0641\u0648\u0627 \u0648\u0644\u064A\u0635\u0641\u062D\u0648\u0627)\u060C \u0641\u0623\u0639\u0627\u062F \u0644\u0647 \u0623\u0628\u0648 \u0628\u0643\u0631 \u0646\u0641\u0642\u062A\u0647.",
            lessons: "\u0627\u0644\u0635\u062D\u0627\u0628\u0629 \u0628\u0634\u0631 \u064A\u062E\u0637\u0626\u0648\u0646 \u0648\u064A\u062A\u0648\u0628\u0648\u0646. \u0641\u0636\u0644 \u0627\u0644\u0639\u0641\u0648 \u0648\u0627\u0644\u0635\u0641\u062D \u0639\u0646 \u0627\u0644\u0645\u0633\u064A\u0621 \u0648\u0645\u0642\u0627\u0628\u0644\u0629 \u0627\u0644\u0633\u064A\u0626\u0629 \u0628\u0627\u0644\u0625\u062D\u0633\u0627\u0646.",
            category_tag: "\u0623\u0647\u0644 \u0628\u062F\u0631"
        },
        {
            id: 39,
            category: "\u0627\u0644\u0635\u062D\u0627\u0628\u0629",
            name: "\u0645\u0627\u0639\u0632 \u0628\u0646 \u0645\u0627\u0644\u0643",
            title: "\u0627\u0644\u062A\u0627\u0626\u0628 \u0627\u0644\u0635\u0627\u062F\u0642",
            story: "\u0645\u0646 \u0642\u0628\u064A\u0644\u0629 \u0623\u0633\u0644\u0645\u060C \u0648\u0642\u0639 \u0641\u064A \u0627\u0644\u0632\u0646\u0627 \u0648\u0646\u062F\u0645 \u0646\u062F\u0645\u0627\u064B \u0634\u062F\u064A\u062F\u0627\u064B\u060C \u0641\u0623\u0635\u0631\u0651 \u0639\u0644\u0649 \u0625\u0642\u0627\u0645\u0629 \u0627\u0644\u062D\u062F \u0639\u0644\u0649 \u0646\u0641\u0633\u0647 \u0644\u064A\u0637\u0647\u0631\u060C \u0641\u0631\u062C\u0645\u0647 \u0627\u0644\u0635\u062D\u0627\u0628\u0629. \u0642\u0627\u0644 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0639\u0646\u0647: (\u0644\u0642\u062F \u062A\u0627\u0628 \u062A\u0648\u0628\u0629 \u0644\u0648 \u0642\u064F\u0633\u0650\u0645\u062A \u0639\u0644\u0649 \u0623\u0645\u0629 \u0644\u0648\u0633\u0639\u062A\u0647\u0645).",
            lessons: "\u0635\u062F\u0642 \u0627\u0644\u062A\u0648\u0628\u0629 \u0648\u0639\u0638\u0645\u0629 \u0627\u0644\u062E\u0648\u0641 \u0645\u0646 \u0627\u0644\u0644\u0647. \u062A\u0641\u0636\u064A\u0644 \u0639\u0630\u0627\u0628 \u0627\u0644\u062F\u0646\u064A\u0627 \u0648\u0639\u0642\u0648\u0628\u062A\u0647\u0627 \u0639\u0644\u0649 \u0639\u0630\u0627\u0628 \u064A\u0648\u0645 \u0627\u0644\u0642\u064A\u0627\u0645\u0629.",
            category_tag: "\u0627\u0644\u0635\u062D\u0627\u0628\u0629"
        },
        {
            id: 40,
            category: "\u0627\u0644\u0645\u0647\u0627\u062C\u0631\u0648\u0646",
            name: "\u0639\u0642\u064A\u0644 \u0628\u0646 \u0623\u0628\u064A \u0637\u0627\u0644\u0628",
            title: "\u0646\u0633\u0651\u0627\u0628\u0629 \u0642\u0631\u064A\u0634",
            story: "\u0623\u062E\u0648 \u0639\u0644\u064A \u0628\u0646 \u0623\u0628\u064A \u0637\u0627\u0644\u0628 \u0648\u0623\u0633\u0646\u0651 \u0645\u0646\u0647. \u0623\u064F\u0633\u0631 \u064A\u0648\u0645 \u0628\u062F\u0631 \u0645\u0634\u0631\u0643\u0627\u064B \u0641\u0641\u062F\u0627\u0647 \u0627\u0644\u0639\u0628\u0627\u0633. \u0623\u0633\u0644\u0645 \u0639\u0627\u0645 \u0627\u0644\u062D\u062F\u064A\u0628\u064A\u0629 \u0648\u062D\u0633\u0646 \u0625\u0633\u0644\u0627\u0645\u0647. \u0643\u0627\u0646 \u0645\u0646 \u0623\u0639\u0644\u0645 \u0627\u0644\u0646\u0627\u0633 \u0628\u0623\u0646\u0633\u0627\u0628 \u0627\u0644\u0639\u0631\u0628 \u0648\u0623\u064A\u0627\u0645\u0647\u0645\u060C \u0648\u0643\u0627\u0646 \u0627\u0644\u0646\u0628\u064A \uFDFA \u064A\u062D\u0628\u0647 \u0644\u0642\u0631\u0627\u0628\u062A\u0647 \u0648\u0644\u062D\u0628 \u0623\u0628\u064A \u0637\u0627\u0644\u0628 \u0644\u0647.",
            lessons: "\u0627\u0633\u062A\u062B\u0645\u0627\u0631 \u0627\u0644\u0639\u0644\u0645 \u0648\u0627\u0644\u062B\u0642\u0627\u0641\u0629 \u0627\u0644\u0634\u062E\u0635\u064A\u0629 (\u0643\u0627\u0644\u0623\u0646\u0633\u0627\u0628) \u0628\u0639\u062F \u0627\u0644\u0625\u0633\u0644\u0627\u0645. \u0627\u0644\u062D\u0644\u0645 \u0648\u0627\u0644\u0647\u062F\u0648\u0621 \u0641\u064A \u0627\u0644\u0646\u0642\u0627\u0634.",
            category_tag: "\u0622\u0644 \u0627\u0644\u0628\u064A\u062A"
        },
        {
            id: 41,
            category: "\u0627\u0644\u0623\u0646\u0635\u0627\u0631",
            name: "\u0645\u0639\u0627\u0630 \u0628\u0646 \u0639\u0641\u0631\u0627\u0621",
            title: "\u0627\u0644\u0641\u062F\u0627\u0626\u064A \u0627\u0644\u0635\u063A\u064A\u0631",
            story: "\u063A\u0644\u0627\u0645 \u0645\u0646 \u0627\u0644\u0623\u0646\u0635\u0627\u0631\u060C \u062A\u0639\u0627\u0647\u062F \u0647\u0648 \u0648\u0623\u062E\u0648\u0647 \u0645\u0639\u0648\u0630 \u064A\u0648\u0645 \u0628\u062F\u0631 \u0639\u0644\u0649 \u0642\u062A\u0644 \u0623\u0628\u064A \u062C\u0647\u0644 \u0644\u0623\u0646\u0647 \u0643\u0627\u0646 \u064A\u0633\u0628 \u0627\u0644\u0646\u0628\u064A \uFDFA. \u0647\u062C\u0645\u0627 \u0639\u0644\u064A\u0647 \u0643\u0627\u0644\u0635\u0642\u0631\u064A\u0646 \u062D\u062A\u0649 \u0623\u0631\u062F\u064A\u0627\u0647 \u0642\u062A\u064A\u0644\u0627\u064B\u060C \u0641\u0642\u0627\u0644 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0644\u0647\u0645\u0627: (\u0643\u0644\u0627\u0643\u0645\u0627 \u0642\u062A\u0644\u0647).",
            lessons: "\u0627\u0644\u0634\u062C\u0627\u0639\u0629 \u0648\u0627\u0644\u063A\u064A\u0631\u0629 \u0639\u0644\u0649 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0644\u0627 \u062A\u0631\u062A\u0628\u0637 \u0628\u0633\u0646 \u0645\u0639\u064A\u0646. \u0627\u0644\u062A\u0646\u0627\u0641\u0633 \u0628\u064A\u0646 \u0627\u0644\u0634\u0628\u0627\u0628 \u0641\u064A \u0646\u0635\u0631\u0629 \u0627\u0644\u062D\u0642.",
            category_tag: "\u0623\u0647\u0644 \u0628\u062F\u0631"
        },
        {
