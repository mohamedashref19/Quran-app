        "46_29": {
            "title": "\u0648\u064E\u0625\u0650\u0630\u0652 \u0635\u064E\u0631\u064E\u0641\u0652\u0646\u064E\u0627 \u0625\u0650\u0644\u064E\u064A\u0652\u0643\u064E \u0646\u064E\u0641\u064E\u0631\u064B\u0627 \u0645\u0650\u0646\u064E \u0627\u0644\u0652\u062C\u0650\u0646\u0651\u0650 \u064A\u064E\u0633\u0652\u062A\u064E\u0645\u0650\u0639\u064F\u0648\u0646\u064E \u0627\u0644\u0652\u0642\u064F\u0631\u0652\u0622\u0646\u064E \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u062D\u064E\u0636\u064E\u0631\u064F\u0648\u0647\u064F \u0642\u064E\u0627\u0644\u064F\u0648\u0627 \u0623\u064E\u0646\u0652\u0635\u0650\u062A\u064F\u0648\u0627 \u06D6 \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0642\u064F\u0636\u0650\u064A\u064E \u0648\u064E\u0644\u0651\u064E\u0648\u0652\u0627 \u0625\u0650\u0644\u064E\u0649\u0670 \u0642\u064E\u0648\u0652\u0645\u0650\u0647\u0650\u0645\u0652 \u0645\u064F\u0646\u0652\u0630\u0650\u0631\u0650\u064A\u0646\u064E",
            "sabab": "\u0639\u0646 \u0639\u0628\u062F \u0627\u0644\u0644\u0647 \u0628\u0646 \u0645\u0633\u0639\u0648\u062F \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u0627\u0644: \u0647\u0628\u0637\u0648\u0627 \u0639\u0644\u0649 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0648\u0647\u0648 \u064A\u0642\u0631\u0623 \u0627\u0644\u0642\u0631\u0622\u0646 \u0628\u0628\u0637\u0646 \u0646\u062E\u0644\u0629\u060C \u0641\u0644\u0645\u0627 \u0633\u0645\u0639\u0648\u0647\u060C \u0642\u0627\u0644\u0648\u0627: \u0623\u0646\u0635\u062A\u0648\u0627 - \u0642\u0627\u0644: \u0635\u0647 - \u0648 \u0643\u0627\u0646\u0648\u0627 \u062A\u0633\u0639\u0629\u060C \u0623\u062D\u062F\u0647\u0645 \u0632\u0648\u0628\u0639\u0629\u060C \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u0639\u0632 \u0648 \u062C\u0644: { \u0648\u064E\u0625\u0650\u0630\u0652 \u0635\u064E\u0631\u064E\u0641\u0652\u0646\u064E\u0627\u0653 \u0625\u0650\u0644\u064E\u064A\u0652\u0643\u064E \u0646\u064E\u0641\u064E\u0631\u064B\u0627 \u0645\u0651\u0650\u0646\u064E \u0671\u0644\u0652\u062C\u0650\u0646\u0651\u0650 \u064A\u064E\u0633\u0652\u062A\u064E\u0645\u0650\u0639\u064F\u0648\u0646\u064E \u0671\u0644\u0652\u0642\u064F\u0631\u0652\u0621\u064E\u0627\u0646\u064E \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u062D\u064E\u0636\u064E\u0631\u064F\u0648\u0647\u064F \u0642\u064E\u0627\u0644\u064F\u0648\u0653\u0627\u06DF \u0623\u064E\u0646\u0635\u0650\u062A\u064F\u0648\u0627\u06DF \u06D6 \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0642\u064F\u0636\u0650\u0649\u064E \u0648\u064E\u0644\u0651\u064E\u0648\u0652\u0627\u06DF \u0625\u0650\u0644\u064E\u0649\u0670 \u0642\u064E\u0648\u0652\u0645\u0650\u0647\u0650\u0645 \u0645\u0651\u064F\u0646\u0630\u0650\u0631\u0650\u064A\u0646\u064E \uFD3F\u0662\u0669\uFD3E } \u0625\u0644\u0649 { \u0636\u064E\u0644\u064E\u0640\u0670\u0644\u064D\u06E2 \u0645\u0651\u064F\u0628\u0650\u064A\u0646\u064D }.",
            "fadl": "",
            "action": ""
        },
        "47_13": {
            "title": "\u0648\u064E\u0643\u064E\u0623\u064E\u064A\u0651\u0650\u0646\u0652 \u0645\u0650\u0646\u0652 \u0642\u064E\u0631\u0652\u064A\u064E\u0629\u064D \u0647\u0650\u064A\u064E \u0623\u064E\u0634\u064E\u062F\u0651\u064F \u0642\u064F\u0648\u0651\u064E\u0629\u064B \u0645\u0650\u0646\u0652 \u0642\u064E\u0631\u0652\u064A\u064E\u062A\u0650\u0643\u064E \u0627\u0644\u0651\u064E\u062A\u0650\u064A \u0623\u064E\u062E\u0652\u0631\u064E\u062C\u064E\u062A\u0652\u0643\u064E \u0623\u064E\u0647\u0652\u0644\u064E\u0643\u0652\u0646\u064E\u0627\u0647\u064F\u0645\u0652 \u0641\u064E\u0644\u064E\u0627 \u0646\u064E\u0627\u0635\u0650\u0631\u064E \u0644\u064E\u0647\u064F\u0645\u0652",
            "sabab": "\u0639\u0646 \u0627\u0628\u0646 \u0639\u0628\u0627\u0633 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627: \u0623\u0646 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0644\u0645\u0627 \u062E\u0631\u062C \u0645\u0646 \u0645\u0643\u0629 \u0625\u0644\u0649 \u0627\u0644\u063A\u0627\u0631 \u0648\u0623\u062A\u0627\u0647\u060C \u0641\u0627\u0644\u062A\u0641\u062A \u0625\u0644\u0649 \u0645\u0643\u0629\u060C \u0648\u0642\u0627\u0644: \xab \u0623\u0646\u062A\u0650 \u0623\u062D\u0628 \u0628\u0644\u0627\u062F \u0627\u0644\u0644\u0647 \u0625\u0644\u0649 \u0627\u0644\u0644\u0647\u060C \u0648\u0623\u0646\u062A \u0623\u062D\u0628 \u0628\u0644\u0627\u062F \u0627\u0644\u0644\u0647 \u0625\u0644\u064A\u060C \u0648\u0644\u0648\u0644\u0627 \u0623\u0646 \u0627\u0644\u0645\u0634\u0631\u0643\u064A\u0646 \u0623\u062E\u0631\u062C\u0648\u0646\u064A \u0644\u0645 \u0623\u062E\u0631\u062C \u0645\u0646\u0643 \xbb\u060C \u0641\u0623\u0639\u062F\u0649 \u0627\u0644\u0623\u0639\u062F\u0627\u0621 \u0645\u0646 \u0639\u062F\u0627 \u0639\u0644\u0649 \u0627\u0644\u0644\u0647 \u062A\u0639\u0627\u0644\u0649 \u0641\u064A \u062D\u0631\u0645\u0647\u060C \u0623\u0648 \u0642\u062A\u0644 \u063A\u064A\u0631 \u0642\u0627\u062A\u0644\u0647\u060C \u0623\u0648 \u0642\u062A\u0644 \u0628\u0630\u062D\u0648\u0644 \u0627\u0644\u062C\u0627\u0647\u0644\u064A\u0629\u060C \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u062A\u0639\u0627\u0644\u0649 \u0639\u0644\u0649 \u0646\u0628\u064A\u0647 \uFDFA: { \u0648\u064E\u0643\u064E\u0623\u064E\u064A\u0651\u0650\u0646 \u0645\u0651\u0650\u0646 \u0642\u064E\u0631\u0652\u064A\u064E\u0629\u064D \u0647\u0650\u0649\u064E \u0623\u064E\u0634\u064E\u062F\u0651\u064F \u0642\u064F\u0648\u0651\u064E\u0629\u064B \u0645\u0651\u0650\u0646 \u0642\u064E\u0631\u0652\u064A\u064E\u062A\u0650\u0643\u064E \u0671\u0644\u0651\u064E\u062A\u0650\u0649\u0653 \u0623\u064E\u062E\u0652\u0631\u064E\u062C\u064E\u062A\u0652\u0643\u064E \u0623\u064E\u0647\u0652\u0644\u064E\u0643\u0652\u0646\u064E\u0640\u0670\u0647\u064F\u0645\u0652 \u0641\u064E\u0644\u064E\u0627 \u0646\u064E\u0627\u0635\u0650\u0631\u064E \u0644\u064E\u0647\u064F\u0645\u0652 \uFD3F\u0661\u0663\uFD3E }.",
            "fadl": "",
            "action": ""
        },
        "48_1": {
            "title": "\u0625\u0646\u0627 \u0641\u062A\u062D\u0646\u0627 \u0644\u0643 \u0641\u062A\u062D\u0627\u064B \u0645\u0628\u064A\u0646\u0627\u064B",
            "sabab": "\u0646\u0632\u0644\u062A \u0639\u0644\u0649 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0641\u064A \u0637\u0631\u064A\u0642 \u0639\u0648\u062F\u062A\u0647 \u0645\u0646 \u0635\u0644\u062D \u0627\u0644\u062D\u062F\u064A\u0628\u064A\u0629\u060C \u0648\u0643\u0627\u0646 \u0627\u0644\u0635\u062D\u0627\u0628\u0629 \u0641\u064A \u062D\u0632\u0646 \u0644\u0639\u062F\u0645 \u062F\u062E\u0648\u0644 \u0645\u0643\u0629\u060C \u0641\u0628\u0634\u0631\u0647\u0645 \u0627\u0644\u0644\u0647 \u0628\u0623\u0646\u0647 \u0641\u062A\u062D \u0639\u0638\u064A\u0645.",
            "fadl": "\u0642\u0627\u0644 \u0639\u0646\u0647\u0627 \u0627\u0644\u0646\u0628\u064A \uFDFA: \xab\u0644\u0642\u062F \u0623\u064F\u0646\u0632\u0644\u062A \u0639\u0644\u064A \u0627\u0644\u0644\u064A\u0644\u0629 \u0633\u0648\u0631\u0629\u064C\u060C \u0644\u064E\u0647\u064A \u0623\u062D\u0628\u064F\u0651 \u0625\u0644\u064A\u064E\u0651 \u0645\u0645\u0627 \u0637\u0644\u0639\u062A \u0639\u0644\u064A\u0647 \u0627\u0644\u0634\u0645\u0633\xbb.",
            "action": "\u0645\u0627 \u062A\u0631\u0627\u0647 \u0627\u0644\u064A\u0648\u0645 \u062D\u0631\u0645\u0627\u0646\u0627\u064B \u0623\u0648 \u062A\u0623\u062E\u064A\u0631\u0627\u064B \u0641\u064A \u0625\u062C\u0627\u0628\u0629 \u062F\u0639\u0627\u0626\u0643\u060C \u0642\u062F \u064A\u0643\u0648\u0646 \u0647\u0648 \u0627\u0644\u0641\u062A\u062D \u0627\u0644\u062D\u0642\u064A\u0642\u064A \u0644\u0643 \u0641\u064A \u0639\u0644\u0645 \u0627\u0644\u0644\u0647. \u062B\u0642 \u0628\u062A\u062F\u0628\u064A\u0631\u0647."
        },
        "48_24": {
            "title": "\u0648\u064E\u0647\u064F\u0648\u064E \u0627\u0644\u0651\u064E\u0630\u0650\u064A \u0643\u064E\u0641\u0651\u064E \u0623\u064E\u064A\u0652\u062F\u0650\u064A\u064E\u0647\u064F\u0645\u0652 \u0639\u064E\u0646\u0652\u0643\u064F\u0645\u0652 \u0648\u064E\u0623\u064E\u064A\u0652\u062F\u0650\u064A\u064E\u0643\u064F\u0645\u0652 \u0639\u064E\u0646\u0652\u0647\u064F\u0645\u0652 \u0628\u0650\u0628\u064E\u0637\u0652\u0646\u0650 \u0645\u064E\u0643\u0651\u064E\u0629\u064E \u0645\u0650\u0646\u0652 \u0628\u064E\u0639\u0652\u062F\u0650 \u0623\u064E\u0646\u0652 \u0623\u064E\u0638\u0652\u0641\u064E\u0631\u064E\u0643\u064F\u0645\u0652 \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650\u0645\u0652 \u06DA \u0648\u064E\u0643\u064E\u0627\u0646\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0628\u0650\u0645\u064E\u0627 \u062A\u064E\u0639\u0652\u0645\u064E\u0644\u064F\u0648\u0646\u064E \u0628\u064E\u0635\u0650\u064A\u0631\u064B\u0627",
            "sabab": "\u0639\u064E\u0646\u0652 \u0623\u064E\u0646\u064E\u0633\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0623\u064E\u0646\u0651\u064E \u062B\u064E\u0645\u064E\u0627\u0646\u0650\u064A\u0646\u064E \u0631\u064E\u062C\u064F\u0644\u064B\u0627 \u0645\u0650\u0646\u0652 \u0623\u064E\u0647\u0652\u0644\u0650 \u0645\u064E\u0643\u0651\u064E\u0629\u064E\u060C \u0647\u064E\u0628\u064E\u0637\u064F\u0648\u0627 \u0639\u064E\u0644\u064E\u0649 \u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0648\u064E\u0623\u064E\u0635\u0652\u062D\u064E\u0627\u0628\u0650\u0647\u0650 \u0645\u0650\u0646\u0652 \u062C\u064E\u0628\u064E\u0644\u0650 \u0627\u0644\u062A\u0651\u064E\u0646\u0652\u0639\u0650\u064A\u0645\u0650\u060C \u0639\u0650\u0646\u0652\u062F\u064E \u0635\u064E\u0644\u064E\u0627\u0629\u0650 \u0627\u0644\u0652\u0641\u064E\u062C\u0652\u0631\u0650\u060C \u0641\u064E\u0623\u064E\u062E\u064E\u0630\u064E\u0647\u064F\u0645\u0652 \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0633\u0650\u0644\u0652\u0645\u0627\u064B\u060C \u0641\u064E\u0639\u064E\u0641\u064E\u0627 \u0639\u064E\u0646\u0652\u0647\u064F\u0645\u0652\u060C \u0648\u064E\u0646\u064E\u0632\u064E\u0644\u064E \u0627\u0644\u0652\u0642\u064F\u0631\u0652\u0622\u0646\u064F: { \u0648\u064E\u0647\u064F\u0648\u064E \u0671\u0644\u0651\u064E\u0630\u0650\u0649 \u0643\u064E\u0641\u0651\u064E \u0623\u064E\u064A\u0652\u062F\u0650\u064A\u064E\u0647\u064F\u0645\u0652 \u0639\u064E\u0646\u0643\u064F\u0645\u0652 \u0648\u064E\u0623\u064E\u064A\u0652\u062F\u0650\u064A\u064E\u0643\u064F\u0645\u0652 \u0639\u064E\u0646\u0652\u0647\u064F\u0645 \u0628\u0650\u0628\u064E\u0637\u0652\u0646\u0650 \u0645\u064E\u0643\u0651\u064E\u0629\u064E \u0645\u0650\u0646\u06E2 \u0628\u064E\u0639\u0652\u062F\u0650 \u0623\u064E\u0646\u0652 \u0623\u064E\u0638\u0652\u0641\u064E\u0631\u064E\u0643\u064F\u0645\u0652 \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650\u0645\u0652 \u06DA }.",
            "fadl": "",
            "action": ""
        },
        "49_1": {
            "title": "\u0644\u0627 \u062A\u0642\u062F\u0645\u0648\u0627 \u0628\u064A\u0646 \u064A\u062F\u064A \u0627\u0644\u0644\u0647 \u0648\u0631\u0633\u0648\u0644\u0647",
            "sabab": "\u0627\u0631\u062A\u0641\u0639 \u0635\u0648\u062A \u0623\u0628\u064A \u0628\u0643\u0631 \u0648\u0639\u0645\u0631 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u0628\u062D\u0636\u0631\u0629 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0641\u064A \u062E\u0644\u0627\u0641 \u062D\u0648\u0644 \u062A\u0639\u064A\u064A\u0646 \u0623\u0645\u064A\u0631\u060C \u0641\u0646\u0632\u0644\u062A \u0627\u0644\u0633\u0648\u0631\u0629 \u062A\u0624\u062F\u0628 \u0627\u0644\u0635\u062D\u0627\u0628\u0629 \u0641\u064A \u0643\u064A\u0641\u064A\u0629 \u0627\u0644\u062A\u0639\u0627\u0645\u0644 \u0645\u0639 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0648\u0627\u0644\u0623\u062F\u0628 \u0645\u0639\u0647.",
            "fadl": "",
            "action": "\u0627\u0644\u0623\u062F\u0628 \u0645\u0639 \u0627\u0644\u0644\u0647 \u0648\u0631\u0633\u0648\u0644\u0647 \u064A\u0642\u062A\u0636\u064A \u0639\u062F\u0645 \u062A\u0642\u062F\u064A\u0645 \u0631\u0623\u064A\u0643 \u0623\u0648 \u0647\u0648\u0627\u0643 \u0639\u0644\u0649 \u0627\u0644\u0646\u0635 \u0627\u0644\u0642\u0631\u0622\u0646\u064A \u0648\u0627\u0644\u0646\u0628\u0648\u064A. \u0627\u0633\u062A\u0633\u0644\u0645 \u0644\u0623\u0645\u0631 \u0627\u0644\u0644\u0647 \u064A\u0623\u062A\u064A\u0643 \u0627\u0644\u062E\u064A\u0631."
        },
        "49_2": {
            "title": "\u064A\u064E\u0627 \u0623\u064E\u064A\u0651\u064F\u0647\u064E\u0627 \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0622\u0645\u064E\u0646\u064F\u0648\u0627 \u0644\u064E\u0627 \u062A\u064E\u0631\u0652\u0641\u064E\u0639\u064F\u0648\u0627 \u0623\u064E\u0635\u0652\u0648\u064E\u0627\u062A\u064E\u0643\u064F\u0645\u0652 \u0641\u064E\u0648\u0652\u0642\u064E \u0635\u064E\u0648\u0652\u062A\u0650 \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u0650 \u0648\u064E\u0644\u064E\u0627 \u062A\u064E\u062C\u0652\u0647\u064E\u0631\u064F\u0648\u0627 \u0644\u064E\u0647\u064F \u0628\u0650\u0627\u0644\u0652\u0642\u064E\u0648\u0652\u0644\u0650 \u0643\u064E\u062C\u064E\u0647\u0652\u0631\u0650 \u0628\u064E\u0639\u0652\u0636\u0650\u0643\u064F\u0645\u0652 \u0644\u0650\u0628\u064E\u0639\u0652\u0636\u064D \u0623\u064E\u0646\u0652 \u062A\u064E\u062D\u0652\u0628\u064E\u0637\u064E \u0623\u064E\u0639\u0652\u0645\u064E\u0627\u0644\u064F\u0643\u064F\u0645\u0652 \u0648\u064E\u0623\u064E\u0646\u0652\u062A\u064F\u0645\u0652 \u0644\u064E\u0627 \u062A\u064E\u0634\u0652\u0639\u064F\u0631\u064F\u0648\u0646\u064E",
            "sabab": "\u0639\u064E\u0646\u0650 \u0627\u0628\u0652\u0646\u0650 \u0623\u064E\u0628\u0650\u064A \u0645\u064F\u0644\u064E\u064A\u0652\u0643\u064E\u0629\u064E \u0631\u062D\u0645\u0647 \u0627\u0644\u0644\u0647 \u0642\u064E\u0627\u0644\u064E: \u0643\u064E\u0627\u062F\u064E \u0627\u0644\u0652\u062E\u0651\u0650\u064A\u0652\u0631\u064E\u0627\u0646\u0650 \u0623\u064E\u0646\u0652 \u064A\u064E\u0647\u0652\u0644\u0650\u0643\u064E\u0627\u060C \u0623\u064E\u0628\u064F\u0648 \u0628\u064E\u0643\u0652\u0631\u064D \u0648\u064E\u0639\u064F\u0645\u064E\u0631\u064F \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627\u060C \u0631\u064E\u0641\u064E\u0639\u064E\u0627 \u0623\u064E\u0635\u0652\u0648\u064E\u0627\u062A\u064E\u0647\u064F\u0645\u064E\u0627 \u0639\u0650\u0646\u0652\u062F\u064E \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u0650 \u0627\u0644\u0644\u0647\u0650 \uFDFA\u060C \u062D\u0650\u064A\u0646\u064E \u0642\u064E\u062F\u0650\u0645\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650 \u0631\u064E\u0643\u0652\u0628\u064F \u0628\u064E\u0646\u0650\u064A \u062A\u064E\u0645\u0650\u064A\u0645\u060C \u0641\u064E\u0623\u064E\u0634\u064E\u0627\u0631\u064E \u0623\u064E\u062D\u062F\u064F\u0647\u064F\u0645\u064E\u0627 \u0628\u0650\u0627\u0644\u0652\u0623\u064E\u0642\u0652\u0631\u064E\u0639\u0650 \u0628\u0652\u0646\u0650 \u062D\u064E\u0627\u0628\u0650\u0633\u064D \u0623\u064E\u062E\u0650\u064A \u0628\u064E\u0646\u0650\u064A \u0645\u064F\u062C\u064E\u0627\u0634\u0650\u0639\u064D\u060C \u0648\u064E\u0623\u064E\u0634\u064E\u0627\u0631\u064E \u0627\u0644\u0652\u0622\u062E\u064E\u0631\u064F \u0628\u0650\u0631\u064E\u062C\u064F\u0644\u064D \u0622\u062E\u064E\u0631\u064E\u060C \u0642\u064E\u0627\u0644\u064E \u0646\u064E\u0627\u0641\u0650\u0639\u064C \u0644\u064E\u0627 \u0623\u064E\u062D\u0652\u0641\u064E\u0638\u064F \u0627\u0633\u0652\u0645\u064E\u0647\u064F\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0623\u064E\u0628\u064F\u0648 \u0628\u064E\u0643\u0652\u0631\u064D \u0644\u0650\u0639\u064F\u0645\u064E\u0631\u064E: \u0645\u064E\u0627 \u0623\u064E\u0631\u064E\u062F\u0652\u062A\u064E \u0625\u0650\u0644\u0651\u064E\u0627 \u062E\u0650\u0644\u064E\u0627\u0641\u0650\u064A\u060C \u0642\u064E\u0627\u0644\u064E: \u0645\u064E\u0627 \u0623\u064E\u0631\u064E\u062F\u0652\u062A\u064F \u062E\u0650\u0644\u064E\u0627\u0641\u064E\u0643\u064E\u060C \u0641\u064E\u0627\u0631\u0652\u062A\u064E\u0641\u064E\u0639\u064E\u062A\u0652 \u0623\u064E\u0635\u064E\u0648\u064E\u0627\u062A\u064F\u0647\u064F\u0645\u064E\u0627 \u0641\u0650\u064A \u0630\u064E\u0644\u0650\u0643\u064E\u060C \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F: { \u064A\u064E\u0640\u0670\u0653\u0623\u064E\u064A\u0651\u064F\u0647\u064E\u0627 \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0621\u064E\u0627\u0645\u064E\u0646\u064F\u0648\u0627\u06DF \u0644\u064E\u0627 \u062A\u064E\u0631\u0652\u0641\u064E\u0639\u064F\u0648\u0653\u0627\u06DF \u0623\u064E\u0635\u0652\u0648\u064E\u0670\u062A\u064E\u0643\u064F\u0645\u0652 } \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u064E\u060C \u0642\u064E\u0627\u0644\u064E \u0627\u0628\u0652\u0646\u064F \u0627\u0644\u0632\u0651\u064F\u0628\u064E\u064A\u0652\u0631\u0650: \u0641\u064E\u0645\u064E\u0627 \u0643\u064E\u0627\u0646\u064E \u0639\u064F\u0645\u064E\u0631\u064F \u064A\u064F\u0633\u0652\u0645\u0650\u0639\u064F \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0628\u064E\u0639\u0652\u062F\u064E \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u0650 \u062D\u064E\u062A\u0651\u064E\u0649 \u064A\u064E\u0633\u0652\u062A\u064E\u0641\u0652\u0647\u0650\u0645\u064E\u0647\u064F. \u0648\u064E\u0644\u064E\u0645\u0652 \u064A\u064E\u0630\u0652\u0643\u064F\u0631\u0652 \u0630\u064E\u0644\u0650\u0643\u064E \u0639\u064E\u0646\u0652 \u0623\u064E\u0628\u0650\u064A\u0647\u0650\u060C \u064A\u064E\u0639\u0652\u0646\u0650\u064A \u0623\u064E\u0628\u064E\u0627 \u0628\u064E\u0643\u0652\u0631\u064D.",
            "fadl": "",
            "action": ""
        },
        "49_4": {
            "title": "\u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u064A\u064F\u0646\u064E\u0627\u062F\u064F\u0648\u0646\u064E\u0643\u064E \u0645\u0650\u0646\u0652 \u0648\u064E\u0631\u064E\u0627\u0621\u0650 \u0627\u0644\u0652\u062D\u064F\u062C\u064F\u0631\u064E\u0627\u062A\u0650 \u0623\u064E\u0643\u0652\u062B\u064E\u0631\u064F\u0647\u064F\u0645\u0652 \u0644\u064E\u0627 \u064A\u064E\u0639\u0652\u0642\u0650\u0644\u064F\u0648\u0646\u064E",
            "sabab": "\u0639\u064E\u0646\u0650 \u0627\u0644\u0652\u0623\u064E\u0642\u0652\u0631\u064E\u0639\u0650 \u0628\u0652\u0646\u0650 \u062D\u064E\u0627\u0628\u0650\u0633\u064D \u0623\u064E\u0646\u0651\u064E\u0647\u064F \u0623\u064E\u062A\u064E\u0649 \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064E \uFDFA\u060C \u0641\u0646\u0627\u062F\u0627\u0647\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E: \u064A\u064E\u0627 \u0645\u062D\u0645\u062F \u0625\u0650\u0646\u0651\u064E \u0645\u064E\u062F\u062D\u064A \u0632\u064E\u064A\u0652\u0646\u064C\u060C \u0648\u064E\u0625\u0650\u0646\u0651\u064E \u0634\u062A\u0645\u064A \u0634\u064E\u064A\u0652\u0646\u064C\u060C \u0641\u062E\u0631\u062C \u0625\u0644\u064A\u0647 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0641\u0642\u0627\u0644: \xab \u0648\u064A\u0644\u0643 \u0630\u064E\u0644\u0643\u064E \u0627\u0644\u0644\u0647 \u0639\u0632 \u0648 \u062C\u0644 \xbb\u060C \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 { \u0625\u0650\u0646\u0651\u064E \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u064A\u064F\u0646\u064E\u0627\u062F\u064F\u0648\u0646\u064E\u0643\u064E \u0645\u0650\u0646 \u0648\u064E\u0631\u064E\u0627\u0653\u0621\u0650 \u0671\u0644\u0652\u062D\u064F\u062C\u064F\u0631\u064E\u0670\u062A\u0650 } \u0627\u0644\u0622\u064A\u0629.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0648\u0647\u0646\u0627\u0643 \u0633\u0628\u0628 \u062B\u0627\u0646 \u0644\u0644\u0646\u0632\u0648\u0644: \u062C\u0627\u0621 \u0639\u0646 \u0632\u064A\u062F \u0628\u0646 \u0623\u0631\u0642\u0645 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u0627\u0644: \u062C\u0627\u0621 \u0646\u0627\u0633 \u0645\u0646 \u0627\u0644\u0639\u0631\u0628 \u0641\u0642\u0627\u0644\u0648\u0627: \u0627\u0646\u0637\u0644\u0642\u0648\u0627 \u0628\u0646\u0627 \u0625\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u0631\u062C\u0644\u060C \u0641\u0625\u0646 \u064A\u0643 \u0646\u0628\u064A\u0627\u064B \u0641\u0646\u062D\u0646 \u0623\u0633\u0639\u062F \u0627\u0644\u0646\u0627\u0633 \u0628\u0647\u060C \u0648\u0625\u0646 \u064A\u0643 \u0645\u0644\u0643\u0627\u064B \u0639\u0634\u0646\u0627 \u0641\u064A \u062D\u064A\u0627\u062A\u0647\u060C \u0641\u0627\u0646\u0637\u0644\u0642\u062A \u0625\u0644\u0649 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0641\u0623\u062E\u0628\u0631\u062A\u0647 \u0628\u0645\u0627 \u0642\u0627\u0644\u0648\u0627\u060C \u062B\u0645 \u062C\u0627\u0624\u0648\u0627 \u0625\u0644\u0649 \u062D\u062C\u0631 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0641\u062C\u0639\u0644\u0648\u0627 \u064A\u0646\u0627\u062F\u0648\u0646 \u06CC\u0627 \u0645\u062D\u0645\u062F\u060C \u06CC\u0627 \u0645\u062D\u0645\u062F\u060C \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u0639\u0632 \u0648 \u062C\u0644: { \u0625\u0650\u0646\u0651\u064E \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u064A\u064F\u0646\u064E\u0627\u062F\u064F\u0648\u0646\u064E\u0643\u064E \u0645\u0650\u0646 \u0648\u064E\u0631\u064E\u0627\u0653\u0621\u0650 \u0671\u0644\u0652\u062D\u064F\u062C\u064F\u0631\u064E\u0670\u062A\u0650 \u0623\u064E\u0643\u0652\u062B\u064E\u0631\u064F\u0647\u064F\u0645\u0652 \u0644\u064E\u0627 \u064A\u064E\u0639\u0652\u0642\u0650\u0644\u064F\u0648\u0646\u064E \uFD3F\u0664\uFD3E } \u0641\u0623\u062E\u0630 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \uFDFA \u0628\u0623\u0630\u0646\u064A \u0641\u0642\u0627\u0644: \xab \u0644\u0642\u062F \u0635\u062F\u0642 \u0627\u0644\u0644\u0647 \u0642\u0648\u0644\u0643 \u064A\u0627 \u0632\u064A\u062F \xbb.",
            "fadl": "",
            "action": ""
        },
        "49_9": {
            "title": "\u0648\u064E\u0625\u0650\u0646\u0652 \u0637\u064E\u0627\u0626\u0650\u0641\u064E\u062A\u064E\u0627\u0646\u0650 \u0645\u0650\u0646\u064E \u0627\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u0650\u064A\u0646\u064E \u0627\u0642\u0652\u062A\u064E\u062A\u064E\u0644\u064F\u0648\u0627 \u0641\u064E\u0623\u064E\u0635\u0652\u0644\u0650\u062D\u064F\u0648\u0627 \u0628\u064E\u064A\u0652\u0646\u064E\u0647\u064F\u0645\u064E\u0627 \u06D6 \u0641\u064E\u0625\u0650\u0646\u0652 \u0628\u064E\u063A\u064E\u062A\u0652 \u0625\u0650\u062D\u0652\u062F\u064E\u0627\u0647\u064F\u0645\u064E\u0627 \u0639\u064E\u0644\u064E\u0649 \u0627\u0644\u0652\u0623\u064F\u062E\u0652\u0631\u064E\u0649\u0670 \u0641\u064E\u0642\u064E\u0627\u062A\u0650\u0644\u064F\u0648\u0627 \u0627\u0644\u0651\u064E\u062A\u0650\u064A \u062A\u064E\u0628\u0652\u063A\u0650\u064A \u062D\u064E\u062A\u0651\u064E\u0649\u0670 \u062A\u064E\u0641\u0650\u064A\u0621\u064E \u0625\u0650\u0644\u064E\u0649\u0670 \u0623\u064E\u0645\u0652\u0631\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u06DA \u0641\u064E\u0625\u0650\u0646\u0652 \u0641\u064E\u0627\u0621\u064E\u062A\u0652 \u0641\u064E\u0623\u064E\u0635\u0652\u0644\u0650\u062D\u064F\u0648\u0627 \u0628\u064E\u064A\u0652\u0646\u064E\u0647\u064F\u0645\u064E\u0627 \u0628\u0650\u0627\u0644\u0652\u0639\u064E\u062F\u0652\u0644\u0650 \u0648\u064E\u0623\u064E\u0642\u0652\u0633\u0650\u0637\u064F\u0648\u0627 \u06D6 \u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064E \u064A\u064F\u062D\u0650\u0628\u0651\u064F \u0627\u0644\u0652\u0645\u064F\u0642\u0652\u0633\u0650\u0637\u0650\u064A\u0646\u064E",
            "sabab": "\u0639\u064E\u0646\u0652 \u0623\u064E\u0646\u064E\u0633\u0650\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u064E\u0627\u0644\u064E: \u0642\u0650\u064A\u0644\u064E \u0644\u0650\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u0650 \uFDFA \u0644\u064E\u0648\u0652 \u0623\u064E\u062A\u064E\u064A\u0652\u062A\u064E \u0639\u064E\u0628\u0652\u062F\u064E \u0627\u0644\u0644\u0647\u0650 \u0628\u0652\u0646\u064E \u0623\u064F\u0628\u064E\u064A\u0651\u064D. \u0641\u064E\u0627\u0646\u0652\u0637\u064E\u0644\u064E\u0642\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0648\u064E\u0631\u064E\u0643\u0650\u0628\u064E \u062D\u0650\u0645\u064E\u0627\u0631\u0627\u064B\u060C \u0648\u064E\u0627\u0646\u0652\u0637\u064E\u0644\u064E\u0642\u064E \u0627\u0644\u0652\u0645\u064F\u0633\u0652\u0644\u0650\u0645\u064F\u0648\u0646\u064E \u064A\u064E\u0645\u0652\u0634\u064F\u0648\u0646\u064E \u0648\u064E\u0647\u0650\u064A\u064E \u0623\u064E\u0631\u0652\u0636\u064C \u0633\u064E\u0628\u0650\u062E\u064E\u0629\u064C\u060C \u0641\u064E\u0644\u064E\u0645\u0651\u064E\u0627 \u0627\u0646\u0652\u0637\u064E\u0644\u064E\u0642\u064E \u0625\u0650\u0644\u064E\u064A\u0652\u0647\u0650 \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064F \uFDFA \u0642\u064E\u0627\u0644\u064E: \u0625\u0650\u0644\u064E\u064A\u0652\u0643\u064E \u0639\u064E\u0646\u0651\u0650\u064A\u060C \u0641\u064E\u0648\u064E\u0627\u0644\u0644\u0647\u0650 \u0644\u064E\u0642\u064E\u062F\u0652 \u0622\u0630\u064E\u0627\u0646\u0650\u064A \u0631\u0650\u064A\u062D\u064F \u062D\u0650\u0645\u064E\u0627\u0631\u0650\u0643\u064E. \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0631\u064E\u062C\u064F\u0644\u064C \u0645\u0650\u0646\u0652 \u0627\u0644\u0652\u0623\u064E\u0646\u0652\u0635\u064E\u0627\u0631\u0650: \u0648\u064E\u0627\u0644\u0644\u0647\u0650 \u0644\u064E\u062D\u0650\u0645\u064E\u0627\u0631\u064F \u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0623\u064E\u0637\u0652\u064A\u064E\u0628\u064F \u0631\u0650\u064A\u062D\u0627\u064B \u0645\u0650\u0646\u0652\u0643\u064E\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u063A\u064E\u0636\u0650\u0628\u064E \u0644\u0650\u0639\u064E\u0628\u0652\u062F\u0650 \u0627\u0644\u0644\u0647\u0650 \u0631\u064E\u062C\u064F\u0644\u064C \u0645\u0650\u0646\u0652 \u0642\u064E\u0648\u0652\u0645\u0650\u0647\u0650\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u063A\u064E\u0636\u0650\u0628\u064E \u0644\u0650\u0643\u064F\u0644\u0651\u0650 \u0648\u064E\u0627\u062D\u0650\u062F \u0645\u0650\u0646\u0652\u0647\u064F\u0645\u064E\u0627 \u0623\u064E\u0635\u064E\u062D\u064E\u0627\u0628\u064F\u0647\u064F\u060C \u0642\u064E\u0627\u0644\u064E: \u0648\u064E\u0643\u064E\u0627\u0646\u064E \u0628\u064E\u064A\u0652\u0646\u064E\u0647\u064F\u0645\u0652 \u0636\u064E\u0631\u0652\u0628\u064C \u0628\u0650\u0627\u0644\u0652\u062C\u064E\u0631\u0650\u064A\u062F\u0650 \u0648\u064E\u0628\u0650\u0627\u0644\u0652\u0623\u064E\u064A\u0652\u062F\u0650\u064A \u0648\u064E\u0627\u0644\u0646\u0651\u0650\u0639\u064E\u0627\u0644\u0650\u060C \u0641\u064E\u0628\u064E\u0644\u064E\u063A\u064E\u0646\u064E\u0627 \u0623\u064E\u0646\u0651\u064E\u0647\u064E\u0627 \u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652 \u0641\u0650\u064A\u0647\u0650\u0645\u0652: { \u0648\u064E\u0625\u0650\u0646 \u0637\u064E\u0627\u0653\u0626\u0650\u0641\u064E\u062A\u064E\u0627\u0646\u0650 \u0645\u0650\u0646\u064E \u0671\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u0650\u064A\u0646\u064E \u0671\u0642\u0652\u062A\u064E\u062A\u064E\u0644\u064F\u0648\u0627\u06DF \u0641\u064E\u0623\u064E\u0635\u0652\u0644\u0650\u062D\u064F\u0648\u0627\u06DF \u0628\u064E\u064A\u0652\u0646\u064E\u0647\u064F\u0645\u064E\u0627 \u06D6 }.",
            "fadl": "",
            "action": ""
        },
        "49_11": {
            "title": "\u0644\u0627 \u064A\u0633\u062E\u0631 \u0642\u0648\u0645 \u0645\u0646 \u0642\u0648\u0645",
            "sabab": "\u0646\u0632\u0644\u062A \u0641\u064A \u0645\u062C\u0645\u0648\u0639\u0629 \u0645\u0646 \u0627\u0644\u0635\u062D\u0627\u0628\u0629 \u0633\u062E\u0631\u0648\u0627 \u0645\u0646 \u0628\u0644\u0627\u0644 \u0648\u0635\u0647\u064A\u0628 \u0648\u0639\u0645\u0627\u0631 \u0644\u0641\u0642\u0631\u0647\u0645\u060C \u0648\u0641\u064A \u0628\u0639\u0636 \u0627\u0644\u0646\u0633\u0627\u0621 \u0633\u062E\u0631\u0646 \u0645\u0646 \u0623\u0645 \u0633\u0644\u0645\u0629 \u0644\u0650\u0642\u0635\u0631\u0647\u0627\u060C \u0641\u0646\u0647\u0627\u0647\u0645 \u0627\u0644\u0644\u0647.",
            "fadl": "",
            "action": "\u0627\u062D\u0630\u0631 \u0645\u0646 \u0627\u0644\u062A\u0646\u0645\u0631 \u0648\u0627\u0644\u0633\u062E\u0631\u064A\u0629 \u0648\u0644\u0648 \u0628\u0627\u0644\u0645\u0632\u0627\u062D. \u0631\u0628\u0645\u0627 \u064A\u0643\u0648\u0646 \u0645\u0646 \u062A\u0633\u062E\u0631 \u0645\u0646\u0647 \u0623\u0646\u0642\u0649 \u0642\u0644\u0628\u0627\u064B \u0648\u0623\u062D\u0628 \u0625\u0644\u0649 \u0627\u0644\u0644\u0647 \u0645\u0646\u0643."
        },
        "49_18": {
            "title": "\u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064E \u064A\u064E\u0639\u0652\u0644\u064E\u0645\u064F \u063A\u064E\u064A\u0652\u0628\u064E \u0627\u0644\u0633\u0651\u064E\u0645\u064E\u0627\u0648\u064E\u0627\u062A\u0650 \u0648\u064E\u0627\u0644\u0652\u0623\u064E\u0631\u0652\u0636\u0650 \u06DA \u0648\u064E\u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0628\u064E\u0635\u0650\u064A\u0631\u064C \u0628\u0650\u0645\u064E\u0627 \u062A\u064E\u0639\u0652\u0645\u064E\u0644\u064F\u0648\u0646\u064E",
            "sabab": "\u0639\u0646 \u0627\u0628\u0646 \u0639\u0628\u0627\u0633 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u0642\u0627\u0644: \u062C\u0627\u0621\u062A \u0628\u0646\u0648 \u0623\u0633\u062F \u0625\u0644\u0649 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \uFDFA\u060C \u0641\u0642\u0627\u0644\u0648\u0627: \u064A\u0627 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \u0623\u0633\u0644\u0645\u0646\u0627 \u0648\u0642\u0627\u062A\u0644\u062A\u0643 \u0627\u0644\u0639\u0631\u0628 \u0648\u0644\u0645 \u0646\u0642\u0627\u062A\u0644\u0643\u060C \u0641\u0642\u0627\u0644 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \uFDFA: \xab \u0625\u0646 \u0641\u0642\u0647\u0647\u0645 \u0642\u0644\u064A\u0644\u060C \u0648\u0625\u0646 \u0627\u0644\u0634\u064A\u0637\u0627\u0646 \u064A\u0646\u0637\u0642 \u0639\u0644\u0649 \u0623\u0644\u0633\u0646\u062A\u0647\u0645 \xbb\u060C \u0648\u0646\u0632\u0644\u062A. \u0647\u0630\u0647 \u0627\u0644\u0622\u064A\u0629: { \u064A\u064E\u0645\u064F\u0646\u0651\u064F\u0648\u0646\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064E \u0623\u064E\u0646\u0652 \u0623\u064E\u0633\u0652\u0644\u064E\u0645\u064F\u0648\u0627\u06DF \u06D6 \u0642\u064F\u0644 \u0644\u0651\u064E\u0627 \u062A\u064E\u0645\u064F\u0646\u0651\u064F\u0648\u0627\u06DF \u0639\u064E\u0644\u064E\u0649\u0651\u064E \u0625\u0650\u0633\u0652\u0644\u064E\u0640\u0670\u0645\u064E\u0643\u064F\u0645 \u06D6 \u0628\u064E\u0644\u0650 \u0671\u0644\u0644\u0651\u064E\u0647\u064F \u064A\u064E\u0645\u064F\u0646\u0651\u064F \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064F\u0645\u0652 \u0623\u064E\u0646\u0652 \u0647\u064E\u062F\u064E\u0649\u0670\u0643\u064F\u0645\u0652 \u0644\u0650\u0644\u0652\u0625\u0650\u064A\u0645\u064E\u0640\u0670\u0646\u0650 \u0625\u0650\u0646 \u0643\u064F\u0646\u062A\u064F\u0645\u0652 \u0635\u064E\u0640\u0670\u062F\u0650\u0642\u0650\u064A\u0646\u064E \uFD3F\u0661\u0667\uFD3E }",
            "fadl": "",
            "action": ""
        },
        "54_1": {
            "title": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u0627\u0644\u0631\u0651\u064E\u062D\u0652\u0645\u064E\u0670\u0646\u0650 \u0627\u0644\u0631\u0651\u064E\u062D\u0650\u064A\u0645\u0650 \u0627\u0642\u0652\u062A\u064E\u0631\u064E\u0628\u064E\u062A\u0650 \u0627\u0644\u0633\u0651\u064E\u0627\u0639\u064E\u0629\u064F \u0648\u064E\u0627\u0646\u0652\u0634\u064E\u0642\u0651\u064E \u0627\u0644\u0652\u0642\u064E\u0645\u064E\u0631\u064F",
            "sabab": "\u0639\u064E\u0646\u0652 \u0623\u064E\u0646\u064E\u0633\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u064E\u0627\u0644\u064E: \u0633\u064E\u0623\u064E\u0644\u064E \u0623\u064E\u0647\u0652\u0644\u064F \u0645\u064E\u0643\u0651\u064E\u0629\u064E \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064E \uFDFA \u0622\u064A\u064E\u0629\u064B\u060C \u0641\u064E\u0627\u0646\u0652\u0634\u064E\u0642\u0651\u064E \u0627\u0644\u0652\u0642\u064E\u0645\u064E\u0631\u064F \u0628\u0650\u0645\u064E\u0643\u0651\u064E\u0629\u064E \u0645\u064E\u0631\u0651\u064E\u062A\u064E\u064A\u0652\u0646\u0650\u060C \u0641\u064E\u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652: { \u0671\u0642\u0652\u062A\u064E\u0631\u064E\u0628\u064E\u062A\u0650 \u0671\u0644\u0633\u0651\u064E\u0627\u0639\u064E\u0629\u064F \u0648\u064E\u0671\u0646\u0634\u064E\u0642\u0651\u064E \u0671\u0644\u0652\u0642\u064E\u0645\u064E\u0631\u064F \uFD3F\u0661\uFD3E } \u0625\u0650\u0644\u064E\u0649 \u0642\u064E\u0648\u0652\u0644\u0650\u0647\u0650: { \u0633\u0650\u062D\u0652\u0631\u064C \u0645\u0651\u064F\u0633\u0652\u062A\u064E\u0645\u0650\u0631\u0651\u064C }\u060C \u064A\u064E\u0642\u064F\u0648\u0644\u064F: \u0630\u064E\u0627\u0647\u0650\u0628\u064C.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0639\u0646 \u0627\u0628\u0646 \u0645\u0633\u0639\u0648\u062F \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u0627\u0644: \u0627\u0646\u0634\u0642 \u0627\u0644\u0642\u0645\u0631 \u0639\u0644\u0649 \u0639\u0647\u062F \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \uFDFA\u060C \u0641\u0642\u0627\u0644\u062A \u0642\u0631\u064A\u0634: \u0647\u0630\u0627 \u0633\u062D\u0631 \u0627\u0628\u0646 \u0623\u0628\u064A \u0643\u0628\u0634\u0629 \u0633\u062D\u0631\u0643\u0645 \u0641\u0633\u0644\u0648\u0627 \u0627\u0644\u0633\u0641\u0627\u0631\u060C \u0641\u0633\u0623\u0644\u0648\u0647\u0645\u060C \u0641\u0642\u0627\u0644\u0648\u0627: \u0646\u0639\u0645 \u0642\u062F \u0631\u0623\u064A\u0646\u0627\u0647\u060C \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 \u062A\u0628\u0627\u0631\u0643 \u0648\u062A\u0639\u0627\u0644\u0649:{ \u0671\u0642\u0652\u062A\u064E\u0631\u064E\u0628\u064E\u062A\u0650 \u0671\u0644\u0633\u0651\u064E\u0627\u0639\u064E\u0629\u064F \u0648\u064E\u0671\u0646\u0634\u064E\u0642\u0651\u064E \u0671\u0644\u0652\u0642\u064E\u0645\u064E\u0631\u064F \uFD3F\u0661\uFD3E }.",
            "fadl": "",
            "action": ""
        },
        "54_48": {
            "title": "\u064A\u064E\u0648\u0652\u0645\u064E \u064A\u064F\u0633\u0652\u062D\u064E\u0628\u064F\u0648\u0646\u064E \u0641\u0650\u064A \u0627\u0644\u0646\u0651\u064E\u0627\u0631\u0650 \u0639\u064E\u0644\u064E\u0649\u0670 \u0648\u064F\u062C\u064F\u0648\u0647\u0650\u0647\u0650\u0645\u0652 \u0630\u064F\u0648\u0642\u064F\u0648\u0627 \u0645\u064E\u0633\u0651\u064E \u0633\u064E\u0642\u064E\u0631\u064E",
            "sabab": "\u0639\u064E\u0646\u0652 \u0623\u064E\u0628\u0650\u064A \u0647\u064F\u0631\u064E\u064A\u0652\u0631\u064E\u0629\u064E \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u064E\u0627\u0644\u064E: \u062C\u064E\u0627\u0621\u064E \u0645\u064F\u0634\u0652\u0631\u0650\u0643\u064F\u0648 \u0642\u064F\u0631\u064E\u064A\u0652\u0634\u064D \u0625\u0650\u0644\u064E\u0649 \u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0627\u0644\u0644\u0647\u0650 \uFDFA \u064A\u064F\u062E\u064E\u0627\u0635\u0650\u0645\u064F\u0648\u0646\u064E \u0641\u0650\u064A \u0627\u0644\u0652\u0642\u064E\u062F\u064E\u0631\u0650 \u0641\u064E\u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652 \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u064F: { \u064A\u064E\u0648\u0652\u0645\u064E \u064A\u064F\u0633\u0652\u062D\u064E\u0628\u064F\u0648\u0646\u064E \u0641\u0650\u0649 \u0671\u0644\u0646\u0651\u064E\u0627\u0631\u0650 \u0639\u064E\u0644\u064E\u0649\u0670 \u0648\u064F\u062C\u064F\u0648\u0647\u0650\u0647\u0650\u0645\u0652 \u0630\u064F\u0648\u0642\u064F\u0648\u0627\u06DF \u0645\u064E\u0633\u0651\u064E \u0633\u064E\u0642\u064E\u0631\u064E \uFD3F\u0664\u0668\uFD3E \u0625\u0650\u0646\u0651\u064E\u0627 \u0643\u064F\u0644\u0651\u064E \u0634\u064E\u0649\u0652\u0621\u064D \u062E\u064E\u0644\u064E\u0642\u0652\u0646\u064E\u0640\u0670\u0647\u064F \u0628\u0650\u0642\u064E\u062F\u064E\u0631\u064D \uFD3F\u0664\u0669\uFD3E }.",
            "fadl": "",
            "action": ""
        },
        "55_1": {
            "title": "\u0627\u0644\u0631\u062D\u0645\u0646 - \u0623\u0648\u0644 \u0622\u064A\u0629 \u0641\u064A \u0639\u0631\u0648\u0633 \u0627\u0644\u0642\u0631\u0622\u0646",
            "sabab": "",
            "fadl": "\u0627\u0644\u0631\u062D\u0645\u0646 \u0623\u062D\u062F \u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0644\u0647 \u0627\u0644\u062D\u0633\u0646\u0649\u060C \u064A\u064F\u0630\u0643\u0651\u0631 \u0628\u0623\u0646 \u0643\u0644 \u0646\u0639\u0645\u0629 \u062A\u0635\u0644\u0643 \u0647\u064A \u0645\u0646 \u0631\u062D\u0645\u062A\u0647 \u0648\u062D\u062F\u0647.",
            "action": "\u0627\u0628\u062F\u0623 \u064A\u0648\u0645\u0643 \u0628\u062A\u0630\u0643\u0631 \u0627\u0633\u0645 \u0627\u0644\u0631\u062D\u0645\u0646\u060C \u0648\u0642\u0644: \u064A\u0627 \u0631\u062D\u0645\u0646 \u0627\u0631\u062D\u0645\u0646\u064A \u0628\u0631\u062D\u0645\u062A\u0643 \u0627\u0644\u062A\u064A \u0648\u0633\u0639\u062A \u0643\u0644 \u0634\u064A\u0621."
        },
        "57_16": {
            "title": "\u062E\u0634\u0648\u0639 \u0627\u0644\u0642\u0644\u0648\u0628",
            "sabab": "\u0639\u0627\u062A\u0628 \u0627\u0644\u0644\u0647 \u0628\u0647\u0627 \u0627\u0644\u0645\u0624\u0645\u0646\u064A\u0646 \u0628\u0639\u062F \u0625\u0633\u0644\u0627\u0645\u0647\u0645 \u0628\u0633\u0646\u0648\u0627\u062A\u060C \u0648\u0642\u064A\u0644 \u0646\u0632\u0644\u062A \u0644\u0645\u0627 \u0643\u062B\u0631 \u0627\u0644\u0645\u0632\u0627\u062D \u0648\u0627\u0644\u0636\u062D\u0643 \u0641\u064A \u0627\u0644\u0635\u062D\u0627\u0628\u0629 \u0628\u0639\u062F \u062A\u0631\u0641\u0651\u0647\u0647\u0645 \u0628\u0627\u0644\u0645\u062F\u064A\u0646\u0629.",
            "fadl": "",
            "action": "\u0627\u062C\u0639\u0644 \u0642\u0644\u0628\u0643 \u064A\u0644\u064A\u0640\u0646 \u0639\u0646\u062F \u0627\u0644\u0645\u0648\u0639\u0638\u0629 \u0648\u062A\u0644\u0627\u0648\u0629 \u0627\u0644\u0642\u0631\u0622\u0646\u060C \u0648\u0628\u0627\u062F\u0631 \u0628\u0627\u0644\u062A\u0648\u0628\u0629 \u0642\u0627\u0626\u0644\u0627\u064B \u0628\u0644\u0633\u0627\u0646 \u062D\u0627\u0644\u0643: \u0628\u0644\u0649 \u064A\u0627 \u0631\u0628 \u0642\u062F \u0622\u0646."
        },
        "58_1": {
            "title": "\u0642\u062F \u0633\u0645\u0639 \u0627\u0644\u0644\u0647 \u0642\u0648\u0644 \u0627\u0644\u062A\u064A \u062A\u062C\u0627\u062F\u0644\u0643 \u0641\u064A \u0632\u0648\u062C\u0647\u0627",
            "sabab": "\u0646\u0632\u0644\u062A \u0641\u064A \u062E\u0648\u0644\u0629 \u0628\u0646\u062A \u062B\u0639\u0644\u0628\u0629 \u0627\u0644\u062A\u064A \u0638\u0627\u0647\u0631 \u0645\u0646\u0647\u0627 \u0632\u0648\u062C\u0647\u0627\u060C \u0641\u062C\u0627\u0621\u062A \u062A\u0634\u062A\u0643\u064A \u0644\u0644\u0646\u0628\u064A \uFDFA \u0648\u062A\u0628\u0643\u064A\u060C \u0641\u0633\u0645\u0639 \u0627\u0644\u0644\u0647 \u0634\u0643\u0648\u0627\u0647\u0627 \u0645\u0646 \u0641\u0648\u0642 \u0633\u0628\u0639 \u0633\u0645\u0627\u0648\u0627\u062A.",
            "fadl": "",
            "action": "\u0645\u0647\u0645\u0627 \u0643\u0627\u0646 \u0635\u0648\u062A\u0643 \u062E\u0627\u0641\u062A\u0627\u064B \u0648\u0634\u0643\u0648\u0627\u0643 \u062D\u0628\u064A\u0633\u0629 \u0635\u062F\u0631\u0643\u060C \u0641\u0625\u0646 \u0627\u0644\u0644\u0647 \u064A\u0633\u0645\u0639\u0643 \u0643\u0645\u0627 \u0633\u0645\u0639 \u062E\u0648\u0644\u0629. \u0628\u062B \u0634\u0643\u0648\u0627\u0643 \u0644\u0645\u0646 \u0628\u064A\u062F\u0647 \u0627\u0644\u062D\u0644."
        },
        "58_2": {
            "title": "\u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u064A\u064F\u0638\u064E\u0627\u0647\u0650\u0631\u064F\u0648\u0646\u064E \u0645\u0650\u0646\u0652\u0643\u064F\u0645\u0652 \u0645\u0650\u0646\u0652 \u0646\u0650\u0633\u064E\u0627\u0626\u0650\u0647\u0650\u0645\u0652 \u0645\u064E\u0627 \u0647\u064F\u0646\u0651\u064E \u0623\u064F\u0645\u0651\u064E\u0647\u064E\u0627\u062A\u0650\u0647\u0650\u0645\u0652 \u06D6 \u0625\u0650\u0646\u0652 \u0623\u064F\u0645\u0651\u064E\u0647\u064E\u0627\u062A\u064F\u0647\u064F\u0645\u0652 \u0625\u0650\u0644\u0651\u064E\u0627 \u0627\u0644\u0644\u0651\u064E\u0627\u0626\u0650\u064A \u0648\u064E\u0644\u064E\u062F\u0652\u0646\u064E\u0647\u064F\u0645\u0652 \u06DA \u0648\u064E\u0625\u0650\u0646\u0651\u064E\u0647\u064F\u0645\u0652 \u0644\u064E\u064A\u064E\u0642\u064F\u0648\u0644\u064F\u0648\u0646\u064E \u0645\u064F\u0646\u0652\u0643\u064E\u0631\u064B\u0627 \u0645\u0650\u0646\u064E \u0627\u0644\u0652\u0642\u064E\u0648\u0652\u0644\u0650 \u0648\u064E\u0632\u064F\u0648\u0631\u064B\u0627 \u06DA \u0648\u064E\u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064E \u0644\u064E\u0639\u064E\u0641\u064F\u0648\u0651\u064C \u063A\u064E\u0641\u064F\u0648\u0631\u064C",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 1 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
            "fadl": "",
            "action": ""
        },
        "58_8": {
            "title": "\u0623\u064E\u0644\u064E\u0645\u0652 \u062A\u064E\u0631\u064E \u0625\u0650\u0644\u064E\u0649 \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0646\u064F\u0647\u064F\u0648\u0627 \u0639\u064E\u0646\u0650 \u0627\u0644\u0646\u0651\u064E\u062C\u0652\u0648\u064E\u0649\u0670 \u062B\u064F\u0645\u0651\u064E \u064A\u064E\u0639\u064F\u0648\u062F\u064F\u0648\u0646\u064E \u0644\u0650\u0645\u064E\u0627 \u0646\u064F\u0647\u064F\u0648\u0627 \u0639\u064E\u0646\u0652\u0647\u064F \u0648\u064E\u064A\u064E\u062A\u064E\u0646\u064E\u0627\u062C\u064E\u0648\u0652\u0646\u064E \u0628\u0650\u0627\u0644\u0652\u0625\u0650\u062B\u0652\u0645\u0650 \u0648\u064E\u0627\u0644\u0652\u0639\u064F\u062F\u0652\u0648\u064E\u0627\u0646\u0650 \u0648\u064E\u0645\u064E\u0639\u0652\u0635\u0650\u064A\u064E\u062A\u0650 \u0627\u0644\u0631\u0651\u064E\u0633\u064F\u0648\u0644\u0650 \u0648\u064E\u0625\u0650\u0630\u064E\u0627 \u062C\u064E\u0627\u0621\u064F\u0648\u0643\u064E \u062D\u064E\u064A\u0651\u064E\u0648\u0652\u0643\u064E \u0628\u0650\u0645\u064E\u0627 \u0644\u064E\u0645\u0652 \u064A\u064F\u062D\u064E\u064A\u0651\u0650\u0643\u064E \u0628\u0650\u0647\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0648\u064E\u064A\u064E\u0642\u064F\u0648\u0644\u064F\u0648\u0646\u064E \u0641\u0650\u064A \u0623\u064E\u0646\u0652\u0641\u064F\u0633\u0650\u0647\u0650\u0645\u0652 \u0644\u064E\u0648\u0652\u0644\u064E\u0627 \u064A\u064F\u0639\u064E\u0630\u0651\u0650\u0628\u064F\u0646\u064E\u0627 \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0628\u0650\u0645\u064E\u0627 \u0646\u064E\u0642\u064F\u0648\u0644\u064F \u06DA \u062D\u064E\u0633\u0652\u0628\u064F\u0647\u064F\u0645\u0652 \u062C\u064E\u0647\u064E\u0646\u0651\u064E\u0645\u064F \u064A\u064E\u0635\u0652\u0644\u064E\u0648\u0652\u0646\u064E\u0647\u064E\u0627 \u06D6 \u0641\u064E\u0628\u0650\u0626\u0652\u0633\u064E \u0627\u0644\u0652\u0645\u064E\u0635\u0650\u064A\u0631\u064F",
            "sabab": "\u0639\u064E\u0646\u0652 \u0623\u064E\u0646\u064E\u0633\u0650 \u0628\u0652\u0646\u0650 \u0645\u064E\u0627\u0644\u0650\u0643\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0623\u064E\u0646\u0651\u064E \u064A\u064E\u0647\u064F\u0648\u062F\u0650\u064A\u064E\u0651\u0627 \u0623\u064E\u062A\u064E\u0649 \u0639\u064E\u0644\u064E\u0649 \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u0650 \uFDFA \u0648\u064E\u0623\u064E\u0635\u0652\u062D\u064E\u0627\u0628\u0650\u0647\u0650\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E: \u0627\u0644\u0633\u0651\u064E\u0627\u0645\u064F \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064F\u0645\u0652\u060C \u0641\u064E\u0631\u064E\u062F\u0651\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650 \u0627\u0644\u0652\u0642\u064E\u0648\u0652\u0645\u064F\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0646\u064E\u0628\u0650\u064A\u0651\u064F \u0627\u0644\u0644\u0647\u064E \uFDFA: \xab \u0647\u064E\u0644\u0652 \u062A\u064E\u062F\u0652\u0631\u064F\u0648\u0646\u064E \u0645\u064E\u0627 \u0642\u064E\u0627\u0644\u064E \u0647\u064E\u0630\u064E\u0627\u061F \xbb \u0642\u064E\u0627\u0644\u064F\u0648\u0627: \u0627\u0644\u0644\u0647\u064F \u0648\u064E\u0631\u064E\u0633\u064F\u0648\u0644\u064F\u0647\u064F \u0623\u064E\u0639\u0652\u0644\u064E\u0645\u064F\u060C \u0633\u064E\u0644\u0651\u064E\u0645\u064E \u064A\u064E\u0627 \u0646\u064E\u0628\u0650\u064A\u0651\u064E \u0627\u0644\u0644\u0647\u0650. \u0642\u064E\u0627\u0644\u064E: \xab \u0644\u0627\u064E\u060C \u0648\u064E\u0644\u064E\u0643\u0650\u0646\u0651\u064E\u0647\u064F \u0642\u064E\u0627\u0644\u064E \u0643\u064E\u0630\u064E\u0627 \u0648\u064E\u0643\u064E\u0630\u064E\u0627\u060C \u0631\u064F\u062F\u0651\u064F\u0648\u0647\u064F \u0639\u064E\u0644\u064E\u064A\u0651\u064E \xbb\u060C \u0641\u064E\u0631\u064E\u062F\u0651\u064F\u0648\u0647\u064F. \u0642\u064E\u0627\u0644\u064E: \xab \u0642\u064F\u0644\u0652\u062A\u064E: \u0627\u0644\u0633\u0651\u064E\u0627\u0645\u064F\u0651 \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064F\u0645\u0652 \xbb \u0642\u064E\u0627\u0644\u064E: \u0646\u064E\u0639\u064E\u0645\u0652\u060C \u0642\u064E\u0627\u0644\u064E \u0646\u064E\u0628\u0650\u064A\u0651\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0639\u0650\u0646\u0652\u062F\u064E \u0630\u064E\u0644\u0650\u0643\u064E: \xab \u0625\u0650\u0630\u064E\u0627 \u0633\u064E\u0644\u0651\u064E\u0645\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064F\u0645\u0652 \u0623\u064E\u062D\u064E\u062F\u064C \u0645\u0650\u0646\u0652 \u0623\u064E\u0647\u0652\u0644\u0650 \u0627\u0644\u0652\u0643\u0650\u062A\u064E\u0627\u0628\u0650 \u0641\u064E\u0642\u064F\u0648\u0644\u064F\u0648\u0627: \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064E \u0645\u064E\u0627 \u0642\u064F\u0644\u0652\u062A\u064E \xbb. \u0642\u064E\u0627\u0644\u064E: { \u0648\u064E\u0625\u0650\u0630\u064E\u0627 \u062C\u064E\u0627\u0653\u0621\u064F\u0648\u0643\u064E \u062D\u064E\u064A\u0651\u064E\u0648\u0652\u0643\u064E \u0628\u0650\u0645\u064E\u0627 \u0644\u064E\u0645\u0652 \u064A\u064F\u062D\u064E\u064A\u0651\u0650\u0643\u064E \u0628\u0650\u0647\u0650 \u0671\u0644\u0644\u0651\u064E\u0647\u064F }.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0639\u064E\u0646\u0652 \u0639\u064E\u0627\u0626\u0650\u0634\u064E\u0629\u064E \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0627 \u0642\u064E\u0627\u0644\u064E\u062A\u0652: \u0623\u064E\u062A\u064E\u0649 \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064E \uFDFA \u0646\u064E\u0627\u0633\u064C \u0645\u0650\u0646\u0652 \u0627\u0644\u0652\u064A\u064E\u0647\u064F\u0648\u062F\u0650\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064F\u0648\u0627: \u0627\u0644\u0633\u0651\u064E\u0627\u0645\u064F \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064E\u060C \u064A\u064E\u0627 \u0623\u064E\u0628\u064E\u0627 \u0627\u0644\u0652\u0642\u064E\u0627\u0633\u0650\u0645\u0650\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E: \xab \u0648\u064E\u0639\u064E\u0644\u0652\u064A\u0652\u0643\u064F\u0645\u0652 \xbb\u060C \u0642\u064E\u0627\u0644\u064E\u062A\u0652 \u0639\u064E\u0627\u0626\u0650\u0634\u064E\u0629\u064F: \u0641\u064E\u0642\u064F\u0644\u0652\u062A\u064F: \u0648\u064E\u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064F\u0645\u0652 \u0627\u0644\u0633\u0651\u064E\u0627\u0645\u064F \u0648\u064E\u0627\u0644\u064E\u0651\u0630\u0627\u0645\u064F\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647 \uFDFA: \xab\u064A\u064E\u0627 \u0639\u064E\u0627\u0626\u0650\u0634\u064E\u0629\u064F \u0644\u064E\u0627 \u062A\u064E\u0643\u064F\u0648\u0646\u0650\u064A \u0641\u064E\u0627\u062D\u0650\u0634\u064E\u0629\u064B\xbb. \u0642\u064E\u0627\u0644\u064E\u062A\u0652: \u0641\u064E\u0642\u064F\u0644\u0652\u062A\u064F: \u064A\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \u0623\u064E\u0645\u064E\u0627 \u0633\u064E\u0645\u0650\u0639\u0652\u062A\u064E \u0645\u064E\u0627 \u0642\u064E\u0627\u0644\u064F\u0648\u0627: \u0627\u0644\u0633\u0651\u064E\u0627\u0645\u064F \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064E\u061F!!\u060C \u0642\u064E\u0627\u0644\u064E: \xab \u0623\u064E\u0644\u064E\u064A\u0652\u0633\u064E \u0642\u064E\u062F\u0652 \u0631\u064E\u062F\u064E\u062F\u0652\u062A\u064F \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650\u0645\u0652 \u0627\u0644\u0651\u064E\u0630\u0650\u064A \u0642\u064E\u0627\u0644\u064F\u0648\u0627\u061B \u0642\u064F\u0644\u0652\u062A\u064F: \u0648\u064E\u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064F\u0645\u0652 \xbb.\n\n\u0642\u064E\u0627\u0644\u064E \u0627\u0628\u0652\u0646\u064F \u0646\u064F\u0645\u064E\u064A\u0652\u0631\u064D - \u064A\u064E\u0639\u0652\u0646\u0650\u064A \u0641\u0650\u064A \u062D\u064E\u062F\u0650\u064A\u062B\u0650 \u0639\u064E\u0627\u0626\u0650\u0634\u064E\u0629\u064E -\u060C \u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0644\u0647\u064E \u0639\u0632 \u0648 \u062C\u0644 \u0644\u064E\u0627 \u064A\u064F\u062D\u0650\u0628\u0651\u064F \u0627\u0644\u0652\u0641\u064F\u062D\u0652\u0634\u064E \u0648\u064E\u0644\u064E\u0627 \u0627\u0644\u062A\u0651\u064E\u0641\u064E\u062D\u064F\u0651\u0634\u064E\u060C \u0648\u064E\u0642\u064E\u0627\u0644\u064E \u0627\u0628\u0652\u0646\u064F \u0646\u064F\u0645\u064E\u064A\u0652\u0631\u064D \u0641\u0650\u064A \u062D\u064E\u062F\u0650\u064A\u062B\u0650\u0647\u0650 \u0641\u064E\u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652 \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u064F: { \u0648\u064E\u0625\u0650\u0630\u064E\u0627 \u062C\u064E\u0627\u0653\u0621\u064F\u0648\u0643\u064E \u062D\u064E\u064A\u0651\u064E\u0648\u0652\u0643\u064E \u0628\u0650\u0645\u064E\u0627 \u0644\u064E\u0645\u0652 \u064A\u064F\u062D\u064E\u064A\u0651\u0650\u0643\u064E \u0628\u0650\u0647\u0650 \u0671\u0644\u0644\u0651\u064E\u0647\u064F } \u062D\u064E\u062A\u0651\u064E\u0649 \u0641\u064E\u0631\u064E\u063A\u064E.",
            "fadl": "",
            "action": ""
        },
        "58_12": {
            "title": "\u064A\u064E\u0627 \u0623\u064E\u064A\u0651\u064F\u0647\u064E\u0627 \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0622\u0645\u064E\u0646\u064F\u0648\u0627 \u0625\u0650\u0630\u064E\u0627 \u0646\u064E\u0627\u062C\u064E\u064A\u0652\u062A\u064F\u0645\u064F \u0627\u0644\u0631\u0651\u064E\u0633\u064F\u0648\u0644\u064E \u0641\u064E\u0642\u064E\u062F\u0651\u0650\u0645\u064F\u0648\u0627 \u0628\u064E\u064A\u0652\u0646\u064E \u064A\u064E\u062F\u064E\u064A\u0652 \u0646\u064E\u062C\u0652\u0648\u064E\u0627\u0643\u064F\u0645\u0652 \u0635\u064E\u062F\u064E\u0642\u064E\u0629\u064B \u06DA \u0630\u064E\u0670\u0644\u0650\u0643\u064E \u062E\u064E\u064A\u0652\u0631\u064C \u0644\u064E\u0643\u064F\u0645\u0652 \u0648\u064E\u0623\u064E\u0637\u0652\u0647\u064E\u0631\u064F \u06DA \u0641\u064E\u0625\u0650\u0646\u0652 \u0644\u064E\u0645\u0652 \u062A\u064E\u062C\u0650\u062F\u064F\u0648\u0627 \u0641\u064E\u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064E \u063A\u064E\u0641\u064F\u0648\u0631\u064C \u0631\u064E\u062D\u0650\u064A\u0645\u064C",
            "sabab": "\u0639\u064E\u0646\u0652 \u0639\u064E\u0644\u0650\u064A\u0651\u0650 \u0628\u0652\u0646\u0650 \u0623\u064E\u0628\u0650\u064A \u0637\u064E\u0627\u0644\u0650\u0628\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647: \u0642\u064E\u0627\u0644\u064E \u0644\u064E\u0645\u0651\u064E\u0627 \u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652 { \u064A\u064E\u0640\u0670\u0653\u0623\u064E\u064A\u0651\u064F\u0647\u064E\u0627 \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0621\u064E\u0627\u0645\u064E\u0646\u064F\u0648\u0653\u0627\u06DF \u0625\u0650\u0630\u064E\u0627 \u0646\u064E\u0640\u0670\u062C\u064E\u064A\u0652\u062A\u064F\u0645\u064F \u0671\u0644\u0631\u0651\u064E\u0633\u064F\u0648\u0644\u064E \u0641\u064E\u0642\u064E\u062F\u0651\u0650\u0645\u064F\u0648\u0627\u06DF \u0628\u064E\u064A\u0652\u0646\u064E \u064A\u064E\u062F\u064E\u0649\u0652 \u0646\u064E\u062C\u0652\u0648\u064E\u0649\u0670\u0643\u064F\u0645\u0652 \u0635\u064E\u062F\u064E\u0642\u064E\u0629\u064B \u06DA } \u0642\u064E\u0627\u0644\u064E \u0644\u0650\u064A \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064F \uFDFA: \xab \u0645\u064E\u0627 \u062A\u064E\u0631\u064E\u0649 \u062F\u0650\u064A\u0646\u064E\u0627\u0631\u0627\u064B \xbb\u060C \u0642\u064F\u0644\u0652\u062A\u064F: \u0644\u064E\u0627 \u064A\u064F\u0637\u0650\u064A\u0642\u064F\u0648\u0646\u064E\u0647\u064F\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0646\u0650\u0635\u0652\u0641\u064F \u062F\u0650\u064A\u0646\u064E\u0627\u0631\u064D\xbb\u060C \u0642\u064F\u0644\u0652\u062A\u064F: \u0644\u064E\u0627 \u064A\u064F\u0637\u0650\u064A\u0642\u064F\u0648\u0646\u064E\u0647\u064F\u060C \u0642\u064E\u0627\u0644\u064E: \xab \u0641\u064E\u0643\u064E\u0645\u0652 \xbb \u0642\u064F\u0644\u0652\u062A\u064F: \u0634\u064E\u0639\u0650\u064A\u0631\u064E\u0629\u064C\u060C \u0642\u064E\u0627\u0644\u064E: \xab \u0625\u0650\u0646\u0651\u064E\u0643\u064E \u0644\u064E\u0632\u064E\u0647\u0650\u064A\u062F\u064C \xbb \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652: { \u0621\u064E\u0623\u064E\u0634\u0652\u0641\u064E\u0642\u0652\u062A\u064F\u0645\u0652 \u0623\u064E\u0646 \u062A\u064F\u0642\u064E\u062F\u0651\u0650\u0645\u064F\u0648\u0627\u06DF \u0628\u064E\u064A\u0652\u0646\u064E \u064A\u064E\u062F\u064E\u0649\u0652 \u0646\u064E\u062C\u0652\u0648\u064E\u0649\u0670\u0643\u064F\u0645\u0652 \u0635\u064E\u062F\u064E\u0642\u064E\u0640\u0670\u062A\u064D\u06E2 \u06DA } \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u064E \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0628\u0650\u064A \u062E\u064E\u0641\u0651\u064E\u0641\u064E \u0627\u0644\u0644\u0647\u064F \u0639\u064E\u0646\u0652 \u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0623\u064F\u0645\u0651\u064E\u0629\u0650.",
            "fadl": "",
            "action": ""
        },
        "59_1": {
            "title": "\u062C\u0644\u0627\u0621 \u0628\u0646\u064A \u0627\u0644\u0646\u0636\u064A\u0631",
            "sabab": "\u0646\u0632\u0644\u062A \u0641\u064A \u064A\u0647\u0648\u062F \u0628\u0646\u064A \u0627\u0644\u0646\u0636\u064A\u0631 \u062D\u064A\u0646 \u0646\u0642\u0636\u0648\u0627 \u0639\u0647\u062F\u0647\u0645 \u0648\u062D\u0627\u0648\u0644\u0648\u0627 \u0627\u063A\u062A\u064A\u0627\u0644 \u0627\u0644\u0646\u0628\u064A \uFDFA\u060C \u0641\u062D\u0627\u0635\u0631\u0647\u0645 \u0627\u0644\u0645\u0633\u0644\u0645\u0648\u0646 \u0648\u0623\u062C\u0644\u0648\u0647\u0645 \u0639\u0646 \u0627\u0644\u0645\u062F\u064A\u0646\u0629 \u0628\u063A\u064A\u0631 \u0642\u062A\u0627\u0644 \u0634\u062F\u064A\u062F.",
            "fadl": "",
            "action": "(\u0641\u0627\u0639\u062A\u0628\u0631\u0648\u0627 \u064A\u0627 \u0623\u0648\u0644\u064A \u0627\u0644\u0623\u0628\u0635\u0627\u0631).. \u0644\u0627 \u062A\u063A\u062A\u0631 \u0628\u0642\u0648\u062A\u0643 \u0648\u0645\u0627\u0644\u0643 \u0648\u062D\u0635\u0648\u0646\u0643\u060C \u0641\u0625\u0630\u0627 \u0623\u0631\u0627\u062F \u0627\u0644\u0644\u0647 \u0623\u0645\u0631\u0627\u064B \u0623\u062A\u0627\u0643 \u0645\u0646 \u062D\u064A\u062B \u0644\u0645 \u062A\u062D\u062A\u0633\u0628."
        },
        "59_5": {
            "title": "\u0645\u064E\u0627 \u0642\u064E\u0637\u064E\u0639\u0652\u062A\u064F\u0645\u0652 \u0645\u0650\u0646\u0652 \u0644\u0650\u064A\u0646\u064E\u0629\u064D \u0623\u064E\u0648\u0652 \u062A\u064E\u0631\u064E\u0643\u0652\u062A\u064F\u0645\u064F\u0648\u0647\u064E\u0627 \u0642\u064E\u0627\u0626\u0650\u0645\u064E\u0629\u064B \u0639\u064E\u0644\u064E\u0649\u0670 \u0623\u064F\u0635\u064F\u0648\u0644\u0650\u0647\u064E\u0627 \u0641\u064E\u0628\u0650\u0625\u0650\u0630\u0652\u0646\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u0648\u064E\u0644\u0650\u064A\u064F\u062E\u0652\u0632\u0650\u064A\u064E \u0627\u0644\u0652\u0641\u064E\u0627\u0633\u0650\u0642\u0650\u064A\u0646\u064E",
            "sabab": "\u0639\u064E\u0646\u0650 \u0627\u0628\u0652\u0646\u0650 \u0639\u064F\u0645\u064E\u0631\u064E \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u0642\u064E\u0627\u0644\u064E: \u062D\u064E\u0631\u0651\u064E\u0642\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0646\u064E\u062E\u0652\u0644\u064E \u0628\u064E\u0646\u0650\u064A \u0627\u0644\u0646\u0651\u064E\u0636\u0650\u064A\u0631\u0650\u060C \u0648\u064E\u0642\u064E\u0637\u064E\u0639\u064E\u060C \u0648\u064E\u0647\u0650\u064A\u064E \u0627\u0644\u0652\u0628\u064F\u0648\u064E\u064A\u0652\u0631\u064E\u0629\u064F\u060C \u0641\u064E\u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652: { \u0645\u064E\u0627 \u0642\u064E\u0637\u064E\u0639\u0652\u062A\u064F\u0645 \u0645\u0651\u0650\u0646 \u0644\u0651\u0650\u064A\u0646\u064E\u0629\u064D \u0623\u064E\u0648\u0652 \u062A\u064E\u0631\u064E\u0643\u0652\u062A\u064F\u0645\u064F\u0648\u0647\u064E\u0627 \u0642\u064E\u0627\u0653\u0626\u0650\u0645\u064E\u0629\u064B \u0639\u064E\u0644\u064E\u0649\u0670\u0653 \u0623\u064F\u0635\u064F\u0648\u0644\u0650\u0647\u064E\u0627 \u0641\u064E\u0628\u0650\u0625\u0650\u0630\u0652\u0646\u0650 \u0671\u0644\u0644\u0651\u064E\u0647\u0650 }.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0639\u064E\u0646\u0650 \u0627\u0628\u0652\u0646\u0650 \u0639\u064F\u0645\u064E\u0631\u064E \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u0623\u064E\u0646\u0651\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0642\u064E\u0637\u064E\u0639\u064E \u0646\u064E\u062E\u0652\u0644\u064E \u0628\u064E\u0646\u0650\u064A \u0627\u0644\u0646\u0651\u064E\u0636\u0650\u064A\u0631\u0650\u060C \u0648\u064E\u062D\u064E\u0631\u0651\u064E\u0642\u064E\u060C \u0648\u064E\u0644\u064E\u0647\u064E\u0627 \u064A\u064E\u0642\u064F\u0648\u0644\u064F \u062D\u064E\u0633\u0651\u064E\u0627\u0646\u064F:\n\u0648\u064E\u0647\u064E\u0627\u0646\u064E \u0639\u064E\u0644\u064E\u0649 \u0633\u064E\u0631\u064E\u0627\u0629\u0650 \u0628\u064E\u0646\u0650\u064A \u0644\u064F\u0624\u064E\u064A\u0651\u0650      \u062D\u064E\u0631\u0650\u064A\u0642\u064C \u0628\u0650\u0627\u0644\u0652\u0628\u064F\u0648\u064E\u064A\u0652\u0631\u064E\u0629\u0650 \u0645\u064F\u0633\u0652\u062A\u064E\u0637\u0650\u064A\u0631\u064F\n\u0648\u064E\u0641\u0650\u064A \u0630\u064E\u0644\u0650\u0643\u064E \u0646\u064E\u0632\u064E\u0644\u064E\u062A\u0652 { \u0645\u064E\u0627 \u0642\u064E\u0637\u064E\u0639\u0652\u062A\u064F\u0645 \u0645\u0651\u0650\u0646 \u0644\u0651\u0650\u064A\u0646\u064E\u0629\u064D \u0623\u064E\u0648\u0652 \u062A\u064E\u0631\u064E\u0643\u0652\u062A\u064F\u0645\u064F\u0648\u0647\u064E\u0627 \u0642\u064E\u0627\u0653\u0626\u0650\u0645\u064E\u0629\u064B \u0639\u064E\u0644\u064E\u0649\u0670\u0653 \u0623\u064F\u0635\u064F\u0648\u0644\u0650\u0647\u064E\u0627 } \u0627\u0644\u0622\u064A\u064E\u0629.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0639\u064E\u0646\u0650 \u0627\u0628\u0652\u0646\u0650 \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u0641\u0650\u064A \u0642\u064E\u0648\u0652\u0644\u0650 \u0627\u0644\u0644\u0647\u0650 \u0639\u0632 \u0648 \u062C\u0644: { \u0645\u064E\u0627 \u0642\u064E\u0637\u064E\u0639\u0652\u062A\u064F\u0645 \u0645\u0651\u0650\u0646 \u0644\u0651\u0650\u064A\u0646\u064E\u0629\u064D \u0623\u064E\u0648\u0652 \u062A\u064E\u0631\u064E\u0643\u0652\u062A\u064F\u0645\u064F\u0648\u0647\u064E\u0627 \u0642\u064E\u0627\u0653\u0626\u0650\u0645\u064E\u0629\u064B \u0639\u064E\u0644\u064E\u0649\u0670\u0653 \u0623\u064F\u0635\u064F\u0648\u0644\u0650\u0647\u064E\u0627 } \u0642\u064E\u0627\u0644\u064E: \u0627\u0644\u0644\u0651\u0650\u064A\u0646\u064E\u0629\u064F \u0627\u0644\u0646\u0651\u064E\u062E\u0652\u0644\u064E\u0629\u064F { \u0648\u064E\u0644\u0650\u064A\u064F\u062E\u0652\u0632\u0650\u0649\u064E \u0671\u0644\u0652\u0641\u064E\u0640\u0670\u0633\u0650\u0642\u0650\u064A\u0646\u064E }\u060C \u0642\u064E\u0627\u0644\u064E: \u0627\u0633\u0652\u062A\u064E\u0646\u0652\u0632\u064E\u0644\u064F\u0648\u0647\u064F\u0645\u0652 \u0645\u0650\u0646\u0652 \u062D\u064F\u0635\u064F\u0648\u0646\u0650\u0647\u0650\u0645\u0652\u060C \u0642\u064E\u0627\u0644\u064E: \u0648\u064E\u0623\u064F\u0645\u0650\u0631\u064F\u0648\u0627 \u0628\u0650\u0642\u064E\u0637\u0652\u0639\u0650 \u0627\u0644\u0646\u0651\u064E\u062E\u0652\u0644\u0650\u060C \u0641\u064E\u062D\u064E\u0643\u064E\u0651 \u0641\u0650\u064A \u0635\u064F\u062F\u064F\u0648\u0631\u0650\u0647\u0650\u0645\u0652\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0627\u0644\u0652\u0645\u0633\u0652\u0644\u0650\u0645\u064F\u0648\u0646\u064E: \u0642\u064E\u062F\u0652 \u0642\u064E\u0637\u064E\u0639\u0652\u0646\u064E\u0627 \u0628\u064E\u0639\u0652\u0636\u0627\u064B \u0648\u064E\u062A\u064E\u0631\u064E\u0643\u0652\u0646\u064E\u0627 \u0628\u064E\u0639\u0652\u0636\u0627\u064B\u060C \u0641\u064E\u0644\u064E\u0646\u064E\u0633\u0652\u0623\u064E\u0644\u064E\u0646\u0651\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \uFDFA: \u0647\u064E\u0644\u0652 \u0644\u064E\u0646\u064E\u0627 \u0641\u0650\u064A\u0645\u064E\u0627 \u0642\u064E\u0637\u064E\u0639\u0652\u0646\u064E\u0627 \u0645\u0650\u0646\u0652 \u0623\u064E\u062C\u0652\u0631\u064D\u060C \u0648\u064E\u0647\u064E\u0644\u0652 \u0639\u064E\u0644\u064E\u064A\u0652\u0646\u064E\u0627 \u0641\u0650\u064A\u0645\u064E\u0627 \u062A\u064E\u0631\u064E\u0643\u0652\u0646\u064E\u0627 \u0645\u0650\u0646\u0652 \u0648\u0650\u0632\u0652\u0631\u064D\u060C \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u062A\u064E\u0639\u064E\u0627\u0644\u064E\u0649: { \u0645\u064E\u0627 \u0642\u064E\u0637\u064E\u0639\u0652\u062A\u064F\u0645 \u0645\u0651\u0650\u0646 \u0644\u0651\u0650\u064A\u0646\u064E\u0629\u064D \u0623\u064E\u0648\u0652 \u062A\u064E\u0631\u064E\u0643\u0652\u062A\u064F\u0645\u064F\u0648\u0647\u064E\u0627 \u0642\u064E\u0627\u0653\u0626\u0650\u0645\u064E\u0629\u064B \u0639\u064E\u0644\u064E\u0649\u0670\u0653 \u0623\u064F\u0635\u064F\u0648\u0644\u0650\u0647\u064E\u0627 } \u0627\u0644\u0622\u064A\u0629.",
            "fadl": "",
            "action": ""
        },
        "59_9": {
            "title": "\u0648\u064A\u0624\u062B\u0631\u0648\u0646 \u0639\u0644\u0649 \u0623\u0646\u0641\u0633\u0647\u0645 \u0648\u0644\u0648 \u0643\u0627\u0646 \u0628\u0647\u0645 \u062E\u0635\u0627\u0635\u0629",
            "sabab": "\u0646\u0632\u0644\u062A \u0641\u064A \u0623\u0628\u064A \u0637\u0644\u062D\u0629 \u0627\u0644\u0623\u0646\u0635\u0627\u0631\u064A \u0648\u0632\u0648\u062C\u062A\u0647\u060C \u0627\u0644\u0644\u0630\u064A\u0646 \u0623\u0637\u0641\u0622 \u0627\u0644\u0633\u0631\u0627\u062C \u0648\u0648\u0636\u0639\u0627 \u0637\u0639\u0627\u0645\u0647\u0645\u0627 \u0627\u0644\u0642\u0644\u064A\u0644 \u0644\u0636\u064A\u0641 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \uFDFA \u0648\u0628\u0627\u062A\u0627 \u062C\u0627\u0626\u0639\u064A\u0646.",
            "fadl": "\u0642\u0627\u0644 \u0644\u0647\u0645 \u0627\u0644\u0646\u0628\u064A \uFDFA: \u0644\u0642\u062F \u0639\u062C\u0628 \u0627\u0644\u0644\u0647 \u0645\u0646 \u0635\u0646\u064A\u0639\u0643\u0645\u0627 \u0628\u0636\u064A\u0641\u0643\u0645\u0627 \u0627\u0644\u0644\u064A\u0644\u0629.",
            "action": "\u0627\u0644\u0625\u064A\u062B\u0627\u0631 \u0645\u0646 \u0623\u0639\u0644\u0649 \u0645\u0631\u0627\u062A\u0628 \u0627\u0644\u0643\u0631\u0645. \u062C\u0631\u0651\u0628 \u0627\u0644\u064A\u0648\u0645 \u0623\u0646 \u062A\u064F\u0639\u0637\u064A \u0634\u064A\u0626\u0627\u064B \u062A\u062D\u0628\u0647 \u0644\u0645\u062D\u062A\u0627\u062C\u060C \u0648\u0631\u0627\u0642\u0628 \u0627\u0644\u0628\u0631\u0643\u0629 \u0627\u0644\u062A\u064A \u0633\u062A\u062D\u0644 \u0628\u0642\u0644\u0628\u0643."
        },
        "60_1": {
            "title": "\u0642\u0635\u0629 \u062D\u0627\u0637\u0628 \u0628\u0646 \u0623\u0628\u064A \u0628\u0644\u062A\u0639\u0629",
            "sabab": "\u0623\u0631\u0633\u0644 \u0627\u0644\u0635\u062D\u0627\u0628\u064A \u062D\u0627\u0637\u0628 \u0631\u0633\u0627\u0644\u0629 \u0633\u0631\u064A\u0629 \u0644\u0642\u0631\u064A\u0634 \u064A\u062E\u0628\u0631\u0647\u0645 \u0628\u062A\u062C\u0647\u064A\u0632 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0644\u0641\u062A\u062D \u0645\u0643\u0629 (\u062D\u0645\u0627\u064A\u0629 \u0644\u0623\u0647\u0644\u0647 \u0647\u0646\u0627\u0643)\u060C \u0641\u0646\u0632\u0644 \u0627\u0644\u0648\u062D\u064A \u064A\u0639\u0627\u062A\u0628\u0647\u060C \u0648\u0639\u0641\u0627 \u0639\u0646\u0647 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0644\u062D\u0636\u0648\u0631\u0647 \u0628\u062F\u0631\u0627\u064B.",
            "fadl": "",
            "action": "\u0627\u0644\u0648\u0644\u0627\u0621 \u0627\u0644\u062A\u0627\u0645 \u0644\u0644\u0647 \u0648\u0644\u0644\u0645\u0624\u0645\u0646\u064A\u0646 \u0641\u0648\u0642 \u0643\u0644 \u0627\u0639\u062A\u0628\u0627\u0631. \u0644\u0627 \u062A\u062C\u0639\u0644 \u0627\u0644\u062E\u0648\u0641 \u0639\u0644\u0649 \u0627\u0644\u0639\u0627\u0626\u0644\u0629 \u0623\u0648 \u0627\u0644\u0645\u0627\u0644 \u064A\u0628\u0631\u0631 \u0644\u0643 \u0627\u0644\u0648\u0642\u0648\u0641 \u0645\u0639 \u0627\u0644\u0628\u0627\u0637\u0644."
        },
        "60_8": {
            "title": "\u0644\u064E\u0627 \u064A\u064E\u0646\u0652\u0647\u064E\u0627\u0643\u064F\u0645\u064F \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0639\u064E\u0646\u0650 \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0644\u064E\u0645\u0652 \u064A\u064F\u0642\u064E\u0627\u062A\u0650\u0644\u064F\u0648\u0643\u064F\u0645\u0652 \u0641\u0650\u064A \u0627\u0644\u062F\u0651\u0650\u064A\u0646\u0650 \u0648\u064E\u0644\u064E\u0645\u0652 \u064A\u064F\u062E\u0652\u0631\u0650\u062C\u064F\u0648\u0643\u064F\u0645\u0652 \u0645\u0650\u0646\u0652 \u062F\u0650\u064A\u064E\u0627\u0631\u0650\u0643\u064F\u0645\u0652 \u0623\u064E\u0646\u0652 \u062A\u064E\u0628\u064E\u0631\u0651\u064F\u0648\u0647\u064F\u0645\u0652 \u0648\u064E\u062A\u064F\u0642\u0652\u0633\u0650\u0637\u064F\u0648\u0627 \u0625\u0650\u0644\u064E\u064A\u0652\u0647\u0650\u0645\u0652 \u06DA \u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064E \u064A\u064F\u062D\u0650\u0628\u0651\u064F \u0627\u0644\u0652\u0645\u064F\u0642\u0652\u0633\u0650\u0637\u0650\u064A\u0646\u064E",
            "sabab": "\u0639\u064E\u0646\u0652 \u0639\u064E\u0628\u0652\u062F\u0650 \u0627\u0644\u0644\u0647\u0650 \u0628\u0652\u0646\u0650 \u0627\u0644\u0632\u0651\u064F\u0628\u064E\u064A\u0652\u0631\u0650 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u0642\u064E\u0627\u0644\u064E: \u0642\u064E\u062F\u0650\u0645\u064E\u062A\u0652 \u0642\u064F\u062A\u064E\u064A\u0652\u0644\u064E\u0629\u064F \u0627\u0628\u0652\u0646\u064E\u0629\u064F \u0639\u064E\u0628\u0652\u062F\u0650 \u0627\u0644\u0652\u0639\u064F\u0632\u0651\u064E\u0649 \u0628\u0652\u0646\u0650 \u0639\u064E\u0628\u0652\u062F\u0650 \u0623\u064E\u0633\u0652\u0639\u064E\u062F\u064E \u0645\u0650\u0646\u0652 \u0628\u064E\u0646\u0650\u064A \u0645\u064E\u0627\u0644\u0650\u0643\u0650 \u0628\u0652\u0646\u0650 \u062D\u064E\u0633\u064E\u0644\u064D \u0639\u064E\u0644\u064E\u0649 \u0627\u0628\u0652\u0646\u064E\u062A\u0650\u0647\u064E\u0627 \u0623\u064E\u0633\u0652\u0645\u064E\u0627\u0621\u064E \u0627\u0628\u0652\u0646\u064E\u0629\u0650 \u0623\u064E\u0628\u0650\u064A \u0628\u064E\u0643\u0652\u0631\u064D \u0628\u0650\u0647\u064E\u062F\u064E\u0627\u064A\u064E\u0627\u060C \u0636\u0650\u0628\u064E\u0627\u0628\u064D \u0648\u064E\u0623\u064E\u0642\u0650\u0637\u064D \u0648\u064E\u0633\u064E\u0645\u0652\u0646\u064D\u060C \u0648\u064E\u0647\u0650\u064A\u064E \u0645\u064F\u0634\u0652\u0631\u0650\u0643\u064E\u0629\u064C\u060C \u0641\u064E\u0623\u064E\u0628\u064E\u062A\u0652 \u0623\u064E\u0633\u0652\u0645\u064E\u0627\u0621\u064F \u0623\u064E\u0646\u0652 \u062A\u064E\u0642\u0652\u0628\u064E\u0644\u064E \u0647\u064E\u062F\u0650\u064A\u0651\u064E\u062A\u064E\u0647\u064E\u0627 \u0648\u064E\u062A\u064F\u062F\u0652\u062E\u0650\u0644\u064E\u0647\u064E\u0627 \u0628\u064E\u064A\u0652\u062A\u064E\u0647\u064E\u0627\u060C \u0641\u064E\u0633\u064E\u0623\u064E\u0644\u064E\u062A\u0652 \u0639\u064E\u0627\u0626\u0650\u0634\u064E\u0629\u064F \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064E \uFDFA\u060C \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0639\u0632 \u0648 \u062C\u0644: { \u0644\u0651\u064E\u0627 \u064A\u064E\u0646\u0652\u0647\u064E\u0649\u0670\u0643\u064F\u0645\u064F \u0671\u0644\u0644\u0651\u064E\u0647\u064F \u0639\u064E\u0646\u0650 \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0644\u064E\u0645\u0652 \u064A\u064F\u0642\u064E\u0640\u0670\u062A\u0650\u0644\u064F\u0648\u0643\u064F\u0645\u0652 \u0641\u0650\u0649 \u0671\u0644\u062F\u0651\u0650\u064A\u0646\u0650 } \u0625\u0650\u0644\u064E\u0649 \u0622\u062E\u0650\u0631\u0650 \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u0650\u060C \u0641\u064E\u0623\u064E\u0645\u064E\u0631\u064E\u0647\u064E\u0627 \u0623\u064E\u0646\u0652 \u062A\u064E\u0642\u0652\u0628\u064E\u0644\u064E \u0647\u064E\u062F\u0650\u064A\u0651\u064E\u062A\u064E\u0647\u064E\u0627\u060C \u0648\u064E\u0623\u064E\u0646\u0652 \u062A\u064F\u062F\u0652\u062E\u0650\u0644\u064E\u0647\u064E\u0627 \u0628\u064E\u064A\u0652\u062A\u064E\u0647\u064E\u0627.",
            "fadl": "",
            "action": ""
        },
        "60_10": {
            "title": "\u064A\u064E\u0627 \u0623\u064E\u064A\u0651\u064F\u0647\u064E\u0627 \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0622\u0645\u064E\u0646\u064F\u0648\u0627 \u0625\u0650\u0630\u064E\u0627 \u062C\u064E\u0627\u0621\u064E\u0643\u064F\u0645\u064F \u0627\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u064E\u0627\u062A\u064F \u0645\u064F\u0647\u064E\u0627\u062C\u0650\u0631\u064E\u0627\u062A\u064D \u0641\u064E\u0627\u0645\u0652\u062A\u064E\u062D\u0650\u0646\u064F\u0648\u0647\u064F\u0646\u0651\u064E \u06D6 \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0623\u064E\u0639\u0652\u0644\u064E\u0645\u064F \u0628\u0650\u0625\u0650\u064A\u0645\u064E\u0627\u0646\u0650\u0647\u0650\u0646\u0651\u064E \u06D6 \u0641\u064E\u0625\u0650\u0646\u0652 \u0639\u064E\u0644\u0650\u0645\u0652\u062A\u064F\u0645\u064F\u0648\u0647\u064F\u0646\u0651\u064E \u0645\u064F\u0624\u0652\u0645\u0650\u0646\u064E\u0627\u062A\u064D \u0641\u064E\u0644\u064E\u0627 \u062A\u064E\u0631\u0652\u062C\u0650\u0639\u064F\u0648\u0647\u064F\u0646\u0651\u064E \u0625\u0650\u0644\u064E\u0649 \u0627\u0644\u0652\u0643\u064F\u0641\u0651\u064E\u0627\u0631\u0650 \u06D6 \u0644\u064E\u0627 \u0647\u064F\u0646\u0651\u064E \u062D\u0650\u0644\u0651\u064C \u0644\u064E\u0647\u064F\u0645\u0652 \u0648\u064E\u0644\u064E\u0627 \u0647\u064F\u0645\u0652 \u064A\u064E\u062D\u0650\u0644\u0651\u064F\u0648\u0646\u064E \u0644\u064E\u0647\u064F\u0646\u0651\u064E \u06D6 \u0648\u064E\u0622\u062A\u064F\u0648\u0647\u064F\u0645\u0652 \u0645\u064E\u0627 \u0623\u064E\u0646\u0652\u0641\u064E\u0642\u064F\u0648\u0627 \u06DA \u0648\u064E\u0644\u064E\u0627 \u062C\u064F\u0646\u064E\u0627\u062D\u064E \u0639\u064E\u0644\u064E\u064A\u0652\u0643\u064F\u0645\u0652 \u0623\u064E\u0646\u0652 \u062A\u064E\u0646\u0652\u0643\u0650\u062D\u064F\u0648\u0647\u064F\u0646\u0651\u064E \u0625\u0650\u0630\u064E\u0627 \u0622\u062A\u064E\u064A\u0652\u062A\u064F\u0645\u064F\u0648\u0647\u064F\u0646\u0651\u064E \u0623\u064F\u062C\u064F\u0648\u0631\u064E\u0647\u064F\u0646\u0651\u064E \u06DA \u0648\u064E\u0644\u064E\u0627 \u062A\u064F\u0645\u0652\u0633\u0650\u0643\u064F\u0648\u0627 \u0628\u0650\u0639\u0650\u0635\u064E\u0645\u0650 \u0627\u0644\u0652\u0643\u064E\u0648\u064E\u0627\u0641\u0650\u0631\u0650 \u0648\u064E\u0627\u0633\u0652\u0623\u064E\u0644\u064F\u0648\u0627 \u0645\u064E\u0627 \u0623\u064E\u0646\u0652\u0641\u064E\u0642\u0652\u062A\u064F\u0645\u0652 \u0648\u064E\u0644\u0652\u064A\u064E\u0633\u0652\u0623\u064E\u0644\u064F\u0648\u0627 \u0645\u064E\u0627 \u0623\u064E\u0646\u0652\u0641\u064E\u0642\u064F\u0648\u0627 \u06DA \u0630\u064E\u0670\u0644\u0650\u0643\u064F\u0645\u0652 \u062D\u064F\u0643\u0652\u0645\u064F \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u06D6 \u064A\u064E\u062D\u0652\u0643\u064F\u0645\u064F \u0628\u064E\u064A\u0652\u0646\u064E\u0643\u064F\u0645\u0652 \u06DA \u0648\u064E\u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0639\u064E\u0644\u0650\u064A\u0645\u064C \u062D\u064E\u0643\u0650\u064A\u0645\u064C",
            "sabab": "\u0639\u064E\u0646\u0652 \u0645\u064E\u0631\u0652\u0648\u064E\u0627\u0646\u064E \u0648\u064E\u0627\u0644\u0652\u0645\u0650\u0633\u0652\u0648\u064E\u0631\u064E \u0628\u0652\u0646\u064E \u0645\u064E\u062E\u0652\u0631\u064E\u0645\u064E\u0629\u064E \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u064A\u064F\u062E\u0652\u0628\u0650\u0631\u064E\u0627\u0646\u0650 \u0639\u064E\u0646\u0652 \u0623\u064E\u0635\u0652\u062D\u064E\u0627\u0628\u0650 \u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0642\u064E\u0627\u0644\u064E: \u0644\u064E\u0645\u0651\u064E\u0627 \u0643\u064E\u0627\u062A\u064E\u0628\u064E \u0633\u064F\u0647\u064E\u064A\u0652\u0644\u064F \u0628\u0652\u0646\u064F \u0639\u064E\u0645\u0652\u0631\u064D\u0648 \u064A\u064E\u0648\u0652\u0645\u064E\u0626\u0650\u0630\u064D\u060C \u0643\u064E\u0627\u0646\u064E \u0641\u0650\u064A\u0645\u064E\u0627 \u0627\u0634\u0652\u062A\u064E\u0631\u064E\u0637\u064E \u0633\u064F\u0647\u064E\u064A\u0652\u0644\u064F \u0628\u0652\u0646\u064F \u0639\u064E\u0645\u0652\u0631\u064D\u0648 \u0639\u064E\u0644\u064E\u0649 \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u0650 \uFDFA\u060C \u0623\u064E\u0646\u0651\u064E\u0647\u064F \u0644\u064E\u0627 \u064A\u064E\u0623\u0652\u062A\u0650\u064A\u0643\u064E \u0645\u0650\u0646\u0651\u064E\u0627 \u0623\u064E\u062D\u064E\u062F\u064C\u060C \u0648\u064E\u0625\u0650\u0646\u0652 \u0643\u064E\u0627\u0646\u064E \u0639\u064E\u0644\u064E\u0649 \u062F\u0650\u064A\u0646\u0650\u0643\u064E \u0625\u0650\u0644\u0651\u064E\u0627 \u0631\u064E\u062F\u064E\u062F\u0652\u062A\u064E\u0647\u064F \u0625\u0650\u0644\u064E\u064A\u0652\u0646\u064E\u0627\u060C \u0648\u064E\u062E\u064E\u0644\u0651\u064E\u064A\u0652\u062A\u064E \u0628\u064E\u064A\u0652\u0646\u064E\u0646\u064E\u0627 \u0648\u064E\u0628\u064E\u064A\u0652\u0646\u064E\u0647\u064F\u060C \u0641\u064E\u0643\u064E\u0631\u0650\u0647\u064E \u0627\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u064F\u0648\u0646\u064E \u0630\u064E\u0644\u0650\u0643\u064E \u0648\u064E\u0627\u0645\u0652\u062A\u064E\u0639\u064E\u0636\u064F\u0648\u0627 \u0645\u0650\u0646\u0652\u0647\u064F\u060C \u0648\u064E\u0623\u064E\u0628\u064E\u0649 \u0633\u064F\u0647\u064E\u064A\u0652\u0644\u064C \u0625\u0650\u0644\u0651\u064E\u0627 \u0630\u064E\u0644\u0650\u0643\u064E\u060C \u0641\u064E\u0643\u064E\u0627\u062A\u064E\u0628\u064E\u0647\u064F \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064F \uFDFA \u0639\u064E\u0644\u064E\u0649 \u0630\u064E\u0644\u0650\u0643\u064E\u060C \u0641\u064E\u0631\u064E\u062F\u0651\u064E \u064A\u064E\u0648\u0652\u0645\u064E\u0626\u0650\u0630\u064D \u0623\u064E\u0628\u064E\u0627 \u062C\u064E\u0646\u0652\u062F\u064E\u0644\u064D \u0625\u0650\u0644\u064E\u0649 \u0623\u064E\u0628\u0650\u064A\u0647\u0650 \u0633\u064F\u0647\u064E\u064A\u0652\u0644\u0650 \u0628\u0652\u0646\u0650 \u0639\u064E\u0645\u0652\u0631\u064D\u0648\u060C \u0648\u064E\u0644\u064E\u0645\u0652 \u064A\u064E\u0623\u0652\u062A\u0650\u0647\u0650 \u0623\u064E\u062D\u064E\u062F\u064C \u0645\u0650\u0646\u0652 \u0627\u0644\u0631\u0651\u0650\u062C\u064E\u0627\u0644\u0650 \u0625\u0650\u0644\u0651\u064E\u0627 \u0631\u064E\u062F\u0651\u064E\u0647\u064F \u0641\u0650\u064A \u062A\u0650\u0644\u0652\u0643\u064E \u0627\u0644\u0652\u0645\u064F\u062F\u0651\u064E\u0629\u0650\u060C \u0648\u064E\u0625\u0650\u0646\u0652 \u0643\u064E\u0627\u0646\u064E \u0645\u064F\u0633\u0652\u0644\u0650\u0645\u0627\u064B\u060C \u0648\u064E\u062C\u064E\u0627\u0621\u064E\u062A\u0650 \u0627\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u064E\u0627\u062A\u064F \u0645\u064F\u0647\u064E\u0627\u062C\u0650\u0631\u064E\u0627\u062A\u064D\u060C \u0648\u064E\u0643\u064E\u0627\u0646\u064E\u062A\u0652 \u0623\u064F\u0645\u0651\u064F \u0643\u064F\u0644\u0652\u062B\u064F\u0648\u0645\u064D \u0628\u0650\u0646\u0652\u062A\u064F \u0639\u064F\u0642\u0652\u0628\u064E\u0629\u064E \u0628\u0652\u0646\u0650 \u0623\u064E\u0628\u0650\u064A \u0645\u064F\u0639\u064E\u064A\u0652\u0637\u064D \u0645\u0650\u0645\u0651\u064E\u0646\u0652 \u062E\u064E\u0631\u064E\u062C\u064E \u0625\u0650\u0644\u064E\u0649 \u0631\u064E\u0633\u064F\u0648\u0644\u0650 \u064A\u064E\u0648\u0652\u0645\u064E\u0626\u0650\u0630\u064D \u0648\u064E\u0647\u0650\u064A\u064E \u0639\u064E\u0627\u062A\u0650\u0642\u064C\u060C \u0641\u064E\u062C\u064E\u0627\u0621\u064E \u0623\u064E\u0647\u0652\u0644\u064F\u0647\u064E\u0627 \u064A\u064E\u0633\u0652\u0623\u064E\u0644\u064F\u0648\u0646\u064E \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064E \uFDFA \u0623\u064E\u0646\u0652 \u064A\u064E\u0631\u0652\u062C\u0650\u0639\u064E\u0647\u064E\u0627 \u0625\u0650\u0644\u064E\u064A\u0652\u0647\u0650\u0645\u0652\u060C \u0644\u0650\u0645\u064E\u0627 \u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0641\u0650\u064A\u0647\u0650\u0646\u0651\u064E: { \u0625\u0650\u0630\u064E\u0627 \u062C\u064E\u0627\u0653\u0621\u064E\u0643\u064F\u0645\u064F \u0671\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u064E\u0640\u0670\u062A\u064F \u0645\u064F\u0647\u064E\u0640\u0670\u062C\u0650\u0631\u064E\u0670\u062A\u064D\u06E2 \u0641\u064E\u0671\u0645\u0652\u062A\u064E\u062D\u0650\u0646\u064F\u0648\u0647\u064F\u0646\u0651\u064E \u06D6 \u0671\u0644\u0644\u0651\u064E\u0647\u064F \u0623\u064E\u0639\u0652\u0644\u064E\u0645\u064F \u0628\u0650\u0625\u0650\u064A\u0645\u064E\u0640\u0670\u0646\u0650\u0647\u0650\u0646\u0651\u064E \u06D6 } \u0625\u0650\u0644\u064E\u0649 \u0642\u064E\u0648\u0652\u0644\u0650\u0647\u0650 { \u0648\u064E\u0644\u064E\u0627 \u0647\u064F\u0645\u0652 \u064A\u064E\u062D\u0650\u0644\u0651\u064F\u0648\u0646\u064E \u0644\u064E\u0647\u064F\u0646\u0651\u064E \u06D6 }\u060C \u0642\u064E\u0627\u0644\u064E \u0639\u064F\u0631\u0652\u0648\u064E\u0629\u064F: \u0641\u064E\u0623\u064E\u062E\u0652\u0628\u064E\u0631\u064E\u062A\u0652\u0646\u0650\u064A \u0639\u064E\u0627\u0626\u0650\u0634\u064E\u0629\u064F \u0623\u064E\u0646\u0651\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0643\u064E\u0627\u0646\u064E \u064A\u064E\u0645\u0652\u062A\u064E\u062D\u0650\u0646\u064F\u0647\u064F\u0646\u0651\u064E \u0628\u0650\u0647\u064E\u0630\u0650\u0647\u0650 \u0627\u0644\u0652\u0622\u064A\u064E\u0629\u0650: { \u064A\u064E\u0640\u0670\u0653\u0623\u064E\u064A\u0651\u064F\u0647\u064E\u0627 \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0621\u064E\u0627\u0645\u064E\u0646\u064F\u0648\u0653\u0627\u06DF \u0625\u0650\u0630\u064E\u0627 \u062C\u064E\u0627\u0653\u0621\u064E\u0643\u064F\u0645\u064F \u0671\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u064E\u0640\u0670\u062A\u064F \u0645\u064F\u0647\u064E\u0640\u0670\u062C\u0650\u0631\u064E\u0670\u062A\u064D\u06E2 \u0641\u064E\u0671\u0645\u0652\u062A\u064E\u062D\u0650\u0646\u064F\u0648\u0647\u064F\u0646\u0651\u064E \u06D6 } \u0625\u0650\u0644\u064E\u0649 { \u063A\u064E\u0641\u064F\u0648\u0631\u064C \u0631\u0651\u064E\u062D\u0650\u064A\u0645\u064C }\u060C \u0642\u064E\u0627\u0644\u064E \u0639\u064F\u0631\u0652\u0648\u064E\u0629\u064F: \u0642\u064E\u0627\u0644\u064E\u062A\u0652 \u0639\u064E\u0627\u0626\u0650\u0634\u064E\u0629\u064F: \u0641\u064E\u0645\u064E\u0646\u0652 \u0623\u064E\u0642\u064E\u0631\u0651\u064E \u0628\u0650\u0647\u064E\u0630\u064E\u0627 \u0627\u0644\u0634\u0651\u064E\u0631\u0652\u0637\u0650 \u0645\u0650\u0646\u0652\u0647\u064F\u0646\u0651\u064E \u0642\u064E\u0627\u0644\u064E \u0644\u064E\u0647\u064E\u0627 \u0631\u064E\u0633\u064F\u0648\u0644 \u0627\u0644\u0644\u0647\u0650 \uFDFA: \xab \u0642\u064E\u062F\u0652 \u0628\u064E\u0627\u064A\u064E\u0639\u0652\u062A\u064F\u0643\u0650 \xbb\u060C \u0643\u064E\u0644\u064E\u0627\u0645\u0627\u064B \u064A\u064F\u0643\u064E\u0644\u0651\u0650\u0645\u064F\u0647\u064E\u0627 \u0628\u0650\u0647\u0650\u060C \u0648\u064E\u0627\u0644\u0644\u0647\u0650 \u0645\u064E\u0627 \u0645\u064E\u0633\u0651\u064E\u062A\u0652 \u064A\u064E\u062F\u064F\u0647\u064F \u064A\u064E\u062F\u064E \u0627\u0645\u0652\u0631\u064E\u0623\u064E\u0629\u064D \u0642\u064E\u0637\u0651\u064F \u0641\u0650\u064A \u0627\u0644\u0652\u0645\u064F\u0628\u064E\u0627\u064A\u064E\u0639\u064E\u0629\u0650 \u0648\u064E\u0645\u064E\u0627 \u0628\u064E\u0627\u064A\u064E\u0639\u064E\u0647\u064F\u0646\u0651\u064E \u0625\u0650\u0644\u0651\u064E\u0627 \u0628\u0650\u0642\u064E\u0648\u0652\u0644\u0650\u0647\u0650.",
            "fadl": "",
            "action": ""
        },
        "61_1": {
            "title": "\u0628\u0650\u0633\u0652\u0645\u0650 \u0627\u0644\u0644\u0651\u064E\u0647\u0650 \u0627\u0644\u0631\u0651\u064E\u062D\u0652\u0645\u064E\u0670\u0646\u0650 \u0627\u0644\u0631\u0651\u064E\u062D\u0650\u064A\u0645\u0650 \u0633\u064E\u0628\u0651\u064E\u062D\u064E \u0644\u0650\u0644\u0651\u064E\u0647\u0650 \u0645\u064E\u0627 \u0641\u0650\u064A \u0627\u0644\u0633\u0651\u064E\u0645\u064E\u0627\u0648\u064E\u0627\u062A\u0650 \u0648\u064E\u0645\u064E\u0627 \u0641\u0650\u064A \u0627\u0644\u0652\u0623\u064E\u0631\u0652\u0636\u0650 \u06D6 \u0648\u064E\u0647\u064F\u0648\u064E \u0627\u0644\u0652\u0639\u064E\u0632\u0650\u064A\u0632\u064F \u0627\u0644\u0652\u062D\u064E\u0643\u0650\u064A\u0645\u064F",
            "sabab": "\u0639\u0646 \u0627\u0628\u0646 \u0639\u0628\u0627\u0633 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u0641\u064A \u0642\u0648\u0644\u0647 \u062A\u0639\u0627\u0644\u0649: { \u064A\u064E\u0640\u0670\u0653\u0623\u064E\u064A\u0651\u064F\u0647\u064E\u0627 \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0621\u064E\u0627\u0645\u064E\u0646\u064F\u0648\u0627\u06DF \u0644\u0650\u0645\u064E \u062A\u064E\u0642\u064F\u0648\u0644\u064F\u0648\u0646\u064E \u0645\u064E\u0627 \u0644\u064E\u0627 \u062A\u064E\u0641\u0652\u0639\u064E\u0644\u064F\u0648\u0646\u064E \uFD3F\u0662\uFD3E } \u0642\u0627\u0644: \u0643\u0627\u0646 \u0646\u0627\u0633 \u0645\u0646 \u0627\u0644\u0645\u0624\u0645\u0646\u064A\u0646 \u0642\u0628\u0644 \u0623\u0646 \u064A\u0641\u0631\u0636 \u0627\u0644\u062C\u0647\u0627\u062F\u060C \u064A\u0642\u0648\u0644\u0648\u0646: \u0644\u0648\u062F\u062F\u0646\u0627 \u0623\u0646 \u0627\u0644\u0644\u0647 \u0639\u0632 \u0648 \u062C\u0644 \u062F\u0644\u0646\u0627 \u0639\u0644\u0649 \u0623\u062D\u0628 \u0627\u0644\u0623\u0639\u0645\u0627\u0644 \u0625\u0644\u064A\u0647 \u0641\u0646\u0639\u0645\u0644 \u0628\u0647\u060C \u0641\u0623\u062E\u0628\u0631 \u0627\u0644\u0644\u0647 \u0646\u0628\u064A\u0647 \u0623\u0646 \u0623\u062D\u0628 \u0627\u0644\u0623\u0639\u0645\u0627\u0644\u060C \u0625\u064A\u0645\u0627\u0646 \u0628\u0647 \u0644\u0627 \u0634\u0643 \u0641\u064A\u0647\u060C \u0648\u062C\u0647\u0627\u062F \u0623\u0647\u0644 \u0645\u0639\u0635\u064A\u062A\u0647 \u0627\u0644\u0630\u064A\u0646 \u062E\u0627\u0644\u0641\u0648\u0627 \u0627\u0644\u0625\u064A\u0645\u0627\u0646\u060C \u0648\u0644\u0645 \u064A\u0642\u0631\u0648\u0627 \u0628\u0647\u060C \u0641\u0644\u0645\u0627 \u0646\u0632\u0644 \u0627\u0644\u062C\u0647\u0627\u062F\u060C \u0643\u0631\u0647 \u0630\u0644\u0643 \u0646\u0627\u0633 \u0645\u0646 \u0627\u0644\u0645\u0624\u0645\u0646\u064A\u0646\u060C \u0648\u0634\u0642 \u0639\u0644\u064A\u0647\u0645 \u0623\u0645\u0631\u0647 \u0641\u0642\u0627\u0644 \u0627\u0644\u0644\u0647 \u0639\u0632 \u0648 \u062C\u0644: { \u064A\u064E\u0640\u0670\u0653\u0623\u064E\u064A\u0651\u064F\u0647\u064E\u0627 \u0671\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0621\u064E\u0627\u0645\u064E\u0646\u064F\u0648\u0627\u06DF \u0644\u0650\u0645\u064E \u062A\u064E\u0642\u064F\u0648\u0644\u064F\u0648\u0646\u064E \u0645\u064E\u0627 \u0644\u064E\u0627 \u062A\u064E\u0641\u0652\u0639\u064E\u0644\u064F\u0648\u0646\u064E \uFD3F\u0662\uFD3E }.",
            "fadl": "",
            "action": ""
        },
        "61_2": {
            "title": "\u064A\u064E\u0627 \u0623\u064E\u064A\u0651\u064F\u0647\u064E\u0627 \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u0622\u0645\u064E\u0646\u064F\u0648\u0627 \u0644\u0650\u0645\u064E \u062A\u064E\u0642\u064F\u0648\u0644\u064F\u0648\u0646\u064E \u0645\u064E\u0627 \u0644\u064E\u0627 \u062A\u064E\u0641\u0652\u0639\u064E\u0644\u064F\u0648\u0646\u064E",
