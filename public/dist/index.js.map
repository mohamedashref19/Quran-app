        "63_4": {
            "title": "\u06DE \u0648\u064E\u0625\u0650\u0630\u064E\u0627 \u0631\u064E\u0623\u064E\u064A\u0652\u062A\u064E\u0647\u064F\u0645\u0652 \u062A\u064F\u0639\u0652\u062C\u0650\u0628\u064F\u0643\u064E \u0623\u064E\u062C\u0652\u0633\u064E\u0627\u0645\u064F\u0647\u064F\u0645\u0652 \u06D6 \u0648\u064E\u0625\u0650\u0646\u0652 \u064A\u064E\u0642\u064F\u0648\u0644\u064F\u0648\u0627 \u062A\u064E\u0633\u0652\u0645\u064E\u0639\u0652 \u0644\u0650\u0642\u064E\u0648\u0652\u0644\u0650\u0647\u0650\u0645\u0652 \u06D6 \u0643\u064E\u0623\u064E\u0646\u0651\u064E\u0647\u064F\u0645\u0652 \u062E\u064F\u0634\u064F\u0628\u064C \u0645\u064F\u0633\u064E\u0646\u0651\u064E\u062F\u064E\u0629\u064C \u06D6 \u064A\u064E\u062D\u0652\u0633\u064E\u0628\u064F\u0648\u0646\u064E \u0643\u064F\u0644\u0651\u064E \u0635\u064E\u064A\u0652\u062D\u064E\u0629\u064D \u0639\u064E\u0644\u064E\u064A\u0652\u0647\u0650\u0645\u0652 \u06DA \u0647\u064F\u0645\u064F \u0627\u0644\u0652\u0639\u064E\u062F\u064F\u0648\u0651\u064F \u0641\u064E\u0627\u062D\u0652\u0630\u064E\u0631\u0652\u0647\u064F\u0645\u0652 \u06DA \u0642\u064E\u0627\u062A\u064E\u0644\u064E\u0647\u064F\u0645\u064F \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u06D6 \u0623\u064E\u0646\u0651\u064E\u0649\u0670 \u064A\u064F\u0624\u0652\u0641\u064E\u0643\u064F\u0648\u0646\u064E",
