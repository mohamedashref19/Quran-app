            },
            {
                text: "\u0623\u064E\u0639\u064F\u0648\u0630\u064F \u0628\u0650\u0643\u064E\u0644\u0650\u0645\u064E\u0627\u062A\u0650 \u0627\u0644\u0644\u064E\u0651\u0647\u0650 \u0627\u0644\u062A\u064E\u0651\u0627\u0645\u064E\u0651\u0627\u062A\u0650 \u0645\u0650\u0646\u0652 \u0634\u064E\u0631\u0650\u0651 \u0645\u064E\u0627 \u062E\u064E\u0644\u064E\u0642\u064E",
