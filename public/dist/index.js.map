            title: "\u0623\u0645 \u0627\u0644\u0645\u0624\u0645\u0646\u064A\u0646 \u0648\u0639\u0627\u0644\u0645\u0629 \u0627\u0644\u0635\u062D\u0627\u0628\u0629",
            story: "\u0632\u0648\u062C \u0627\u0644\u0646\u0628\u064A \uFDFA \u0648\u0627\u0628\u0646\u0629 \u0627\u0644\u0635\u062F\u064A\u0642. \u0623\u062D\u0641\u0638 \u0627\u0644\u0646\u0633\u0627\u0621 \u0648\u0623\u0641\u0642\u0647\u0647\u0646\u060C \u0631\u0648\u062A \u0623\u0643\u062B\u0631 \u0645\u0646 \u0623\u0644\u0641\u064A\u0646 \u062D\u062F\u064A\u062B. \u0643\u0627\u0646\u062A \u0645\u0631\u062C\u0639\u0627\u064B \u0641\u064A \u0627\u0644\u0641\u062A\u0648\u0649 \u0648\u0627\u0644\u0637\u0628 \u0648\u0627\u0644\u0634\u0639\u0631. \u0628\u0631\u0651\u0623\u0647\u0627 \u0627\u0644\u0644\u0647 \u0645\u0646 \u062D\u0627\u062F\u062B\u0629 \u0627\u0644\u0625\u0641\u0643 \u0628\u0622\u064A\u0627\u062A \u062A\u064F\u062A\u0644\u0649 \u0625\u0644\u0649 \u064A\u0648\u0645 \u0627\u0644\u0642\u064A\u0627\u0645\u0629.",
            lessons: "\u0627\u0644\u0639\u0644\u0645 \u0648\u0627\u0644\u0641\u0642\u0647 \u0644\u064A\u0633 \u062D\u0643\u0631\u0627\u064B \u0639\u0644\u0649 \u0627\u0644\u0631\u062C\u0627\u0644. \u0627\u0644\u0635\u0628\u0631 \u0639\u0644\u0649 \u0627\u0644\u0627\u0628\u062A\u0644\u0627\u0621 \u0648\u0627\u0644\u062B\u0642\u0629 \u0628\u0627\u0644\u0644\u0647 \u064A\u0639\u0642\u0628\u0647\u0645\u0627 \u0627\u0644\u0628\u0631\u0627\u0621\u0629 \u0648\u0627\u0644\u0641\u0631\u062C.",
            category_tag: "\u0623\u0645\u0647\u0627\u062A \u0627\u0644\u0645\u0624\u0645\u0646\u064A\u0646"
