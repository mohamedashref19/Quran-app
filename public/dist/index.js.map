        "5_47": {
            "title": "\u0648\u064E\u0644\u0652\u064A\u064E\u062D\u0652\u0643\u064F\u0645\u0652 \u0623\u064E\u0647\u0652\u0644\u064F \u0627\u0644\u0652\u0625\u0650\u0646\u0652\u062C\u0650\u064A\u0644\u0650 \u0628\u0650\u0645\u064E\u0627 \u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0641\u0650\u064A\u0647\u0650 \u06DA \u0648\u064E\u0645\u064E\u0646\u0652 \u0644\u064E\u0645\u0652 \u064A\u064E\u062D\u0652\u0643\u064F\u0645\u0652 \u0628\u0650\u0645\u064E\u0627 \u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0651\u064E\u0647\u064F \u0641\u064E\u0623\u064F\u0648\u0644\u064E\u0670\u0626\u0650\u0643\u064E \u0647\u064F\u0645\u064F \u0627\u0644\u0652\u0641\u064E\u0627\u0633\u0650\u0642\u064F\u0648\u0646\u064E",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 44 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
