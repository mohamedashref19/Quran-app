        "24_23": {
            "title": "\u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0651\u064E\u0630\u0650\u064A\u0646\u064E \u064A\u064E\u0631\u0652\u0645\u064F\u0648\u0646\u064E \u0627\u0644\u0652\u0645\u064F\u062D\u0652\u0635\u064E\u0646\u064E\u0627\u062A\u0650 \u0627\u0644\u0652\u063A\u064E\u0627\u0641\u0650\u0644\u064E\u0627\u062A\u0650 \u0627\u0644\u0652\u0645\u064F\u0624\u0652\u0645\u0650\u0646\u064E\u0627\u062A\u0650 \u0644\u064F\u0639\u0650\u0646\u064F\u0648\u0627 \u0641\u0650\u064A \u0627\u0644\u062F\u0651\u064F\u0646\u0652\u064A\u064E\u0627 \u0648\u064E\u0627\u0644\u0652\u0622\u062E\u0650\u0631\u064E\u0629\u0650 \u0648\u064E\u0644\u064E\u0647\u064F\u0645\u0652 \u0639\u064E\u0630\u064E\u0627\u0628\u064C \u0639\u064E\u0638\u0650\u064A\u0645\u064C",
            "sabab": "(\u062A\u0627\u0628\u0639 \u0644\u0633\u0628\u0628 \u0646\u0632\u0648\u0644 \u0627\u0644\u0622\u064A\u0629 11 \u0645\u0646 \u0647\u0630\u0647 \u0627\u0644\u0633\u0648\u0631\u0629)",
