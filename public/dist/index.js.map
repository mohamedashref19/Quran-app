        "75_34": {
            "title": "\u0623\u064E\u0648\u0652\u0644\u064E\u0649\u0670 \u0644\u064E\u0643\u064E \u0641\u064E\u0623\u064E\u0648\u0652\u0644\u064E\u0649\u0670",
            "sabab": "\u0639\u0646 \u0633\u0639\u064A\u062F \u0628\u0646 \u062C\u0628\u064A\u0631 \u0631\u062D\u0645\u0647 \u0627\u0644\u0644\u0647 \u0642\u0627\u0644: \u0642\u0644\u062A: \u0644\u0627\u0628\u0646 \u0639\u0628\u0627\u0633 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627. { \u0623\u064E\u0648\u0652\u0644\u064E\u0649\u0670 \u0644\u064E\u0643\u064E \u0641\u064E\u0623\u064E\u0648\u0652\u0644\u064E\u0649\u0670 \uFD3F\u0663\u0664\uFD3E \u062B\u064F\u0645\u0651\u064E \u0623\u064E\u0648\u0652\u0644\u064E\u0649\u0670 \u0644\u064E\u0643\u064E \u0641\u064E\u0623\u064E\u0648\u0652\u0644\u064E\u0649\u0670\u0653 \uFD3F\u0663\u0665\uFD3E }\u060C \u0642\u0627\u0644: \u0642\u0627\u0644\u0647 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \uFDFA \u0644\u0623\u0628\u064A \u062C\u0647\u0644\u060C \u062B\u0645 \u0623\u0646\u0632\u0644\u0647 \u0627\u0644\u0644\u0647 \u0639\u0632 \u0648 \u062C\u0644.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0639\u0646 \u0642\u062A\u0627\u062F\u0629 \u0631\u062D\u0645\u0647 \u0627\u0644\u0644\u0647: \u0642\u0648\u0644\u0647: { \u0623\u064E\u0648\u0652\u0644\u064E\u0649\u0670 \u0644\u064E\u0643\u064E \u0641\u064E\u0623\u064E\u0648\u0652\u0644\u064E\u0649\u0670 \uFD3F\u0663\u0664\uFD3E \u062B\u064F\u0645\u0651\u064E \u0623\u064E\u0648\u0652\u0644\u064E\u0649\u0670 \u0644\u064E\u0643\u064E \u0641\u064E\u0623\u064E\u0648\u0652\u0644\u064E\u0649\u0670\u0653 \uFD3F\u0663\u0665\uFD3E } \u0648\u0639\u064A\u062F \u0639\u0644\u0649 \u0623\u062B\u0631 \u0648\u0639\u064A\u062F\u060C \u0643\u0645\u0627 \u062A\u0632\u0639\u0645\u0648\u0646\u060C \u0648\u0632\u0639\u0645\u0648\u0627 \u0623\u0646 \u0639\u062F\u0648 \u0627\u0644\u0644\u0647 \u0623\u0628\u0627 \u062C\u0647\u0644 \u0623\u062E\u0630 \u0646\u0628\u064A \u0627\u0644\u0644\u0647 \uFDFA \u0628\u0645\u062C\u0627\u0645\u0639 \u062B\u064A\u0627\u0628\u0647\u060C \u062B\u0645 \u0642\u0627\u0644: { \u0623\u064E\u0648\u0652\u0644\u064E\u0649\u0670 \u0644\u064E\u0643\u064E \u0641\u064E\u0623\u064E\u0648\u0652\u0644\u064E\u0649\u0670 \uFD3F\u0663\u0664\uFD3E \u062B\u064F\u0645\u0651\u064E \u0623\u064E\u0648\u0652\u0644\u064E\u0649\u0670 \u0644\u064E\u0643\u064E \u0641\u064E\u0623\u064E\u0648\u0652\u0644\u064E\u0649\u0670\u0653 \uFD3F\u0663\u0665\uFD3E }\u060C \u0641\u0642\u0627\u0644 \u0639\u062F\u0648 \u0627\u0644\u0644\u0647 \u0623\u0628\u0648 \u062C\u0647\u0644: \u0623\u062A\u0648\u0639\u062F\u0646\u064A \u064A\u0627 \u0645\u062D\u0645\u062F\u061F \u0648\u0627\u0644\u0644\u0647 \u0644\u0627 \u062A\u0633\u062A\u0637\u064A\u0639 \u0623\u0646\u062A\u060C \u0648\u0644\u0627 \u0631\u0628\u0643 \u0634\u064A\u0626\u0627\u064B\u060C \u0648\u0625\u0646\u064A \u0644\u0623\u0639\u0632\u0651\u064F \u0645\u0646 \u0645\u0634\u0649 \u0628\u064A\u0646 \u062C\u0628\u0644\u064A\u0647\u0627.",
