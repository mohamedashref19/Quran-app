        "93_3": {
            "title": "\u0645\u0627 \u0648\u062F\u0639\u0643 \u0631\u0628\u0643 \u0648\u0645\u0627 \u0642\u0644\u0649",
            "sabab": "\u0646\u0632\u0644\u062A \u062D\u064A\u0646 \u0627\u062D\u062A\u064F\u0628\u0633 \u0627\u0644\u0648\u062D\u064A \u0639\u0646 \u0627\u0644\u0646\u0628\u064A \uFDFA \u0641\u062A\u0631\u0629\u060C \u0641\u0642\u0627\u0644 \u0627\u0644\u0645\u0634\u0631\u0643\u0648\u0646 \u0625\u0646 \u0631\u0628\u0647 \u0648\u062F\u0651\u0639\u0647 \u0648\u0642\u0644\u0627\u0647\u060C \u0641\u0646\u0632\u0644\u062A \u0647\u0630\u0647 \u0627\u0644\u0622\u064A\u0629 \u062A\u0637\u0645\u064A\u0646\u064B\u0627 \u0644\u0644\u0646\u0628\u064A \uFDFA.",
            "fadl": "",
            "action": "\u0641\u064A \u0644\u062D\u0638\u0627\u062A \u062A\u0623\u062E\u0631 \u0627\u0644\u0641\u0631\u062C \u0623\u0648 \u0627\u0644\u0634\u0639\u0648\u0631 \u0628\u0627\u0644\u0648\u062D\u062F\u0629\u060C \u062A\u0630\u0643\u0631 \u0623\u0646 \u0627\u0644\u0644\u0647 \u0645\u0627 \u0648\u062F\u0651\u0639\u0643 \u0648\u0644\u0627 \u062A\u0631\u0643\u0643. \u0647\u0648 \u0645\u0639\u0643 \u062F\u0627\u0626\u0645\u064B\u0627."
        },
        "93_5": {
            "title": "\u0648\u064E\u0644\u064E\u0633\u064E\u0648\u0652\u0641\u064E \u064A\u064F\u0639\u0652\u0637\u0650\u064A\u0643\u064E \u0631\u064E\u0628\u0651\u064F\u0643\u064E \u0641\u064E\u062A\u064E\u0631\u0652\u0636\u064E\u0649\u0670",
            "sabab": "\u0639\u0646 \u0627\u0628\u0646 \u0639\u0628\u0627\u0633 \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u0642\u0627\u0644: \u0642\u0627\u0644 \u0631\u0633\u0648\u0644 \u0627\u0644\u0644\u0647 \uFDFA: \xab \u0639\u0631\u0636 \u0639\u0644\u064A \u0645\u0627 \u0647\u0648 \u0645\u0641\u062A\u0648\u062D \u0644\u0623\u0645\u062A\u064A \u0628\u0639\u062F\u064A \xbb. \u0641\u0623\u0646\u0632\u0644 \u0627\u0644\u0644\u0647 { \u0648\u064E\u0644\u064E\u0644\u0652\u0640\u0654\u064E\u0627\u062E\u0650\u0631\u064E\u0629\u064F \u062E\u064E\u064A\u0652\u0631\u064C \u0644\u0651\u064E\u0643\u064E \u0645\u0650\u0646\u064E \u0671\u0644\u0652\u0623\u064F\u0648\u0644\u064E\u0649\u0670 \uFD3F\u0664\uFD3E }.",
            "fadl": "",
            "action": ""
        },
        "94_5": {
            "title": "\u0641\u0625\u0646 \u0645\u0639 \u0627\u0644\u0639\u0633\u0631 \u064A\u0633\u0631\u0627\u064B",
            "sabab": "\u0646\u0632\u0644\u062A \u062A\u0633\u0644\u064A\u0629\u064B \u0644\u0644\u0646\u0628\u064A \uFDFA \u0648\u062A\u0630\u0643\u064A\u0631\u0627\u064B \u0628\u0623\u0646 \u0645\u0639 \u0643\u0644 \u0634\u062F\u0629 \u0641\u0631\u062C\u0627\u064B.",
            "fadl": "\u0643\u0631\u0651\u0631\u0647\u0627 \u0627\u0644\u0644\u0647 \u0645\u0631\u062A\u064A\u0646 \u0641\u064A \u0633\u0648\u0631\u0629 \u0648\u0627\u062D\u062F\u0629\u060C \u0641\u0627\u0644\u0639\u0633\u0631 \u0648\u0627\u062D\u062F \u0628\u0627\u0644\u0644\u0627\u0645 \u0627\u0644\u0645\u0639\u0631\u0651\u0641\u0629\u060C \u0648\u0627\u0644\u064A\u0633\u0631 \u0627\u062B\u0646\u0627\u0646 \u0628\u0627\u0644\u062A\u0646\u0643\u064A\u0631\u060C \u0623\u064A \u064A\u064F\u0633\u0631\u0627\u0646 \u0645\u0642\u0627\u0628\u0644 \u0639\u0633\u0631 \u0648\u0627\u062D\u062F.",
            "action": "\u0645\u0639 \u0643\u0644 \u0635\u0639\u0648\u0628\u0629 \u062A\u0648\u0627\u062C\u0647\u0647\u0627\u060C \u0627\u0639\u0644\u0645 \u0623\u0646 \u0645\u0639\u0647\u0627 \u064A\u064F\u0633\u0631\u0627\u064B\u060C \u0648\u0643\u0644\u0645\u0627 \u0627\u0634\u062A\u062F\u0651 \u0627\u0644\u0636\u064A\u0642\u060C \u0643\u0644\u0645\u0627 \u0627\u0642\u062A\u0631\u0628 \u0627\u0644\u0641\u0631\u062C."
        },
        "96_6": {
            "title": "\u0643\u064E\u0644\u0651\u064E\u0627 \u0625\u0650\u0646\u0651\u064E \u0627\u0644\u0652\u0625\u0650\u0646\u0652\u0633\u064E\u0627\u0646\u064E \u0644\u064E\u064A\u064E\u0637\u0652\u063A\u064E\u0649\u0670",
            "sabab": "\u0639\u064E\u0646\u0652 \u0623\u064E\u0628\u0650\u064A \u0647\u064F\u0631\u064E\u064A\u0652\u0631\u064E\u0629\u064E \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647 \u0642\u064E\u0627\u0644\u064E: \u0642\u064E\u0627\u0644\u064E \u0623\u064E\u0628\u064F\u0648 \u062C\u064E\u0647\u0652\u0644\u064D: \u0647\u064E\u0644\u0652 \u064A\u064F\u0639\u064E\u0641\u0651\u0650\u0631\u064F \u0645\u064F\u062D\u064E\u0645\u0651\u064E\u062F\u064C \u0648\u064E\u062C\u0652\u0647\u064E\u0647\u064F \u0628\u064E\u064A\u0652\u0646\u064E \u0623\u064E\u0638\u0652\u0647\u064F\u0631\u0650\u0643\u064F\u0645\u0652\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0642\u0650\u064A\u0644\u064E: \u0646\u064E\u0639\u064E\u0645\u0652\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E: \u0648\u064E\u0627\u0644\u0644\u0651\u064E\u0627\u062A\u0650 \u0648\u064E\u0627\u0644\u0652\u0639\u064F\u0632\u0651\u064E\u0649 \u0644\u064E\u0626\u0650\u0646\u0652 \u0631\u064E\u0623\u064E\u064A\u0652\u062A\u064F\u0647\u064F \u064A\u064E\u0641\u0652\u0639\u064E\u0644\u064F \u0630\u064E\u0644\u0650\u0643\u064E \u0644\u0623\u064E\u0637\u064E\u0623\u064E\u0646\u0651\u064E \u0639\u064E\u0644\u064E\u0649 \u0631\u064E\u0642\u064E\u0628\u064E\u062A\u0650\u0647\u0650\u060C \u0623\u064E\u0648\u0652 \u0644\u064E\u0623\u064F\u0639\u064E\u0641\u0651\u0650\u0631\u064E\u0646\u0651\u064E \u0648\u064E\u062C\u0652\u0647\u064E\u0647\u064F \u0641\u0650\u064A \u0627\u0644\u062A\u0651\u064F\u0631\u064E\u0627\u0628\u0650\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0623\u064E\u062A\u064E\u0649 \u0631\u064E\u0633\u064F\u0648\u0644\u064E \u0627\u0644\u0644\u0647\u0650 \uFDFA \u0648\u064E\u0647\u064F\u0648\u064E \u064A\u064F\u0635\u064E\u0644\u0651\u0650\u064A\u064E\u060C \u0632\u064E\u0639\u064E\u0645\u064E \u0644\u0650\u064A\u064E\u0637\u064E\u0623\u064E \u0639\u064E\u0644\u064E\u0649 \u0631\u064E\u0642\u064E\u0628\u064E\u062A\u0650\u0647\u0650\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0645\u064E\u0627 \u0641\u064E\u062C\u0650\u0626\u064E\u0647\u064F\u0645\u0652 \u0645\u0650\u0646\u0652\u0647\u064F \u0625\u0650\u0644\u0651\u064E\u0627 \u0648\u064E\u0647\u064F\u0648\u064E \u064A\u064E\u0646\u0652\u0643\u064F\u0635\u064F \u0639\u064E\u0644\u064E\u0649 \u0639\u064E\u0642\u0650\u0628\u064E\u064A\u0652\u0647\u0650\u060C \u0648\u064E\u064A\u064E\u062A\u0651\u064E\u0642\u0650\u064A \u0628\u0650\u064A\u064E\u062F\u064E\u064A\u0652\u0647\u0650\u060C \u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0642\u0650\u064A\u0644\u064E \u0644\u064E\u0647\u064F: \u0645\u064E\u0627 \u0644\u064E\u0643\u064E\u061F \u0641\u064E\u0642\u064E\u0627\u0644\u064E: \u0625\u0650\u0646\u0651\u064E \u0628\u064E\u064A\u0652\u0646\u0650\u064A \u0648\u064E\u0628\u064E\u064A\u0652\u0646\u064E\u0647\u064F \u0644\u064E\u062E\u064E\u0646\u0652\u062F\u064E\u0642\u0627\u064B \u0645\u0650\u0646\u0652 \u0646\u064E\u0627\u0631\u064D \u0648\u064E\u0647\u064F\u0648\u0652\u0644\u064B\u0627 \u0648\u064E\u0623\u064E\u062C\u0652\u0646\u0650\u062D\u064E\u0629\u064B.\n\n\u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0631\u064E\u0633\u064F\u0648\u0644\u064F \u0627\u0644\u0644\u0647\u0650 \uFDFA: \xab \u0644\u064E\u0648\u0652 \u062F\u064E\u0646\u064E\u0627 \u0645\u0650\u0646\u0651\u0650\u064A \u0644\u064E\u0627\u064E\u062E\u0652\u062A\u064E\u0637\u064E\u0641\u064E\u062A\u0652\u0647\u064F \u0627\u0644\u0652\u0645\u064E\u0644\u064E\u0627\u0626\u0650\u0643\u064E\u0629\u064F \u0639\u064F\u0636\u064F\u0648\u0627 \u0639\u064F\u0636\u0652\u0648\u0627 \xbb.\n\n\u0642\u064E\u0627\u0644\u064E: \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F \u0639\u0632 \u0648 \u062C\u0644 - \u0644\u064E\u0627 \u0646\u064E\u062F\u0652\u0631\u0650\u064A \u0641\u0650\u064A \u062D\u064E\u062F\u0650\u064A\u062B\u0650 \u0623\u064E\u0628\u0650\u064A \u0647\u0650\u0631\u064E\u064A\u0652\u0631\u064E\u0629\u064E \u0623\u064E\u0648\u0652 \u0634\u064E\u064A\u0652\u0621\u064C \u0628\u064E\u0644\u064E\u063A\u064E\u0647\u064F -: { \u0643\u0640\u064E\u0644\u0651\u064E\u0627\u0653 \u0625\u0650\u0646\u0651\u064E \u0671\u0644\u0652\u0625\u0650\u0646\u0633\u064E\u0670\u0646\u064E \u0644\u064E\u064A\u064E\u0637\u0652\u063A\u064E\u0649\u0670\u0653 \uFD3F\u0666\uFD3E \u0623\u064E\u0646 \u0631\u0651\u064E\u0621\u064E\u0627\u0647\u064F \u0671\u0633\u0652\u062A\u064E\u063A\u0652\u0646\u064E\u0649\u0670\u0653 \uFD3F\u0667\uFD3E \u0625\u0650\u0646\u0651\u064E \u0625\u0650\u0644\u064E\u0649\u0670 \u0631\u064E\u0628\u0651\u0650\u0643\u064E \u0671\u0644\u0631\u0651\u064F\u062C\u0652\u0639\u064E\u0649\u0670\u0653 \uFD3F\u0668\uFD3E \u0623\u064E\u0631\u064E\u0621\u064E\u064A\u0652\u062A\u064E \u0671\u0644\u0651\u064E\u0630\u0650\u0649 \u064A\u064E\u0646\u0652\u0647\u064E\u0649\u0670 \uFD3F\u0669\uFD3E \u0639\u064E\u0628\u0652\u062F\u064B\u0627 \u0625\u0650\u0630\u064E\u0627 \u0635\u064E\u0644\u0651\u064E\u0649\u0670\u0653 \uFD3F\u0661\u0660\uFD3E \u0623\u064E\u0631\u064E\u0621\u064E\u064A\u0652\u062A\u064E \u0625\u0650\u0646 \u0643\u064E\u0627\u0646\u064E \u0639\u064E\u0644\u064E\u0649 \u0671\u0644\u0652\u0647\u064F\u062F\u064E\u0649\u0670\u0653 \uFD3F\u0661\u0661\uFD3E \u0623\u064E\u0648\u0652 \u0623\u064E\u0645\u064E\u0631\u064E \u0628\u0650\u0671\u0644\u062A\u0651\u064E\u0642\u0652\u0648\u064E\u0649\u0670\u0653 \uFD3F\u0661\u0662\uFD3E \u0623\u064E\u0631\u064E\u0621\u064E\u064A\u0652\u062A\u064E \u0625\u0650\u0646 \u0643\u064E\u0630\u0651\u064E\u0628\u064E \u0648\u064E\u062A\u064E\u0648\u064E\u0644\u0651\u064E\u0649\u0670\u0653 \uFD3F\u0661\u0663\uFD3E \u0623\u064E\u0644\u064E\u0645\u0652 \u064A\u064E\u0639\u0652\u0644\u064E\u0645 \u0628\u0650\u0623\u064E\u0646\u0651\u064E \u0671\u0644\u0644\u0651\u064E\u0647\u064E \u064A\u064E\u0631\u064E\u0649\u0670 \uFD3F\u0661\u0664\uFD3E } \u064A\u064E\u0639\u0652\u0646\u0650\u064A \u0623\u064E\u0628\u064E\u0627 \u062C\u064E\u0647\u0652\u0644\u0650 { \u0643\u064E\u0644\u0651\u064E\u0627 \u0644\u064E\u0626\u0650\u0646 \u0644\u0651\u064E\u0645\u0652 \u064A\u064E\u0646\u062A\u064E\u0647\u0650 \u0644\u064E\u0646\u064E\u0633\u0652\u0641\u064E\u0639\u064E\u06E2\u0627 \u0628\u0650\u0671\u0644\u0646\u0651\u064E\u0627\u0635\u0650\u064A\u064E\u0629\u0650 \uFD3F\u0661\u0665\uFD3E \u0646\u064E\u0627\u0635\u0650\u064A\u064E\u0629\u064D \u0643\u064E\u0640\u0670\u0630\u0650\u0628\u064E\u0629\u064D \u062E\u064E\u0627\u0637\u0650\u0626\u064E\u0629\u064D \uFD3F\u0661\u0666\uFD3E \u0641\u064E\u0644\u0652\u064A\u064E\u062F\u0652\u0639\u064F \u0646\u064E\u0627\u062F\u0650\u064A\u064E\u0647\u064F\u06E5 \uFD3F\u0661\u0667\uFD3E \u0633\u064E\u0646\u064E\u062F\u0652\u0639\u064F \u0671\u0644\u0632\u0651\u064E\u0628\u064E\u0627\u0646\u0650\u064A\u064E\u0629\u064E \uFD3F\u0661\u0668\uFD3E \u0643\u064E\u0644\u0651\u064E\u0627 \u0644\u064E\u0627 \u062A\u064F\u0637\u0650\u0639\u0652\u0647\u064F }\u060C \u0632\u064E\u0627\u062F\u064E \u0639\u064F\u0628\u064E\u064A\u0652\u062F\u064F \u0627\u0644\u0644\u0647\u0650 \u0641\u0650\u064A \u062D\u064E\u062F\u0650\u064A\u062B\u0650\u0647\u0650: \u0642\u064E\u0627\u0644\u064E: \u0648\u064E\u0623\u064E\u0645\u064E\u0631\u064E\u0647\u064F \u0628\u0650\u0645\u064E\u0627 \u0623\u064E\u0645\u064E\u0631\u064E\u0647\u064F \u0628\u0650\u0647\u0650.\n\n\u0648\u064E\u0632\u064E\u0627\u062F\u064E \u0627\u0628\u0652\u0646\u064F \u0639\u064E\u0628\u0652\u062F\u0650 \u0627\u0644\u0652\u0623\u064E\u0639\u0652\u0644\u064E\u0649: { \u0641\u064E\u0644\u0652\u064A\u064E\u062F\u0652\u0639\u064F \u0646\u064E\u0627\u062F\u0650\u064A\u064E\u0647\u064F\u06E5 } \u064A\u064E\u0639\u0652\u0646\u0650\u064A \u0642\u064E\u0648\u0652\u0645\u064E\u0647\u064F.\n\n\uD83D\uDCCC \u0631\u0648\u0627\u064A\u0629 \u0623\u062E\u0631\u0649: \n\u0639\u064E\u0646\u0650 \u0627\u0628\u0652\u0646\u0650 \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D \u0631\u0636\u064A \u0627\u0644\u0644\u0647 \u0639\u0646\u0647\u0645\u0627 \u0642\u064E\u0627\u0644\u064E: \u0643\u064E\u0627\u0646\u064E \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064F \uFDFA \u064A\u064F\u0635\u064E\u0644\u0651\u0650\u064A\u060C \u0641\u064E\u062C\u064E\u0627\u0621\u064E \u0623\u064E\u0628\u064F\u0648 \u062C\u064E\u0647\u0652\u0644\u064D\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E: \u0623\u064E\u0644\u064E\u0645\u0652 \u0623\u064E\u0646\u0652\u0647\u064E\u0643\u064E \u0639\u064E\u0646\u0652 \u0647\u064E\u0630\u064E\u0627\u061F \u0623\u064E\u0644\u064E\u0645\u0652 \u0623\u064E\u0646\u0652\u0647\u064E\u0643\u064E \u0639\u064E\u0646\u0652 \u0647\u064E\u0630\u064E\u0627\u061F \u0623\u064E\u0644\u064E\u0645\u0652 \u0623\u064E\u0646\u0652\u0647\u064E\u0643\u064E \u0639\u064E\u0646\u0652 \u0647\u064E\u0630\u064E\u0627\u061F \u0641\u064E\u0627\u0646\u0652\u0635\u064E\u0631\u064E\u0641\u064E \u0627\u0644\u0646\u0651\u064E\u0628\u0650\u064A\u0651\u064F \uFDFA \u0641\u064E\u0632\u064E\u0628\u064E\u0631\u064E\u0647\u064F\u060C \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0623\u064E\u0628\u064F\u0648 \u062C\u064E\u0647\u0652\u0644\u064D: \u0625\u0650\u0646\u0651\u064E\u0643\u064E \u0644\u064E\u062A\u064E\u0639\u0652\u0644\u064E\u0645\u064F \u0645\u064E\u0627 \u0628\u0650\u0647\u064E\u0627 \u0646\u064E\u0627\u062F\u064D \u0623\u064E\u0643\u0652\u062B\u064E\u0631\u064F \u0645\u0650\u0646\u0651\u0650\u064A\u060C \u0641\u064E\u0623\u064E\u0646\u0652\u0632\u064E\u0644\u064E \u0627\u0644\u0644\u0647\u064F { \u0641\u064E\u0644\u0652\u064A\u064E\u062F\u0652\u0639\u064F \u0646\u064E\u0627\u062F\u0650\u064A\u064E\u0647\u064F\u06E5 \uFD3F\u0661\u0667\uFD3E \u0633\u064E\u0646\u064E\u062F\u0652\u0639\u064F \u0671\u0644\u0632\u0651\u064E\u0628\u064E\u0627\u0646\u0650\u064A\u064E\u0629\u064E \uFD3F\u0661\u0668\uFD3E }. \u0641\u064E\u0642\u064E\u0627\u0644\u064E \u0627\u0628\u0652\u0646\u064F \u0639\u064E\u0628\u0651\u064E\u0627\u0633\u064D: \u0641\u064E\u0648\u064E\u0627\u0644\u0644\u0647\u0650 \u0644\u064E\u0648\u0652 \u062F\u064E\u0639\u064E\u0627 \u0646\u064E\u0627\u062F\u0650\u064A\u064E\u0647\u064F \u0644\u064E\u0623\u064E\u062E\u064E\u0630\u0