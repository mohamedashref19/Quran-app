extends base

block content
  .row.justify-content-center
    .col-md-5
      .card.border-0.shadow.p-4
        .card-body
          h2.text-center.mb-4.text-success تعيين كلمة مرور جديدة 🔑
          
          form#resetPasswordForm
            .mb-3
              label.form-label(for='password') كلمة المرور الجديدة
              input#password.form-control(type='password' placeholder='••••••••' required minlength='8')
            .mb-3
              label.form-label(for='passwordConfirm') تأكيد كلمة المرور
              input#passwordConfirm.form-control(type='password' placeholder='••••••••' required minlength='8')
            
            button.btn.btn-aqra.w-100.py-2.btn-reset(type='submit') تغيير كلمة المرور