extends base

block content
  .row.justify-content-center
    .col-md-5
      .card.border-0.shadow.p-4
        .card-body
          h2.text-center.mb-4.text-success نسيت كلمة المرور؟ 🔒
          p.text-muted.text-center أدخل بريدك الإلكتروني وسنرسل لك رابطاً لاستعادة الحساب.
          
          form#forgotPasswordForm
            .mb-3
              label.form-label(for='email') البريد الإلكتروني
              input#email.form-control(type='email' placeholder='name@example.com' required)
            
            button.btn.btn-aqra.w-100.py-2(type='submit') إرسال الرابط