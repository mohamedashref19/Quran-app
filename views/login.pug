extends base

block content
  .row.justify-content-center
    .col-md-5
      .card.border-0.shadow.p-4
        .card-body
          h2.text-center.mb-4.text-success تسجيل الدخول
          form#loginForm
            .mb-3
              label.form-label(for='email') البريد الإلكتروني
              input#email.form-control(type='email' placeholder='name@example.com' required)
            .mb-3
              label.form-label(for='password') كلمة المرور
              input#password.form-control(type='password' placeholder='••••••••' required minlength='8')
            
            button.btn.btn-aqra.w-100.py-2.mb-3(type='submit') دخول
            
            .text-center
              a.text-muted.text-decoration-none(href='/forgot-password') نسيت كلمة المرور؟