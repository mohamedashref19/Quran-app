doctype html
html(dir="rtl" lang="ar")
  head
    block head
      meta(charset='UTF-8')
      meta(name='viewport' content='width=device-width, initial-scale=1.0')
      title Aqra | #{title}
      link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css')
      link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css')
      link(rel="stylesheet", href="/css/style.css")
      link(rel="shortcut icon", type="image/png", href="/img/title.png")
      link(rel="manifest", href="/manifest.json")
      meta(name="theme-color", content="#1e5f31")
      link(rel="apple-touch-icon", href="/img/icons/icon-192.png")
      link(rel="stylesheet", href=`/css/style.css?t=${Date.now()}`)

  body.d-flex.flex-column.min-vh-100
    
    // NAVIGATION
    nav.navbar.navbar-expand-lg.navbar-dark.bg-aqra.shadow-sm.py-2
      .container.d-flex.align-items-center
        // 1. اسم التطبيق (سيكون في أقصى اليمين - Order 0)
        a.navbar-brand.fw-bold.order-0(href='/') 📖 تطبيق اقرأ
        
        .d-flex.align-items-center.mx-auto.order-1(style="flex: 1; max-width: 600px; justify-content: center;")
        
          // حاوية البحث
          .search-container.position-relative.w-100(style="max-width: 450px;")
            input#search-input.form-control.rounded-pill.px-4.py-2.test2(type="text" placeholder="ابحث عن آية أو كلمة..." style="border: 2px solid #1e5f31; padding-left: 40px;")
            i.fas.fa-search.position-absolute.text-muted(style="left: 15px; top: 50%; transform: translateY(-50%);")
            #search-results.list-group.position-absolute.w-100.shadow-lg.d-none(style="z-index: 1000; max-height: 300px; overflow-y: auto; top: 50px;")

          // زر الثيم بجانب البحث مباشرة
          button#theme-toggle.btn.btn-link.nav-link.ms-2(title="تغيير المظهر")
            i.fas.fa-moon.fs-5.text-white

        

           
        // 3. زر الثلاث شرطات (سيكون في أقصى اليسار - Order 2)
        button.navbar-toggler.order-2.ms-2(type='button' data-bs-toggle='collapse' data-bs-target='#navbarNav')
          span.navbar-toggler-icon
        
        // 4. القائمة المنسدلة (تظهر عند الضغط على الشرطات - Order 3)
        #navbarNav.collapse.navbar-collapse.order-3
          ul.navbar-nav.ms-auto
            if user
              li.nav-item: a.nav-link(href='/me') 👤 حسابي
              if user.role === 'admin'
                li.nav-item: a.nav-link.text-warning(href='/manage-users') 🛠️ لوحة الأدمن
              li.nav-item: a.nav-link(href='#' id='logoutBtn') تسجيل خروج
            else
              li.nav-item: a.nav-link(href='/login') تسجيل دخول
              li.nav-item: a.nav-link(href='/signup') إنشاء حساب

    // CONTENT
    .container.my-5
      block content

    script.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/service-worker.js')
            .then(function(registration) {
              console.log('SW Registered ✅');
              
              registration.onupdatefound = function() {
                const installingWorker = registration.installing;
                installingWorker.onstatechange = function() {
                  if (installingWorker.state === 'installed') {
                    if (navigator.serviceWorker.controller) {
                      console.log('New content is available; please refresh.');
                    } else {
                      console.log('Content is cached for offline use.');
                    }
                  }
                };
              };
            }, function(err) {
              console.log('SW Registration Failed ❌: ', err);
            });
        });
        //-for New website
        navigator.serviceWorker.getRegistrations().then(function(registrations) {
           for(let registration of registrations) {
              if(registration.scope !== window.location.origin + '/') {
                  registration.unregister();
              }
           }
        });
      }

    footer.bg-white.border-top.py-3.mt-auto
      .container
        .row.align-items-center.flex-column-reverse.flex-md-row
          .col-md-6.text-center.text-md-end
            .d-flex.align-items-center.justify-content-center.justify-content-md-start
              img.me-2(src="/img/title.png" alt="Aqra Logo" style="width: 18px; height: 18px; opacity: 0.8;")
              p.mb-0.text-muted.fw-light(style="font-size: 0.85rem;")
                | جميع الحقوق محفوظة لـ 
                strong.text-success تطبيق اقرأ 
                | &copy; 
                span#current-year

          .col-md-6.text-center.text-md-start.mb-2.mb-md-0
            div.d-flex.align-items-center.justify-content-center.justify-content-md-start.gap-2
              p.mb-0.text-muted(style="font-size: 0.85rem;") تم التطوير بواسطة 
              a.text-dark.text-decoration-none.fw-bold(href='https://mohamed-ashraf-backend.netlify.app/' target='_blank') Mohamed Ashraf
              
              span.text-muted.mx-1 |
              
              a.text-secondary.social-link(href="https://github.com/mohamedashref19" target='_blank'): i.fab.fa-github
              a.text-secondary.social-link(href="https://www.linkedin.com/in/mohamed-ashraf-dev/" target='_blank'): i.fab.fa-linkedin-in

    // SCRIPTS
    script(src='https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js')
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11")
    script(src='https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js')
    script(src='https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.6/dist/umd/popper.min.js')
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.min.js')
    script(src=`/js/bundle.js?t=${Date.now()}`)
    block scripts

    script.
      document.getElementById('current-year').textContent = new Date().getFullYear();