extends base

block content
  .container.py-5
    .text-center.mb-5
      h1.text-success 🔖 العلامات المحفوظة
      p.text-muted ارجع للآيات التي توقفت عندها بسهولة
    .row.justify-content-center.mb-4
      .col-md-6
        .input-group.shadow-sm.rounded-pill.overflow-hidden
          span.input-group-text.bg-white.border-0: i.fas.fa-search.text-success
          input#search-bookmarks-input.form-control.border-0.py-2(type="text" placeholder="ابحث في العلامات المحفوظة (سورة أو نص آية)...")  

    #bookmarks-container.row.g-4
      .text-center
        .spinner-border.text-success(role="status")