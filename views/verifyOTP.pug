extends base

block content
  .row.justify-content-center
    .col-md-5
      .card.border-0.shadow.p-4.text-center
        .card-body
          .display-1.mb-3 📩
          h3 تفعيل الحساب
          p.text-muted لقد أرسلنا رمز التحقق إلى بريدك الإلكتروني.
          
          form#verifyOTPForm.mt-4
            .mb-3.text-start
              label.form-label البريد الإلكتروني
              input#email.form-control(type='email' placeholder='الإيميل المسجل' required)
            .mb-3.text-start
              label.form-label رمز التحقق (OTP)
              input#otp.form-control(type='text' placeholder='123456' required maxlength='6' style="letter-spacing: 5px; text-align: center; font-size: 1.2rem;")
            
            button.btn.btn-aqra.w-100(type='submit') تفعيل الحساب